@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

// slaengine — umbrella crate and App-layer host (skeleton form).
//
// Organisation follows Bevy's App/System shape (owner ruling 2026-11-01):
//
//     App (builder) -> Plugin (registration) -> Schedule -> System (run)
//
// This file is the thin first form of that shape, NOT a plain re-export
// layer. `App` is the value every future engine layer hangs off:
//
//   - app_new()          the builder entry; reserved crates register here.
//   - app_add_plugin()   the Plugin registration point (counted today;
//                        real Plugin values land with sla_ecs / render).
//   - app_add_system()   the System registration point for Schedules.
//   - app_run()          the Schedule runner; today it reports the
//                        registry and exits 0.
//
// When sla_ecs is embedded (crates/sla_ecs) and the render backends land
// (crates/sla_webgl first, crates/sla_gpu second), their Plugins register
// through these same points without changing this entry's shape.
//
// TARGET SURFACE (owner conciseness benchmark, 2026-11-01; the Bevy
// dynamic system-registration example, kept at
// ~/workspace/slaengine-survey/bevy_system_registry_example.rs). The App
// layer's reserved form aims at exactly this surface, in SLA terms:
//
//   - one prelude-style import line brings App/Commands/Query/SystemId in;
//   - App builder: new() -> add_systems(SCHEDULE_LABEL, system) -> run();
//   - schedule labels are named slots (Startup, Update, ...), registered
//     through app_add_systems(app, label, system) below;
//   - Commands is the deferred queue: spawn(component),
//     register_system(closure) -> SystemId, register_boxed_system(boxed),
//     run_system(id);
//   - SystemId is a plain value that can be stored INSIDE a Component and
//     invoked later via run_system(id);
//   - Query<T> iteration over components inside ordinary systems;
//     exclusive systems take the whole World.
//
// MORPHOLOGY REGISTRATION ONLY: names and shapes above are reserved; no
// semantics are implemented in this skeleton. Two benchmark requirements
// are explicitly NOT degraded to the survey's function-pointer +
// descriptor-registry form: (1) closure systems must be registrable, not
// just static functions; (2) SystemId must be storable in a Component.
// Whether sla_ecs's existing mechanisms (AppFunctionRegistry descriptor
// registry as base material) can carry closure capture and boxed systems
// is an open design question for the implementation batch — itemised as
// capability checks in FOUNDATION_REPORT.md, marked unverified there.
//
// Workspace membership has exactly one source of truth: workspace.toml.
// Member crates (active):     slasl  — shader compiler (crates/slasl)
//                             sax3d  — 3D asset format (crates/sax3d)
// Member crates (reserved):   sla_asset, sla_ecs, sla_3d, sla_webgl, sla_gpu

struct App {
    plugins: i32,
    systems: i32,
}

fn app_new() -> App {
    return App { plugins: 0, systems: 0 };
}

fn app_add_plugin(a: &App) {
    a.plugins = a.plugins + 1;
}

fn app_add_system(a: &App) {
    a.systems = a.systems + 1;
}

// Benchmark-shaped registration point: systems attach to a named
// Schedule label (0 = Startup, 1 = Update, ...). The label is accepted
// and reserved today; Schedule storage lands with sla_ecs.
fn app_add_systems(a: &App, schedule: i32) {
    a.systems = a.systems + 1;
}

fn app_run(a: &App) -> i32 {
    println("slaengine 0.1.0 - workspace umbrella (App skeleton)");
    println("members active: slasl, sax3d");
    println("members reserved: sla_asset, sla_ecs, sla_3d, sla_webgl, sla_gpu");
    println("plugins registered: {}", a.plugins);
    println("systems registered: {}", a.systems);
    return 0;
}

fn main() -> i32 {
    let app = app_new();
    // The two active member crates register as the App's founding Plugins.
    // Reserved crates (sla_ecs, sla_3d, sla_webgl, sla_gpu) register through
    // the same point when they land; no Systems exist yet (no Schedules).
    app_add_plugin(&app);
    app_add_plugin(&app);
    // One Startup-label registration exercises the benchmark-shaped
    // add_systems(label, system) point; no real System exists yet.
    app_add_systems(&app, 0);
    return app_run(&app);
}
