// json.sla — JSON DOM + 解析器（convert 移植用）。
// Zig 侧对应 std.json.Value：对象保插入序（转换器的迭代点都先排序键，
// 与 std.json 的哈希序无关）；整数/浮点双轨（ji 对浮点截断、jf 对
// 整数提升，与 Zig 助手语义一致）。字符串解码后存 strs（\\u 含代理对）。
// 值以 id 索引并行 Vec 存储；f64 走位模式（GAP-PORT-7 纪律）。

@import "../src/core.sla"
@import "../src/numfmt.sla"

struct JDoc {
    kinds: Vec<i32>,       // 0 null 1 bool 2 int 3 float 4 string 5 array 6 object
    ints: Vec<i64>,
    fbits: Vec<u64>,
    flags: Vec<i32>,       // bool 值
    soff: Vec<i32>,
    slen: Vec<i32>,
    aoff: Vec<i32>,        // array: items 在 pool 中的起止
    alen: Vec<i32>,
    koff: Vec<i32>,        // object: 值在 pool 中的段基址
    klen: Vec<i32>,
    kbase: Vec<i32>,       // object: 键在 kpool 中的段基址（与 pool 独立计）
    pool: Vec<i32>,        // array 元素 id / object 值 id 交错池
    kpool_off: Vec<i32>,   // object 键 span（与 pool 同索引段的 koff/klen 另存两列不够——键与值同段：koff2/klen2 平行 pool）
    kpool_len: Vec<i32>,
    strs: SBuf,
    err: bool,
}

fn j_new() -> JDoc {
    let d = JDoc {
        kinds: Vec::new(), ints: Vec::new(), fbits: Vec::new(), flags: Vec::new(),
        soff: Vec::new(), slen: Vec::new(), aoff: Vec::new(), alen: Vec::new(),
        koff: Vec::new(), klen: Vec::new(), kbase: Vec::new(), pool: Vec::new(),
        kpool_off: Vec::new(), kpool_len: Vec::new(),
        strs: sb_new(), err: false,
    };
    return d;
}

fn j_push(d: &JDoc, kind: i32) -> i32 {
    d.kinds.push(kind);
    d.ints.push(0i64);
    d.fbits.push(0u64);
    d.flags.push(0i32);
    d.soff.push(0i32);
    d.slen.push(0i32);
    d.aoff.push(0i32);
    d.alen.push(0i32);
    d.koff.push(0i32);
    d.klen.push(0i32);
    d.kbase.push(0i32);
    return d.kinds.len() - 1;
}

fn j_kind(d: &JDoc, v: i32) -> i32 {
    if v < 0 { return -1; };
    return d.kinds[v as usize];
}

// 对象按键查找：命中返回值 id，未命中 -1（非对象亦 -1）。
fn j_get(d: &JDoc, v: i32, key: ptr, klen: i64) -> i32 {
    if j_kind(d, v) != 6 { return -1; };
    let base = d.koff[v as usize];
    let kbase = d.kbase[v as usize];
    let n = d.klen[v as usize];
    let i = 0;
    while i < n {
        let ko = d.kpool_off[(kbase + i) as usize];
        let kl = d.kpool_len[(kbase + i) as usize];
        if (kl as i64) == klen {
            if sx_spans_eq(sx_ptr_add(d.strs.data as ptr, ko as u64), kl as u64, key, klen) {
                return d.pool[(base + i) as usize];
            };
        };
        i = i + 1;
    }
    return -1;
}

fn j_get_lit(d: &JDoc, v: i32, key: ptr, klen: i64) -> i32 {
    return j_get(d, v, key, klen);
}

fn j_arr_len(d: &JDoc, v: i32) -> i32 {
    if j_kind(d, v) != 5 { return 0; };
    return d.alen[v as usize];
}

fn j_arr_at(d: &JDoc, v: i32, i: i32) -> i32 {
    if j_kind(d, v) != 5 { return -1; };
    if i < 0 { return -1; };
    if i >= d.alen[v as usize] { return -1; };
    return d.pool[(d.aoff[v as usize] + i) as usize];
}

// 可选值助手：v<0 视作缺失。
fn jo_arr_len(d: &JDoc, v: i32) -> i32 {
    return j_arr_len(d, v);
}

fn j_str_off(d: &JDoc, v: i32) -> i32 {
    return d.soff[v as usize];
}

fn j_str_len(d: &JDoc, v: i32) -> i32 {
    return d.slen[v as usize];
}

fn j_is_str_eq(d: &JDoc, v: i32, lit: ptr, llen: i64) -> bool {
    if j_kind(d, v) != 4 { return false; };
    if (d.slen[v as usize] as i64) != llen { return false; };
    return sx_spans_eq(sx_ptr_add(d.strs.data as ptr, d.soff[v as usize] as u64), llen, lit, llen);
}

// ji：integer 原样；float 截断（Zig @intFromFloat 向零）。
fn j_int(d: &JDoc, v: i32, present: &bool) -> i64 {
    if v < 0 { *present = false; return 0; };
    let k = j_kind(d, v);
    if k == 2 { *present = true; return d.ints[v as usize]; };
    if k == 3 { *present = true; return nf_f64_from_bits(d.fbits[v as usize]) as i64; };
    *present = false;
    return 0;
}

fn j_float(d: &JDoc, v: i32, present: &bool) -> f64 {
    if v < 0 { *present = false; return 0.0; };
    let k = j_kind(d, v);
    if k == 3 { *present = true; return nf_f64_from_bits(d.fbits[v as usize]); };
    if k == 2 { *present = true; return d.ints[v as usize] as f64; };
    *present = false;
    return 0.0;
}

fn j_bool(d: &JDoc, v: i32) -> bool {
    if j_kind(d, v) != 1 { return false; };
    return d.flags[v as usize] != 0;
}

// ---- 解析器 ----

struct JP {
    data: SBuf,
    pos: i64,
    d: JDoc,
}

fn jp_byte(p: &JP) -> i32 {
    if p.pos >= p.data.len { return -1; };
    return sb_byte(&p.data, p.pos as u64) as i32;
}

fn jp_ws(p: &JP) -> bool {
    let going = true;
    while going {
        let b = jp_byte(p);
        if (b == 32) || (b == 9) || (b == 10) || (b == 13) {
            p.pos = p.pos + 1;
        } else {
            going = false;
        };
    }
    return true;
}

fn jp_hex4(p: &JP, ok: &bool) -> i32 {
    let v = 0;
    let i = 0;
    *ok = true;
    while i < 4 {
        let b = jp_byte(p);
        let dgt = -1;
        if (b >= 48) && (b <= 57) { dgt = b - 48; };
        if (b >= 97) && (b <= 102) { dgt = b - 87; };
        if (b >= 65) && (b <= 70) { dgt = b - 55; };
        if dgt < 0 { *ok = false; return 0; };
        v = v * 16 + dgt;
        p.pos = p.pos + 1;
        i = i + 1;
    }
    return v;
}

fn jp_utf8(out: &SBuf, cp: i32) -> bool {
    if cp < 128 {
        sb_push_byte(out, cp as u8);
    } else if cp < 2048 {
        sb_push_byte(out, (192 + cp / 64) as u8);
        sb_push_byte(out, (128 + cp % 64) as u8);
    } else if cp < 65536 {
        sb_push_byte(out, (224 + cp / 4096) as u8);
        sb_push_byte(out, (128 + (cp / 64) % 64) as u8);
        sb_push_byte(out, (128 + cp % 64) as u8);
    } else {
        sb_push_byte(out, (240 + cp / 262144) as u8);
        sb_push_byte(out, (128 + (cp / 4096) % 64) as u8);
        sb_push_byte(out, (128 + (cp / 64) % 64) as u8);
        sb_push_byte(out, (128 + cp % 64) as u8);
    };
    return true;
}

// 解析字符串字面量（含起始引号）：解码字节落入 d.strs，返回 (off,len) 或 err。
fn jp_string(p: &JP, soff_out: &i32, slen_out: &i32) -> bool {
    // 当前字节须为 '"'
    p.pos = p.pos + 1;
    let start = p.d.strs.len;
    let done = false;
    while !done {
        let b = jp_byte(p);
        if b < 0 { p.d.err = true; return false; };
        if b == 34 {
            p.pos = p.pos + 1;
            done = true;
        } else if b == 92 {
            p.pos = p.pos + 1;
            let e = jp_byte(p);
            if e < 0 { p.d.err = true; return false; };
            p.pos = p.pos + 1;
            if e == 34 { sb_push_byte(&p.d.strs, 34u8); }
            else if e == 92 { sb_push_byte(&p.d.strs, 92u8); }
            else if e == 47 { sb_push_byte(&p.d.strs, 47u8); }
            else if e == 98 { sb_push_byte(&p.d.strs, 8u8); }
            else if e == 102 { sb_push_byte(&p.d.strs, 12u8); }
            else if e == 110 { sb_push_byte(&p.d.strs, 10u8); }
            else if e == 114 { sb_push_byte(&p.d.strs, 13u8); }
            else if e == 116 { sb_push_byte(&p.d.strs, 9u8); }
            else if e == 117 {
                let ok = false;
                let cp = jp_hex4(p, &ok);
                if !ok { p.d.err = true; return false; };
                if (cp >= 55296) && (cp <= 56319) {
                    // 高代理：须跟 \uXXXX 低代理
                    if jp_byte(p) != 92 { p.d.err = true; return false; };
                    p.pos = p.pos + 1;
                    if jp_byte(p) != 117 { p.d.err = true; return false; };
                    p.pos = p.pos + 1;
                    let lo = jp_hex4(p, &ok);
                    if !ok { p.d.err = true; return false; };
                    if (lo < 56320) || (lo > 57343) { p.d.err = true; return false; };
                    let full = 65536 + (cp - 55296) * 1024 + (lo - 56320);
                    let t1 = jp_utf8(&p.d.strs, full);
                } else if (cp >= 56320) && (cp <= 57343) {
                    p.d.err = true; return false;
                } else {
                    let t2 = jp_utf8(&p.d.strs, cp);
                };
            } else {
                p.d.err = true; return false;
            };
        } else if b < 32 {
            p.d.err = true; return false;
        } else {
            sb_push_byte(&p.d.strs, b as u8);
            p.pos = p.pos + 1;
        };
    }
    *soff_out = start as i32;
    *slen_out = (p.d.strs.len - start) as i32;
    return true;
}

fn jp_value(p: &JP) -> i32 {
    let w = jp_ws(p);
    let b = jp_byte(p);
    if b < 0 { p.d.err = true; return -1; };
    if b == 123 {
        // object（子项先收本地表，闭合后整段追加，保证父段连续）
        let id = j_push(&p.d, 6);
        p.pos = p.pos + 1;
        let w2 = jp_ws(p);
        let vals: Vec<i32> = Vec::new();
        let kos: Vec<i32> = Vec::new();
        let kls: Vec<i32> = Vec::new();
        if jp_byte(p) == 125 {
            p.pos = p.pos + 1;
            p.d.koff[id as usize] = p.d.pool.len();
            p.d.kbase[id as usize] = p.d.kpool_off.len();
            p.d.klen[id as usize] = 0;
            return id;
        };
        let more = true;
        while more {
            let w3 = jp_ws(p);
            if jp_byte(p) != 34 { p.d.err = true; return -1; };
            let ko = 0; let kl = 0;
            if !jp_string(p, &ko, &kl) { return -1; };
            let w4 = jp_ws(p);
            if jp_byte(p) != 58 { p.d.err = true; return -1; };
            p.pos = p.pos + 1;
            let val = jp_value(p);
            if val < 0 { return -1; };
            vals.push(val);
            kos.push(ko);
            kls.push(kl);
            let w5 = jp_ws(p);
            let nb = jp_byte(p);
            if nb == 44 {
                p.pos = p.pos + 1;
            } else if nb == 125 {
                p.pos = p.pos + 1;
                more = false;
            } else {
                p.d.err = true; return -1;
            };
        }
        let base = p.d.pool.len();
        let kbase = p.d.kpool_off.len();
        let n = vals.len();
        let ii = 0;
        while ii < n {
            p.d.pool.push(vals[ii as usize]);
            p.d.kpool_off.push(kos[ii as usize]);
            p.d.kpool_len.push(kls[ii as usize]);
            ii = ii + 1;
        }
        p.d.koff[id as usize] = base;
        p.d.kbase[id as usize] = kbase;
        p.d.klen[id as usize] = n;
        return id;
    };
    if b == 91 {
        let id = j_push(&p.d, 5);
        p.pos = p.pos + 1;
        let w2 = jp_ws(p);
        let vals: Vec<i32> = Vec::new();
        if jp_byte(p) == 93 {
            p.pos = p.pos + 1;
            p.d.aoff[id as usize] = p.d.pool.len();
            p.d.alen[id as usize] = 0;
            return id;
        };
        let more = true;
        while more {
            let val = jp_value(p);
            if val < 0 { return -1; };
            vals.push(val);
            let w5 = jp_ws(p);
            let nb = jp_byte(p);
            if nb == 44 {
                p.pos = p.pos + 1;
            } else if nb == 93 {
                p.pos = p.pos + 1;
                more = false;
            } else {
                p.d.err = true; return -1;
            };
        }
        let base = p.d.pool.len();
        let n = vals.len();
        let ii = 0;
        while ii < n {
            p.d.pool.push(vals[ii as usize]);
            ii = ii + 1;
        }
        p.d.aoff[id as usize] = base;
        p.d.alen[id as usize] = n;
        return id;
    };
    if b == 34 {
        let so = 0; let sl = 0;
        if !jp_string(p, &so, &sl) { return -1; };
        let id = j_push(&p.d, 4);
        p.d.soff[id as usize] = so;
        p.d.slen[id as usize] = sl;
        return id;
    };
    if b == 116 {
        if !sx_spans_eq(sx_ptr_add(p.data.data as ptr, p.pos as u64), 4, "true", 4) { p.d.err = true; return -1; };
        p.pos = p.pos + 4;
        let id = j_push(&p.d, 1);
        p.d.flags[id as usize] = 1;
        return id;
    };
    if b == 102 {
        if !sx_spans_eq(sx_ptr_add(p.data.data as ptr, p.pos as u64), 5, "false", 5) { p.d.err = true; return -1; };
        p.pos = p.pos + 5;
        let id = j_push(&p.d, 1);
        p.d.flags[id as usize] = 0;
        return id;
    };
    if b == 110 {
        if !sx_spans_eq(sx_ptr_add(p.data.data as ptr, p.pos as u64), 4, "null", 4) { p.d.err = true; return -1; };
        p.pos = p.pos + 4;
        return j_push(&p.d, 0);
    };
    // number
    let start = p.pos;
    let is_float = false;
    if jp_byte(p) == 45 { p.pos = p.pos + 1; };
    let digits = 0;
    let scanning = true;
    while scanning {
        let c = jp_byte(p);
        if (c >= 48) && (c <= 57) {
            p.pos = p.pos + 1;
            digits = digits + 1;
        } else {
            scanning = false;
        };
    }
    if jp_byte(p) == 46 {
        is_float = true;
        p.pos = p.pos + 1;
        let fd = 0;
        let sc2 = true;
        while sc2 {
            let c = jp_byte(p);
            if (c >= 48) && (c <= 57) {
                p.pos = p.pos + 1;
                fd = fd + 1;
            } else {
                sc2 = false;
            };
        }
        if fd == 0 { p.d.err = true; return -1; };
    };
    let eb = jp_byte(p);
    if (eb == 101) || (eb == 69) {
        is_float = true;
        p.pos = p.pos + 1;
        let sb2 = jp_byte(p);
        if (sb2 == 43) || (sb2 == 45) { p.pos = p.pos + 1; };
        let ed = 0;
        let sc3 = true;
        while sc3 {
            let c = jp_byte(p);
            if (c >= 48) && (c <= 57) {
                p.pos = p.pos + 1;
                ed = ed + 1;
            } else {
                sc3 = false;
            };
        }
        if ed == 0 { p.d.err = true; return -1; };
    };
    if digits == 0 { p.d.err = true; return -1; };
    let nlen = p.pos - start;
    if !is_float {
        // 整数轨：手工累积（溢出则转浮点轨近似 std.json 的回退）
        let val: i64 = 0;
        let neg = false;
        let i = start;
        if sb_byte(&p.data, i as u64) == 45u8 { neg = true; i = i + 1; };
        let ovf = false;
        while i < p.pos {
            let dgt = (sb_byte(&p.data, i as u64) as i64) - 48;
            if val > (9223372036854775807 - dgt) / 10 { ovf = true; };
            if !ovf { val = val * 10 + dgt; };
            i = i + 1;
        }
        if !ovf {
            let id = j_push(&p.d, 2);
            p.d.ints[id as usize] = if neg { 0 - val } else { val };
            return id;
        };
    };
    let okc = malloc(8);
    let fv = nf_parse_f64_json(sx_ptr_add(p.data.data as ptr, start as u64), nlen as u64, okc as ptr);
    let good = sx_cell_u64(okc as ptr) != 0;
    free(okc);
    if !good { p.d.err = true; return -1; };
    let id = j_push(&p.d, 3);
    p.d.fbits[id as usize] = nf_f64_bits(fv);
    return id;
}

// 解析整份 JSON：成功返回根 id 且 d.err=false。
fn j_parse(src: &SBuf) -> JDoc {
    let p = JP { data: sb_new(), pos: 0, d: j_new() };
    sb_push_span(&p.data, src.data as ptr, src.len);
    let root = jp_value(&p);
    if root >= 0 {
        let w = jp_ws(&p);
        if p.pos < p.data.len { p.d.err = true; };
    };
    if p.d.err {
        return p.d;
    };
    return p.d;
}
