// convert.sla — SLA port of tools/convert.zig (SAX3D <-> glTF/GLB
// bidirectional converter, Phase 2). Mapping spec = CONVERTER_MAP.md;
// zero silent loss: every approximation/synthesis/loss goes to the
// stdout LEDGER, unsupported shapes fail with named Cvt* diagnostics.
//   convert to-sax3d <in.gltf|in.glb> <outdir> --fixtures-dir <dir>
//   convert to-gltf  <in.sax3d> <in.saxb3d> <outdir> [--iface S=<file>]...
//                                                        [--std-shader S]...

@import "../src/core.sla"
@import "../src/numfmt.sla"
@import "../src/model.sla"
@import "../src/lexer.sla"
@import "../src/parse.sla"
@import "../src/iface.sla"
@import "../src/check.sla"
@import "../src/layout.sla"
@import "../src/binio.sla"
@import "json.sla"

extern "C" {
    fn malloc(size: usize) -> *u8;
    fn free(p: *u8);
}

// ---------------- 上下文：诊断 + 台账 ----------------

struct CV {
    x: X,
    led: SBuf,
    n_loss: i64,
    n_approx: i64,
    n_synth: i64,
    n_lines: i64,
    failed: bool,
    jd: JDoc,
    root: i32,
    buf_off: Vec<i32>,
    buf_len: Vec<i32>,
    bufstore: SBuf,
    gdir_off: i32,
    gdir_len: i32,
    strs: SBuf,
}

fn cv_new() -> CV {
    return CV {
        x: x_new(), led: sb_new(), n_loss: 0, n_approx: 0, n_synth: 0, n_lines: 0,
        failed: false, jd: j_new(), root: -1,
        buf_off: Vec::new(), buf_len: Vec::new(), bufstore: sb_new(),
        gdir_off: 0, gdir_len: 0, strs: sb_new(),
    };
}

// 字符串入 CV.strs 池，返回 (off,len) 打包为两个 out。
fn cv_str(cv: &CV, p: ptr, n: u64, o_out: &i32, l_out: &i32) {
    *o_out = cv.strs.len as i32;
    sb_push_span(&cv.strs, p, n);
    *l_out = n as i32;
}

fn cv_str_eq(cv: &CV, o: i32, l: i32, p: ptr, n: u64) -> bool {
    if (l as u64) != n { return false; };
    return sx_spans_eq(sx_ptr_add(cv.strs.data as ptr, o as u64), n, p, n);
}

// 失败：把 x.msg 现内容作为消息提交具名诊断，置 failed。
fn cv_fail(cv: &CV, code_p: ptr, code_n: u64) -> bool {
    diag_commit(&cv.x, code_p, code_n);
    cv.failed = true;
    return false;
}

fn cv_fail_lit(cv: &CV, code_p: ptr, code_n: u64, msg_p: ptr, msg_n: u64) -> bool {
    sb_push_span(&cv.x.msg, msg_p, msg_n);
    return cv_fail(cv, code_p, code_n);
}

// 台账一行：kind + 已拼好的消息（在 msg SBuf 中）。
fn cv_led(cv: &CV, kind_p: ptr, kind_n: u64, msg: &SBuf) {
    sb_push_lit(&cv.led, "LEDGER ", 7);
    sb_push_span(&cv.led, kind_p, kind_n);
    sb_push_byte(&cv.led, 32u8);
    sb_push_span(&cv.led, msg.data as ptr, msg.len);
    sb_push_byte(&cv.led, 10u8);
    cv.n_lines = cv.n_lines + 1;
    if sx_spans_eq(kind_p, kind_n, "LOSS", 4) { cv.n_loss = cv.n_loss + 1; };
    if sx_spans_eq(kind_p, kind_n, "APPROX", 6) { cv.n_approx = cv.n_approx + 1; };
    if sx_spans_eq(kind_p, kind_n, "SYNTH", 5) { cv.n_synth = cv.n_synth + 1; };
}

fn cv_led_print(cv: &CV) {
    sx_out_buf(&cv.led);
    let tail = sb_new();
    sb_push_lit(&tail, "LEDGER SUMMARY loss=", 20);
    sb_push_i64(&tail, cv.n_loss);
    sb_push_lit(&tail, " approx=", 8);
    sb_push_i64(&tail, cv.n_approx);
    sb_push_lit(&tail, " synth=", 7);
    sb_push_i64(&tail, cv.n_synth);
    sb_push_lit(&tail, " total=", 7);
    sb_push_i64(&tail, cv.n_lines);
    sb_push_byte(&tail, 10u8);
    sx_out_buf(&tail);
}

// 读文件（失败 → CvtBadInput cannot read '<path>': <ErrName>）。
fn cv_read_file(cv: &CV, pp: ptr, plen: u64, out: &SBuf) -> bool {
    let cell = malloc(8);
    let okf = sx_read_file(pp, plen, out, cell as ptr);
    let st = sx_cell_u64(cell as ptr);
    free(cell);
    if okf { return true; };
    sb_push_lit(&cv.x.msg, "cannot read '", 13);
    sb_push_span(&cv.x.msg, pp, plen);
    sb_push_lit(&cv.x.msg, "': ", 3);
    sx_io_err_name(st, &cv.x.msg);
    return cv_fail(cv, "CvtBadInput", 11);
}

// ---------------- SBuf 拼装助手（{s}/{d} 模板的展开形） ----------------

fn put_lit(b: &SBuf, p: ptr, n: u64) {
    sb_push_span(b, p, n);
}

fn put_span(cv: &CV, b: &SBuf, o: i32, l: i32) {
    sb_push_span(b, sx_ptr_add(cv.strs.data as ptr, o as u64), l as u64);
}

// 字段级借用变体：目标为 &cv.x.msg 时用（&cv 与 &cv.x.msg 同调用冲突）。
fn put_span_s(strs: &SBuf, b: &SBuf, o: i32, l: i32) {
    sb_push_span(b, sx_ptr_add(strs.data as ptr, o as u64), l as u64);
}

fn put_jspan(cv: &CV, b: &SBuf, v: i32) {
    // JSON 字符串值 v 的解码字节
    sb_push_span(b, sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[v as usize] as u64), cv.jd.slen[v as usize] as u64);
}

// 字段级借用变体（同上）。
fn put_jspan_j(jd: &JDoc, b: &SBuf, v: i32) {
    sb_push_span(b, sx_ptr_add(jd.strs.data as ptr, jd.soff[v as usize] as u64), jd.slen[v as usize] as u64);
}

fn put_i64(b: &SBuf, v: i64) {
    sb_push_i64(b, v);
}

fn put_u64(b: &SBuf, v: u64) {
    sb_push_u64(b, v);
}

fn put_f64(b: &SBuf, v: f64) {
    nf_push_f64(b, v);
}

// vecStr：[a, b, c]（f64 数组，元素由调用方逐个喂入本函数族）——
// 此处提供从 f64 位池读的版本：vals 是位模式 Vec<u64> 视图不可行，
// 改由调用方用 put_f64 逐个拼。见 cv_vec3/cv_vec4/cv_vecN（JSON 侧）。
fn cv_jvec(cv: &CV, b: &SBuf, arr: i32, n: i32) -> bool {
    // 把 JSON 数组 arr 的前 n 个数值以 [v, v, ...] 形式拼入 b。
    if j_arr_len(&cv.jd, arr) < n { return false; };
    sb_push_byte(b, 91u8);
    let i = 0;
    while i < n {
        if i > 0 { sb_push_lit(b, ", ", 2); };
        let pres = false;
        let v = j_float(&cv.jd, j_arr_at(&cv.jd, arr, i), &pres);
        if !pres { return false; };
        nf_push_f64(b, v);
        i = i + 1;
    }
    sb_push_byte(b, 93u8);
    return true;
}

// ---------------- JSON 便捷层（键字面量） ----------------

fn jg(cv: &CV, v: i32, key: ptr, klen: u64) -> i32 {
    return j_get(&cv.jd, v, key, klen as i64);
}

fn jg_str(cv: &CV, v: i32, key: ptr, klen: u64, o_out: &i32, l_out: &i32) -> bool {
    let s = j_get(&cv.jd, v, key, klen as i64);
    if j_kind(&cv.jd, s) != 4 { return false; };
    // 字符串字节在 jd.strs 中；转存 CV.strs 以便统一 span 语义
    cv_str(cv, sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[s as usize] as u64), cv.jd.slen[s as usize] as u64, o_out, l_out);
    return true;
}

fn jg_int(cv: &CV, v: i32, key: ptr, klen: u64, pres: &bool) -> i64 {
    return j_int(&cv.jd, j_get(&cv.jd, v, key, klen as i64), pres);
}

fn jg_f64(cv: &CV, v: i32, key: ptr, klen: u64, pres: &bool) -> f64 {
    return j_float(&cv.jd, j_get(&cv.jd, v, key, klen as i64), pres);
}

// 材质因子读取（f64 必须单次无条件绑定：条件赋值会被 phi 合并重解释，GAP-PORT-8）。
fn mat_factor_pbr(cv: &CV, mat_idx: i64, key: ptr, klen: u64, def: f64) -> f64 {
    if mat_idx < 0 { return def; };
    let mats = jg(cv, cv.root, "materials", 9);
    let m = j_arr_at(&cv.jd, mats, mat_idx as i32);
    if m < 0 { return def; };
    let pbr = jg(cv, m, "pbrMetallicRoughness", 20);
    if pbr < 0 { return def; };
    let pres = false;
    let r = jg_f64(cv, pbr, key, klen, &pres);
    if pres { return r; };
    return def;
}

fn mat_factor_top(cv: &CV, mat_idx: i64, key: ptr, klen: u64, def: f64) -> f64 {
    if mat_idx < 0 { return def; };
    let mats = jg(cv, cv.root, "materials", 9);
    let m = j_arr_at(&cv.jd, mats, mat_idx as i32);
    if m < 0 { return def; };
    let pres = false;
    let r = jg_f64(cv, m, key, klen, &pres);
    if pres { return r; };
    return def;
}

fn mat_present(cv: &CV, mat_idx: i64, key: ptr, klen: u64) -> bool {
    if mat_idx < 0 { return false; };
    let mats = jg(cv, cv.root, "materials", 9);
    let m = j_arr_at(&cv.jd, mats, mat_idx as i32);
    if m < 0 { return false; };
    return jg(cv, m, key, klen) >= 0;
}

// 值本身取字符串（已是字符串值 v）→ CV.strs span。
fn jv_str(cv: &CV, s: i32, o_out: &i32, l_out: &i32) -> bool {
    if j_kind(&cv.jd, s) != 4 { return false; };
    cv_str(cv, sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[s as usize] as u64), cv.jd.slen[s as usize] as u64, o_out, l_out);
    return true;
}

fn jv_int(cv: &CV, s: i32, pres: &bool) -> i64 {
    return j_int(&cv.jd, s, pres);
}

// ---------------- base64 解码（标准字母表，容忍无填充） ----------------

fn b64_val(c: u8) -> i32 {
    if (c >= 65u8) && (c <= 90u8) { return (c - 65u8) as i32; };
    if (c >= 97u8) && (c <= 122u8) { return (c - 97u8) as i32 + 26; };
    if (c >= 48u8) && (c <= 57u8) { return (c - 48u8) as i32 + 52; };
    if c == 43u8 { return 62; };
    if c == 47u8 { return 63; };
    return -1;
}

fn b64_decode(p: ptr, n: u64, out: &SBuf) -> bool {
    let acc: u32 = 0;
    let nbits = 0;
    let i: u64 = 0;
    while i < n {
        let c = PTR_BYTE_AT(p, i);
        if c == 61u8 {
            i = i + 1;
            // 填充：结束
            let done = true;
            // 跳过剩余填充
            while i < n {
                i = i + 1;
            }
            return true;
        };
        let v = b64_val(c);
        if v < 0 { return false; };
        acc = (acc << 6) | (v as u32);
        nbits = nbits + 6;
        if nbits >= 8 {
            nbits = nbits - 8;
            sb_push_byte(out, ((acc >> (nbits as u32)) & 255u32) as u8);
        };
        i = i + 1;
    }
    return true;
}

// ---------------- glTF 装载 ----------------

fn comp_size(c: i64) -> i64 {
    if (c == 5120) || (c == 5121) { return 1; };
    if (c == 5122) || (c == 5123) { return 2; };
    if (c == 5125) || (c == 5126) { return 4; };
    return 0;
}

fn type_comps_p(p: ptr, n: u64) -> i64 {
    if sx_spans_eq(p, n, "SCALAR", 6) { return 1; };
    if sx_spans_eq(p, n, "VEC2", 4) { return 2; };
    if sx_spans_eq(p, n, "VEC3", 4) { return 3; };
    if sx_spans_eq(p, n, "VEC4", 4) { return 4; };
    if sx_spans_eq(p, n, "MAT2", 4) { return 4; };
    if sx_spans_eq(p, n, "MAT3", 4) { return 9; };
    if sx_spans_eq(p, n, "MAT4", 4) { return 16; };
    return 0;
}

// accessorInfo：out 参数组 (comp, ty_off, ty_len, count, normalized, elem)
fn acc_info(cv: &CV, idx: i64, comp: &i64, to: &i32, tl: &i32, count: &i64, norm: &bool, elem: &i64) -> bool {
    let accs = jg(cv, cv.root, "accessors", 9);
    let acc = j_arr_at(&cv.jd, accs, idx as i32);
    if acc < 0 { return false; };
    let pres = false;
    let c = jg_int(cv, acc, "componentType", 13, &pres);
    if !pres { return false; };
    let ty = jg(cv, acc, "type", 4);
    if j_kind(&cv.jd, ty) != 4 { return false; };
    let cnt = jg_int(cv, acc, "count", 5, &pres);
    if !pres { return false; };
    let cs = comp_size(c);
    let tc = type_comps_p(sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[ty as usize] as u64), cv.jd.slen[ty as usize] as u64);
    if (cs == 0) || (tc == 0) { return false; };
    *comp = c;
    *to = cv.jd.soff[ty as usize];
    *tl = cv.jd.slen[ty as usize];
    *count = cnt;
    let nv = jg(cv, acc, "normalized", 10);
    *norm = j_bool(&cv.jd, nv);
    *elem = cs * tc;
    return true;
}

// accessorBytes：紧密提取（解交错）入 out；失败走 cv_fail。
fn acc_bytes(cv: &CV, idx: i64, out: &SBuf) -> bool {
    let accs = jg(cv, cv.root, "accessors", 9);
    let acc = j_arr_at(&cv.jd, accs, idx as i32);
    if acc < 0 {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, idx);
        sb_push_lit(&cv.x.msg, " missing", 8);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    if jg(cv, acc, "sparse", 6) >= 0 {
        if j_kind(&cv.jd, jg(cv, acc, "sparse", 6)) != -1 {
            sb_push_lit(&cv.x.msg, "accessor ", 9);
            sb_push_i64(&cv.x.msg, idx);
            sb_push_lit(&cv.x.msg, " is sparse (unsupported per map)", 32);
            return cv_fail(cv, "CvtSparseAccessor", 17);
        };
    };
    let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem = 0;
    if !acc_info(cv, idx, &comp, &to, &tl, &count, &norm, &elem) {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, idx);
        sb_push_lit(&cv.x.msg, " malformed", 10);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let pres = false;
    let bv_v = jg(cv, acc, "bufferView", 10);
    if bv_v < 0 {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, idx);
        sb_push_lit(&cv.x.msg, " has no bufferView", 18);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let bv_idx = j_int(&cv.jd, bv_v, &pres);
    if !pres {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, idx);
        sb_push_lit(&cv.x.msg, " bufferView not an int", 22);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let bvs = jg(cv, cv.root, "bufferViews", 11);
    let bv = j_arr_at(&cv.jd, bvs, bv_idx as i32);
    if bv < 0 {
        sb_push_lit(&cv.x.msg, "bufferView ", 11);
        sb_push_i64(&cv.x.msg, bv_idx);
        sb_push_lit(&cv.x.msg, " missing", 8);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let buf_idx = jg_int(cv, bv, "buffer", 6, &pres);
    let buf_i = if pres { buf_idx } else { 0 };
    if (buf_i < 0) || (buf_i >= cv.buf_off.len()) {
        sb_push_lit(&cv.x.msg, "buffer ", 7);
        sb_push_i64(&cv.x.msg, buf_i);
        sb_push_lit(&cv.x.msg, " not loaded", 11);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let bv_off = jg_int(cv, bv, "byteOffset", 10, &pres);
    let bv_o = if pres { bv_off } else { 0 };
    let bv_len = jg_int(cv, bv, "byteLength", 10, &pres);
    if !pres {
        sb_push_lit(&cv.x.msg, "bufferView ", 11);
        sb_push_i64(&cv.x.msg, bv_idx);
        sb_push_lit(&cv.x.msg, " lacks byteLength", 17);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let acc_off = jg_int(cv, acc, "byteOffset", 10, &pres);
    let acc_o = if pres { acc_off } else { 0 };
    let stride_v = jg_int(cv, bv, "byteStride", 10, &pres);
    let stride = if pres { stride_v } else { elem };
    let src_off = cv.buf_off[buf_i as usize];
    let src_len = cv.buf_len[buf_i as usize];
    let i = 0;
    while i < count {
        let so = bv_o + acc_o + i * stride;
        if (so + elem > bv_o + bv_len) || (so + elem > src_len as i64) {
            sb_push_lit(&cv.x.msg, "accessor ", 9);
            sb_push_i64(&cv.x.msg, idx);
            sb_push_lit(&cv.x.msg, " element ", 9);
            sb_push_i64(&cv.x.msg, i);
            sb_push_lit(&cv.x.msg, " overruns its bufferView", 24);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        sb_push_span(out, sx_ptr_add(cv.bufstore.data as ptr, (src_off as i64 + so) as u64), elem as u64);
        i = i + 1;
    }
    return true;
}

// loadGltf：填充 cv.jd/root/buffers/gdir。path span 在调用方 SBuf 中。
fn load_gltf(cv: &CV, pp: ptr, plen: u64) -> bool {
    let raw = sb_new();
    if !cv_read_file(cv, pp, plen, &raw) { return false; };
    // dir = path 的目录部分（最后一个 '/' 之前），无则 "."
    let li = sx_last_index_of_byte(pp, plen, 47u8);
    if li >= 0 {
        let go_o = 0; let go_l = 0;
        cv_str(cv, pp, li as u64, &go_o, &go_l);
        cv.gdir_off = go_o;
        cv.gdir_len = go_l;
    } else {
        let go_o = 0; let go_l = 0;
        cv_str(cv, ".", 1, &go_o, &go_l);
        cv.gdir_off = go_o;
        cv.gdir_len = go_l;
    };
    let json = sb_new();
    let bin = sb_new();
    let has_bin = false;
    if (raw.len >= 12) && sx_spans_eq(raw.data as ptr, 4, "glTF", 4) {
        let total = sx_rd_u32(raw.data as ptr, 8) as i64;
        if total > raw.len {
            sb_push_lit(&cv.x.msg, "GLB length field ", 17);
            sb_push_i64(&cv.x.msg, total);
            sb_push_lit(&cv.x.msg, " exceeds file ", 14);
            sb_push_i64(&cv.x.msg, raw.len);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let off: i64 = 12;
        while (off + 8) <= raw.len {
            let clen = sx_rd_u32(raw.data as ptr, off as u64) as i64;
            if (off + 8 + clen) > raw.len {
                return cv_fail_lit(cv, "CvtBadInput", 11, "GLB chunk overruns file", 23);
            };
            let ctype_p = sx_ptr_add(raw.data as ptr, (off + 4) as u64);
            let cdata_p = sx_ptr_add(raw.data as ptr, (off + 8) as u64);
            if sx_spans_eq(ctype_p, 4, "JSON", 4) {
                sb_clear(&json);
                sb_push_span(&json, cdata_p, clen as u64);
            };
            if sx_spans_eq(ctype_p, 4, "BIN\0", 4) {
                sb_clear(&bin);
                sb_push_span(&bin, cdata_p, clen as u64);
                has_bin = true;
            };
            off = off + 8 + clen;
        }
    } else {
        sb_push_span(&json, raw.data as ptr, raw.len);
    };
    let jd = j_parse(&json);
    if jd.err {
        return cv_fail_lit(cv, "CvtBadInput", 11, "JSON parse failed: SyntaxError", 30);
    };
    cv.jd = jd;
    cv.root = 0;
    // buffers 逐个解出
    let buffers = jg(cv, cv.root, "buffers", 7);
    let nbuf = j_arr_len(&cv.jd, buffers);
    let bi = 0;
    while bi < nbuf {
        let bdesc = j_arr_at(&cv.jd, buffers, bi);
        let uri_v = jg(cv, bdesc, "uri", 3);
        if j_kind(&cv.jd, uri_v) == 4 {
            let uo = 0; let ul = 0;
            let ok1 = jv_str(cv, uri_v, &uo, &ul);
            let up = sx_ptr_add(cv.strs.data as ptr, uo as u64);
            if sx_starts_with(up, ul as u64, "data:", 5) {
                let comma = sx_index_of_byte(up, ul as u64, 44u8);
                if comma < 0 {
                    sb_push_lit(&cv.x.msg, "buffer ", 7);
                    sb_push_i64(&cv.x.msg, bi as i64);
                    sb_push_lit(&cv.x.msg, " data URI malformed", 19);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                let enc_p = sx_ptr_add(up, (comma + 1) as u64);
                let enc_n = (ul as i64 - comma - 1) as u64;
                let dec = sb_new();
                if !b64_decode(enc_p, enc_n, &dec) {
                    sb_push_lit(&cv.x.msg, "buffer ", 7);
                    sb_push_i64(&cv.x.msg, bi as i64);
                    sb_push_lit(&cv.x.msg, " base64 decode failed", 21);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                cv.buf_off.push(cv.bufstore.len as i32);
                cv.buf_len.push(dec.len as i32);
                sb_push_span(&cv.bufstore, dec.data as ptr, dec.len);
            } else {
                let full = sb_new();
                sb_push_span(&full, sx_ptr_add(cv.strs.data as ptr, cv.gdir_off as u64), cv.gdir_len as u64);
                sb_push_byte(&full, 47u8);
                sb_push_span(&full, up, ul as u64);
                let data = sb_new();
                if !cv_read_file(cv, full.data as ptr, full.len, &data) { return false; };
                cv.buf_off.push(cv.bufstore.len as i32);
                cv.buf_len.push(data.len as i32);
                sb_push_span(&cv.bufstore, data.data as ptr, data.len);
            };
        } else if has_bin {
            cv.buf_off.push(cv.bufstore.len as i32);
            cv.buf_len.push(bin.len as i32);
            sb_push_span(&cv.bufstore, bin.data as ptr, bin.len);
        } else {
            sb_push_lit(&cv.x.msg, "buffer ", 7);
            sb_push_i64(&cv.x.msg, bi as i64);
            sb_push_lit(&cv.x.msg, " has neither uri nor GLB BIN chunk", 34);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        bi = bi + 1;
    }
    // 扩展门
    let er = jg(cv, cv.root, "extensionsRequired", 18);
    if j_kind(&cv.jd, er) == 5 {
        let n = j_arr_len(&cv.jd, er);
        let i = 0;
        while i < n {
            let e = j_arr_at(&cv.jd, er, i);
            if j_kind(&cv.jd, e) == 4 {
                if !j_is_str_eq(&cv.jd, e, "KHR_texture_transform", 21) {
                    sb_push_lit(&cv.x.msg, "extensionsRequired contains '", 29);
                    put_jspan_j(&cv.jd, &cv.x.msg, e);
                    sb_push_lit(&cv.x.msg, "' (unsupported per map)", 23);
                    return cv_fail(cv, "CvtUnsupportedExtension", 23);
                };
            };
            i = i + 1;
        }
    };
    let eu = jg(cv, cv.root, "extensionsUsed", 14);
    if j_kind(&cv.jd, eu) == 5 {
        let n = j_arr_len(&cv.jd, eu);
        let i = 0;
        while i < n {
            let e = j_arr_at(&cv.jd, eu, i);
            if j_kind(&cv.jd, e) == 4 {
                if !j_is_str_eq(&cv.jd, e, "KHR_texture_transform", 21) {
                    let m = sb_new();
                    sb_push_lit(&m, "extensionsUsed '", 16);
                    put_jspan(cv, &m, e);
                    sb_push_lit(&m, "' not understood; conversion is PARTIAL for that extension's semantics", 70);
                    cv_led(cv, "LOSS", 4, &m);
                };
            };
            i = i + 1;
        }
    };
    return true;
}

// ---------------- Conv1 状态 ----------------
// 池 id：0 mesh 1 mat 2 node 3 tex 4 img 5 skin 6 scene 7 clip 8 section

struct C1 {
    used_off: Vec<i32>,
    used_len: Vec<i32>,
    used_pool: Vec<i32>,
    used_bytes: SBuf,
    sec_off: Vec<i32>,     // 段名 → strs
    sec_len: Vec<i32>,
    sec_boff: Vec<i32>,    // 段字节 → secstore
    sec_blen: Vec<i32>,
    secstore: SBuf,
    accsec_acc: Vec<i32>,  // acc_section 去重表（-1 空）
    accsec_off: Vec<i32>,
    accsec_len: Vec<i32>,
    node_name_off: Vec<i32>,
    node_name_len: Vec<i32>,
    node_parent: Vec<i32>,
    mg_off: Vec<i32>,      // 每 glTF mesh 的名组在 mg_names 中的段
    mg_len: Vec<i32>,
    mg_names_off: Vec<i32>,
    mg_names_len: Vec<i32>,
    mg_skin: Vec<i32>,     // 与 mg_names 平行：组 (skin,uv)
    mg_uv: Vec<i32>,
    skin_names_off: Vec<i32>,
    skin_names_len: Vec<i32>,
    tex_names_off: Vec<i32>,
    tex_names_len: Vec<i32>,
    img_names_off: Vec<i32>,
    img_names_len: Vec<i32>,
    txt_img: SBuf,
    txt_tex: SBuf,
    txt_mesh: SBuf,
    txt_skel: SBuf,
    txt_mat: SBuf,
    txt_scene: SBuf,
    txt_clip: SBuf,
    mv_key_off: Vec<i32>,
    mv_key_len: Vec<i32>,
    mv_val_off: Vec<i32>,
    mv_val_len: Vec<i32>,
    mv_bytes: SBuf,
    su_off: Vec<i32>,
    su_len: Vec<i32>,
}

fn c1_new() -> C1 {
    return C1 {
        used_off: Vec::new(), used_len: Vec::new(), used_pool: Vec::new(), used_bytes: sb_new(),
        sec_off: Vec::new(), sec_len: Vec::new(), sec_boff: Vec::new(), sec_blen: Vec::new(),
        secstore: sb_new(),
        accsec_acc: Vec::new(), accsec_off: Vec::new(), accsec_len: Vec::new(),
        node_name_off: Vec::new(), node_name_len: Vec::new(), node_parent: Vec::new(),
        mg_off: Vec::new(), mg_len: Vec::new(), mg_names_off: Vec::new(), mg_names_len: Vec::new(),
        mg_skin: Vec::new(), mg_uv: Vec::new(),
        skin_names_off: Vec::new(), skin_names_len: Vec::new(),
        tex_names_off: Vec::new(), tex_names_len: Vec::new(),
        img_names_off: Vec::new(), img_names_len: Vec::new(),
        txt_img: sb_new(), txt_tex: sb_new(), txt_mesh: sb_new(), txt_skel: sb_new(),
        txt_mat: sb_new(), txt_scene: sb_new(), txt_clip: sb_new(),
        mv_key_off: Vec::new(), mv_key_len: Vec::new(), mv_val_off: Vec::new(), mv_val_len: Vec::new(),
        mv_bytes: sb_new(), su_off: Vec::new(), su_len: Vec::new(),
    };
}

// ---------------- 名字池 ----------------

fn kw_index(tbl: ptr, tbl_len: u64, p: ptr, n: u64) -> i32 {
    let i: u64 = 0;
    let start: u64 = 0;
    let idx = 0;
    while i <= tbl_len {
        let c: u8 = if i < tbl_len { PTR_BYTE_AT(tbl, i) } else { 0u8 };
        if c == 0u8 {
            let wl = i - start;
            if wl == n {
                if sx_spans_eq(sx_ptr_add(tbl, start), n, p, n) { return idx; };
            };
            idx = idx + 1;
            start = i + 1;
        };
        i = i + 1;
    }
    return -1;
}

fn kw_in(tbl: ptr, tbl_len: u64, p: ptr, n: u64) -> bool {
    return kw_index(tbl, tbl_len, p, n) >= 0;
}

fn np_is_keyword(p: ptr, n: u64) -> bool {
    return kw_in("asset\0binary\0mesh\0skeleton\0image\0texture\0shader\0material\0scene\0clip\0node\0joint\0sampler\0channel\0attr\0morph\0primitive\0section\0inverse_bind\0vertices\0transform\0matrix\0skin\0state\0topology\0parent\0bind\0source\0format\0size\0color_space\0param\0indices\0input\0output\0interpolation\0path\0version\0bounds\0", 287, p, n);
}

fn np_used_has(c1: &C1, pool: i32, p: ptr, n: u64) -> bool {
    let i = 0;
    let cnt = c1.used_off.len();
    while i < cnt {
        if c1.used_pool[i as usize] == pool {
            let lo = c1.used_len[i as usize];
            if (lo as u64) == n {
                if sx_spans_eq(sx_ptr_add(c1.used_bytes.data as ptr, c1.used_off[i as usize] as u64), n, p, n) { return true; };
            };
        };
        i = i + 1;
    }
    return false;
}

fn np_byte_ok(c: u8) -> bool {
    if (c >= 97u8) && (c <= 122u8) { return true; };
    if (c >= 65u8) && (c <= 90u8) { return true; };
    if (c >= 48u8) && (c <= 57u8) { return true; };
    if c == 95u8 { return true; };
    if c == 45u8 { return true; };
    return false;
}

fn np_map_byte(c: u8) -> u8 {
    if np_byte_ok(c) { return c; };
    return 95u8;
}

fn np_needs_prefix(f: u8) -> bool {
    if (f >= 48u8) && (f <= 57u8) { return true; };
    if f == 45u8 { return true; };
    return false;
}

fn np_prefix_n(out: &SBuf) {
    let tmp = sb_new();
    sb_push_byte(&tmp, 110u8);
    sb_push_span(&tmp, out.data as ptr, out.len);
    sb_clear(out);
    sb_push_span(out, tmp.data as ptr, tmp.len);
}

fn np_sanitize(raw_p: ptr, raw_n: u64, out: &SBuf) {
    let i: u64 = 0;
    while i < raw_n {
        let c: u8 = PTR_BYTE_AT(raw_p, i);
        sb_push_byte(out, np_map_byte(c));
        i = i + 1;
    }
    if out.len == 0 { sb_push_lit(out, "unnamed", 7); };
    let f = sb_byte(out, 0);
    if np_needs_prefix(f) { np_prefix_n(out); };
}

// claim：结果名入 cv.strs，(off,len) 经 out 返回；台账 SYNTH 在此统一发。
fn np_claim(cv: &CV, c1: &C1, pool: i32, raw_present: bool, raw_p: ptr, raw_n: u64, kind_p: ptr, kind_n: u64, idx: i64, o_out: &i32, l_out: &i32) {
    let cand = sb_new();
    if raw_present {
        np_sanitize(raw_p, raw_n, &cand);
    } else {
        sb_push_span(&cand, kind_p, kind_n);
        sb_push_byte(&cand, 95u8);
        sb_push_i64(&cand, idx);
    };
    if np_is_keyword(cand.data as ptr, cand.len) {
        sb_push_byte(&cand, 95u8);
    };
    if np_used_has(c1, pool, cand.data as ptr, cand.len) {
        let n = 1;
        let searching = true;
        while searching {
            let c2 = sb_new();
            sb_push_span(&c2, cand.data as ptr, cand.len);
            sb_push_byte(&c2, 95u8);
            sb_push_i64(&c2, idx + n);
            if !np_used_has(c1, pool, c2.data as ptr, c2.len) {
                sb_clear(&cand);
                sb_push_span(&cand, c2.data as ptr, c2.len);
                searching = false;
            };
            n = n + 1;
        }
    };
    c1.used_off.push(c1.used_bytes.len as i32);
    c1.used_len.push(cand.len as i32);
    c1.used_pool.push(pool);
    sb_push_span(&c1.used_bytes, cand.data as ptr, cand.len);
    cv_str(cv, cand.data as ptr, cand.len, o_out, l_out);
    if !raw_present {
        let m = sb_new();
        sb_push_lit(&m, "name for ", 9);
        sb_push_span(&m, kind_p, kind_n);
        sb_push_byte(&m, 91u8);
        sb_push_i64(&m, idx);
        sb_push_lit(&m, "] absent in source; synthesised '", 33);
        sb_push_span(&m, cand.data as ptr, cand.len);
        sb_push_byte(&m, 39u8);
        cv_led(cv, "SYNTH", 5, &m);
    } else {
        if !sx_spans_eq(cand.data as ptr, cand.len, raw_p, raw_n) {
            let m = sb_new();
            sb_push_lit(&m, "name for ", 9);
            sb_push_span(&m, kind_p, kind_n);
            sb_push_byte(&m, 91u8);
            sb_push_i64(&m, idx);
            sb_push_lit(&m, "] sanitised/deduped '", 21);
            sb_push_span(&m, raw_p, raw_n);
            sb_push_lit(&m, "' -> '", 6);
            sb_push_span(&m, cand.data as ptr, cand.len);
            sb_push_byte(&m, 39u8);
            cv_led(cv, "SYNTH", 5, &m);
        };
    };
}

// 便捷：从 JSON 值（可缺失/可非串）取名字 claim。nv 是名字值 id（<0 缺失）。
fn np_claim_jname(cv: &CV, c1: &C1, pool: i32, nv: i32, kind_p: ptr, kind_n: u64, idx: i64, o_out: &i32, l_out: &i32) {
    if j_kind(&cv.jd, nv) == 4 {
        np_claim(cv, c1, pool, true, sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[nv as usize] as u64), cv.jd.slen[nv as usize] as u64, kind_p, kind_n, idx, o_out, l_out);
    } else {
        np_claim(cv, c1, pool, false, "", 0, kind_p, kind_n, idx, o_out, l_out);
    };
}

// ---------------- 段登记 ----------------

fn c1_add_section(cv: &CV, c1: &C1, raw_p: ptr, raw_n: u64, bytes_p: ptr, bytes_n: u64, o_out: &i32, l_out: &i32) {
    np_claim(cv, c1, 8, true, raw_p, raw_n, "section", 7, c1.sec_off.len() as i64, o_out, l_out);
    c1.sec_off.push(*o_out);
    c1.sec_len.push(*l_out);
    c1.sec_boff.push(c1.secstore.len as i32);
    c1.sec_blen.push(bytes_n as i32);
    sb_push_span(&c1.secstore, bytes_p, bytes_n);
}

fn c1_acc_section(cv: &CV, c1: &C1, acc_idx: i64, raw_p: ptr, raw_n: u64, bytes_p: ptr, bytes_n: u64, o_out: &i32, l_out: &i32) {
    // accsec 表按 accessor 下标扩容
    while (c1.accsec_acc.len() as i64) <= acc_idx {
        c1.accsec_acc.push(-1);
        c1.accsec_off.push(0);
        c1.accsec_len.push(0);
    }
    if c1.accsec_acc[acc_idx as usize] >= 0 {
        *o_out = c1.accsec_off[acc_idx as usize];
        *l_out = c1.accsec_len[acc_idx as usize];
        return;
    };
    c1_add_section(cv, c1, raw_p, raw_n, bytes_p, bytes_n, o_out, l_out);
    c1.accsec_acc[acc_idx as usize] = 1;
    c1.accsec_off[acc_idx as usize] = *o_out;
    c1.accsec_len[acc_idx as usize] = *l_out;
}

// ---------------- 小工具 ----------------

fn rd_f32(p: ptr, idx: u64) -> f32 {
    return nf_f32_from_bits(sx_rd_u32(p, idx * 4));
}

fn wr_u16le(b: &SBuf, v: u32) {
    sb_push_byte(b, (v & 255u32) as u8);
    sb_push_byte(b, ((v >> 8u32) & 255u32) as u8);
}

fn wr_u32le(b: &SBuf, v: u32) {
    sb_push_byte(b, (v & 255u32) as u8);
    sb_push_byte(b, ((v >> 8u32) & 255u32) as u8);
    sb_push_byte(b, ((v >> 16u32) & 255u32) as u8);
    sb_push_byte(b, ((v >> 24u32) & 255u32) as u8);
}

fn wr_f32(b: &SBuf, v: f32) {
    wr_u32le(b, nf_f32_bits(v));
}

fn rd_idx(p: ptr, i: u64, is32: bool) -> u32 {
    if is32 { return sx_rd_u32(p, i * 4); };
    return sx_rd_u16(p, i * 2);
}

fn wr_idx(b: &SBuf, v: u32, is32: bool) {
    if is32 { wr_u32le(b, v); } else { wr_u16le(b, v); };
}

// 三角扇展开（SPEC D-9）：bytes 是源索引字节（在 src SBuf 中）。
fn expand_fan(src_p: ptr, src_n: u64, is32: bool, out: &SBuf) {
    let esz: u64 = if is32 { 4 } else { 2 };
    let n = src_n / esz;
    if n < 3 { return; };
    let first = rd_idx(src_p, 0, is32);
    let k: u64 = 1;
    while (k + 1) < n {
        wr_idx(out, first, is32);
        wr_idx(out, rd_idx(src_p, k, is32), is32);
        wr_idx(out, rd_idx(src_p, k + 1, is32), is32);
        k = k + 1;
    }
}

fn expand_fan_sequential(vcount: i64, out: &SBuf, is32_out: &bool) {
    let is32 = vcount > 65536;
    *is32_out = is32;
    let seq = sb_new();
    let i = 0;
    while i < vcount {
        wr_idx(&seq, i as u32, is32);
        i = i + 1;
    }
    expand_fan(seq.data as ptr, seq.len, is32, out);
}

// 派生法线：pos 字节（f32x3），idx 可空。acc 用 f32 位模式 Vec<u32> 累积。
// f32 平方根：sa_std/sla_std 无 sqrt 面（实查无），以 f64 Newton
// 迭代实现（derive_normals 冷路径专用）。注：Zig 为 f32 @sqrt
// （单精度正确舍入），本实现经 f64 计算后截断回 f32，极端输入下
// 可能与 Zig 差 1 ulp——语料差分若触发再议（见 PORT 终报登记）。
fn nf_f32_sqrt(v: f32) -> f32 {
    if v <= nf_f32_from_bits(0) { return nf_f32_from_bits(0); };
    let d = v as f64;
    // 迭代以 u64 bits 携带（f64 循环携带变量会被 phi 合并重解释，GAP-PORT-8）；每步用新鲜 f64 局部。
    // 种子不用 if 表达式（f64 经分支合并同样被重解释）：d+1 对一切 d>0 都 >= sqrt(d)，Newton 自上收敛。
    let gb = nf_f64_bits(d + 1.0);
    let i = 0;
    while i < 200 {
        let g = nf_f64_from_bits(gb);
        let ng = (g + d / g) * 0.5;
        gb = nf_f64_bits(ng);
        i = i + 1;
    }
    return nf_f64_from_bits(gb) as f32;
}

fn derive_normals(pos_p: ptr, pos_n: u64, has_idx: bool, idx_p: ptr, idx_n: u64, idx32: bool, out: &SBuf) {
    let n = (pos_n / 12) as i64;
    let acc: Vec<u32> = Vec::new();
    let z = 0;
    while z < n * 3 {
        acc.push(0u32);
        z = z + 1;
    }
    let tri_count = if has_idx { (idx_n / (if idx32 { 4 } else { 2 })) / 3 } else { (n / 3) as u64 };
    let t: u64 = 0;
    while t < tri_count {
        let vi0 = if has_idx { rd_idx(idx_p, t * 3, idx32) as u64 } else { t * 3 };
        let vi1 = if has_idx { rd_idx(idx_p, t * 3 + 1, idx32) as u64 } else { t * 3 + 1 };
        let vi2 = if has_idx { rd_idx(idx_p, t * 3 + 2, idx32) as u64 } else { t * 3 + 2 };
        let ax = rd_f32(pos_p, vi0 * 3); let ay = rd_f32(pos_p, vi0 * 3 + 1); let az = rd_f32(pos_p, vi0 * 3 + 2);
        let bx = rd_f32(pos_p, vi1 * 3); let by = rd_f32(pos_p, vi1 * 3 + 1); let bz = rd_f32(pos_p, vi1 * 3 + 2);
        let cx = rd_f32(pos_p, vi2 * 3); let cy = rd_f32(pos_p, vi2 * 3 + 1); let cz = rd_f32(pos_p, vi2 * 3 + 2);
        let ux = bx - ax; let uy = by - ay; let uz = bz - az;
        let vx = cx - ax; let vy = cy - ay; let vz = cz - az;
        let crx = uy * vz - uz * vy;
        let cry = uz * vx - ux * vz;
        let crz = ux * vy - uy * vx;
        let vis: [u64; 3] = [vi0, vi1, vi2];
        let vi_i = 0;
        while vi_i < 3 {
            let base = (vis[vi_i as usize] * 3) as usize;
            acc[base] = nf_f32_bits(nf_f32_from_bits(acc[base]) + crx);
            acc[base + 1] = nf_f32_bits(nf_f32_from_bits(acc[base + 1]) + cry);
            acc[base + 2] = nf_f32_bits(nf_f32_from_bits(acc[base + 2]) + crz);
            vi_i = vi_i + 1;
        }
        t = t + 1;
    }
    let i = 0;
    while i < n {
        let base = (i * 3) as usize;
        let x0 = nf_f32_from_bits(acc[base]);
        let y0 = nf_f32_from_bits(acc[base + 1]);
        let z0 = nf_f32_from_bits(acc[base + 2]);
        let l = nf_f32_sqrt(x0 * x0 + y0 * y0 + z0 * z0);
        let x = x0; let y = y0; let zz = z0;
        if l > nf_f32_from_bits(0) {
            wr_f32(out, x / l);
            wr_f32(out, y / l);
            wr_f32(out, zz / l);
        } else {
            wr_f32(out, nf_f32_from_bits(0));
            wr_f32(out, nf_f32_from_bits(0));
            wr_f32(out, nf_f32_from_bits(1065353216));
        };
        i = i + 1;
    }
}

// ---------------- 通道字节转换 ----------------

// convChannelBytes：joints u8→u16 拓宽 / weights 归一整数→f32。
// 结果字节入 out；elem 名入 eo/el（空 = 未转换，elem=""）。
fn conv_channel_bytes(cv: &CV, acc_idx: i64, want_p: ptr, want_n: u64, out: &SBuf, eo: &i32, el: &i32) -> bool {
    let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem = 0;
    if !acc_info(cv, acc_idx, &comp, &to, &tl, &count, &norm, &elem) {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, acc_idx);
        sb_push_lit(&cv.x.msg, " malformed", 10);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let raw = sb_new();
    if !acc_bytes(cv, acc_idx, &raw) { return false; };
    *eo = 0;
    *el = 0;
    if sx_spans_eq(want_p, want_n, "joints", 6) && (comp == 5121) {
        let i: u64 = 0;
        while i < raw.len {
            let jb: u8 = PTR_BYTE_AT(raw.data as ptr, i);
            wr_u16le(out, jb as u32);
            i = i + 1;
        }
        let m = sb_new();
        sb_push_lit(&m, "JOINTS_0 u8 widened to u16 (values preserved, bytes change) in accessor ", 72);
        sb_push_i64(&m, acc_idx);
        cv_led(cv, "APPROX", 6, &m);
        cv_str(cv, "u16x4", 5, eo, el);
        return true;
    };
    if sx_spans_eq(want_p, want_n, "weights", 7) && ((comp == 5121) || (comp == 5123)) && norm {
        let div: f32 = if comp == 5121 { (255.0 as f32) } else { (65535.0 as f32) };
        if comp == 5121 {
            let i: u64 = 0;
            while i < raw.len {
                let wb: u8 = PTR_BYTE_AT(raw.data as ptr, i);
                let v = (wb as f32) / div;
                wr_f32(out, v);
                i = i + 1;
            }
        } else {
            let i: u64 = 0;
            while i < raw.len {
                let v = (sx_rd_u16(raw.data as ptr, i) as f32) / div;
                wr_f32(out, v);
                i = i + 2;
            }
        };
        let m = sb_new();
        sb_push_lit(&m, "WEIGHTS_0 normalized integers converted to f32 in accessor ", 59);
        sb_push_i64(&m, acc_idx);
        cv_led(cv, "APPROX", 6, &m);
        cv_str(cv, "f32x4", 5, eo, el);
        return true;
    };
    sb_push_span(out, raw.data as ptr, raw.len);
    return true;
}

// elemNameFor：comp/ty → SAX3D 元素名；不支持 → CvtUnsupportedElemType。
fn elem_name_for(cv: &CV, comp: i64, ty_p: ptr, ty_n: u64, acc_idx: i64, eo: &i32, el: &i32) -> bool {
    let m = sb_new();
    if (comp == 5126) && sx_spans_eq(ty_p, ty_n, "SCALAR", 6) { sb_push_lit(&m, "f32", 3); }
    else if (comp == 5126) && sx_spans_eq(ty_p, ty_n, "VEC2", 4) { sb_push_lit(&m, "f32x2", 5); }
    else if (comp == 5126) && sx_spans_eq(ty_p, ty_n, "VEC3", 4) { sb_push_lit(&m, "f32x3", 5); }
    else if (comp == 5126) && sx_spans_eq(ty_p, ty_n, "VEC4", 4) { sb_push_lit(&m, "f32x4", 5); }
    else if (comp == 5123) && sx_spans_eq(ty_p, ty_n, "VEC4", 4) { sb_push_lit(&m, "u16x4", 5); }
    else if (comp == 5121) && sx_spans_eq(ty_p, ty_n, "VEC4", 4) { sb_push_lit(&m, "u8x4", 4); }
    else if (comp == 5125) && sx_spans_eq(ty_p, ty_n, "SCALAR", 6) { sb_push_lit(&m, "u32", 3); }
    else if (comp == 5123) && sx_spans_eq(ty_p, ty_n, "SCALAR", 6) { sb_push_lit(&m, "u16", 3); }
    else {
        sb_push_lit(&cv.x.msg, "accessor ", 9);
        sb_push_i64(&cv.x.msg, acc_idx);
        sb_push_lit(&cv.x.msg, ": componentType ", 16);
        sb_push_i64(&cv.x.msg, comp);
        sb_push_lit(&cv.x.msg, " type ", 6);
        sb_push_span(&cv.x.msg, ty_p, ty_n);
        sb_push_lit(&cv.x.msg, " has no SAX3D element type", 26);
        return cv_fail(cv, "CvtUnsupportedElemType", 22);
    };
    cv_str(cv, m.data as ptr, m.len, eo, el);
    return true;
}

fn shader_name_for(cv: &CV, skin: bool, tex: bool, uv: bool, o_out: &i32, l_out: &i32) {
    let b = sb_new();
    sb_push_lit(&b, "StdPbr", 6);
    if skin { sb_push_lit(&b, "Skinned", 7); };
    if !tex { sb_push_lit(&b, "Nt", 2); };
    if !uv { sb_push_lit(&b, "Nu", 2); };
    cv_str(cv, b.data as ptr, b.len, o_out, l_out);
}

// StdPbrSkinnedNtNu -> std_pbr_skinned_nt_nu（大写转小写并在非首位前加 _）
fn fixture_file_for(p: ptr, n: u64, out: &SBuf) {
    let i: u64 = 0;
    while i < n {
        let c = PTR_BYTE_AT(p, i);
        if (c >= 65u8) && (c <= 90u8) {
            if i > 0 { sb_push_byte(out, 95u8); };
            sb_push_byte(out, c + 32u8);
        } else {
            sb_push_byte(out, c);
        };
        i = i + 1;
    }
}

fn wrap_name(v_present: bool, v: i64, o_out: &i32, l_out: &i32, cv: &CV) {
    let x = if v_present { v } else { 10497 };
    if x == 33071 { cv_str(cv, "clamp", 5, o_out, l_out); }
    else if x == 33648 { cv_str(cv, "mirror", 6, o_out, l_out); }
    else { cv_str(cv, "repeat", 6, o_out, l_out); };
}

fn filt_name(v_present: bool, v: i64, def_o: i32, def_l: i32, o_out: &i32, l_out: &i32, cv: &CV) {
    if !v_present { *o_out = def_o; *l_out = def_l; return; };
    if v == 9728 { cv_str(cv, "nearest", 7, o_out, l_out); }
    else { cv_str(cv, "linear", 6, o_out, l_out); };
}

// ---------------- 材质变体发射 ----------------
// tex_names: c1.tex_names_*（name span 列表）。

fn mat_slot_check(cv: &CV, pbr: i32, m: i32, key: ptr, klen: i64) -> bool {
    if (jg(cv, pbr, key, klen) >= 0) || (jg(cv, m, key, klen) >= 0) {
        sb_push_lit(&cv.x.msg, "material slot '", 15);
        sb_push_span(&cv.x.msg, key, klen as u64);
        sb_push_lit(&cv.x.msg, "' has no StdPbr interface slot (map §2)", 40);
        return cv_fail(cv, "CvtUnsupportedTextureSlot", 25);
    };
    return true;
}

fn emit_mat_variant(cv: &CV, c1: &C1, mat_idx: i64, vn_o: i32, vn_l: i32, sh_o: i32, sh_l: i32) -> bool {
    let t = sb_new();
    sb_push_lit(&t, "material ", 9);
    put_span(cv, &t, vn_o, vn_l);
    sb_push_lit(&t, " {\n  shader: ", 13);
    put_span(cv, &t, sh_o, sh_l);
    sb_push_lit(&t, ";\n", 2);
    let base: [f64; 4] = [1.0, 1.0, 1.0, 1.0];
    let rough = mat_factor_pbr(cv, mat_idx, "roughnessFactor", 15, 1.0);
    let metal = mat_factor_pbr(cv, mat_idx, "metallicFactor", 14, 1.0);
    let alpha_o = 0; let alpha_l = 0;
    cv_str(cv, "opaque", 6, &alpha_o, &alpha_l);
    let cutoff = mat_factor_top(cv, mat_idx, "alphaCutoff", 11, 0.0);
    let cutoff_present = mat_present(cv, mat_idx, "alphaCutoff", 11);
    let has_cutoff = false;
    let dbl = false;
    let tb_o = 0; let tb_l = 0; let has_tb = false;
    let tt = -1;
    if mat_idx >= 0 {
        let mats = jg(cv, cv.root, "materials", 9);
        let m = j_arr_at(&cv.jd, mats, mat_idx as i32);
        if m < 0 {
            sb_push_lit(&cv.x.msg, "material ", 9);
            sb_push_i64(&cv.x.msg, mat_idx);
            sb_push_lit(&cv.x.msg, " missing", 8);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let pbr = jg(cv, m, "pbrMetallicRoughness", 20);
        if pbr >= 0 {
            let bcf = jg(cv, pbr, "baseColorFactor", 15);
            if j_arr_len(&cv.jd, bcf) == 4 {
                let bi = 0;
                while bi < 4 {
                    let pres = false;
                    let v = j_float(&cv.jd, j_arr_at(&cv.jd, bcf, bi), &pres);
                    if pres { base[bi as usize] = v; };
                    bi = bi + 1;
                }
            };
            let bct = jg(cv, pbr, "baseColorTexture", 16);
            if bct >= 0 {
                let pres3 = false;
                let tcoord = jg_int(cv, bct, "texCoord", 8, &pres3);
                let tc = if pres3 { tcoord } else { 0 };
                if tc != 0 {
                    sb_push_lit(&cv.x.msg, "baseColorTexture texCoord ", 26);
                    sb_push_i64(&cv.x.msg, tc);
                    sb_push_lit(&cv.x.msg, " != 0 (no per-binding channel select in SAX3D v1)", 49);
                    return cv_fail(cv, "CvtUnsupportedTextureSlot", 25);
                };
                let tidx = jg_int(cv, bct, "index", 5, &pres3);
                if !pres3 {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "baseColorTexture lacks index", 28);
                };
                if (tidx < 0) || (tidx >= c1.tex_names_off.len()) {
                    sb_push_lit(&cv.x.msg, "baseColorTexture index ", 23);
                    sb_push_i64(&cv.x.msg, tidx);
                    sb_push_lit(&cv.x.msg, " out of range", 13);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                tb_o = c1.tex_names_off[tidx as usize];
                tb_l = c1.tex_names_len[tidx as usize];
                has_tb = true;
                let ext = jg(cv, bct, "extensions", 10);
                if ext >= 0 {
                    let ktt = jg(cv, ext, "KHR_texture_transform", 21);
                    if ktt >= 0 { tt = ktt; };
                };
            };
            if !mat_slot_check(cv, pbr, m, "metallicRoughnessTexture", 24) { return false; };
            if !mat_slot_check(cv, pbr, m, "normalTexture", 13) { return false; };
            if !mat_slot_check(cv, pbr, m, "occlusionTexture", 16) { return false; };
            if !mat_slot_check(cv, pbr, m, "emissiveTexture", 15) { return false; };
        };
        let ef = jg(cv, m, "emissiveFactor", 14);
        if j_arr_len(&cv.jd, ef) == 3 {
            let pres4 = false;
            let e0 = j_float(&cv.jd, j_arr_at(&cv.jd, ef, 0), &pres4);
            let e1 = j_float(&cv.jd, j_arr_at(&cv.jd, ef, 1), &pres4);
            let e2 = j_float(&cv.jd, j_arr_at(&cv.jd, ef, 2), &pres4);
            if (e0 != 0.0) || (e1 != 0.0) || (e2 != 0.0) {
                sb_push_lit(&cv.x.msg, "emissiveFactor [", 16);
                nf_push_f64(&cv.x.msg, e0);
                sb_push_lit(&cv.x.msg, ", ", 2);
                nf_push_f64(&cv.x.msg, e1);
                sb_push_lit(&cv.x.msg, ", ", 2);
                nf_push_f64(&cv.x.msg, e2);
                sb_push_lit(&cv.x.msg, "] nonzero: StdPbr has no emissive param (map §2)", 49);
                return cv_fail(cv, "CvtUnsupportedParam", 19);
            };
        };
        let am_o = 0; let am_l = 0;
        if jg_str(cv, m, "alphaMode", 9, &am_o, &am_l) {
            if cv_str_eq(cv, am_o, am_l, "BLEND", 5) {
                cv_str(cv, "blend", 5, &alpha_o, &alpha_l);
            };
            if cv_str_eq(cv, am_o, am_l, "MASK", 4) {
                cv_str(cv, "mask", 4, &alpha_o, &alpha_l);
                if cutoff_present { has_cutoff = true; };
            };
        };
        let ds = jg(cv, m, "doubleSided", 11);
        if j_bool(&cv.jd, ds) { dbl = true; };
    };
    sb_push_lit(&t, "  param base_color = [", 22);
    let bi2 = 0;
    while bi2 < 4 {
        if bi2 > 0 { sb_push_lit(&t, ", ", 2); };
        nf_push_f64(&t, base[bi2 as usize]);
        bi2 = bi2 + 1;
    }
    sb_push_lit(&t, "];\n  param roughness = ", 23);
    nf_push_f64(&t, rough);
    sb_push_lit(&t, ";\n  param metallic = ", 21);
    nf_push_f64(&t, metal);
    sb_push_lit(&t, ";\n", 2);
    if has_tb {
        sb_push_lit(&t, "  texture base_color_map: ", 26);
        put_span(cv, &t, tb_o, tb_l);
        sb_push_lit(&t, ";\n", 2);
    };
    if tt >= 0 {
        sb_push_lit(&t, "  tex_transform base_color_map {", 32);
        let offv = jg(cv, tt, "offset", 6);
        if j_kind(&cv.jd, offv) == 5 {
            sb_push_lit(&t, " offset: ", 9);
            let okv = cv_jvec(cv, &t, offv, 2);
            sb_push_byte(&t, 59u8);
        };
        let scv = jg(cv, tt, "scale", 5);
        if j_kind(&cv.jd, scv) == 5 {
            sb_push_lit(&t, " scale: ", 8);
            let okv2 = cv_jvec(cv, &t, scv, 2);
            sb_push_byte(&t, 59u8);
        };
        let pres6 = false;
        let rot = jg_f64(cv, tt, "rotation", 8, &pres6);
        if pres6 {
            sb_push_lit(&t, " rotation: ", 11);
            nf_push_f64(&t, rot);
            sb_push_byte(&t, 59u8);
        };
        sb_push_lit(&t, " }}\n", 4);
        let m2 = sb_new();
        sb_push_lit(&m2, "KHR_texture_transform on material '", 35);
        put_span(cv, &m2, vn_o, vn_l);
        sb_push_lit(&m2, "' mapped to tex_transform (map §2)", 35);
        cv_led(cv, "APPROX", 6, &m2);
    };
    if !cv_str_eq(cv, alpha_o, alpha_l, "opaque", 6) || has_cutoff || dbl {
        sb_push_lit(&t, "  state { alpha: ", 17);
        put_span(cv, &t, alpha_o, alpha_l);
        sb_push_byte(&t, 59u8);
        if has_cutoff {
            sb_push_lit(&t, " cutoff: ", 9);
            nf_push_f64(&t, cutoff);
            sb_push_byte(&t, 59u8);
        };
        if dbl { sb_push_lit(&t, " double_sided: true;", 20); };
        sb_push_lit(&t, " }", 2);
        sb_push_byte(&t, 10u8);
    };
    sb_push_lit(&t, "}\n", 2);
    sb_push_span(&c1.txt_mat, t.data as ptr, t.len);
    return true;
}

// ---------------- 局部名池（morph/primitive 每网格新建） ----------------

struct LPool {
    off: Vec<i32>,
    len: Vec<i32>,
    bytes: SBuf,
}

fn lp_new() -> LPool {
    return LPool { off: Vec::new(), len: Vec::new(), bytes: sb_new() };
}

fn lp_has(lp: &LPool, p: ptr, n: u64) -> bool {
    let i = 0;
    let cnt = lp.off.len();
    while i < cnt {
        if (lp.len[i as usize] as u64) == n {
            if sx_spans_eq(sx_ptr_add(lp.bytes.data as ptr, lp.off[i as usize] as u64), n, p, n) { return true; };
        };
        i = i + 1;
    }
    return false;
}

fn np_claim_l(cv: &CV, lp: &LPool, raw_present: bool, raw_p: ptr, raw_n: u64, kind_p: ptr, kind_n: u64, idx: i64, o_out: &i32, l_out: &i32) {
    let cand = sb_new();
    if raw_present {
        np_sanitize(raw_p, raw_n, &cand);
    } else {
        sb_push_span(&cand, kind_p, kind_n);
        sb_push_byte(&cand, 95u8);
        sb_push_i64(&cand, idx);
    };
    if np_is_keyword(cand.data as ptr, cand.len) {
        sb_push_byte(&cand, 95u8);
    };
    if lp_has(lp, cand.data as ptr, cand.len) {
        let n = 1;
        let searching = true;
        while searching {
            let c2 = sb_new();
            sb_push_span(&c2, cand.data as ptr, cand.len);
            sb_push_byte(&c2, 95u8);
            sb_push_i64(&c2, idx + n);
            if !lp_has(lp, c2.data as ptr, c2.len) {
                sb_clear(&cand);
                sb_push_span(&cand, c2.data as ptr, c2.len);
                searching = false;
            };
            n = n + 1;
        }
    };
    lp.off.push(lp.bytes.len as i32);
    lp.len.push(cand.len as i32);
    sb_push_span(&lp.bytes, cand.data as ptr, cand.len);
    cv_str(cv, cand.data as ptr, cand.len, o_out, l_out);
    if !raw_present {
        let m = sb_new();
        sb_push_lit(&m, "name for ", 9);
        sb_push_span(&m, kind_p, kind_n);
        sb_push_byte(&m, 91u8);
        sb_push_i64(&m, idx);
        sb_push_lit(&m, "] absent in source; synthesised '", 33);
        sb_push_span(&m, cand.data as ptr, cand.len);
        sb_push_byte(&m, 39u8);
        cv_led(cv, "SYNTH", 5, &m);
    } else {
        if !sx_spans_eq(cand.data as ptr, cand.len, raw_p, raw_n) {
            let m = sb_new();
            sb_push_lit(&m, "name for ", 9);
            sb_push_span(&m, kind_p, kind_n);
            sb_push_byte(&m, 91u8);
            sb_push_i64(&m, idx);
            sb_push_lit(&m, "] sanitised/deduped '", 21);
            sb_push_span(&m, raw_p, raw_n);
            sb_push_lit(&m, "' -> '", 6);
            sb_push_span(&m, cand.data as ptr, cand.len);
            sb_push_byte(&m, 39u8);
            cv_led(cv, "SYNTH", 5, &m);
        };
    };
}

// ---------------- mat_variants / shaders_used（C1 侧表） ----------------

fn mv_get(c1: &C1, key_p: ptr, key_n: u64, o_out: &i32, l_out: &i32) -> bool {
    let i = 0;
    let cnt = c1.mv_key_off.len();
    while i < cnt {
        if (c1.mv_key_len[i as usize] as u64) == key_n {
            if sx_spans_eq(sx_ptr_add(c1.mv_bytes.data as ptr, c1.mv_key_off[i as usize] as u64), key_n, key_p, key_n) {
                *o_out = c1.mv_val_off[i as usize];
                *l_out = c1.mv_val_len[i as usize];
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

fn mv_put(c1: &C1, key_p: ptr, key_n: u64, vo: i32, vl: i32) {
    c1.mv_key_off.push(c1.mv_bytes.len as i32);
    c1.mv_key_len.push(key_n as i32);
    sb_push_span(&c1.mv_bytes, key_p, key_n);
    c1.mv_val_off.push(vo);
    c1.mv_val_len.push(vl);
}

fn su_add(c1: &C1, o: i32, l: i32) {
    c1.su_off.push(o);
    c1.su_len.push(l);
}

fn su_has(cv: &CV, c1: &C1, o: i32, l: i32) -> bool {
    let i = 0;
    let cnt = c1.su_off.len();
    while i < cnt {
        if c1.su_len[i as usize] == l {
            if sx_spans_eq(sx_ptr_add(cv.strs.data as ptr, c1.su_off[i as usize] as u64), l as u64, sx_ptr_add(cv.strs.data as ptr, o as u64), l as u64) { return true; };
        };
        i = i + 1;
    }
    return false;
}

// 对象键排序收集：把对象 v 的键 (off,len@jd.strs) 与值 id 按键字节序
// 排入 ko/kl/kv（插入排序，小 n）。
fn keys_push_one(jd: &JDoc, ko: &Vec<i32>, kl: &Vec<i32>, kv: &Vec<i32>, base: i32, kbase: i32, i: i32) {
    ko.push(jd.kpool_off[(kbase + i) as usize]);
    kl.push(jd.kpool_len[(kbase + i) as usize]);
    kv.push(jd.pool[(base + i) as usize]);
}

// 相邻比较+交换（无环助手）：返回 true 表示发生了交换。
fn keys_sort_step(jd: &JDoc, ko: &Vec<i32>, kl: &Vec<i32>, kv: &Vec<i32>, b: i32) -> bool {
    let o1 = ko[(b - 1) as usize]; let l1 = kl[(b - 1) as usize];
    let o2 = ko[b as usize]; let l2 = kl[b as usize];
    if span_cmp(sx_ptr_add(jd.strs.data as ptr, o1 as u64), l1 as u64, sx_ptr_add(jd.strs.data as ptr, o2 as u64), l2 as u64) > 0 {
        ko[(b - 1) as usize] = o2; kl[(b - 1) as usize] = l2;
        let tv = kv[(b - 1) as usize];
        ko[b as usize] = o1; kl[b as usize] = l1;
        kv[(b - 1) as usize] = kv[b as usize];
        kv[b as usize] = tv;
        return true;
    };
    return false;
}

fn obj_keys_sorted(cv: &CV, v: i32, ko: &Vec<i32>, kl: &Vec<i32>, kv: &Vec<i32>) {
    if j_kind(&cv.jd, v) != 6 { return; };
    let base = cv.jd.koff[v as usize];
    let kbase = cv.jd.kbase[v as usize];
    let n = cv.jd.klen[v as usize];
    let i = 0;
    while i < n {
        keys_push_one(&cv.jd, ko, kl, kv, base, kbase, i);
        i = i + 1;
    }
    // 插入排序
    let a = 1;
    while a < n {
        let b = a;
        let going = true;
        while going && (b > 0) {
            if keys_sort_step(&cv.jd, ko, kl, kv, b) {
            } else {
                going = false;
            };
            b = b - 1;
        }
        a = a + 1;
    }
}

fn span_cmp(p1: ptr, n1: u64, p2: ptr, n2: u64) -> i32 {
    let m = if n1 < n2 { n1 } else { n2 };
    let i: u64 = 0;
    while i < m {
        let a: u8 = PTR_BYTE_AT(p1, i);
        let b: u8 = PTR_BYTE_AT(p2, i);
        if a != b { return (a as i32) - (b as i32); };
        i = i + 1;
    }
    if n1 == n2 { return 0; };
    return if n1 < n2 { -1 } else { 1 };
}

// 在已排序键表中按键查值 id（未命中 -1）。
fn sorted_get(ko: &Vec<i32>, kl: &Vec<i32>, kv: &Vec<i32>, jd: &JDoc, key: ptr, klen: u64) -> i32 {
    let i = 0;
    let n = ko.len();
    while i < n {
        if (kl[i as usize] as u64) == klen {
            if sx_spans_eq(sx_ptr_add(jd.strs.data as ptr, ko[i as usize] as u64), klen, key, klen) {
                return kv[i as usize];
            };
        };
        i = i + 1;
    }
    return -1;
}

// ---------------- to-sax3d: 网格 ----------------

fn is_canon_attr(p: ptr, n: u64) -> bool {
    return kw_in("POSITION\0NORMAL\0TANGENT\0TEXCOORD_0\0TEXCOORD_1\0TEXCOORD_2\0TEXCOORD_3\0COLOR_0\0JOINTS_0\0WEIGHTS_0\0", 95, p, n);
}

fn mat_has_base_tex(cv: &CV, mat_idx: i64) -> bool {
    if mat_idx < 0 { return false; };
    let mats = jg(cv, cv.root, "materials", 9);
    let m = j_arr_at(&cv.jd, mats, mat_idx as i32);
    if m < 0 { return false; };
    let pbr = jg(cv, m, "pbrMetallicRoughness", 20);
    if pbr < 0 { return false; };
    return jg(cv, pbr, "baseColorTexture", 16) >= 0;
}

// 对象键“源序”收集（std.json ArrayHashMap = 插入序）：ko/kl/kv。
fn obj_keys_raw(cv: &CV, v: i32, ko: &Vec<i32>, kl: &Vec<i32>, kv: &Vec<i32>) {
    if j_kind(&cv.jd, v) != 6 { return; };
    let base = cv.jd.koff[v as usize];
    let kbase = cv.jd.kbase[v as usize];
    let n = cv.jd.klen[v as usize];
    let i = 0;
    while i < n {
        keys_push_one(&cv.jd, ko, kl, kv, base, kbase, i);
        i = i + 1;
    }
}

fn mesh_sig(cv: &CV, prim: i32, sig: &SBuf) -> bool {
    let attrs = jg(cv, prim, "attributes", 10);
    if j_kind(&cv.jd, attrs) != 6 {
        sb_push_lit(&cv.x.msg, "mesh ", 5);
        sb_push_lit(&cv.x.msg, "prim lacks attributes", 21);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let ko: Vec<i32> = Vec::new();
    let kl: Vec<i32> = Vec::new();
    let kv: Vec<i32> = Vec::new();
    obj_keys_sorted(cv, attrs, &ko, &kl, &kv);
    let i = 0;
    let n = ko.len();
    while i < n {
        sb_push_span(sig, sx_ptr_add(cv.jd.strs.data as ptr, ko[i as usize] as u64), kl[i as usize] as u64);
        sb_push_byte(sig, 61u8);
        let pres = false;
        let v = j_int(&cv.jd, kv[i as usize], &pres);
        sb_push_i64(sig, if pres { v } else { -1 });
        sb_push_byte(sig, 59u8);
        i = i + 1;
    }
    let pres2 = false;
    let iv = jg_int(cv, prim, "indices", 7, &pres2);
    sb_push_lit(sig, "IDX=", 4);
    sb_push_i64(sig, if pres2 { iv } else { -1 });
    sb_push_lit(sig, ";MODE=", 6);
    let mv = jg_int(cv, prim, "mode", 4, &pres2);
    sb_push_i64(sig, if pres2 { mv } else { 4 });
    sb_push_byte(sig, 59u8);
    let tg = jg(cv, prim, "targets", 7);
    if j_kind(&cv.jd, tg) == 5 {
        let tn = j_arr_len(&cv.jd, tg);
        let ti = 0;
        while ti < tn {
            let td = j_arr_at(&cv.jd, tg, ti);
            if j_kind(&cv.jd, td) == 6 {
                let tko: Vec<i32> = Vec::new();
                let tkl: Vec<i32> = Vec::new();
                let tkv: Vec<i32> = Vec::new();
                obj_keys_sorted(cv, td, &tko, &tkl, &tkv);
                let tj = 0;
                let tnn = tko.len();
                while tj < tnn {
                    sb_push_lit(sig, "T:", 2);
                    sb_push_span(sig, sx_ptr_add(cv.jd.strs.data as ptr, tko[tj as usize] as u64), tkl[tj as usize] as u64);
                    sb_push_byte(sig, 61u8);
                    let pres3 = false;
                    let v = j_int(&cv.jd, tkv[tj as usize], &pres3);
                    sb_push_i64(sig, if pres3 { v } else { -1 });
                    sb_push_byte(sig, 59u8);
                    tj = tj + 1;
                }
            };
            ti = ti + 1;
        }
    };
    return true;
}

fn conv_meshes(cv: &CV, c1: &C1) -> bool {
    let meshes = jg(cv, cv.root, "meshes", 6);
    let nm = j_arr_len(&cv.jd, meshes);
    let mi = 0;
    while mi < nm {
        let mesh = j_arr_at(&cv.jd, meshes, mi);
        let wv = jg(cv, mesh, "weights", 7);
        if j_kind(&cv.jd, wv) == 5 {
            let wn = j_arr_len(&cv.jd, wv);
            let wi = 0;
            while wi < wn {
                let pres = false;
                let v = j_float(&cv.jd, j_arr_at(&cv.jd, wv, wi), &pres);
                if (if pres { v } else { 0.0 }) != 0.0 {
                    sb_push_lit(&cv.x.msg, "mesh ", 5);
                    sb_push_i64(&cv.x.msg, mi as i64);
                    sb_push_lit(&cv.x.msg, ": nonzero default morph weights have no SAX3D counterpart", 57);
                    return cv_fail(cv, "CvtUnsupportedParam", 19);
                };
                wi = wi + 1;
            }
            if wn > 0 {
                let m = sb_new();
                sb_push_lit(&m, "mesh ", 5);
                sb_push_i64(&m, mi as i64);
                sb_push_lit(&m, ": all-zero default morph weights omitted (equivalent)", 53);
                cv_led(cv, "APPROX", 6, &m);
            };
        };
        let prims_v = jg(cv, mesh, "primitives", 10);
        if j_kind(&cv.jd, prims_v) != 5 {
            sb_push_lit(&cv.x.msg, "mesh ", 5);
            sb_push_i64(&cv.x.msg, mi as i64);
            sb_push_lit(&cv.x.msg, " lacks primitives array", 23);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let nprim = j_arr_len(&cv.jd, prims_v);
        // 分组：一遍扫描，grp_of[prim] = 组号
        let sig_off: Vec<i32> = Vec::new();
        let sig_len: Vec<i32> = Vec::new();
        let sig_bytes = sb_new();
        let grp_of: Vec<i32> = Vec::new();
        let pi = 0;
        while pi < nprim {
            let prim = j_arr_at(&cv.jd, prims_v, pi);
            let sig = sb_new();
            if !mesh_sig(cv, prim, &sig) { return false; };
            let gi = 0;
            let found = -1;
            let ngroups = sig_off.len();
            while gi < ngroups {
                if (sig_len[gi as usize] as u64) == sig.len {
                    if sx_spans_eq(sx_ptr_add(sig_bytes.data as ptr, sig_off[gi as usize] as u64), sig.len, sig.data as ptr, sig.len) {
                        found = gi;
                        gi = ngroups;
                    } else {
                        gi = gi + 1;
                    };
                } else {
                    gi = gi + 1;
                };
            }
            if found >= 0 {
                grp_of.push(found);
            } else {
                sig_off.push(sig_bytes.len as i32);
                sig_len.push(sig.len as i32);
                sb_push_span(&sig_bytes, sig.data as ptr, sig.len);
                grp_of.push(sig_off.len() - 1);
            };
            pi = pi + 1;
        }
        let ngroups = sig_off.len();
        let gname_base = c1.mg_names_off.len();
        let gi = 0;
        while gi < ngroups {
            if !conv_mesh_group(cv, c1, mesh, mi, prims_v, nprim, &grp_of, gi) { return false; };
            gi = gi + 1;
        }
        if ngroups > 1 {
            let m = sb_new();
            sb_push_lit(&m, "mesh ", 5);
            sb_push_i64(&m, mi as i64);
            sb_push_lit(&m, ": primitives have differing attribute/index sets; split into ", 61);
            sb_push_i64(&m, ngroups as i64);
            sb_push_lit(&m, " SAX3D meshes (map §1)", 23);
            cv_led(cv, "APPROX", 6, &m);
        };
        c1.mg_off.push(gname_base);
        c1.mg_len.push(c1.mg_names_off.len() - gname_base);
        mi = mi + 1;
    }
    return true;
}

// 角色通道固定序表（key/role/elem）：POSITION/NORMAL/TANGENT/TEXCOORD_0..3
fn role_chan(cv: &CV, c1: &C1, body: &SBuf, attrs: i32, mesh_no: i32, mesh_lo: i32, vcount: i64, pos_bytes: &SBuf, has_uv: &bool) -> bool {
    // 角色表逐角色显式展开（下七组调用，字面量直传）。
    return role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "POSITION", 8, "position", 8, "f32x3", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "NORMAL", 6, "normal", 6, "f32x3", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "TANGENT", 7, "tangent", 7, "f32x4", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "TEXCOORD_0", 10, "uv0", 3, "f32x2", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "TEXCOORD_1", 10, "uv1", 3, "f32x2", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "TEXCOORD_2", 10, "uv2", 3, "f32x2", 5, vcount, pos_bytes, has_uv)
        && role_chan_one(cv, c1, body, attrs, mesh_no, mesh_lo, "TEXCOORD_3", 10, "uv3", 3, "f32x2", 5, vcount, pos_bytes, has_uv);
}

// 单个角色通道：attrs 是原始 attributes 对象 id。返回 false = 已 fail。
// present_out 通过 has_uv 仅对 uv0 置位（其余角色不用）。
fn role_bytes(cv: &CV, ai: i64, pos_bytes: &SBuf, is_pos: bool, out: &SBuf) -> bool {
    if is_pos {
        sb_push_span(out, pos_bytes.data as ptr, pos_bytes.len);
        return true;
    };
    return acc_bytes(cv, ai, out);
}

fn role_chan_one(cv: &CV, c1: &C1, body: &SBuf, attrs: i32, mesh_no: i32, mesh_lo: i32, key: ptr, klen: u64, role: ptr, rlen: u64, elem: ptr, elen: u64, vcount: i64, pos_bytes: &SBuf, has_uv: &bool) -> bool {
    let av = jg(cv, attrs, key, klen);
    if av < 0 { return true; };
    let pres = false;
    let ai = j_int(&cv.jd, av, &pres);
    if !pres {
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " accessor not int", 17);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem_sz = 0;
    if !acc_info(cv, ai, &comp, &to, &tl, &count, &norm, &elem_sz) {
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " accessor malformed", 19);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    if count != vcount {
        sb_push_lit(&cv.x.msg, "mesh '", 6);
        put_span_s(&cv.strs, &cv.x.msg, mesh_no, mesh_lo);
        sb_push_lit(&cv.x.msg, "': ", 3);
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " count ", 7);
        sb_push_i64(&cv.x.msg, count);
        sb_push_lit(&cv.x.msg, " != vertex count ", 17);
        sb_push_i64(&cv.x.msg, vcount);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let bytes = sb_new();
    if !role_bytes(cv, ai, pos_bytes, sx_spans_eq(key, klen, "POSITION", 8), &bytes) { return false; };
    let rn = sb_new();
    put_span(cv, &rn, mesh_no, mesh_lo);
    sb_push_byte(&rn, 95u8);
    sb_push_span(&rn, role, rlen);
    let so = 0; let sl = 0;
    c1_acc_section(cv, c1, ai, rn.data as ptr, rn.len, bytes.data as ptr, bytes.len, &so, &sl);
    sb_push_lit(body, "  channel ", 10);
    sb_push_span(body, role, rlen);
    sb_push_lit(body, " : ", 3);
    sb_push_span(body, elem, elen);
    sb_push_lit(body, " @ ", 3);
    put_span(cv, body, so, sl);
    sb_push_lit(body, ";\n", 2);
    if sx_spans_eq(role, rlen, "uv0", 3) { *has_uv = true; };
    return true;
}

// 单组处理：rep = 组内首 prim；成员 = grp_of[p]==gi 的全部 prim。
fn conv_mesh_group(cv: &CV, c1: &C1, mesh: i32, mi: i32, prims_v: i32, nprim: i32, grp_of: &Vec<i32>, gi: i32) -> bool {
    // rep prim
    let rep = -1;
    let scan = 0;
    while scan < nprim {
        if grp_of[scan as usize] == gi { rep = j_arr_at(&cv.jd, prims_v, scan); scan = nprim; } else { scan = scan + 1; };
    }
    let mn_o = 0; let mn_l = 0;
    np_claim_jname(cv, c1, 0, jg(cv, mesh, "name", 4), "mesh", 4, mi as i64, &mn_o, &mn_l);
    let attrs = jg(cv, rep, "attributes", 10);
    // POSITION
    let pos_v = jg(cv, attrs, "POSITION", 8);
    if pos_v < 0 {
        sb_push_lit(&cv.x.msg, "mesh ", 5);
        sb_push_i64(&cv.x.msg, mi as i64);
        sb_push_lit(&cv.x.msg, ": primitive without POSITION", 28);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let pres = false;
    let pos_acc = j_int(&cv.jd, pos_v, &pres);
    if !pres {
        return cv_fail_lit(cv, "CvtBadInput", 11, "POSITION accessor not int", 25);
    };
    let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem_sz = 0;
    if !acc_info(cv, pos_acc, &comp, &to, &tl, &count, &norm, &elem_sz) {
        return cv_fail_lit(cv, "CvtBadInput", 11, "POSITION accessor malformed", 27);
    };
    if (comp != 5126) || !sx_spans_eq(sx_ptr_add(cv.jd.strs.data as ptr, to as u64), tl as u64, "VEC3", 4) {
        sb_push_lit(&cv.x.msg, "mesh ", 5);
        sb_push_i64(&cv.x.msg, mi as i64);
        sb_push_lit(&cv.x.msg, ": POSITION must be f32 VEC3", 27);
        return cv_fail(cv, "CvtUnsupportedElemType", 22);
    };
    let vcount = count;
    let pos_bytes = sb_new();
    if !acc_bytes(cv, pos_acc, &pos_bytes) { return false; };
    // indices（先行）
    let idx_bytes = sb_new();
    let has_idx = false;
    let idx_acc_idx = -1;
    let idx_elem_o = 0; let idx_elem_l = 0;
    let idx_count = 0;
    let idx_is32 = false;
    let idx_expanded = false;
    let iv = jg(cv, rep, "indices", 7);
    if iv >= 0 {
        let ia = j_int(&cv.jd, iv, &pres);
        if !pres {
            return cv_fail_lit(cv, "CvtBadInput", 11, "indices not int", 15);
        };
        idx_acc_idx = ia;
        if !acc_info(cv, ia, &comp, &to, &tl, &count, &norm, &elem_sz) {
            return cv_fail_lit(cv, "CvtBadInput", 11, "indices accessor malformed", 26);
        };
        idx_count = count;
        if comp == 5123 {
            if !acc_bytes(cv, ia, &idx_bytes) { return false; };
            cv_str(cv, "u16", 3, &idx_elem_o, &idx_elem_l);
            has_idx = true;
        } else if comp == 5125 {
            if !acc_bytes(cv, ia, &idx_bytes) { return false; };
            cv_str(cv, "u32", 3, &idx_elem_o, &idx_elem_l);
            idx_is32 = true;
            has_idx = true;
        } else if comp == 5121 {
            let rawb = sb_new();
            if !acc_bytes(cv, ia, &rawb) { return false; };
            let bi: u64 = 0;
            while bi < rawb.len {
                let bb: u8 = PTR_BYTE_AT(rawb.data as ptr, bi);
                wr_u16le(&idx_bytes, bb as u32);
                bi = bi + 1;
            }
            cv_str(cv, "u16", 3, &idx_elem_o, &idx_elem_l);
            has_idx = true;
            let m = sb_new();
            sb_push_lit(&m, "mesh '", 6);
            put_span(cv, &m, mn_o, mn_l);
            sb_push_lit(&m, "': u8 indices widened to u16 (values preserved)", 47);
            cv_led(cv, "APPROX", 6, &m);
        } else {
            sb_push_lit(&cv.x.msg, "mesh ", 5);
            sb_push_i64(&cv.x.msg, mi as i64);
            sb_push_lit(&cv.x.msg, ": indices componentType ", 24);
            sb_push_i64(&cv.x.msg, comp);
            sb_push_lit(&cv.x.msg, " unsupported", 12);
            return cv_fail(cv, "CvtUnsupportedElemType", 22);
        };
    };
    // mode / topology / fan
    let mode_v = jg_int(cv, rep, "mode", 4, &pres);
    let mode = if pres { mode_v } else { 4 };
    let topo_o = 0; let topo_l = 0;
    if mode == 0 { cv_str(cv, "points", 6, &topo_o, &topo_l); }
    else if mode == 1 { cv_str(cv, "lines", 5, &topo_o, &topo_l); }
    else if mode == 3 { cv_str(cv, "line-strip", 10, &topo_o, &topo_l); }
    else if mode == 4 { cv_str(cv, "triangles", 9, &topo_o, &topo_l); }
    else if mode == 5 { cv_str(cv, "triangle-strip", 14, &topo_o, &topo_l); }
    else if mode == 6 { cv_str(cv, "triangles", 9, &topo_o, &topo_l); }
    else {
        sb_push_lit(&cv.x.msg, "mesh ", 5);
        sb_push_i64(&cv.x.msg, mi as i64);
        sb_push_lit(&cv.x.msg, ": primitive mode ", 17);
        sb_push_i64(&cv.x.msg, mode);
        sb_push_lit(&cv.x.msg, " (line-loop etc.) unsupported", 29);
        return cv_fail(cv, "CvtUnsupportedTopology", 22);
    };
    if mode == 6 {
        if has_idx {
            if idx_count < 3 {
                sb_push_lit(&cv.x.msg, "mesh '", 6);
                put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                sb_push_lit(&cv.x.msg, "': triangle fan of ", 19);
                sb_push_i64(&cv.x.msg, idx_count);
                sb_push_lit(&cv.x.msg, " indices expands to zero triangles; refusing (loud, not a silent empty mesh)", 76);
                return cv_fail(cv, "CvtUnsupportedTopology", 22);
            };
            let ex = sb_new();
            expand_fan(idx_bytes.data as ptr, idx_bytes.len, idx_is32, &ex);
            let esz: i64 = if idx_is32 { 4 } else { 2 };
            sb_clear(&idx_bytes);
            sb_push_span(&idx_bytes, ex.data as ptr, ex.len);
            idx_count = (ex.len as i64) / esz;
            idx_expanded = true;
            let m = sb_new();
            sb_push_lit(&m, "mesh '", 6);
            put_span(cv, &m, mn_o, mn_l);
            sb_push_lit(&m, "': TRIANGLE_FAN expanded to triangle list (lossless, SPEC D-9): fan indices -> ", 79);
            sb_push_i64(&m, idx_count);
            sb_push_lit(&m, " triangle indices", 17);
            cv_led(cv, "APPROX", 6, &m);
        } else {
            if vcount < 3 {
                sb_push_lit(&cv.x.msg, "mesh '", 6);
                put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                sb_push_lit(&cv.x.msg, "': non-indexed triangle fan of ", 31);
                sb_push_i64(&cv.x.msg, vcount);
                sb_push_lit(&cv.x.msg, " vertices expands to zero triangles; refusing (loud, not a silent empty mesh)", 77);
                return cv_fail(cv, "CvtUnsupportedTopology", 22);
            };
            let ex = sb_new();
            let e32 = false;
            expand_fan_sequential(vcount, &ex, &e32);
            idx_is32 = e32;
            if e32 { cv_str(cv, "u32", 3, &idx_elem_o, &idx_elem_l); } else { cv_str(cv, "u16", 3, &idx_elem_o, &idx_elem_l); };
            let esz: i64 = if e32 { 4 } else { 2 };
            idx_count = (ex.len as i64) / esz;
            sb_push_span(&idx_bytes, ex.data as ptr, ex.len);
            has_idx = true;
            idx_expanded = true;
            let m = sb_new();
            sb_push_lit(&m, "mesh '", 6);
            put_span(cv, &m, mn_o, mn_l);
            sb_push_lit(&m, "': non-indexed TRIANGLE_FAN expanded to triangle list (lossless, SPEC D-9): index buffer synthesized, ", 102);
            sb_push_i64(&m, vcount);
            sb_push_lit(&m, " vertices -> ", 13);
            sb_push_i64(&m, idx_count);
            sb_push_lit(&m, " triangle indices", 17);
            cv_led(cv, "APPROX", 6, &m);
        };
    };
    let body = sb_new();
    sb_push_lit(&body, "mesh ", 5);
    put_span(cv, &body, mn_o, mn_l);
    sb_push_lit(&body, " {\n  topology: ", 15);
    put_span(cv, &body, topo_o, topo_l);
    sb_push_lit(&body, ";\n  vertices ", 13);
    sb_push_i64(&body, vcount);
    sb_push_lit(&body, ";\n", 2);
    let has_uv = false;
    let has_skin = false;
    if !role_chan(cv, c1, &body, attrs, mn_o, mn_l, vcount, &pos_bytes, &has_uv) { return false; };
    // NORMAL 缺失 → 派生
    if jg(cv, attrs, "NORMAL", 6) < 0 {
        let derived = sb_new();
        derive_normals(pos_bytes.data as ptr, pos_bytes.len, has_idx, idx_bytes.data as ptr, idx_bytes.len, idx_is32, &derived);
        let rn = sb_new();
        put_span(cv, &rn, mn_o, mn_l);
        sb_push_lit(&rn, "_normal_derived", 15);
        let so = 0; let sl = 0;
        c1_add_section(cv, c1, rn.data as ptr, rn.len, derived.data as ptr, derived.len, &so, &sl);
        sb_push_lit(&body, "  channel normal : f32x3 @ ", 27);
        put_span(cv, &body, so, sl);
        sb_push_lit(&body, ";\n", 2);
        let m = sb_new();
        sb_push_lit(&m, "mesh '", 6);
        put_span(cv, &m, mn_o, mn_l);
        sb_push_lit(&m, "': NORMAL absent; normals derived (", 35);
        if has_idx { sb_push_lit(&m, "area-weighted accumulation", 26); } else { sb_push_lit(&m, "flat per-face, exact for non-indexed geometry", 45); };
        sb_push_lit(&m, ") into section '", 16);
        put_span(cv, &m, so, sl);
        sb_push_byte(&m, 39u8);
        cv_led(cv, "APPROX", 6, &m);
    };
    // COLOR_0
    let c0v = jg(cv, attrs, "COLOR_0", 7);
    if c0v >= 0 {
        let ai = j_int(&cv.jd, c0v, &pres);
        if !pres { return cv_fail_lit(cv, "CvtBadInput", 11, "COLOR_0 not int", 15); };
        if !acc_info(cv, ai, &comp, &to, &tl, &count, &norm, &elem_sz) {
            return cv_fail_lit(cv, "CvtBadInput", 11, "COLOR_0 malformed", 17);
        };
        if count != vcount {
            sb_push_lit(&cv.x.msg, "mesh '", 6);
            put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
            sb_push_lit(&cv.x.msg, "': COLOR_0 count mismatch", 25);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let en_o = 0; let en_l = 0;
        if !elem_name_for(cv, comp, sx_ptr_add(cv.jd.strs.data as ptr, to as u64), tl as u64, ai, &en_o, &en_l) { return false; };
        if !cv_str_eq(cv, en_o, en_l, "f32x4", 5) && !cv_str_eq(cv, en_o, en_l, "u8x4", 4) {
            sb_push_lit(&cv.x.msg, "mesh '", 6);
            put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
            sb_push_lit(&cv.x.msg, "': COLOR_0 element ", 19);
            put_span_s(&cv.strs, &cv.x.msg, en_o, en_l);
            sb_push_lit(&cv.x.msg, " unsupported (need f32x4/u8x4)", 30);
            return cv_fail(cv, "CvtUnsupportedElemType", 22);
        };
        let bytes = sb_new();
        if !acc_bytes(cv, ai, &bytes) { return false; };
        let rn = sb_new();
        put_span(cv, &rn, mn_o, mn_l);
        sb_push_lit(&rn, "_color0", 7);
        let so = 0; let sl = 0;
        c1_acc_section(cv, c1, ai, rn.data as ptr, rn.len, bytes.data as ptr, bytes.len, &so, &sl);
        sb_push_lit(&body, "  channel color0 : ", 19);
        put_span(cv, &body, en_o, en_l);
        sb_push_lit(&body, " @ ", 3);
        put_span(cv, &body, so, sl);
        sb_push_lit(&body, ";\n", 2);
    };
    // JOINTS_0 / WEIGHTS_0
    if !conv_jw(cv, c1, &body, attrs, mn_o, mn_l, vcount, "JOINTS_0", 8, "joints0", 7, "joints", 6, "u16x4", 5, &has_skin) { return false; };
    if !conv_jw(cv, c1, &body, attrs, mn_o, mn_l, vcount, "WEIGHTS_0", 9, "weights0", 8, "weights", 7, "f32x4", 5, &has_skin) { return false; };
    // 自定义属性（源序）
    if !conv_custom_attrs(cv, c1, &body, attrs, mn_o, mn_l) { return false; };
    // morph 目标
    if !conv_morphs(cv, c1, &body, mesh, rep, mn_o, mn_l, vcount) { return false; };
    // indices 行
    if has_idx {
        let rn = sb_new();
        put_span(cv, &rn, mn_o, mn_l);
        sb_push_lit(&rn, "_idx", 4);
        let so = 0; let sl = 0;
        if (idx_acc_idx >= 0) && !idx_expanded {
            c1_acc_section(cv, c1, idx_acc_idx, rn.data as ptr, rn.len, idx_bytes.data as ptr, idx_bytes.len, &so, &sl);
        } else {
            c1_add_section(cv, c1, rn.data as ptr, rn.len, idx_bytes.data as ptr, idx_bytes.len, &so, &sl);
        };
        sb_push_lit(&body, "  indices ", 10);
        put_span(cv, &body, idx_elem_o, idx_elem_l);
        sb_push_lit(&body, " @ ", 3);
        put_span(cv, &body, so, sl);
        sb_push_lit(&body, " count ", 7);
        sb_push_i64(&body, idx_count);
        sb_push_lit(&body, ";\n", 2);
    };
    // primitives（组内成员）
    if !conv_group_prims(cv, c1, &body, prims_v, nprim, grp_of, gi, has_skin, has_uv) { return false; };
    sb_push_lit(&body, "}\n", 2);
    sb_push_span(&c1.txt_mesh, body.data as ptr, body.len);
    c1.mg_names_off.push(mn_o);
    c1.mg_names_len.push(mn_l);
    c1.mg_skin.push(if has_skin { 1 } else { 0 });
    c1.mg_uv.push(if has_uv { 1 } else { 0 });
    return true;
}

// JOINTS_0 / WEIGHTS_0 通道（want_elem 为目标元素名）。
fn conv_jw(cv: &CV, c1: &C1, body: &SBuf, attrs: i32, mn_o: i32, mn_l: i32, vcount: i64, key: ptr, klen: u64, role: ptr, rlen: u64, want: ptr, wlen: u64, elem: ptr, elen: u64, has_skin: &bool) -> bool {
    let av = jg(cv, attrs, key, klen);
    if av < 0 { return true; };
    let pres = false;
    let ai = j_int(&cv.jd, av, &pres);
    if !pres {
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " not int", 8);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem_sz = 0;
    if !acc_info(cv, ai, &comp, &to, &tl, &count, &norm, &elem_sz) {
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " malformed", 10);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    if count != vcount {
        sb_push_lit(&cv.x.msg, "mesh '", 6);
        put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
        sb_push_lit(&cv.x.msg, "': ", 3);
        sb_push_span(&cv.x.msg, key, klen);
        sb_push_lit(&cv.x.msg, " count mismatch", 15);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let bytes = sb_new();
    let ce_o = 0; let ce_l = 0;
    if !conv_channel_bytes(cv, ai, want, wlen, &bytes, &ce_o, &ce_l) { return false; };
    if ce_l > 0 {
        if !cv_str_eq(cv, ce_o, ce_l, elem, elen) {
            sb_push_lit(&cv.x.msg, "mesh '", 6);
            put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
            sb_push_lit(&cv.x.msg, "': ", 3);
            sb_push_span(&cv.x.msg, key, klen);
            sb_push_lit(&cv.x.msg, " element ", 9);
            put_span_s(&cv.strs, &cv.x.msg, ce_o, ce_l);
            sb_push_lit(&cv.x.msg, " unsupported", 12);
            return cv_fail(cv, "CvtUnsupportedElemType", 22);
        };
    } else {
        let en_o = 0; let en_l = 0;
        if !elem_name_for(cv, comp, sx_ptr_add(cv.jd.strs.data as ptr, to as u64), tl as u64, ai, &en_o, &en_l) { return false; };
        if !cv_str_eq(cv, en_o, en_l, elem, elen) {
            sb_push_lit(&cv.x.msg, "mesh '", 6);
            put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
            sb_push_lit(&cv.x.msg, "': ", 3);
            sb_push_span(&cv.x.msg, key, klen);
            sb_push_lit(&cv.x.msg, " element ", 9);
            put_span_s(&cv.strs, &cv.x.msg, en_o, en_l);
            sb_push_lit(&cv.x.msg, " unsupported (need ", 19);
            sb_push_span(&cv.x.msg, elem, elen);
            sb_push_byte(&cv.x.msg, 41u8);
            return cv_fail(cv, "CvtUnsupportedElemType", 22);
        };
    };
    let rn = sb_new();
    put_span(cv, &rn, mn_o, mn_l);
    sb_push_byte(&rn, 95u8);
    sb_push_span(&rn, role, rlen);
    let so = 0; let sl = 0;
    c1_acc_section(cv, c1, ai, rn.data as ptr, rn.len, bytes.data as ptr, bytes.len, &so, &sl);
    sb_push_lit(body, "  channel ", 10);
    sb_push_span(body, role, rlen);
    sb_push_lit(body, " : ", 3);
    sb_push_span(body, elem, elen);
    sb_push_lit(body, " @ ", 3);
    put_span(cv, body, so, sl);
    sb_push_lit(body, ";\n", 2);
    if sx_spans_eq(role, rlen, "joints0", 7) { *has_skin = true; };
    return true;
}

// 自定义属性（源序迭代 attributes）。
fn conv_custom_attrs(cv: &CV, c1: &C1, body: &SBuf, attrs: i32, mn_o: i32, mn_l: i32) -> bool {
    let ko: Vec<i32> = Vec::new();
    let kl: Vec<i32> = Vec::new();
    let kv: Vec<i32> = Vec::new();
    obj_keys_raw(cv, attrs, &ko, &kl, &kv);
    let i = 0;
    let n = ko.len();
    while i < n {
        let kp = sx_ptr_add(cv.jd.strs.data as ptr, ko[i as usize] as u64);
        let kn = kl[i as usize] as u64;
        if !is_canon_attr(kp, kn) {
            if sx_starts_with(kp, kn, "TEXCOORD_", 9) {
                sb_push_lit(&cv.x.msg, "mesh '", 6);
                put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                sb_push_lit(&cv.x.msg, "': ", 3);
                sb_push_span(&cv.x.msg, kp, kn);
                sb_push_lit(&cv.x.msg, " exceeds uv0..uv3", 17);
                return cv_fail(cv, "CvtUnsupportedElemType", 22);
            };
            if !sx_starts_with(kp, kn, "_", 1) {
                sb_push_lit(&cv.x.msg, "mesh '", 6);
                put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                sb_push_lit(&cv.x.msg, "': attribute '", 14);
                sb_push_span(&cv.x.msg, kp, kn);
                sb_push_lit(&cv.x.msg, "' is neither standard nor _-prefixed custom", 43);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let pres = false;
            let ai = j_int(&cv.jd, kv[i as usize], &pres);
            if !pres {
                return cv_fail_lit(cv, "CvtBadInput", 11, "custom attr not int", 19);
            };
            let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem_sz = 0;
            if !acc_info(cv, ai, &comp, &to, &tl, &count, &norm, &elem_sz) {
                return cv_fail_lit(cv, "CvtBadInput", 11, "custom attr malformed", 21);
            };
            let en_o = 0; let en_l = 0;
            if !elem_name_for(cv, comp, sx_ptr_add(cv.jd.strs.data as ptr, to as u64), tl as u64, ai, &en_o, &en_l) { return false; };
            let bytes = sb_new();
            if !acc_bytes(cv, ai, &bytes) { return false; };
            let rn = sb_new();
            put_span(cv, &rn, mn_o, mn_l);
            sb_push_lit(&rn, "_attr_", 6);
            sb_push_span(&rn, sx_ptr_add(kp, 1), kn - 1);
            let so = 0; let sl = 0;
            c1_acc_section(cv, c1, ai, rn.data as ptr, rn.len, bytes.data as ptr, bytes.len, &so, &sl);
            sb_push_lit(body, "  attr ", 7);
            sb_push_span(body, sx_ptr_add(kp, 1), kn - 1);
            sb_push_lit(body, " : ", 3);
            put_span(cv, body, en_o, en_l);
            sb_push_lit(body, " @ ", 3);
            put_span(cv, body, so, sl);
            sb_push_lit(body, ";\n", 2);
        };
        i = i + 1;
    }
    return true;
}

// morph 目标（rep.targets；名字源 mesh.extras.targetNames）。
fn conv_morphs(cv: &CV, c1: &C1, body: &SBuf, mesh: i32, rep: i32, mn_o: i32, mn_l: i32, vcount: i64) -> bool {
    let tg = jg(cv, rep, "targets", 7);
    if j_kind(&cv.jd, tg) != 5 { return true; };
    let tn = j_arr_len(&cv.jd, tg);
    let mpool = lp_new();
    let tnames = -1;
    let ex = jg(cv, mesh, "extras", 6);
    if ex >= 0 {
        let t2 = jg(cv, ex, "targetNames", 11);
        if j_kind(&cv.jd, t2) == 5 { tnames = t2; };
    };
    let ti = 0;
    while ti < tn {
        let td = j_arr_at(&cv.jd, tg, ti);
        let nv2 = -1;
        if tnames >= 0 {
            let nv = j_arr_at(&cv.jd, tnames, ti);
            if j_kind(&cv.jd, nv) == 4 {
                nv2 = nv;
            };
        };
        let mo = 0; let ml = 0;
        if nv2 >= 0 {
            np_claim_l(cv, &mpool, true, sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[nv2 as usize] as u64), cv.jd.slen[nv2 as usize] as u64, "morph", 5, ti as i64, &mo, &ml);
        } else {
            np_claim_l(cv, &mpool, false, "", 0, "morph", 5, ti as i64, &mo, &ml);
        };
        sb_push_lit(body, "  morph ", 8);
        put_span(cv, body, mo, ml);
        sb_push_lit(body, " {\n", 3);
        if j_kind(&cv.jd, td) == 6 {
            let ko: Vec<i32> = Vec::new();
            let kl: Vec<i32> = Vec::new();
            let kv: Vec<i32> = Vec::new();
            obj_keys_raw(cv, td, &ko, &kl, &kv);
            let ei = 0;
            let en = ko.len();
            while ei < en {
                let kp = sx_ptr_add(cv.jd.strs.data as ptr, ko[ei as usize] as u64);
                let kn = kl[ei as usize] as u64;
                let role = -1;
                if sx_spans_eq(kp, kn, "POSITION", 8) { role = 0; }
                else if sx_spans_eq(kp, kn, "NORMAL", 6) { role = 1; }
                else if sx_spans_eq(kp, kn, "TANGENT", 7) { role = 2; }
                else {
                    sb_push_lit(&cv.x.msg, "mesh '", 6);
                    put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                    sb_push_lit(&cv.x.msg, "': morph target attribute '", 27);
                    sb_push_span(&cv.x.msg, kp, kn);
                    sb_push_lit(&cv.x.msg, "' unsupported", 13);
                    return cv_fail(cv, "CvtUnsupportedElemType", 22);
                };
                let pres = false;
                let ai = j_int(&cv.jd, kv[ei as usize], &pres);
                if !pres {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "morph attr not int", 18);
                };
                let comp = 0; let to = 0; let tl = 0; let count = 0; let norm = false; let elem_sz = 0;
                if !acc_info(cv, ai, &comp, &to, &tl, &count, &norm, &elem_sz) {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "morph attr malformed", 20);
                };
                if count != vcount {
                    sb_push_lit(&cv.x.msg, "mesh '", 6);
                    put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                    sb_push_lit(&cv.x.msg, "': morph count mismatch", 23);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                let en_o = 0; let en_l = 0;
                if !elem_name_for(cv, comp, sx_ptr_add(cv.jd.strs.data as ptr, to as u64), tl as u64, ai, &en_o, &en_l) { return false; };
                let elem_ok = false;
                if role == 2 { elem_ok = cv_str_eq(cv, en_o, en_l, "f32x4", 5); } else { elem_ok = cv_str_eq(cv, en_o, en_l, "f32x3", 5); };
                if !elem_ok {
                    sb_push_lit(&cv.x.msg, "mesh '", 6);
                    put_span_s(&cv.strs, &cv.x.msg, mn_o, mn_l);
                    sb_push_lit(&cv.x.msg, "': morph ", 9);
                    if role == 0 { sb_push_span(&cv.x.msg, "position", 8); } else if role == 1 { sb_push_span(&cv.x.msg, "normal", 6); } else { sb_push_span(&cv.x.msg, "tangent", 7); };
                    sb_push_lit(&cv.x.msg, " element ", 9);
                    put_span_s(&cv.strs, &cv.x.msg, en_o, en_l);
                    sb_push_lit(&cv.x.msg, " unsupported", 12);
                    return cv_fail(cv, "CvtUnsupportedElemType", 22);
                };
                let bytes = sb_new();
                if !acc_bytes(cv, ai, &bytes) { return false; };
                let rn = sb_new();
                put_span(cv, &rn, mn_o, mn_l);
                sb_push_lit(&rn, "_morph_", 7);
                put_span(cv, &rn, mo, ml);
                sb_push_byte(&rn, 95u8);
                if role == 0 { sb_push_span(&rn, "position", 8); } else if role == 1 { sb_push_span(&rn, "normal", 6); } else { sb_push_span(&rn, "tangent", 7); };
                let so = 0; let sl = 0;
                c1_acc_section(cv, c1, ai, rn.data as ptr, rn.len, bytes.data as ptr, bytes.len, &so, &sl);
                sb_push_lit(body, "    channel ", 12);
                if role == 0 { sb_push_span(body, "position", 8); } else if role == 1 { sb_push_span(body, "normal", 6); } else { sb_push_span(body, "tangent", 7); };
                sb_push_lit(body, " : ", 3);
                put_span(cv, body, en_o, en_l);
                sb_push_lit(body, " @ ", 3);
                put_span(cv, body, so, sl);
                sb_push_lit(body, ";\n", 2);
                ei = ei + 1;
            }
        };
        sb_push_lit(body, "  }\n", 4);
        ti = ti + 1;
    }
    return true;
}

// 组内 primitives 发射（含材质变体）。
fn conv_group_prims(cv: &CV, c1: &C1, body: &SBuf, prims_v: i32, nprim: i32, grp_of: &Vec<i32>, gi: i32, has_skin: bool, has_uv: bool) -> bool {
    let ppool = lp_new();
    let scan = 0;
    while scan < nprim {
        if grp_of[scan as usize] == gi {
            let p = j_arr_at(&cv.jd, prims_v, scan);
            let pn_o = 0; let pn_l = 0;
            np_claim_l(cv, &ppool, false, "", 0, "primitive", 9, scan as i64, &pn_o, &pn_l);
            let pres = false;
            let mat_idx = jg_int(cv, p, "material", 8, &pres);
            let midx = if pres { mat_idx } else { -1 };
            let tex = mat_has_base_tex(cv, midx);
            let sh_o = 0; let sh_l = 0;
            shader_name_for(cv, has_skin, tex, has_uv, &sh_o, &sh_l);
            if !su_has(cv, c1, sh_o, sh_l) { su_add(c1, sh_o, sh_l); };
            let vkey = sb_new();
            sb_push_i64(&vkey, midx);
            sb_push_byte(&vkey, 124u8);
            sb_push_byte(&vkey, if has_skin { 49u8 } else { 48u8 });
            sb_push_byte(&vkey, if tex { 49u8 } else { 48u8 });
            sb_push_byte(&vkey, if has_uv { 49u8 } else { 48u8 });
            let vn_o = 0; let vn_l = 0;
            if mv_get(c1, vkey.data as ptr, vkey.len, &vn_o, &vn_l) {
                // 命中既有变体
            } else {
                if midx >= 0 {
                    let mats = jg(cv, cv.root, "materials", 9);
                    let mm = j_arr_at(&cv.jd, mats, midx as i32);
                    let name_v = jg(cv, mm, "name", 4);
                    if j_kind(&cv.jd, name_v) == 4 {
                        np_claim_jname(cv, c1, 1, name_v, "material", 8, midx, &vn_o, &vn_l);
                    } else {
                        np_claim(cv, c1, 1, true, "DefaultMaterial", 15, "material", 8, midx, &vn_o, &vn_l);
                    };
                } else {
                    np_claim(cv, c1, 1, true, "DefaultMaterial", 15, "material", 8, 0, &vn_o, &vn_l);
                };
                let m = sb_new();
                sb_push_lit(&m, "material '", 10);
                put_span(cv, &m, vn_o, vn_l);
                sb_push_lit(&m, "' bound to shader '", 19);
                put_span(cv, &m, sh_o, sh_l);
                sb_push_lit(&m, "' (glTF has no shader concept; map §2 standard-PBR binding)", 60);
                cv_led(cv, "SYNTH", 5, &m);
                if !emit_mat_variant(cv, c1, midx, vn_o, vn_l, sh_o, sh_l) { return false; };
                mv_put(c1, vkey.data as ptr, vkey.len, vn_o, vn_l);
            };
            sb_push_lit(body, "  primitive ", 12);
            put_span(cv, body, pn_o, pn_l);
            sb_push_lit(body, " { material: ", 13);
            put_span(cv, body, vn_o, vn_l);
            sb_push_lit(body, "; }\n", 4);
        };
        scan = scan + 1;
    }
    return true;
}

// ---------------- to-sax3d: 骨骼 ----------------

fn conv_skins(cv: &CV, c1: &C1) -> bool {
    let skins = jg(cv, cv.root, "skins", 5);
    let nsk = j_arr_len(&cv.jd, skins);
    let si = 0;
    while si < nsk {
        let sk = j_arr_at(&cv.jd, skins, si);
        let nm_o = 0; let nm_l = 0;
        np_claim_jname(cv, c1, 5, jg(cv, sk, "name", 4), "skeleton", 8, si as i64, &nm_o, &nm_l);
        let joints = jg(cv, sk, "joints", 6);
        if j_kind(&cv.jd, joints) != 5 {
            sb_push_lit(&cv.x.msg, "skin ", 5);
            sb_push_i64(&cv.x.msg, si as i64);
            sb_push_lit(&cv.x.msg, " lacks joints", 13);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let nj = j_arr_len(&cv.jd, joints);
        let ib_bytes = sb_new();
        let has_ib = false;
        let ib_acc = -1;
        let ivv = jg(cv, sk, "inverseBindMatrices", 19);
        if ivv >= 0 {
            let pres = false;
            let ia = j_int(&cv.jd, ivv, &pres);
            if !pres {
                return cv_fail_lit(cv, "CvtBadInput", 11, "inverseBindMatrices not int", 27);
            };
            ib_acc = ia;
            if !acc_bytes(cv, ia, &ib_bytes) { return false; };
            has_ib = true;
        } else {
            let total = nj * 64;
            let z = 0;
            while z < total {
                sb_push_byte(&ib_bytes, 0u8);
                z = z + 1;
            }
            let j2 = 0;
            while j2 < nj {
                let offs: [i32; 4] = [0, 20, 40, 60];
                let oi = 0;
                while oi < 4 {
                    let at = (j2 * 64 + offs[oi as usize]) as u64;
                    // 写 f32 1.0 的 LE 字节（0x3F800000）
                    let cell = sb_new();
                    sb_push_span(&cell, ib_bytes.data as ptr, ib_bytes.len);
                    sx_wr_u32(&cell, at, 1065353216u32);
                    sb_clear(&ib_bytes);
                    sb_push_span(&ib_bytes, cell.data as ptr, cell.len);
                    oi = oi + 1;
                }
                j2 = j2 + 1;
            }
            let m = sb_new();
            sb_push_lit(&m, "skeleton '", 10);
            put_span(cv, &m, nm_o, nm_l);
            sb_push_lit(&m, "': inverseBindMatrices absent; identity matrices synthesised (= glTF default semantics)", 87);
            cv_led(cv, "SYNTH", 5, &m);
        };
        let skv = jg(cv, sk, "skeleton", 8);
        if skv >= 0 {
            let pres2 = false;
            let root_hint = j_int(&cv.jd, skv, &pres2);
            let m = sb_new();
            sb_push_lit(&m, "skeleton '", 10);
            put_span(cv, &m, nm_o, nm_l);
            sb_push_lit(&m, "': skin.skeleton root hint (node ", 33);
            sb_push_i64(&m, if pres2 { root_hint } else { -1 });
            sb_push_lit(&m, ") dropped — optimisation hint only, no semantics", 50);
            cv_led(cv, "LOSS", 4, &m);
        };
        let rn = sb_new();
        put_span(cv, &rn, nm_o, nm_l);
        sb_push_lit(&rn, "_ib", 3);
        let so = 0; let sl = 0;
        if has_ib {
            c1_acc_section(cv, c1, ib_acc, rn.data as ptr, rn.len, ib_bytes.data as ptr, ib_bytes.len, &so, &sl);
        } else {
            c1_add_section(cv, c1, rn.data as ptr, rn.len, ib_bytes.data as ptr, ib_bytes.len, &so, &sl);
        };
        sb_push_lit(&c1.txt_skel, "skeleton ", 9);
        put_span(cv, &c1.txt_skel, nm_o, nm_l);
        sb_push_lit(&c1.txt_skel, " {\n", 3);
        let ji2 = 0;
        while ji2 < nj {
            let pres3 = false;
            let jn = j_int(&cv.jd, j_arr_at(&cv.jd, joints, ji2), &pres3);
            if !pres3 {
                return cv_fail_lit(cv, "CvtBadInput", 11, "joint not int", 13);
            };
            // 父关节：沿 node_parent 上溯到首个同 skin 关节（递归形：while 头变量不得由索引读更新，GAP-PORT-9）
            let pn_o = 0; let pn_l = 0;
            let has_pn = joint_parent_span(c1, cv, joints, c1.node_parent[jn as usize], &pn_o, &pn_l);
            sb_push_lit(&c1.txt_skel, "  joint ", 8);
            put_span(cv, &c1.txt_skel, c1.node_name_off[jn as usize], c1.node_name_len[jn as usize]);
            sb_push_lit(&c1.txt_skel, " { parent: ", 11);
            if has_pn {
                put_span(cv, &c1.txt_skel, pn_o, pn_l);
            } else {
                sb_push_lit(&c1.txt_skel, "none", 4);
            };
            sb_push_lit(&c1.txt_skel, "; }\n", 4);
            ji2 = ji2 + 1;
        }
        sb_push_lit(&c1.txt_skel, "  inverse_bind @ ", 17);
        put_span(cv, &c1.txt_skel, so, sl);
        sb_push_lit(&c1.txt_skel, ";\n}\n", 4);
        c1.skin_names_off.push(nm_o);
        c1.skin_names_len.push(nm_l);
        si = si + 1;
    }
    return true;
}

fn joint_parent_span(c1: &C1, cv: &CV, joints: i32, cur: i32, o_out: &i32, l_out: &i32) -> bool {
    if cur < 0 { return false; };
    if joint_in(joints, cv, cur) {
        *o_out = c1.node_name_off[cur as usize];
        *l_out = c1.node_name_len[cur as usize];
        return true;
    };
    return joint_parent_span(c1, cv, joints, c1.node_parent[cur as usize], o_out, l_out);
}

fn joint_in(joints: i32, cv: &CV, node_idx: i64) -> bool {
    let n = j_arr_len(&cv.jd, joints);
    let i = 0;
    while i < n {
        let pres = false;
        let v = j_int(&cv.jd, j_arr_at(&cv.jd, joints, i), &pres);
        if pres && (v == node_idx) { return true; };
        i = i + 1;
    }
    return false;
}

// ---------------- to-sax3d: 场景 ----------------

fn build_parents(cv: &CV, c1: &C1, ni: i32) {
    let nodes = jg(cv, cv.root, "nodes", 5);
    let nd = j_arr_at(&cv.jd, nodes, ni);
    if nd < 0 { return; };
    let ch = jg(cv, nd, "children", 8);
    if j_kind(&cv.jd, ch) == 5 {
        let n = j_arr_len(&cv.jd, ch);
        let i = 0;
        while i < n {
            let pres = false;
            let ci = j_int(&cv.jd, j_arr_at(&cv.jd, ch, i), &pres);
            if pres {
                c1.node_parent[ci as usize] = ni;
                build_parents(cv, c1, ci as i32);
            };
            i = i + 1;
        }
    };
}

fn emit_node_c(cv: &CV, c1: &C1, buf: &SBuf, ni: i32, depth: i32) -> bool {
    let nodes = jg(cv, cv.root, "nodes", 5);
    let nd = j_arr_at(&cv.jd, nodes, ni);
    if nd < 0 {
        sb_push_lit(&cv.x.msg, "node ", 5);
        sb_push_i64(&cv.x.msg, ni as i64);
        sb_push_lit(&cv.x.msg, " missing", 8);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let nm_o = c1.node_name_off[ni as usize];
    let nm_l = c1.node_name_len[ni as usize];
    if jg(cv, nd, "camera", 6) >= 0 {
        sb_push_lit(&cv.x.msg, "node '", 6);
        put_span_s(&cv.strs, &cv.x.msg, nm_o, nm_l);
        sb_push_lit(&cv.x.msg, "' carries a camera (F-7 core-only scope)", 40);
        return cv_fail(cv, "CvtUnsupportedNodeFeature", 25);
    };
    let wv = jg(cv, nd, "weights", 7);
    if j_kind(&cv.jd, wv) == 5 {
        let wn = j_arr_len(&cv.jd, wv);
        let wi = 0;
        while wi < wn {
            let pres = false;
            let v = j_float(&cv.jd, j_arr_at(&cv.jd, wv, wi), &pres);
            if (if pres { v } else { 0.0 }) != 0.0 {
                sb_push_lit(&cv.x.msg, "node '", 6);
                put_span_s(&cv.strs, &cv.x.msg, nm_o, nm_l);
                sb_push_lit(&cv.x.msg, "' has nonzero morph weights (no SAX3D counterpart)", 50);
                return cv_fail(cv, "CvtUnsupportedNodeFeature", 25);
            };
            wi = wi + 1;
        }
    };
    let ind = sb_new();
    let sp = 0;
    while sp < depth * 2 {
        sb_push_byte(&ind, 32u8);
        sp = sp + 1;
    }
    sb_push_span(buf, ind.data as ptr, ind.len);
    sb_push_lit(buf, "node ", 5);
    put_span(cv, buf, nm_o, nm_l);
    sb_push_lit(buf, " {\n", 3);
    let mv = jg(cv, nd, "matrix", 6);
    if j_kind(&cv.jd, mv) == 5 {
        if j_arr_len(&cv.jd, mv) == 16 {
            sb_push_span(buf, ind.data as ptr, ind.len);
            sb_push_lit(buf, "  matrix: ", 10);
            let okv = cv_jvec(cv, buf, mv, 16);
            sb_push_lit(buf, ";\n", 2);
        };
    } else if (jg(cv, nd, "translation", 11) >= 0) || (jg(cv, nd, "rotation", 8) >= 0) || (jg(cv, nd, "scale", 5) >= 0) {
        sb_push_span(buf, ind.data as ptr, ind.len);
        sb_push_lit(buf, "  transform {", 13);
        let tv = jg(cv, nd, "translation", 11);
        if j_kind(&cv.jd, tv) == 5 {
            sb_push_lit(buf, " t: ", 4);
            let ok1 = cv_jvec(cv, buf, tv, 3);
            sb_push_byte(buf, 59u8);
        };
        let rv = jg(cv, nd, "rotation", 8);
        if j_kind(&cv.jd, rv) == 5 {
            sb_push_lit(buf, " r: ", 4);
            let ok2 = cv_jvec(cv, buf, rv, 4);
            sb_push_byte(buf, 59u8);
        };
        let sv = jg(cv, nd, "scale", 5);
        if j_kind(&cv.jd, sv) == 5 {
            sb_push_lit(buf, " s: ", 4);
            let ok3 = cv_jvec(cv, buf, sv, 3);
            sb_push_byte(buf, 59u8);
        };
        sb_push_lit(buf, " }\n", 3);
    };
    let mesh_v = jg(cv, nd, "mesh", 4);
    if mesh_v >= 0 {
        let pres2 = false;
        let mix = j_int(&cv.jd, mesh_v, &pres2);
        if !pres2 {
            return cv_fail_lit(cv, "CvtBadInput", 11, "node mesh not int", 17);
        };
        let gbase = c1.mg_off[mix as usize];
        sb_push_span(buf, ind.data as ptr, ind.len);
        sb_push_lit(buf, "  mesh: ", 8);
        put_span(cv, buf, c1.mg_names_off[gbase as usize], c1.mg_names_len[gbase as usize]);
        sb_push_lit(buf, ";\n", 2);
        let skin_v = jg(cv, nd, "skin", 4);
        if skin_v >= 0 {
            let skx = j_int(&cv.jd, skin_v, &pres2);
            if !pres2 {
                return cv_fail_lit(cv, "CvtBadInput", 11, "node skin not int", 17);
            };
            sb_push_span(buf, ind.data as ptr, ind.len);
            sb_push_lit(buf, "  skin: ", 8);
            put_span(cv, buf, c1.skin_names_off[skx as usize], c1.skin_names_len[skx as usize]);
            sb_push_lit(buf, ";\n", 2);
        };
        let glen = c1.mg_len[mix as usize];
        if glen > 1 {
            let k = 1;
            while k < glen {
                let gn_o = c1.mg_names_off[(gbase + k) as usize];
                let gn_l = c1.mg_names_len[(gbase + k) as usize];
                let raw = sb_new();
                put_span(cv, &raw, nm_o, nm_l);
                sb_push_lit(&raw, "__part", 6);
                sb_push_i64(&raw, k as i64);
                let pn_o = 0; let pn_l = 0;
                np_claim(cv, c1, 2, true, raw.data as ptr, raw.len, "node", 4, ni as i64, &pn_o, &pn_l);
                sb_push_span(buf, ind.data as ptr, ind.len);
                sb_push_lit(buf, "  node ", 7);
                put_span(cv, buf, pn_o, pn_l);
                sb_push_lit(buf, " { mesh: ", 9);
                put_span(cv, buf, gn_o, gn_l);
                sb_push_lit(buf, "; }\n", 4);
                let m = sb_new();
                sb_push_lit(&m, "node '", 6);
                put_span(cv, &m, nm_o, nm_l);
                sb_push_lit(&m, "': split-mesh group '", 21);
                put_span(cv, &m, gn_o, gn_l);
                sb_push_lit(&m, "' bound via synthesised child node '", 36);
                put_span(cv, &m, pn_o, pn_l);
                sb_push_byte(&m, 39u8);
                cv_led(cv, "APPROX", 6, &m);
                k = k + 1;
            }
        };
    };
    let ch = jg(cv, nd, "children", 8);
    if j_kind(&cv.jd, ch) == 5 {
        let n = j_arr_len(&cv.jd, ch);
        let i = 0;
        while i < n {
            let pres3 = false;
            let ci = j_int(&cv.jd, j_arr_at(&cv.jd, ch, i), &pres3);
            if pres3 {
                if !emit_node_c(cv, c1, buf, ci as i32, depth + 1) { return false; };
            };
            i = i + 1;
        }
    };
    sb_push_span(buf, ind.data as ptr, ind.len);
    sb_push_lit(buf, "}\n", 2);
    return true;
}

fn conv_scenes(cv: &CV, c1: &C1) -> bool {
    let scenes = jg(cv, cv.root, "scenes", 6);
    let nsc = j_arr_len(&cv.jd, scenes);
    let si = 0;
    while si < nsc {
        let sc = j_arr_at(&cv.jd, scenes, si);
        let nm_o = 0; let nm_l = 0;
        np_claim_jname(cv, c1, 6, jg(cv, sc, "name", 4), "scene", 5, si as i64, &nm_o, &nm_l);
        sb_push_lit(&c1.txt_scene, "scene ", 6);
        put_span(cv, &c1.txt_scene, nm_o, nm_l);
        sb_push_lit(&c1.txt_scene, " {\n", 3);
        let ns = jg(cv, sc, "nodes", 5);
        if j_kind(&cv.jd, ns) == 5 {
            let n = j_arr_len(&cv.jd, ns);
            let i = 0;
            while i < n {
                let pres = false;
                let ni = j_int(&cv.jd, j_arr_at(&cv.jd, ns, i), &pres);
                if pres {
                    let ntmp = sb_new();
                    if !emit_node_c(cv, c1, &ntmp, ni as i32, 1) { return false; };
                    sb_push_span(&c1.txt_scene, ntmp.data as ptr, ntmp.len);
                };
                i = i + 1;
            }
        };
        sb_push_lit(&c1.txt_scene, "}\n", 2);
        si = si + 1;
    }
    return true;
}

// ---------------- to-sax3d: 动画 ----------------

fn conv_clips(cv: &CV, c1: &C1) -> bool {
    let anims = jg(cv, cv.root, "animations", 10);
    let na = j_arr_len(&cv.jd, anims);
    let ai = 0;
    while ai < na {
        let an = j_arr_at(&cv.jd, anims, ai);
        let nm_o = 0; let nm_l = 0;
        np_claim_jname(cv, c1, 7, jg(cv, an, "name", 4), "clip", 4, ai as i64, &nm_o, &nm_l);
        sb_push_lit(&c1.txt_clip, "clip ", 5);
        put_span(cv, &c1.txt_clip, nm_o, nm_l);
        sb_push_lit(&c1.txt_clip, " {\n", 3);
        let m = sb_new();
        sb_push_lit(&m, "clip '", 6);
        put_span(cv, &m, nm_o, nm_l);
        sb_push_lit(&m, "': sampler names synthesised S<a>_<s> (glTF samplers are unnamed)", 65);
        cv_led(cv, "SYNTH", 5, &m);
        let samplers = jg(cv, an, "samplers", 8);
        let sname_off: Vec<i32> = Vec::new();
        let sname_len: Vec<i32> = Vec::new();
        if j_kind(&cv.jd, samplers) == 5 {
            let ns = j_arr_len(&cv.jd, samplers);
            let sj = 0;
            while sj < ns {
                let sm = j_arr_at(&cv.jd, samplers, sj);
                let sn = sb_new();
                sb_push_byte(&sn, 83u8);
                sb_push_i64(&sn, ai as i64);
                sb_push_byte(&sn, 95u8);
                sb_push_i64(&sn, sj as i64);
                let so = 0; let sl = 0;
                cv_str(cv, sn.data as ptr, sn.len, &so, &sl);
                sname_off.push(so);
                sname_len.push(sl);
                let pres = false;
                let in_acc = jg_int(cv, sm, "input", 5, &pres);
                if !pres {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "anim sampler lacks input", 24);
                };
                let out_acc = jg_int(cv, sm, "output", 6, &pres);
                if !pres {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "anim sampler lacks output", 25);
                };
                let icomp = 0; let ito = 0; let itl = 0; let icount = 0; let inorm = false; let ielem = 0;
                if !acc_info(cv, in_acc, &icomp, &ito, &itl, &icount, &inorm, &ielem) {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "anim input malformed", 20);
                };
                let ocomp = 0; let oto = 0; let otl = 0; let ocount = 0; let onorm = false; let oelem = 0;
                if !acc_info(cv, out_acc, &ocomp, &oto, &otl, &ocount, &onorm, &oelem) {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "anim output malformed", 21);
                };
                if (icomp != 5126) || !sx_spans_eq(sx_ptr_add(cv.jd.strs.data as ptr, ito as u64), itl as u64, "SCALAR", 6) {
                    sb_push_lit(&cv.x.msg, "clip '", 6);
                    put_span_s(&cv.strs, &cv.x.msg, nm_o, nm_l);
                    sb_push_lit(&cv.x.msg, "': animation input must be f32 SCALAR", 37);
                    return cv_fail(cv, "CvtUnsupportedElemType", 22);
                };
                let oe_o = 0; let oe_l = 0;
                if (ocomp == 5126) && sx_spans_eq(sx_ptr_add(cv.jd.strs.data as ptr, oto as u64), otl as u64, "VEC3", 4) {
                    cv_str(cv, "f32x3", 5, &oe_o, &oe_l);
                } else if (ocomp == 5126) && sx_spans_eq(sx_ptr_add(cv.jd.strs.data as ptr, oto as u64), otl as u64, "VEC4", 4) {
                    cv_str(cv, "quat", 4, &oe_o, &oe_l);
                } else if (ocomp == 5126) && sx_spans_eq(sx_ptr_add(cv.jd.strs.data as ptr, oto as u64), otl as u64, "SCALAR", 6) {
                    cv_str(cv, "f32", 3, &oe_o, &oe_l);
                } else {
                    sb_push_lit(&cv.x.msg, "clip '", 6);
                    put_span_s(&cv.strs, &cv.x.msg, nm_o, nm_l);
                    sb_push_lit(&cv.x.msg, "': animation output type ", 25);
                    sb_push_span(&cv.x.msg, sx_ptr_add(cv.jd.strs.data as ptr, oto as u64), otl as u64);
                    sb_push_byte(&cv.x.msg, 47u8);
                    sb_push_i64(&cv.x.msg, ocomp);
                    sb_push_lit(&cv.x.msg, " unsupported", 12);
                    return cv_fail(cv, "CvtUnsupportedElemType", 22);
                };
                let in_bytes = sb_new();
                if !acc_bytes(cv, in_acc, &in_bytes) { return false; };
                let rn1 = sb_new();
                put_span(cv, &rn1, nm_o, nm_l);
                sb_push_byte(&rn1, 95u8);
                put_span(cv, &rn1, so, sl);
                sb_push_lit(&rn1, "_in", 3);
                let iso = 0; let isl = 0;
                c1_acc_section(cv, c1, in_acc, rn1.data as ptr, rn1.len, in_bytes.data as ptr, in_bytes.len, &iso, &isl);
                let out_bytes = sb_new();
                if !acc_bytes(cv, out_acc, &out_bytes) { return false; };
                let rn2 = sb_new();
                put_span(cv, &rn2, nm_o, nm_l);
                sb_push_byte(&rn2, 95u8);
                put_span(cv, &rn2, so, sl);
                sb_push_lit(&rn2, "_out", 4);
                let oso = 0; let osl = 0;
                c1_acc_section(cv, c1, out_acc, rn2.data as ptr, rn2.len, out_bytes.data as ptr, out_bytes.len, &oso, &osl);
                let io_o = 0; let io_l = 0;
                let interp_v = jg(cv, sm, "interpolation", 13);
                if j_kind(&cv.jd, interp_v) == 4 {
                    if j_is_str_eq(&cv.jd, interp_v, "STEP", 4) { cv_str(cv, "step", 4, &io_o, &io_l); }
                    else if j_is_str_eq(&cv.jd, interp_v, "CUBICSPLINE", 11) { cv_str(cv, "cubic-spline", 12, &io_o, &io_l); }
                    else { cv_str(cv, "linear", 6, &io_o, &io_l); };
                } else {
                    cv_str(cv, "linear", 6, &io_o, &io_l);
                };
                sb_push_lit(&c1.txt_clip, "  sampler ", 10);
                put_span(cv, &c1.txt_clip, so, sl);
                sb_push_lit(&c1.txt_clip, " {\n    input: f32 @ ", 20);
                put_span(cv, &c1.txt_clip, iso, isl);
                sb_push_lit(&c1.txt_clip, " count ", 7);
                sb_push_i64(&c1.txt_clip, icount);
                sb_push_lit(&c1.txt_clip, ";\n    output: ", 14);
                put_span(cv, &c1.txt_clip, oe_o, oe_l);
                sb_push_lit(&c1.txt_clip, " @ ", 3);
                put_span(cv, &c1.txt_clip, oso, osl);
                sb_push_lit(&c1.txt_clip, " count ", 7);
                sb_push_i64(&c1.txt_clip, ocount);
                sb_push_lit(&c1.txt_clip, ";\n    interpolation: ", 21);
                put_span(cv, &c1.txt_clip, io_o, io_l);
                sb_push_lit(&c1.txt_clip, ";\n  }\n", 6);
                sj = sj + 1;
            }
        };
        let channels = jg(cv, an, "channels", 8);
        if j_kind(&cv.jd, channels) == 5 {
            let nc = j_arr_len(&cv.jd, channels);
            let ci = 0;
            while ci < nc {
                let ch = j_arr_at(&cv.jd, channels, ci);
                let pres2 = false;
                let sm_idx = jg_int(cv, ch, "sampler", 7, &pres2);
                if !pres2 {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "channel lacks sampler", 21);
                };
                let tgt = jg(cv, ch, "target", 6);
                if tgt < 0 {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "channel lacks target", 20);
                };
                let tn = jg_int(cv, tgt, "node", 4, &pres2);
                if !pres2 {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "channel target lacks node", 25);
                };
                let path_v = jg(cv, tgt, "path", 4);
                if j_kind(&cv.jd, path_v) != 4 {
                    return cv_fail_lit(cv, "CvtBadInput", 11, "channel lacks path", 18);
                };
                let path_ok = j_is_str_eq(&cv.jd, path_v, "translation", 11) || j_is_str_eq(&cv.jd, path_v, "rotation", 8) || j_is_str_eq(&cv.jd, path_v, "scale", 5) || j_is_str_eq(&cv.jd, path_v, "weights", 7);
                if !path_ok {
                    sb_push_lit(&cv.x.msg, "channel path '", 14);
                    put_jspan_j(&cv.jd, &cv.x.msg, path_v);
                    sb_push_lit(&cv.x.msg, "' unknown", 9);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                sb_push_lit(&c1.txt_clip, "  channel { node: ", 18);
                put_span(cv, &c1.txt_clip, c1.node_name_off[tn as usize], c1.node_name_len[tn as usize]);
                sb_push_lit(&c1.txt_clip, "; path: ", 8);
                put_jspan(cv, &c1.txt_clip, path_v);
                sb_push_lit(&c1.txt_clip, "; sampler: ", 11);
                put_span(cv, &c1.txt_clip, sname_off[sm_idx as usize], sname_len[sm_idx as usize]);
                sb_push_lit(&c1.txt_clip, "; }\n", 4);
                ci = ci + 1;
            }
        };
        sb_push_lit(&c1.txt_clip, "}\n", 2);
        ai = ai + 1;
    }
    return true;
}

// ---------------- to-sax3d: 图像/纹理 ----------------

fn mime_to_format(p: ptr, n: u64, o_out: &i32, l_out: &i32, cv: &CV) -> bool {
    if sx_spans_eq(p, n, "image/png", 9) { cv_str(cv, "png", 3, o_out, l_out); return true; };
    if sx_spans_eq(p, n, "image/jpeg", 10) { cv_str(cv, "jpeg", 4, o_out, l_out); return true; };
    if sx_spans_eq(p, n, "image/ktx2", 10) { cv_str(cv, "ktx2", 4, o_out, l_out); return true; };
    return false;
}

fn ext_to_format(p: ptr, n: u64, o_out: &i32, l_out: &i32, cv: &CV) -> bool {
    if (n >= 4) && sx_spans_eq(sx_ptr_add(p, n - 4), 4, ".png", 4) { cv_str(cv, "png", 3, o_out, l_out); return true; };
    if (n >= 4) && sx_spans_eq(sx_ptr_add(p, n - 4), 4, ".jpg", 4) { cv_str(cv, "jpeg", 4, o_out, l_out); return true; };
    if (n >= 5) && sx_spans_eq(sx_ptr_add(p, n - 5), 5, ".jpeg", 5) { cv_str(cv, "jpeg", 4, o_out, l_out); return true; };
    if (n >= 5) && sx_spans_eq(sx_ptr_add(p, n - 5), 5, ".ktx2", 5) { cv_str(cv, "ktx2", 4, o_out, l_out); return true; };
    return false;
}

// 图像角色推断：遍历 materials 的槽位，img_role_o/l 按 image 下标记录 cs。
fn img_role_one(cv: &CV, m: i32, in_pbr: bool, key: ptr, klen: i64, cs: ptr, cslen: u64, role_o: &Vec<i32>, role_l: &Vec<i32>) {
    let holder = -1;
    if in_pbr {
        holder = jg(cv, m, "pbrMetallicRoughness", 20);
    } else {
        holder = m;
    };
    if holder < 0 { return; };
    let ti = jg(cv, holder, key, klen);
    if ti < 0 { return; };
    let pres = false;
    let tidx = jg_int(cv, ti, "index", 5, &pres);
    if !pres || (tidx < 0) { return; };
    let texs = jg(cv, cv.root, "textures", 8);
    let tex = j_arr_at(&cv.jd, texs, tidx as i32);
    if tex < 0 { return; };
    let sidx = jg_int(cv, tex, "source", 6, &pres);
    if !pres || (sidx < 0) || ((sidx as i32) >= role_o.len()) { return; };
    let co = 0; let cl = 0;
    cv_str(cv, cs, cslen, &co, &cl);
    role_o[sidx as usize] = co;
    role_l[sidx as usize] = cl;
}

fn compute_img_roles(cv: &CV, role_o: &Vec<i32>, role_l: &Vec<i32>) {
    let mats = jg(cv, cv.root, "materials", 9);
    let nm = j_arr_len(&cv.jd, mats);
    let mi = 0;
    while mi < nm {
        let m = j_arr_at(&cv.jd, mats, mi);
        img_role_one(cv, m, true, "baseColorTexture", 16, "srgb", 4, role_o, role_l);
        img_role_one(cv, m, false, "emissiveTexture", 15, "srgb", 4, role_o, role_l);
        img_role_one(cv, m, false, "normalTexture", 13, "linear", 6, role_o, role_l);
        img_role_one(cv, m, false, "occlusionTexture", 16, "linear", 6, role_o, role_l);
        img_role_one(cv, m, true, "metallicRoughnessTexture", 24, "linear", 6, role_o, role_l);
        mi = mi + 1;
    }
}

fn conv_images(cv: &CV, c1: &C1) -> bool {
    // 角色表（按 image 下标；l<0 = 无角色）
    let imgs0 = jg(cv, cv.root, "images", 6);
    let ni0 = j_arr_len(&cv.jd, imgs0);
    let role_o: Vec<i32> = Vec::new();
    let role_l: Vec<i32> = Vec::new();
    let z = 0;
    while z < ni0 {
        role_o.push(0);
        role_l.push(-1);
        z = z + 1;
    }
    compute_img_roles(cv, &role_o, &role_l);
    let imgs = imgs0;
    let ni = ni0;
    let i = 0;
    while i < ni {
        let im = j_arr_at(&cv.jd, imgs, i);
        let nm_o = 0; let nm_l = 0;
        np_claim_jname(cv, c1, 4, jg(cv, im, "name", 4), "image", 5, i as i64, &nm_o, &nm_l);
        let fmt_o = 0; let fmt_l = 0;
        cv_str(cv, "png", 3, &fmt_o, &fmt_l);
        let kind = 0; // 0 section, 1 path
        let ref_o = 0; let ref_l = 0;
        let bvv = jg(cv, im, "bufferView", 10);
        if bvv >= 0 {
            let pres = false;
            let bvi = j_int(&cv.jd, bvv, &pres);
            if !pres {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " bufferView not int", 19);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let bvs = jg(cv, cv.root, "bufferViews", 11);
            let bv = j_arr_at(&cv.jd, bvs, bvi as i32);
            if bv < 0 {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " bufferView ", 12);
                sb_push_i64(&cv.x.msg, bvi);
                sb_push_lit(&cv.x.msg, " missing", 8);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let pres2 = false;
            let buf_idx = jg_int(cv, bv, "buffer", 6, &pres2);
            let buf_i = if pres2 { buf_idx } else { 0 };
            let bo = jg_int(cv, bv, "byteOffset", 10, &pres2);
            let bo_v = if pres2 { bo } else { 0 };
            let bl = jg_int(cv, bv, "byteLength", 10, &pres2);
            if !pres2 {
                return cv_fail_lit(cv, "CvtBadInput", 11, "image bufferView lacks byteLength", 33);
            };
            if (buf_i < 0) || (buf_i >= cv.buf_off.len()) || ((bo_v + bl) > (cv.buf_len[buf_i as usize] as i64)) {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " bufferView overruns buffer", 27);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let rn = sb_new();
            put_span(cv, &rn, nm_o, nm_l);
            sb_push_lit(&rn, "_data", 5);
            c1_add_section(cv, c1, rn.data as ptr, rn.len, sx_ptr_add(cv.bufstore.data as ptr, (cv.buf_off[buf_i as usize] as i64 + bo_v) as u64), bl as u64, &ref_o, &ref_l);
            let mime_v = jg(cv, im, "mimeType", 8);
            if j_kind(&cv.jd, mime_v) != 4 {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " (bufferView) lacks mimeType", 28);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            if !mime_to_format(sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[mime_v as usize] as u64), cv.jd.slen[mime_v as usize] as u64, &fmt_o, &fmt_l, cv) {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " mimeType '", 11);
                put_jspan_j(&cv.jd, &cv.x.msg, mime_v);
                sb_push_lit(&cv.x.msg, "' unsupported", 13);
                return cv_fail(cv, "CvtBadInput", 11);
            };
        } else {
            let uv = jg(cv, im, "uri", 3);
            if j_kind(&cv.jd, uv) != 4 {
                sb_push_lit(&cv.x.msg, "image ", 6);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " has neither bufferView nor uri", 31);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let uo = 0; let ul = 0;
            let oku = jv_str(cv, uv, &uo, &ul);
            let up = sx_ptr_add(cv.strs.data as ptr, uo as u64);
            if sx_starts_with(up, ul as u64, "data:", 5) {
                let comma = sx_index_of_byte(up, ul as u64, 44u8);
                if comma < 0 {
                    sb_push_lit(&cv.x.msg, "image ", 6);
                    sb_push_i64(&cv.x.msg, i as i64);
                    sb_push_lit(&cv.x.msg, " data URI malformed", 19);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                let dec = sb_new();
                if !b64_decode(sx_ptr_add(up, (comma + 1) as u64), (ul as i64 - comma - 1) as u64, &dec) {
                    sb_push_lit(&cv.x.msg, "image ", 6);
                    sb_push_i64(&cv.x.msg, i as i64);
                    sb_push_lit(&cv.x.msg, " base64 bad", 11);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                let rn = sb_new();
                put_span(cv, &rn, nm_o, nm_l);
                sb_push_lit(&rn, "_data", 5);
                c1_add_section(cv, c1, rn.data as ptr, rn.len, dec.data as ptr, dec.len, &ref_o, &ref_l);
                let mime_v = jg(cv, im, "mimeType", 8);
                if j_kind(&cv.jd, mime_v) == 4 {
                    let f_o = 0; let f_l = 0;
                    if mime_to_format(sx_ptr_add(cv.jd.strs.data as ptr, cv.jd.soff[mime_v as usize] as u64), cv.jd.slen[mime_v as usize] as u64, &f_o, &f_l, cv) {
                        fmt_o = f_o; fmt_l = f_l;
                    };
                };
            } else {
                kind = 1;
                ref_o = uo; ref_l = ul;
                if !ext_to_format(up, ul as u64, &fmt_o, &fmt_l, cv) {
                    sb_push_lit(&cv.x.msg, "image ", 6);
                    sb_push_i64(&cv.x.msg, i as i64);
                    sb_push_lit(&cv.x.msg, " uri '", 6);
                    sb_push_span(&cv.x.msg, up, ul as u64);
                    sb_push_lit(&cv.x.msg, "': cannot determine format from extension", 41);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
            };
        };
        let cs_o = 0; let cs_l = 0;
        if role_l[i as usize] >= 0 {
            cs_o = role_o[i as usize];
            cs_l = role_l[i as usize];
        } else {
            let m = sb_new();
            sb_push_lit(&m, "image '", 7);
            put_span(cv, &m, nm_o, nm_l);
            sb_push_lit(&m, "': referenced by no material slot role; color_space inferred srgb (map §3)", 75);
            cv_led(cv, "APPROX", 6, &m);
            cv_str(cv, "srgb", 4, &cs_o, &cs_l);
        };
        sb_push_lit(&c1.txt_img, "image ", 6);
        put_span(cv, &c1.txt_img, nm_o, nm_l);
        sb_push_lit(&c1.txt_img, " {\n  source ", 12);
        if kind == 0 {
            sb_push_lit(&c1.txt_img, "@ ", 2);
            put_span(cv, &c1.txt_img, ref_o, ref_l);
        } else {
            sb_push_byte(&c1.txt_img, 34u8);
            put_span(cv, &c1.txt_img, ref_o, ref_l);
            sb_push_byte(&c1.txt_img, 34u8);
        };
        sb_push_lit(&c1.txt_img, ";\n  format ", 11);
        put_span(cv, &c1.txt_img, fmt_o, fmt_l);
        sb_push_lit(&c1.txt_img, ";\n  color_space ", 16);
        put_span(cv, &c1.txt_img, cs_o, cs_l);
        sb_push_lit(&c1.txt_img, ";\n}\n", 4);
        c1.img_names_off.push(nm_o);
        c1.img_names_len.push(nm_l);
        i = i + 1;
    }
    return true;
}

fn conv_textures(cv: &CV, c1: &C1) -> bool {
    let texs = jg(cv, cv.root, "textures", 8);
    let nt = j_arr_len(&cv.jd, texs);
    let i = 0;
    // 默认名 span（linear/repeat）
    let lin_o = 0; let lin_l = 0;
    cv_str(cv, "linear", 6, &lin_o, &lin_l);
    let rep_o = 0; let rep_l = 0;
    cv_str(cv, "repeat", 6, &rep_o, &rep_l);
    let nea_o = 0; let nea_l = 0;
    cv_str(cv, "nearest", 7, &nea_o, &nea_l);
    let non_o = 0; let non_l = 0;
    cv_str(cv, "none", 4, &non_o, &non_l);
    while i < nt {
        let tx = j_arr_at(&cv.jd, texs, i);
        let nm_o = 0; let nm_l = 0;
        np_claim_jname(cv, c1, 3, jg(cv, tx, "name", 4), "texture", 7, i as i64, &nm_o, &nm_l);
        let pres = false;
        let sidx = jg_int(cv, tx, "source", 6, &pres);
        if !pres {
            sb_push_lit(&cv.x.msg, "texture ", 8);
            sb_push_i64(&cv.x.msg, i as i64);
            sb_push_lit(&cv.x.msg, " lacks source", 13);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        if (sidx < 0) || (sidx >= c1.img_names_off.len()) {
            sb_push_lit(&cv.x.msg, "texture ", 8);
            sb_push_i64(&cv.x.msg, i as i64);
            sb_push_lit(&cv.x.msg, " source ", 8);
            sb_push_i64(&cv.x.msg, sidx);
            sb_push_lit(&cv.x.msg, " out of range", 13);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let mag_o = lin_o; let mag_l = lin_l;
        let min_o = lin_o; let min_l = lin_l;
        let mip_o = lin_o; let mip_l = lin_l;
        let wu_o = rep_o; let wu_l = rep_l;
        let wv_o = rep_o; let wv_l = rep_l;
        let sv = jg(cv, tx, "sampler", 7);
        if sv >= 0 {
            let sidx2 = j_int(&cv.jd, sv, &pres);
            if !pres {
                sb_push_lit(&cv.x.msg, "texture ", 8);
                sb_push_i64(&cv.x.msg, i as i64);
                sb_push_lit(&cv.x.msg, " sampler not int", 16);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let smps = jg(cv, cv.root, "samplers", 8);
            let smp = j_arr_at(&cv.jd, smps, sidx2 as i32);
            if smp < 0 {
                sb_push_lit(&cv.x.msg, "sampler ", 8);
                sb_push_i64(&cv.x.msg, sidx2);
                sb_push_lit(&cv.x.msg, " missing", 8);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let magv = jg_int(cv, smp, "magFilter", 9, &pres);
            if pres && (magv == 9728) { mag_o = nea_o; mag_l = nea_l; };
            let minf_v = jg_int(cv, smp, "minFilter", 9, &pres);
            let minf = if pres { minf_v } else { 9987 };
            if minf == 9728 { min_o = nea_o; min_l = nea_l; mip_o = non_o; mip_l = non_l; }
            else if minf == 9729 { min_o = lin_o; min_l = lin_l; mip_o = non_o; mip_l = non_l; }
            else if minf == 9984 { min_o = nea_o; min_l = nea_l; mip_o = nea_o; mip_l = nea_l; }
            else if minf == 9985 { min_o = nea_o; min_l = nea_l; mip_o = lin_o; mip_l = lin_l; }
            else if minf == 9986 { min_o = lin_o; min_l = lin_l; mip_o = nea_o; mip_l = nea_l; }
            else if minf == 9987 { min_o = lin_o; min_l = lin_l; mip_o = lin_o; mip_l = lin_l; }
            else {
                sb_push_lit(&cv.x.msg, "sampler minFilter ", 18);
                sb_push_i64(&cv.x.msg, minf);
                sb_push_lit(&cv.x.msg, " unknown", 8);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let wsv = jg_int(cv, smp, "wrapS", 5, &pres);
            wrap_name(pres, wsv, &wu_o, &wu_l, cv);
            let wtv = jg_int(cv, smp, "wrapT", 5, &pres);
            wrap_name(pres, wtv, &wv_o, &wv_l, cv);
        } else {
            let m = sb_new();
            sb_push_lit(&m, "texture '", 9);
            put_span(cv, &m, nm_o, nm_l);
            sb_push_lit(&m, "': no sampler in glTF; explicit sampler state = glTF defaults (linear/linear-mipmap-linear/repeat)", 98);
            cv_led(cv, "APPROX", 6, &m);
        };
        sb_push_lit(&c1.txt_tex, "texture ", 8);
        put_span(cv, &c1.txt_tex, nm_o, nm_l);
        sb_push_lit(&c1.txt_tex, " {\n  image: ", 12);
        put_span(cv, &c1.txt_tex, c1.img_names_off[sidx as usize], c1.img_names_len[sidx as usize]);
        sb_push_lit(&c1.txt_tex, ";\n  sampler { mag: ", 19);
        put_span(cv, &c1.txt_tex, mag_o, mag_l);
        sb_push_lit(&c1.txt_tex, "; min: ", 7);
        put_span(cv, &c1.txt_tex, min_o, min_l);
        sb_push_lit(&c1.txt_tex, "; mipmap: ", 10);
        put_span(cv, &c1.txt_tex, mip_o, mip_l);
        sb_push_lit(&c1.txt_tex, "; wrap_u: ", 10);
        put_span(cv, &c1.txt_tex, wu_o, wu_l);
        sb_push_lit(&c1.txt_tex, "; wrap_v: ", 10);
        put_span(cv, &c1.txt_tex, wv_o, wv_l);
        sb_push_lit(&c1.txt_tex, "; }\n}\n", 6);
        c1.tex_names_off.push(nm_o);
        c1.tex_names_len.push(nm_l);
        i = i + 1;
    }
    return true;
}

// ---------------- to-sax3d 主体 ----------------

fn to_sax3d(cv: &CV, in_p: ptr, in_n: u64, out_p: ptr, out_n: u64, fix_p: ptr, fix_n: u64) -> bool {
    if !load_gltf(cv, in_p, in_n) { return false; };
    let c1 = c1_new();
    // 节点名与父图（先行）
    let nodes = jg(cv, cv.root, "nodes", 5);
    let n_nodes = j_arr_len(&cv.jd, nodes);
    let ni = 0;
    while ni < n_nodes {
        let nd = j_arr_at(&cv.jd, nodes, ni);
        let no = 0; let nl = 0;
        np_claim_jname(cv, &c1, 2, jg(cv, nd, "name", 4), "node", 4, ni as i64, &no, &nl);
        c1.node_name_off.push(no);
        c1.node_name_len.push(nl);
        c1.node_parent.push(-1);
        ni = ni + 1;
    }
    let scenes0 = jg(cv, cv.root, "scenes", 6);
    let nsc = j_arr_len(&cv.jd, scenes0);
    let si = 0;
    while si < nsc {
        let sc = j_arr_at(&cv.jd, scenes0, si);
        let ns = jg(cv, sc, "nodes", 5);
        if j_kind(&cv.jd, ns) == 5 {
            let n = j_arr_len(&cv.jd, ns);
            let i = 0;
            while i < n {
                let pres = false;
                let ri = j_int(&cv.jd, j_arr_at(&cv.jd, ns, i), &pres);
                if pres { build_parents(cv, &c1, ri as i32); };
                i = i + 1;
            }
        };
        si = si + 1;
    }
    if !conv_images(cv, &c1) { return false; };
    if !conv_textures(cv, &c1) { return false; };
    if !conv_meshes(cv, &c1) { return false; };
    if !conv_skins(cv, &c1) { return false; };
    if !conv_scenes(cv, &c1) { return false; };
    if !conv_clips(cv, &c1) { return false; };
    // 组装文本
    let bi = sx_last_index_of_byte(in_p, in_n, 47u8);
    let stem_o = if bi >= 0 { bi + 1 } else { 0 };
    let stem_n = (in_n as i64) - stem_o;
    let di = sx_last_index_of_byte(sx_ptr_add(in_p, stem_o as u64), stem_n as u64, 46u8);
    let base_n = if di >= 0 { di } else { stem_n };
    let asset_pool = lp_new();
    let an_o = 0; let an_l = 0;
    np_claim_l(cv, &asset_pool, true, sx_ptr_add(in_p, stem_o as u64), base_n as u64, "asset", 5, 0, &an_o, &an_l);
    let text = sb_new();
    sb_push_lit(&text, "asset ", 6);
    put_span(cv, &text, an_o, an_l);
    sb_push_lit(&text, " version 1;\n\nbinary \"", 21);
    put_span(cv, &text, an_o, an_l);
    sb_push_lit(&text, ".saxb3d\" {\n", 11);
    let ns2 = c1.sec_off.len();
    let i2 = 0;
    while i2 < ns2 {
        sb_push_lit(&text, "    section ", 12);
        put_span(cv, &text, c1.sec_off[i2 as usize], c1.sec_len[i2 as usize]);
        sb_push_byte(&text, 32u8);
        sb_push_i64(&text, c1.sec_blen[i2 as usize] as i64);
        sb_push_lit(&text, ";\n", 2);
        i2 = i2 + 1;
    }
    sb_push_lit(&text, "}\n\n", 3);
    // shader 名排序（字节序）
    let sh_o: Vec<i32> = Vec::new();
    let sh_l: Vec<i32> = Vec::new();
    let i3 = 0;
    let nsh = c1.su_off.len();
    while i3 < nsh {
        sh_o.push(c1.su_off[i3 as usize]);
        sh_l.push(c1.su_len[i3 as usize]);
        i3 = i3 + 1;
    }
    let a = 1;
    while a < nsh {
        let b = a;
        let going = true;
        while going && (b > 0) {
            let o1 = sh_o[(b - 1) as usize]; let l1 = sh_l[(b - 1) as usize];
            let o2 = sh_o[b as usize]; let l2 = sh_l[b as usize];
            if span_cmp(sx_ptr_add(cv.strs.data as ptr, o1 as u64), l1 as u64, sx_ptr_add(cv.strs.data as ptr, o2 as u64), l2 as u64) > 0 {
                sh_o[(b - 1) as usize] = o2; sh_l[(b - 1) as usize] = l2;
                sh_o[b as usize] = o1; sh_l[b as usize] = l1;
            } else {
                going = false;
            };
            b = b - 1;
        }
        a = a + 1;
    }
    let i4 = 0;
    while i4 < nsh {
        sb_push_lit(&text, "shader ", 7);
        put_span(cv, &text, sh_o[i4 as usize], sh_l[i4 as usize]);
        sb_push_lit(&text, ": slasl \"", 9);
        let ff = sb_new();
        fixture_file_for(sx_ptr_add(cv.strs.data as ptr, sh_o[i4 as usize] as u64), sh_l[i4 as usize] as u64, &ff);
        sb_push_span(&text, ff.data as ptr, ff.len);
        sb_push_lit(&text, ".slasl\";\n", 9);
        i4 = i4 + 1;
    }
    if nsh > 0 { sb_push_byte(&text, 10u8); };
    sb_push_span(&text, c1.txt_mesh.data as ptr, c1.txt_mesh.len);
    sb_push_span(&text, c1.txt_skel.data as ptr, c1.txt_skel.len);
    sb_push_span(&text, c1.txt_img.data as ptr, c1.txt_img.len);
    sb_push_span(&text, c1.txt_tex.data as ptr, c1.txt_tex.len);
    sb_push_span(&text, c1.txt_mat.data as ptr, c1.txt_mat.len);
    sb_push_span(&text, c1.txt_scene.data as ptr, c1.txt_scene.len);
    sb_push_span(&text, c1.txt_clip.data as ptr, c1.txt_clip.len);
    // 内部裁判
    {
        let x2 = x_new();
        let i5 = 0;
        while i5 < nsh {
            let fp = sb_new();
            sb_push_span(&fp, fix_p, fix_n);
            sb_push_byte(&fp, 47u8);
            let ff = sb_new();
            fixture_file_for(sx_ptr_add(cv.strs.data as ptr, sh_o[i5 as usize] as u64), sh_l[i5 as usize] as u64, &ff);
            sb_push_span(&fp, ff.data as ptr, ff.len);
            sb_push_lit(&fp, ".iface.txt", 10);
            let fsrc = sb_new();
            let cell = malloc(8);
            let okf = sx_read_file(fp.data as ptr, fp.len, &fsrc, cell as ptr);
            free(cell);
            if !okf {
                sb_push_lit(&cv.x.msg, "fixture for shader '", 20);
                put_span_s(&cv.strs, &cv.x.msg, sh_o[i5 as usize], sh_l[i5 as usize]);
                sb_push_lit(&cv.x.msg, "' not found at '", 16);
                sb_push_span(&cv.x.msg, fp.data as ptr, fp.len);
                sb_push_byte(&cv.x.msg, 39u8);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let sh_off = x_intern(&x2, sx_ptr_add(cv.strs.data as ptr, sh_o[i5 as usize] as u64), sh_l[i5 as usize] as u64);
            let f_off = x_intern(&x2, fsrc.data as ptr, fsrc.len);
            iface_parse(&x2, f_off, fsrc.len, sh_off, sh_l[i5 as usize]);
            i5 = i5 + 1;
        }
        let t_off = x_intern(&x2, text.data as ptr, text.len);
        let p = p_new(0);
        parse_asset(&x2, &p, t_off, text.len as i32);
        if p.fail {
            diag_print_all(&x2);
            return cv_fail_lit(cv, "CvtInternalInvariant", 20, "converted asset text does not parse", 35);
        };
        check_asset(&x2);
        if diag_count(&x2) > 0 {
            diag_print_all(&x2);
            sb_push_lit(&cv.x.msg, "converted asset FAILED the SAX3D referee (", 42);
            sb_push_i64(&cv.x.msg, diag_count(&x2) as i64);
            sb_push_lit(&cv.x.msg, " diagnostics) — refusing to deliver", 37);
            return cv_fail(cv, "CvtInternalInvariant", 20);
        };
    }
    // 写出
    sx_mkdir_p(out_p, out_n);
    let payload_dir = sb_new();
    sb_push_span(&payload_dir, out_p, out_n);
    sb_push_lit(&payload_dir, "/payload", 8);
    sx_mkdir_p(payload_dir.data as ptr, payload_dir.len);
    let i6 = 0;
    while i6 < ns2 {
        let pth = sb_new();
        sb_push_span(&pth, payload_dir.data as ptr, payload_dir.len);
        sb_push_byte(&pth, 47u8);
        put_span(cv, &pth, c1.sec_off[i6 as usize], c1.sec_len[i6 as usize]);
        sb_push_lit(&pth, ".bin", 4);
        let rc = sx_write_file(pth.data as ptr, pth.len, sx_ptr_add(c1.secstore.data as ptr, c1.sec_boff[i6 as usize] as u64), c1.sec_blen[i6 as usize] as u64);
        if rc != 0 {
            sb_push_lit(&cv.x.msg, "cannot write payload '", 22);
            sb_push_span(&cv.x.msg, pth.data as ptr, pth.len);
            sb_push_lit(&cv.x.msg, "': ", 3);
            sx_io_err_name(rc as u64, &cv.x.msg);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        i6 = i6 + 1;
    }
    let text_path = sb_new();
    sb_push_span(&text_path, out_p, out_n);
    sb_push_byte(&text_path, 47u8);
    put_span(cv, &text_path, an_o, an_l);
    sb_push_lit(&text_path, ".sax3d", 6);
    let rc2 = sx_write_file(text_path.data as ptr, text_path.len, text.data as ptr, text.len);
    if rc2 != 0 {
        sb_push_lit(&cv.x.msg, "cannot write '", 14);
        sb_push_span(&cv.x.msg, text_path.data as ptr, text_path.len);
        sb_push_lit(&cv.x.msg, "': ", 3);
        sx_io_err_name(rc2 as u64, &cv.x.msg);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let w = sb_new();
    sb_push_lit(&w, "WROTE ", 6);
    sb_push_span(&w, text_path.data as ptr, text_path.len);
    sb_push_lit(&w, " (+", 3);
    sb_push_i64(&w, ns2 as i64);
    sb_push_lit(&w, " payload sections)\n", 19);
    sx_err_buf(&w);
    return true;
}

// ---------------- PNG 编码（raw-rgba8 无损重编码） ----------------

fn crc32w(p: ptr, n: u64) -> u32 {
    let crc: u32 = 4294967295u32;
    let i: u64 = 0;
    while i < n {
        let cb: u8 = PTR_BYTE_AT(p, i);
        crc = crc ^ (cb as u32);
        let k = 0;
        while k < 8 {
            let m = 0u32 - (crc & 1u32);
            crc = (crc >> 1u32) ^ (3988292384u32 & m);
            k = k + 1;
        }
        i = i + 1;
    }
    return crc ^ 4294967295u32;
}

fn png_chunk(out: &SBuf, typ: ptr, data_p: ptr, data_n: u64) {
    wr_u32be(out, data_n as u32);
    let start = out.len;
    sb_push_span(out, typ, 4);
    sb_push_span(out, data_p, data_n);
    let crc = crc32w(sx_ptr_add(out.data as ptr, start as u64), 4 + data_n);
    wr_u32be(out, crc);
}

fn wr_u32be(b: &SBuf, v: u32) {
    sb_push_byte(b, ((v >> 24u32) & 255u32) as u8);
    sb_push_byte(b, ((v >> 16u32) & 255u32) as u8);
    sb_push_byte(b, ((v >> 8u32) & 255u32) as u8);
    sb_push_byte(b, (v & 255u32) as u8);
}

fn encode_png_rgba8(cv: &CV, raw_p: ptr, raw_n: u64, w: u32, h: u32, out: &SBuf) -> bool {
    if raw_n != ((w as u64) * (h as u64) * 4u64) {
        sb_push_lit(&cv.x.msg, "raw-rgba8 payload ", 18);
        sb_push_u64(&cv.x.msg, raw_n);
        sb_push_lit(&cv.x.msg, "B != ", 5);
        sb_push_u64(&cv.x.msg, w as u64);
        sb_push_byte(&cv.x.msg, 120u8);
        sb_push_u64(&cv.x.msg, h as u64);
        sb_push_lit(&cv.x.msg, "x4", 2);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let scan = sb_new();
    let y = 0;
    while y < h {
        sb_push_byte(&scan, 0u8);
        sb_push_span(&scan, sx_ptr_add(raw_p, (y * w * 4u32) as u64), (w * 4u32) as u64);
        y = y + 1;
    }
    let idat = sb_new();
    sb_push_byte(&idat, 120u8);
    sb_push_byte(&idat, 1u8);
    let a: u32 = 1;
    let b: u32 = 0;
    let si: u64 = 0;
    while si < scan.len {
        let ab: u8 = PTR_BYTE_AT(scan.data as ptr, si);
        a = (a + (ab as u32)) % 65521u32;
        b = (b + a) % 65521u32;
        si = si + 1;
    }
    let off: u64 = 0;
    let going = true;
    while going {
        let rem = scan.len - off;
        let chunk_len = if rem < 65535u64 { rem } else { 65535u64 };
        let last = (off + chunk_len) >= scan.len;
        sb_push_byte(&idat, if last { 1u8 } else { 0u8 });
        wr_u16le(&idat, chunk_len as u32);
        wr_u16le(&idat, (chunk_len as u32) ^ 65535u32);
        sb_push_span(&idat, sx_ptr_add(scan.data as ptr, off), chunk_len);
        off = off + chunk_len;
        if last { going = false; };
    }
    wr_u32be(&idat, (b << 16u32) | a);
    let sig: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];
    let sig_i = 0;
    while sig_i < 8 {
        sb_push_byte(out, sig[sig_i as usize]);
        sig_i = sig_i + 1;
    }
    let ihdr = sb_new();
    wr_u32be(&ihdr, w);
    wr_u32be(&ihdr, h);
    sb_push_byte(&ihdr, 8u8);
    sb_push_byte(&ihdr, 6u8);
    sb_push_byte(&ihdr, 0u8);
    sb_push_byte(&ihdr, 0u8);
    sb_push_byte(&ihdr, 0u8);
    png_chunk(out, "IHDR", ihdr.data as ptr, ihdr.len);
    png_chunk(out, "IDAT", idat.data as ptr, idat.len);
    png_chunk(out, "IEND", "", 0);
    return true;
}

// ---------------- to-gltf ----------------

struct GOut {
    bin: SBuf,
    bv_off: Vec<i32>,
    bv_len: Vec<i32>,
    ac_off: Vec<i32>,
    ac_len: Vec<i32>,
    frags: SBuf,
    cache_key_off: Vec<i32>,
    cache_key_len: Vec<i32>,
    cache_val: Vec<i32>,
    pay_name_off: Vec<i32>,
    pay_name_len: Vec<i32>,
    pay_off: Vec<i32>,
    pay_len: Vec<i32>,
    paystore: SBuf,
    ext_off: Vec<i32>,
    ext_len: Vec<i32>,
    imgf: FragList,
    smpf: FragList,
    texf: FragList,
    matf: FragList,
    meshf: FragList,
    nodef: FragList,
    scenef: FragList,
    skinf: FragList,
    animf: FragList,
    tex_index: NameIdx,
    mat_index: NameIdx,
    mesh_index: NameIdx,
    skin_index: NameIdx,
    node_index: NameIdx,
}

fn go_new() -> GOut {
    return GOut {
        bin: sb_new(), bv_off: Vec::new(), bv_len: Vec::new(),
        ac_off: Vec::new(), ac_len: Vec::new(), frags: sb_new(),
        cache_key_off: Vec::new(), cache_key_len: Vec::new(), cache_val: Vec::new(),
        pay_name_off: Vec::new(), pay_name_len: Vec::new(), pay_off: Vec::new(), pay_len: Vec::new(),
        paystore: sb_new(), ext_off: Vec::new(), ext_len: Vec::new(),
        imgf: fl_new(), smpf: fl_new(), texf: fl_new(), matf: fl_new(), meshf: fl_new(),
        nodef: fl_new(), scenef: fl_new(), skinf: fl_new(), animf: fl_new(),
        tex_index: ni_new(), mat_index: ni_new(), mesh_index: ni_new(),
        skin_index: ni_new(), node_index: ni_new(),
    };
}

fn json_esc(b: &SBuf, p: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        let c = PTR_BYTE_AT(p, i);
        if (c == 34u8) || (c == 92u8) {
            sb_push_byte(b, 92u8);
            sb_push_byte(b, c);
        } else if c < 32u8 {
            sb_push_lit(b, "\\u", 2);
            sb_push_byte(b, 48u8);
            sb_push_byte(b, 48u8);
            sb_push_byte(b, hex_digit((c >> 4u8) & 15u8));
            sb_push_byte(b, hex_digit(c & 15u8));
        } else {
            sb_push_byte(b, c);
        };
        i = i + 1;
    }
}

// joinJson 等价：把 frags 中 [off,len) 列表以 ',' 连接入 out。
fn hex_digit(n: u8) -> u8 {
    if n < 10u8 { return 48u8 + n; };
    return 87u8 + n;
}

fn join_one(frags: &SBuf, out: &SBuf, off: i32, len: i32, first: bool) {
    if !first { sb_push_byte(out, 44u8); };
    sb_push_span(out, sx_ptr_add(frags.data as ptr, off as u64), len as u64);
}

fn join_frags(frags: &SBuf, out: &SBuf, offs: &Vec<i32>, lens: &Vec<i32>, base: i32, cnt: i32) {
    let i = 0;
    while i < cnt {
        join_one(frags, out, offs[(base + i) as usize], lens[(base + i) as usize], i == 0);
        i = i + 1;
    }
}

fn go_add_bv(gout: &GOut, bytes_p: ptr, bytes_n: u64) -> i32 {
    let off = gout.bin.len;
    sb_push_span(&gout.bin, bytes_p, bytes_n);
    let f = sb_new();
    sb_push_lit(&f, "{\"buffer\":0,\"byteOffset\":", 25);
    sb_push_u64(&f, off);
    sb_push_lit(&f, ",\"byteLength\":", 14);
    sb_push_u64(&f, bytes_n);
    sb_push_byte(&f, 125u8);
    gout.bv_off.push(gout.frags.len as i32);
    gout.bv_len.push(f.len as i32);
    sb_push_span(&gout.frags, f.data as ptr, f.len);
    return gout.bv_off.len() - 1;
}

// addAccessor：section 名（x2 arena span）+ 字节 + comp/ty/normalized。
// 缓存键 = "{section}|{comp}|{ty}|{normalized}"（在 gout.frags 中）。
fn go_add_acc(cv: &CV, gout: &GOut, sec_p: ptr, sec_n: u64, bytes_p: ptr, bytes_n: u64, comp: u32, ty: ptr, ty_n: u64, normalized: bool) -> i32 {
    let key = sb_new();
    sb_push_span(&key, sec_p, sec_n);
    sb_push_byte(&key, 124u8);
    sb_push_u64(&key, comp as u64);
    sb_push_byte(&key, 124u8);
    sb_push_span(&key, ty, ty_n);
    sb_push_byte(&key, 124u8);
    sb_push_byte(&key, if normalized { 49u8 } else { 48u8 });
    let i = 0;
    let n = gout.cache_key_off.len();
    while i < n {
        if (gout.cache_key_len[i as usize] as u64) == key.len {
            if sx_spans_eq(sx_ptr_add(gout.frags.data as ptr, gout.cache_key_off[i as usize] as u64), key.len, key.data as ptr, key.len) {
                return gout.cache_val[i as usize];
            };
        };
        i = i + 1;
    }
    let bv = go_add_bv(gout, bytes_p, bytes_n);
    let csize: u64 = if (comp == 5120u32) || (comp == 5121u32) { 1 } else if (comp == 5122u32) || (comp == 5123u32) { 2 } else { 4 };
    let esize = csize * (type_comps_p(ty, ty_n) as u64);
    let count = if esize > 0 { bytes_n / esize } else { 0 };
    let f = sb_new();
    sb_push_lit(&f, "{\"bufferView\":", 14);
    sb_push_i64(&f, bv as i64);
    sb_push_lit(&f, ",\"componentType\":", 17);
    sb_push_u64(&f, comp as u64);
    sb_push_lit(&f, ",\"count\":", 9);
    sb_push_u64(&f, count);
    sb_push_lit(&f, ",\"type\":\"", 9);
    sb_push_span(&f, ty, ty_n);
    sb_push_byte(&f, 34u8);
    if normalized { sb_push_lit(&f, ",\"normalized\":true", 18); };
    sb_push_byte(&f, 125u8);
    gout.ac_off.push(gout.frags.len as i32);
    gout.ac_len.push(f.len as i32);
    sb_push_span(&gout.frags, f.data as ptr, f.len);
    let ix = gout.ac_off.len() - 1;
    gout.cache_key_off.push(gout.frags.len as i32);
    gout.cache_key_len.push(key.len as i32);
    sb_push_span(&gout.frags, key.data as ptr, key.len);
    gout.cache_val.push(ix);
    return ix;
}

// sectionBytes：payload 名（arena span）→ paystore 切片。
fn go_section(cv: &CV, gout: &GOut, name_p: ptr, name_n: u64, o_out: &i32, l_out: &i32) -> bool {
    let i = 0;
    let n = gout.pay_name_off.len();
    while i < n {
        if (gout.pay_name_len[i as usize] as u64) == name_n {
            if sx_spans_eq(sx_ptr_add(gout.paystore.data as ptr, gout.pay_name_off[i as usize] as u64), name_n, name_p, name_n) {
                // paystore 中名字与字节同池：名字段单独存（见装载处）
                *o_out = gout.pay_off[i as usize];
                *l_out = gout.pay_len[i as usize];
                return true;
            };
        };
        i = i + 1;
    }
    sb_push_lit(&cv.x.msg, "section '", 9);
    sb_push_span(&cv.x.msg, name_p, name_n);
    sb_push_lit(&cv.x.msg, "' not present in the split binary", 33);
    return cv_fail(cv, "CvtBadInput", 11);
}

fn elem_to_comp_ty(ty_p: ptr, ty_n: u64, comp_out: &u32, tn_o: &i32, tn_l: &i32, cv: &CV) -> bool {
    let m = sb_new();
    if sx_spans_eq(ty_p, ty_n, "f32", 3) { *comp_out = 5126; sb_push_lit(&m, "SCALAR", 6); }
    else if sx_spans_eq(ty_p, ty_n, "f32x2", 5) { *comp_out = 5126; sb_push_lit(&m, "VEC2", 4); }
    else if sx_spans_eq(ty_p, ty_n, "f32x3", 5) { *comp_out = 5126; sb_push_lit(&m, "VEC3", 4); }
    else if sx_spans_eq(ty_p, ty_n, "f32x4", 5) { *comp_out = 5126; sb_push_lit(&m, "VEC4", 4); }
    else if sx_spans_eq(ty_p, ty_n, "quat", 4) { *comp_out = 5126; sb_push_lit(&m, "VEC4", 4); }
    else if sx_spans_eq(ty_p, ty_n, "u8x4", 4) { *comp_out = 5121; sb_push_lit(&m, "VEC4", 4); }
    else if sx_spans_eq(ty_p, ty_n, "u16x4", 5) { *comp_out = 5123; sb_push_lit(&m, "VEC4", 4); }
    else if sx_spans_eq(ty_p, ty_n, "u32", 3) { *comp_out = 5125; sb_push_lit(&m, "SCALAR", 6); }
    else if sx_spans_eq(ty_p, ty_n, "u16", 3) { *comp_out = 5123; sb_push_lit(&m, "SCALAR", 6); }
    else if sx_spans_eq(ty_p, ty_n, "f32x4x4", 7) { *comp_out = 5126; sb_push_lit(&m, "MAT4", 4); }
    else { return false; };
    cv_str(cv, m.data as ptr, m.len, tn_o, tn_l);
    return true;
}

// arena span 等值（x2.ar 内的两 span）。
fn ar_eq(x: &X, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    if l1 != l2 { return false; };
    return sx_spans_eq(x_ptr(x, o1), l1 as u64, x_ptr(x, o2), l2 as u64);
}

fn ar_eq_lit(x: &X, o: i32, l: i32, p: ptr, n: u64) -> bool {
    if (l as u64) != n { return false; };
    return sx_spans_eq(x_ptr(x, o), n, p, n);
}

// to_gltf 主体（上）：裁判 + 载荷 + 图像/采样器/材质。
// spec_off/spec_len：--iface 规格（cv.strs span，形 Name=file）；
// std_off/std_len：--std-shader 名（cv.strs span）。
fn to_gltf(cv: &CV, text_p: ptr, text_n: u64, bin_p: ptr, bin_n: u64, out_p: ptr, out_n: u64, spec_off: &Vec<i32>, spec_len: &Vec<i32>, std_off: &Vec<i32>, std_len: &Vec<i32>) -> bool {
    let x2 = x_new();
    // ifaces
    let nspec = spec_off.len();
    let si = 0;
    while si < nspec {
        let sp = sx_ptr_add(cv.strs.data as ptr, spec_off[si as usize] as u64);
        let sl = spec_len[si as usize] as u64;
        let eq = sx_index_of_byte(sp, sl, 61u8);
        if eq < 0 {
            return cv_fail_lit(cv, "CvtBadInput", 11, "--iface expects <Shader>=<file>", 31);
        };
        let fsrc = sb_new();
        if !cv_read_file(cv, sx_ptr_add(sp, (eq + 1) as u64), sl - (eq as u64) - 1, &fsrc) { return false; };
        let sh_off = x_intern(&x2, sp, eq as u64);
        let f_off = x_intern(&x2, fsrc.data as ptr, fsrc.len);
        iface_parse(&x2, f_off, fsrc.len, sh_off, eq as i32);
        si = si + 1;
    }
    // 裁判
    let src = sb_new();
    if !cv_read_file(cv, text_p, text_n, &src) { return false; };
    let t_off = x_intern(&x2, src.data as ptr, src.len);
    let p = p_new(0);
    parse_asset(&x2, &p, t_off, src.len as i32);
    if p.fail {
        diag_print_all(&x2);
        return cv_fail_lit(cv, "CvtBadInput", 11, "SAX3D input does not parse", 26);
    };
    check_asset(&x2);
    if diag_count(&x2) > 0 {
        diag_print_all(&x2);
        sb_push_lit(&cv.x.msg, "SAX3D input fails the referee (", 31);
        sb_push_i64(&cv.x.msg, diag_count(&x2) as i64);
        sb_push_lit(&cv.x.msg, " diagnostics); refusing to convert", 34);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    // 载荷（拆分二进制）
    let binb = sb_new();
    if !cv_read_file(cv, bin_p, bin_n, &binb) { return false; };
    let b_off = x_intern(&cv.x, binb.data as ptr, binb.len);
    let hdr = bn_parse_header(&cv.x, b_off, binb.len as i32);
    if hdr.ok == 0 {
        return cv_fail_lit(cv, "CvtBadInput", 11, "binary header invalid", 21);
    };
    if hdr.form != 0 {
        return cv_fail_lit(cv, "CvtBadInput", 11, "to-gltf expects a split-form .saxb3d", 36);
    };
    if !bn_table_fits(binb.len as i32, hdr.count) {
        return cv_fail_lit(cv, "CvtBadInput", 11, "binary truncated", 16);
    };
    let gout = go_new();
    let ri = 0;
    while ri < hdr.count {
        let rec = bn_read_rec(&cv.x, b_off, ri);
        let nm = bn_name_at(&cv.x, b_off, binb.len as i32, &hdr, rec.name_off as i32);
        if nm.len < 0 {
            return cv_fail_lit(cv, "CvtBadInput", 11, "binary section name unresolvable", 32);
        };
        if (rec.offset + rec.len) > (binb.len as i64) {
            sb_push_lit(&cv.x.msg, "binary section '", 16);
            sb_push_span(&cv.x.msg, x_ptr(&cv.x, nm.off), nm.len as u64);
            sb_push_lit(&cv.x.msg, "' overruns file", 15);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        gout.pay_name_off.push(gout.paystore.len as i32);
        gout.pay_name_len.push(nm.len);
        sb_push_span(&gout.paystore, x_ptr(&cv.x, nm.off), nm.len as u64);
        gout.pay_off.push(gout.paystore.len as i32);
        gout.pay_len.push(rec.len as i32);
        sb_push_span(&gout.paystore, sx_ptr_add(binb.data as ptr, rec.offset as u64), rec.len as u64);
        ri = ri + 1;
    }
    // text_dir
    let li = sx_last_index_of_byte(text_p, text_n, 47u8);
    let td_o = 0; let td_l = 0;
    if li >= 0 { cv_str(cv, text_p, li as u64, &td_o, &td_l); } else { cv_str(cv, ".", 1, &td_o, &td_l); };
    if !gltf_images(cv, &x2, &gout, td_o, td_l) { return false; };
    if !gltf_textures(cv, &x2, &gout) { return false; };
    if !gltf_materials(cv, &x2, &gout, std_off, std_len) { return false; };
    if !gltf_meshes(cv, &x2, &gout) { return false; };
    if !gltf_scenes_skins_anims(cv, &x2, &gout) { return false; };
    return gltf_finish(cv, &x2, &gout, out_p, out_n);
}

// 名字→下标线性表（arena span 键）：在 GOut.frags 中存键字节。
struct NameIdx {
    k_off: Vec<i32>,
    k_len: Vec<i32>,
    val: Vec<i32>,
}

fn ni_new() -> NameIdx {
    return NameIdx { k_off: Vec::new(), k_len: Vec::new(), val: Vec::new() };
}

fn ni_match(frags: &SBuf, t: &NameIdx, x: &X, i: i32, o: i32, l: i32) -> bool {
    if t.k_len[i as usize] != l { return false; };
    return sx_spans_eq(sx_ptr_add(frags.data as ptr, t.k_off[i as usize] as u64), l as u64, x_ptr(x, o), l as u64);
}

fn ni_get(frags: &SBuf, t: &NameIdx, x: &X, o: i32, l: i32) -> i32 {
    let i = 0;
    let n = t.k_off.len();
    while i < n {
        if ni_match(frags, t, x, i, o, l) { return t.val[i as usize]; };
        i = i + 1;
    }
    return -1;
}

fn ni_put(frags: &SBuf, t: &NameIdx, x: &X, o: i32, l: i32, v: i32) {
    t.k_off.push(frags.len as i32);
    t.k_len.push(l);
    sb_push_span(frags, x_ptr(x, o), l as u64);
    t.val.push(v);
}

// 片段列表（frag span 在 gout.frags 中）
struct FragList {
    off: Vec<i32>,
    len: Vec<i32>,
}

fn fl_new() -> FragList {
    return FragList { off: Vec::new(), len: Vec::new() };
}

fn fl_push(frags: &SBuf, fl: &FragList, f: &SBuf) {
    fl.off.push(frags.len as i32);
    fl.len.push(f.len as i32);
    sb_push_span(frags, f.data as ptr, f.len);
}

fn fl_set(frags: &SBuf, fl: &FragList, idx: i32, f: &SBuf) {
    fl.off[idx as usize] = frags.len as i32;
    fl.len[idx as usize] = f.len as i32;
    sb_push_span(frags, f.data as ptr, f.len);
}

fn img_mime_of(x: &X, im: &ImgD) -> i32 {
    if sx_starts_with(x_ptr(x, im.f_off), im.f_len as u64, "raw-", 4) { return 0; };
    if ar_eq_lit(x, im.f_off, im.f_len, "jpeg", 4) { return 1; };
    if ar_eq_lit(x, im.f_off, im.f_len, "ktx2", 4) { return 2; };
    return 0;
}

fn img_bytes_fill(cv: &CV, x: &X, gout: &GOut, td_o: i32, td_l: i32, i: i32, bytes: &SBuf) -> bool {
    let im = x.imgs[i as usize];
    if sx_starts_with(x_ptr(x, im.f_off), im.f_len as u64, "raw-", 4) {
        if !ar_eq_lit(x, im.f_off, im.f_len, "raw-rgba8", 9) {
            sb_push_lit(&cv.x.msg, "image '", 7);
            sb_push_span(&cv.x.msg, x_ptr(x, im.n_off), im.n_len as u64);
            sb_push_lit(&cv.x.msg, "': ", 3);
            sb_push_span(&cv.x.msg, x_ptr(x, im.f_off), im.f_len as u64);
            sb_push_lit(&cv.x.msg, " cannot be PNG-encoded without value reinterpretation (f16 payloads); loudly unsupported", 88);
            return cv_fail(cv, "CvtUnsupportedImageFormat", 25);
        };
        if im.has_size == 0 {
            sb_push_lit(&cv.x.msg, "image '", 7);
            sb_push_span(&cv.x.msg, x_ptr(x, im.n_off), im.n_len as u64);
            sb_push_lit(&cv.x.msg, "': raw format lacks size (referee should have caught this)", 58);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        let po = 0; let pl = 0;
        if !go_section(cv, gout, x_ptr(x, im.s_off), im.s_len as u64, &po, &pl) { return false; };
        let enc = sb_new();
        if !encode_png_rgba8(cv, sx_ptr_add(gout.paystore.data as ptr, po as u64), pl as u64, im.w as u32, im.h as u32, &enc) { return false; };
        sb_push_span(bytes, enc.data as ptr, enc.len);
        let m = sb_new();
        sb_push_lit(&m, "image '", 7);
        sb_push_span(&m, x_ptr(x, im.n_off), im.n_len as u64);
        sb_push_lit(&m, "': raw-rgba8 losslessly PNG-encoded for glTF (representation change, pixels identical)", 86);
        cv_led(cv, "APPROX", 6, &m);
        return true;
    };
    if im.kind == 0 {
        let po = 0; let pl = 0;
        if !go_section(cv, gout, x_ptr(x, im.s_off), im.s_len as u64, &po, &pl) { return false; };
        sb_push_span(bytes, sx_ptr_add(gout.paystore.data as ptr, po as u64), pl as u64);
    } else {
        let full = sb_new();
        put_span(cv, &full, td_o, td_l);
        sb_push_byte(&full, 47u8);
        sb_push_span(&full, x_ptr(x, im.s_off), im.s_len as u64);
        if !cv_read_file(cv, full.data as ptr, full.len, bytes) { return false; };
        let m = sb_new();
        sb_push_lit(&m, "image '", 7);
        sb_push_span(&m, x_ptr(x, im.n_off), im.n_len as u64);
        sb_push_lit(&m, "': path-source file embedded as bufferView; the path reference itself is not preserved in glTF output", 101);
        cv_led(cv, "APPROX", 6, &m);
    };
    if ar_eq_lit(x, im.f_off, im.f_len, "png", 3) { return true; };
    if ar_eq_lit(x, im.f_off, im.f_len, "jpeg", 4) { return true; };
    if ar_eq_lit(x, im.f_off, im.f_len, "ktx2", 4) { return true; };
    sb_push_lit(&cv.x.msg, "image '", 7);
    sb_push_span(&cv.x.msg, x_ptr(x, im.n_off), im.n_len as u64);
    sb_push_lit(&cv.x.msg, "': format '", 11);
    sb_push_span(&cv.x.msg, x_ptr(x, im.f_off), im.f_len as u64);
    sb_push_lit(&cv.x.msg, "' has no glTF mime", 18);
    return cv_fail(cv, "CvtBadInput", 11);
}

fn gltf_images(cv: &CV, x: &X, gout: &GOut, td_o: i32, td_l: i32) -> bool {
    let i = 0;
    let n = x.imgs.len();
    while i < n {
        let im = x.imgs[i as usize];
        let bytes = sb_new();
        if !img_bytes_fill(cv, x, gout, td_o, td_l, i, &bytes) { return false; };
        let mime_code = img_mime_of(x, &im);
        let bv = go_add_bv(gout, bytes.data as ptr, bytes.len);
        let f = sb_new();
        sb_push_lit(&f, "{\"name\":\"", 9);
        json_esc(&f, x_ptr(x, im.n_off), im.n_len as u64);
        sb_push_lit(&f, "\",\"bufferView\":", 15);
        sb_push_i64(&f, bv as i64);
        sb_push_lit(&f, ",\"mimeType\":\"", 13);
        if mime_code == 0 { sb_push_span(&f, "image/png", 9); } else if mime_code == 1 { sb_push_span(&f, "image/jpeg", 10); } else { sb_push_span(&f, "image/ktx2", 10); };
        sb_push_lit(&f, "\"}", 2);
        fl_push(&gout.frags, &gout.imgf, &f);
        i = i + 1;
    }
    return true;
}

fn gltf_textures(cv: &CV, x: &X, gout: &GOut) -> bool {
    let i = 0;
    let n = x.texs.len();
    while i < n {
        let t = x.texs[i as usize];
        let mag: u32 = if (t.mag_len > 0) && ar_eq_lit(x, t.mag_off, t.mag_len, "nearest", 7) { 9728 } else { 9729 };
        let minf: u32 = 9729;
        {
            let mn_o = t.min_off; let mn_l = t.min_len;
            let mp_o = t.mip_off; let mp_l = t.mip_len;
            let mn_near = (mn_l > 0) && ar_eq_lit(x, mn_o, mn_l, "nearest", 7);
            if mp_l <= 0 {
                minf = if mn_near { 9728 } else { 9729 };
            } else if ar_eq_lit(x, mp_o, mp_l, "none", 4) {
                minf = if mn_near { 9728 } else { 9729 };
            } else if ar_eq_lit(x, mp_o, mp_l, "nearest", 7) {
                minf = if mn_near { 9984 } else { 9986 };
            } else {
                minf = if mn_near { 9985 } else { 9987 };
            };
        }
        let wu: u32 = if t.wu_len > 0 {
            if ar_eq_lit(x, t.wu_off, t.wu_len, "clamp", 5) { 33071 } else if ar_eq_lit(x, t.wu_off, t.wu_len, "mirror", 6) { 33648 } else { 10497 }
        } else { 10497 };
        let wv: u32 = if t.wv_len > 0 {
            if ar_eq_lit(x, t.wv_off, t.wv_len, "clamp", 5) { 33071 } else if ar_eq_lit(x, t.wv_off, t.wv_len, "mirror", 6) { 33648 } else { 10497 }
        } else { 10497 };
        if t.ww_len > 0 {
            let m = sb_new();
            sb_push_lit(&m, "texture '", 9);
            sb_push_span(&m, x_ptr(x, t.n_off), t.n_len as u64);
            sb_push_lit(&m, "': sampler wrap_w '", 19);
            sb_push_span(&m, x_ptr(x, t.ww_off), t.ww_len as u64);
            sb_push_lit(&m, "' has no glTF 2D counterpart; dropped", 37);
            cv_led(cv, "LOSS", 4, &m);
        };
        let f = sb_new();
        sb_push_lit(&f, "{\"magFilter\":", 13);
        sb_push_u64(&f, mag as u64);
        sb_push_lit(&f, ",\"minFilter\":", 13);
        sb_push_u64(&f, minf as u64);
        sb_push_lit(&f, ",\"wrapS\":", 9);
        sb_push_u64(&f, wu as u64);
        sb_push_lit(&f, ",\"wrapT\":", 9);
        sb_push_u64(&f, wv as u64);
        sb_push_byte(&f, 125u8);
        fl_push(&gout.frags, &gout.smpf, &f);
        let img_idx = 0;
        let j = 0;
        let ni = x.imgs.len();
        while j < ni {
            if ar_eq(x, x.imgs[j as usize].n_off, x.imgs[j as usize].n_len, t.i_off, t.i_len) { img_idx = j; };
            j = j + 1;
        }
        let tf = sb_new();
        sb_push_lit(&tf, "{\"name\":\"", 9);
        json_esc(&tf, x_ptr(x, t.n_off), t.n_len as u64);
        sb_push_lit(&tf, "\",\"source\":", 11);
        sb_push_i64(&tf, img_idx as i64);
        sb_push_lit(&tf, ",\"sampler\":", 11);
        sb_push_i64(&tf, i as i64);
        sb_push_byte(&tf, 125u8);
        fl_push(&gout.frags, &gout.texf, &tf);
        ni_put(&gout.frags, &gout.tex_index, x, t.n_off, t.n_len, i);
        i = i + 1;
    }
    return true;
}

// ---- to-gltf: 材质 ----

fn metallic_final(x: &X, m: &MatD, need_led: &bool) -> f64 {
    let pj2 = m.pa_off;
    while pj2 < (m.pa_off + m.pa_len) {
        let pr = x.params[pj2 as usize];
        if ar_eq_lit(x, pr.n_off, pr.n_len, "metallic", 8) && (pr.kind == 0) {
            return pr.val;
        };
        pj2 = pj2 + 1;
    }
    let dv = 0.0;
    if iface_metallic_default(x, m.sh_off, m.sh_len, &dv) {
        return dv;
    };
    *need_led = true;
    return 1.0;
}


fn iface_metallic_default(x: &X, sh_o: i32, sh_l: i32, out: &f64) -> bool {
    let i = 0;
    let n = x.if_names_off.len();
    while i < n {
        if ar_eq(x, x.if_names_off[i as usize], x.if_names_len[i as usize], sh_o, sh_l) {
            let fx = x.ifaces[i as usize];
            let j = 0;
            let np = fx.params.len();
            while j < np {
                let fp = fx.params[j as usize];
                if ar_eq_lit(x, fp.n_off, fp.n_len, "metallic", 8) {
                    if (fp.has_def != 0) && (fp.has_ds != 0) {
                        *out = fp.ds;
                        return true;
                    };
                    return false;
                };
                j = j + 1;
            }
            return false;
        };
        i = i + 1;
    }
    return false;
}

fn gltf_materials(cv: &CV, x: &X, gout: &GOut, std_off: &Vec<i32>, std_len: &Vec<i32>) -> bool {
    let i = 0;
    let n = x.mats.len();
    while i < n {
        let m = x.mats[i as usize];
        ni_put(&gout.frags, &gout.mat_index, x, m.n_off, m.n_len, i);
        let extras = sb_new();
        sb_push_lit(&extras, "\"sax3d_shader\":\"", 16);
        json_esc(&extras, x_ptr(x, m.sh_off), m.sh_len as u64);
        sb_push_byte(&extras, 34u8);
        let is_std = x_starts_lit(x, m.sh_off, m.sh_len, "StdPbr", 6);
        if !is_std {
            let si = 0;
            let nstd = std_off.len();
            while si < nstd {
                if cv_str_eq(cv, std_off[si as usize], std_len[si as usize], x_ptr(x, m.sh_off), m.sh_len as u64) { is_std = true; };
                si = si + 1;
            }
        };
        if is_std {
            let mm = sb_new();
            sb_push_lit(&mm, "material '", 10);
            sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
            sb_push_lit(&mm, "': standard shader '", 20);
            sb_push_span(&mm, x_ptr(x, m.sh_off), m.sh_len as u64);
            sb_push_lit(&mm, "' represented by the PBR parameter set; name kept in extras.sax3d_shader", 72);
            cv_led(cv, "APPROX", 6, &mm);
        } else {
            let mm = sb_new();
            sb_push_lit(&mm, "material '", 10);
            sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
            sb_push_lit(&mm, "': CUSTOM shader '", 18);
            sb_push_span(&mm, x_ptr(x, m.sh_off), m.sh_len as u64);
            sb_push_lit(&mm, "' logic is not expressible in glTF; only PBR-approximable params mapped, name kept in extras.sax3d_shader", 105);
            cv_led(cv, "LOSS", 4, &mm);
        };
        // pbr parts（片段存入临时 FragList 语义：本地 off/len 表 + gout.frags）
        let parts = fl_new();
        let pj = m.pa_off;
        while pj < (m.pa_off + m.pa_len) {
            let pr = x.params[pj as usize];
            if ar_eq_lit(x, pr.n_off, pr.n_len, "base_color", 10) {
                if (pr.kind == 1) && (pr.v_len == 4) {
                    let v0 = nf_f64_from_bits(x.vecpool[pr.v_off as usize]);
                    let v1 = nf_f64_from_bits(x.vecpool[(pr.v_off + 1) as usize]);
                    let v2 = nf_f64_from_bits(x.vecpool[(pr.v_off + 2) as usize]);
                    let v3 = nf_f64_from_bits(x.vecpool[(pr.v_off + 3) as usize]);
                    if !((v0 == 1.0) && (v1 == 1.0) && (v2 == 1.0) && (v3 == 1.0)) {
                        let f = sb_new();
                        sb_push_lit(&f, "\"baseColorFactor\":[", 19);
                        nf_push_f64(&f, v0);
                        sb_push_byte(&f, 44u8);
                        nf_push_f64(&f, v1);
                        sb_push_byte(&f, 44u8);
                        nf_push_f64(&f, v2);
                        sb_push_byte(&f, 44u8);
                        nf_push_f64(&f, v3);
                        sb_push_byte(&f, 93u8);
                        fl_push(&gout.frags, &parts, &f);
                    };
                };
            } else if ar_eq_lit(x, pr.n_off, pr.n_len, "roughness", 9) {
                if pr.kind == 0 {
                    let f = sb_new();
                    sb_push_lit(&f, "\"roughnessFactor\":", 18);
                    nf_push_f64(&f, pr.val);
                    fl_push(&gout.frags, &parts, &f);
                };
            } else if ar_eq_lit(x, pr.n_off, pr.n_len, "metallic", 8) {
                // 统一处理（下方）
            } else {
                let mm = sb_new();
                sb_push_lit(&mm, "material '", 10);
                sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
                sb_push_lit(&mm, "': param '", 10);
                sb_push_span(&mm, x_ptr(x, pr.n_off), pr.n_len as u64);
                sb_push_lit(&mm, "' has no glTF PBR counterpart; dropped", 38);
                cv_led(cv, "LOSS", 4, &mm);
            };
            pj = pj + 1;
        }
        let metal_need_led = false;
        let metal = metallic_final(x, &m, &metal_need_led);
        if metal_need_led {
            let mm = sb_new();
            sb_push_lit(&mm, "material '", 10);
            sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
            sb_push_lit(&mm, "': metallic neither set nor defaulted by fixture; glTF default 1.0 written explicitly", 85);
            cv_led(cv, "APPROX", 6, &mm);
        };
        {
            let f = sb_new();
            sb_push_lit(&f, "\"metallicFactor\":", 17);
            nf_push_f64(&f, metal);
            fl_push(&gout.frags, &parts, &f);
        }
        // texbinds
        let tj = m.tb_off;
        while tj < (m.tb_off + m.tb_len) {
            let tb = x.tbinds[tj as usize];
            if ar_eq_lit(x, tb.n_off, tb.n_len, "base_color_map", 14) {
                let tix = ni_get(&gout.frags, &gout.tex_index, x, tb.t_off, tb.t_len);
                if tix < 0 {
                    sb_push_lit(&cv.x.msg, "texture '", 9);
                    sb_push_span(&cv.x.msg, x_ptr(x, tb.t_off), tb.t_len as u64);
                    sb_push_lit(&cv.x.msg, "' unknown", 9);
                    return cv_fail(cv, "CvtBadInput", 11);
                };
                let tt_part = sb_new();
                let tk = m.tt_off;
                while tk < (m.tt_off + m.tt_len) {
                    let tt = x.ttrs[tk as usize];
                    if ar_eq(x, tt.n_off, tt.n_len, tb.n_off, tb.n_len) {
                        let inner = sb_new();
                        let first = true;
                        if tt.off_v >= 0 {
                            sb_push_lit(&inner, "\"offset\":[", 10);
                            nf_push_f64(&inner, nf_f64_from_bits(x.vecpool[tt.off_v as usize]));
                            sb_push_byte(&inner, 44u8);
                            nf_push_f64(&inner, nf_f64_from_bits(x.vecpool[(tt.off_v + 1) as usize]));
                            sb_push_byte(&inner, 93u8);
                            first = false;
                        };
                        if tt.scl_v >= 0 {
                            if !first { sb_push_byte(&inner, 44u8); };
                            sb_push_lit(&inner, "\"scale\":[", 9);
                            nf_push_f64(&inner, nf_f64_from_bits(x.vecpool[tt.scl_v as usize]));
                            sb_push_byte(&inner, 44u8);
                            nf_push_f64(&inner, nf_f64_from_bits(x.vecpool[(tt.scl_v + 1) as usize]));
                            sb_push_byte(&inner, 93u8);
                            first = false;
                        };
                        if tt.has_rot != 0 {
                            if !first { sb_push_byte(&inner, 44u8); };
                            sb_push_lit(&inner, "\"rotation\":", 11);
                            nf_push_f64(&inner, tt.rot);
                        };
                        sb_push_lit(&tt_part, ",\"extensions\":{\"KHR_texture_transform\":{", 40);
                        sb_push_span(&tt_part, inner.data as ptr, inner.len);
                        sb_push_lit(&tt_part, "}}", 2);
                        let has_ext = false;
                        let ei = 0;
                        let ne = gout.ext_off.len();
                        while ei < ne {
                            if cv_str_eq(cv, gout.ext_off[ei as usize], gout.ext_len[ei as usize], "KHR_texture_transform", 21) { has_ext = true; };
                            ei = ei + 1;
                        }
                        if !has_ext {
                            let eo = 0; let el = 0;
                            cv_str(cv, "KHR_texture_transform", 21, &eo, &el);
                            gout.ext_off.push(eo);
                            gout.ext_len.push(el);
                        };
                    };
                    tk = tk + 1;
                }
                let f = sb_new();
                sb_push_lit(&f, "\"baseColorTexture\":{\"index\":", 28);
                sb_push_i64(&f, tix as i64);
                sb_push_span(&f, tt_part.data as ptr, tt_part.len);
                sb_push_byte(&f, 125u8);
                fl_push(&gout.frags, &parts, &f);
            } else {
                let mm = sb_new();
                sb_push_lit(&mm, "material '", 10);
                sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
                sb_push_lit(&mm, "': texture binding '", 20);
                sb_push_span(&mm, x_ptr(x, tb.n_off), tb.n_len as u64);
                sb_push_lit(&mm, "' has no glTF PBR slot; dropped", 31);
                cv_led(cv, "LOSS", 4, &mm);
            };
            tj = tj + 1;
        }
        let frag = sb_new();
        sb_push_lit(&frag, "{\"name\":\"", 9);
        json_esc(&frag, x_ptr(x, m.n_off), m.n_len as u64);
        sb_push_lit(&frag, "\",\"pbrMetallicRoughness\":{", 26);
        join_frags(&gout.frags, &frag, &parts.off, &parts.len, 0, parts.off.len());
        sb_push_byte(&frag, 125u8);
        if m.al_len > 0 {
            if ar_eq_lit(x, m.al_off, m.al_len, "blend", 5) {
                sb_push_lit(&frag, ",\"alphaMode\":\"BLEND\"", 20);
            };
            if ar_eq_lit(x, m.al_off, m.al_len, "mask", 4) {
                sb_push_lit(&frag, ",\"alphaMode\":\"MASK\"", 19);
                if m.has_cut != 0 {
                    sb_push_lit(&frag, ",\"alphaCutoff\":", 15);
                    nf_push_f64(&frag, m.cut);
                };
            };
        };
        if m.ds == 1 {
            sb_push_lit(&frag, ",\"doubleSided\":true", 19);
        };
        if m.dw >= 0 {
            let mm = sb_new();
            sb_push_lit(&mm, "material '", 10);
            sb_push_span(&mm, x_ptr(x, m.n_off), m.n_len as u64);
            sb_push_lit(&mm, "': state depth_write=", 21);
            if m.dw == 1 { sb_push_lit(&mm, "true", 4); } else { sb_push_lit(&mm, "false", 5); };
            sb_push_lit(&mm, " has no glTF core counterpart; recorded in extras only", 54);
            cv_led(cv, "LOSS", 4, &mm);
            sb_push_lit(&extras, ",\"sax3d_depth_write\":", 21);
            if m.dw == 1 { sb_push_lit(&extras, "true", 4); } else { sb_push_lit(&extras, "false", 5); };
        };
        sb_push_lit(&frag, ",\"extras\":{", 11);
        sb_push_span(&frag, extras.data as ptr, extras.len);
        sb_push_lit(&frag, "}}", 2);
        fl_push(&gout.frags, &gout.matf, &frag);
        i = i + 1;
    }
    return true;
}

// arena span 前缀判定（x_ptr 版 startsWith）。
fn x_starts_lit(x: &X, o: i32, l: i32, p: ptr, n: u64) -> bool {
    if (l as u64) < n { return false; };
    return sx_spans_eq(x_ptr(x, o), n, p, n);
}


// ---- to-gltf: 网格 ----

// 子串查找（首个出现位置，未找到 -1）。
fn find_sub(p: ptr, n: u64, q: ptr, m: u64) -> i64 {
    if m == 0 { return 0; };
    if n < m { return -1; };
    let i: u64 = 0;
    while i + m <= n {
        if sx_spans_eq(sx_ptr_add(p, i), m, q, m) { return i as i64; };
        i = i + 1;
    }
    return -1;
}

// 以原始字节登记名字→下标（键存 gout.frags）。
fn ni_put_raw(frags: &SBuf, t: &NameIdx, p: ptr, n: u64, v: i32) {
    t.k_off.push(frags.len as i32);
    t.k_len.push(n as i32);
    sb_push_span(frags, p, n);
    t.val.push(v);
}

// 通道字节（段名 = x arena span）。
fn chan_bytes(cv: &CV, gout: &GOut, x: &X, s_o: i32, s_l: i32, out: &SBuf) -> bool {
    let po = 0; let pl = 0;
    if !go_section(cv, gout, x_ptr(x, s_o), s_l as u64, &po, &pl) { return false; };
    sb_push_span(out, sx_ptr_add(gout.paystore.data as ptr, po as u64), pl as u64);
    return true;
}

// 构建一个网格的 attributes 对象（不含外层大括号由调用方加）。
fn gltf_attrs(cv: &CV, x: &X, gout: &GOut, mesh: &MeshD, out: &SBuf) -> bool {
    sb_push_byte(out, 123u8);
    let first = true;
    let cj = mesh.ch_off;
    while cj < (mesh.ch_off + mesh.ch_len) {
        let ch = x.chans[cj as usize];
        let bytes = sb_new();
        if !chan_bytes(cv, gout, x, ch.s_off, ch.s_len, &bytes) { return false; };
        if ch.custom != 0 {
            let comp: u32 = 0;
            let tn_o = 0; let tn_l = 0;
            if !elem_to_comp_ty(x_ptr(x, ch.t_off), ch.t_len as u64, &comp, &tn_o, &tn_l, cv) {
                sb_push_lit(&cv.x.msg, "attr '", 6);
                sb_push_span(&cv.x.msg, x_ptr(x, ch.n_off), ch.n_len as u64);
                sb_push_lit(&cv.x.msg, "' type ", 7);
                sb_push_span(&cv.x.msg, x_ptr(x, ch.t_off), ch.t_len as u64);
                sb_push_lit(&cv.x.msg, " has no glTF accessor form", 26);
                return cv_fail(cv, "CvtUnsupportedElemType", 22);
            };
            let ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, comp, sx_ptr_add(cv.strs.data as ptr, tn_o as u64), tn_l as u64, false);
            if !first { sb_push_byte(out, 44u8); };
            first = false;
            sb_push_lit(out, "\"_", 2);
            json_esc(out, x_ptr(x, ch.n_off), ch.n_len as u64);
            sb_push_lit(out, "\":", 2);
            sb_push_i64(out, ax as i64);
        } else if ar_eq_lit(x, ch.n_off, ch.n_len, "color0", 6) {
            let is_u8 = ar_eq_lit(x, ch.t_off, ch.t_len, "u8x4", 4);
            let comp: u32 = if is_u8 { 5121 } else { 5126 };
            let ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, comp, "VEC4", 4, is_u8);
            if !first { sb_push_byte(out, 44u8); };
            first = false;
            sb_push_lit(out, "\"COLOR_0\":", 10);
            sb_push_i64(out, ax as i64);
        } else {
            let code = -1;
            if ar_eq_lit(x, ch.n_off, ch.n_len, "position", 8) { code = 0; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "normal", 6) { code = 1; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "tangent", 7) { code = 2; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "uv0", 3) { code = 3; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "uv1", 3) { code = 4; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "uv2", 3) { code = 5; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "uv3", 3) { code = 6; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "joints0", 7) { code = 7; }
            else if ar_eq_lit(x, ch.n_off, ch.n_len, "weights0", 8) { code = 8; };
            if code >= 0 {
                let ax = 0;
                if code == 0 { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC3", 4, false); }
                else if code == 1 { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC3", 4, false); }
                else if code == 2 { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC4", 4, false); }
                else if code == 7 { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5123, "VEC4", 4, false); }
                else if code == 8 { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC4", 4, false); }
                else { ax = go_add_acc(cv, gout, x_ptr(x, ch.s_off), ch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC2", 4, false); };
                if !first { sb_push_byte(out, 44u8); };
                first = false;
                if code == 0 { sb_push_lit(out, "\"POSITION\":", 11); }
                else if code == 1 { sb_push_lit(out, "\"NORMAL\":", 9); }
                else if code == 2 { sb_push_lit(out, "\"TANGENT\":", 10); }
                else if code == 3 { sb_push_lit(out, "\"TEXCOORD_0\":", 13); }
                else if code == 4 { sb_push_lit(out, "\"TEXCOORD_1\":", 13); }
                else if code == 5 { sb_push_lit(out, "\"TEXCOORD_2\":", 13); }
                else if code == 6 { sb_push_lit(out, "\"TEXCOORD_3\":", 13); }
                else if code == 7 { sb_push_lit(out, "\"JOINTS_0\":", 11); }
                else { sb_push_lit(out, "\"WEIGHTS_0\":", 12); };
                sb_push_i64(out, ax as i64);
            };
        };
        cj = cj + 1;
    }
    sb_push_byte(out, 125u8);
    return true;
}

fn gltf_meshes(cv: &CV, x: &X, gout: &GOut) -> bool {
    let mi = 0;
    let nm = x.meshes.len();
    while mi < nm {
        let mesh = x.meshes[mi as usize];
        ni_put(&gout.frags, &gout.mesh_index, x, mesh.n_off, mesh.n_len, mi);
        let attrs = sb_new();
        if !gltf_attrs(cv, x, gout, &mesh, &attrs) { return false; };
        // 索引
        let has_idx = false;
        let idx_acc = -1;
        let is_fan = ar_eq_lit(x, mesh.topo_off, mesh.topo_len, "triangle-fan", 12);
        if is_fan {
            if mesh.ity_len > 0 {
                let is32 = !ar_eq_lit(x, mesh.ity_off, mesh.ity_len, "u16", 3);
                let raw = sb_new();
                if !chan_bytes(cv, gout, x, mesh.isec_off, mesh.isec_len, &raw) { return false; };
                let exp = sb_new();
                expand_fan(raw.data as ptr, raw.len, is32, &exp);
                let key = sb_new();
                sb_push_span(&key, x_ptr(x, mesh.isec_off), mesh.isec_len as u64);
                sb_push_lit(&key, "#fanexp", 7);
                idx_acc = go_add_acc(cv, gout, key.data as ptr, key.len, exp.data as ptr, exp.len, if is32 { 5125 } else { 5123 }, "SCALAR", 6, false);
                has_idx = true;
                let esz: u64 = if is32 { 4 } else { 2 };
                let mm = sb_new();
                sb_push_lit(&mm, "mesh '", 6);
                sb_push_span(&mm, x_ptr(x, mesh.n_off), mesh.n_len as u64);
                sb_push_lit(&mm, "': topology 'triangle-fan' (outside the SAX3D closed set, SPEC D-9) expanded to triangle list (lossless): ", 106);
                sb_push_u64(&mm, raw.len / esz);
                sb_push_lit(&mm, " -> ", 4);
                sb_push_u64(&mm, exp.len / esz);
                sb_push_lit(&mm, " indices; glTF TRIANGLES written, fan never emitted", 51);
                cv_led(cv, "APPROX", 6, &mm);
            } else {
                let exp = sb_new();
                let is32 = false;
                expand_fan_sequential(mesh.vertices as i64, &exp, &is32);
                let key = sb_new();
                sb_push_span(&key, x_ptr(x, mesh.n_off), mesh.n_len as u64);
                sb_push_lit(&key, "#fanexp", 7);
                idx_acc = go_add_acc(cv, gout, key.data as ptr, key.len, exp.data as ptr, exp.len, if is32 { 5125 } else { 5123 }, "SCALAR", 6, false);
                has_idx = true;
                let mm = sb_new();
                sb_push_lit(&mm, "mesh '", 6);
                sb_push_span(&mm, x_ptr(x, mesh.n_off), mesh.n_len as u64);
                sb_push_lit(&mm, "': non-indexed topology 'triangle-fan' (outside the SAX3D closed set, SPEC D-9) expanded to triangle list (lossless): index buffer synthesized for ", 147);
                sb_push_u64(&mm, mesh.vertices);
                sb_push_lit(&mm, " vertices; glTF TRIANGLES written, fan never emitted", 52);
                cv_led(cv, "APPROX", 6, &mm);
            };
        } else if mesh.ity_len > 0 {
            let raw = sb_new();
            if !chan_bytes(cv, gout, x, mesh.isec_off, mesh.isec_len, &raw) { return false; };
            let comp: u32 = if ar_eq_lit(x, mesh.ity_off, mesh.ity_len, "u16", 3) { 5123 } else { 5125 };
            idx_acc = go_add_acc(cv, gout, x_ptr(x, mesh.isec_off), mesh.isec_len as u64, raw.data as ptr, raw.len, comp, "SCALAR", 6, false);
            has_idx = true;
        };
        let mode = 4;
        if ar_eq_lit(x, mesh.topo_off, mesh.topo_len, "points", 6) { mode = 0; }
        else if ar_eq_lit(x, mesh.topo_off, mesh.topo_len, "lines", 5) { mode = 1; }
        else if ar_eq_lit(x, mesh.topo_off, mesh.topo_len, "line-strip", 10) { mode = 3; }
        else if ar_eq_lit(x, mesh.topo_off, mesh.topo_len, "triangle-strip", 14) { mode = 5; };
        // targets（全 prim 共享一段）
        let targets = sb_new();
        if mesh.mo_len > 0 {
            sb_push_lit(&targets, ",\"targets\":[", 12);
            let firstt = true;
            let mj = mesh.mo_off;
            while mj < (mesh.mo_off + mesh.mo_len) {
                let mo = x.morphs[mj as usize];
                if !firstt { sb_push_byte(&targets, 44u8); };
                firstt = false;
                sb_push_byte(&targets, 123u8);
                let firsta = true;
                let mcj = mo.ch_off;
                while mcj < (mo.ch_off + mo.ch_len) {
                    let mch = x.mchans[mcj as usize];
                    let bytes = sb_new();
                    if !chan_bytes(cv, gout, x, mch.s_off, mch.s_len, &bytes) { return false; };
                    let keyc = 2;
                    let tyc = 3;
                    if ar_eq_lit(x, mch.n_off, mch.n_len, "position", 8) { keyc = 0; }
                    else if ar_eq_lit(x, mch.n_off, mch.n_len, "normal", 6) { keyc = 1; }
                    else if ar_eq_lit(x, mch.n_off, mch.n_len, "tangent", 7) { tyc = 4; };
                    let ax = 0;
                    if tyc == 4 { ax = go_add_acc(cv, gout, x_ptr(x, mch.s_off), mch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC4", 4, false); }
                    else { ax = go_add_acc(cv, gout, x_ptr(x, mch.s_off), mch.s_len as u64, bytes.data as ptr, bytes.len, 5126, "VEC3", 4, false); };
                    if !firsta { sb_push_byte(&targets, 44u8); };
                    firsta = false;
                    sb_push_byte(&targets, 34u8);
                    if keyc == 0 { sb_push_span(&targets, "POSITION", 8); } else if keyc == 1 { sb_push_span(&targets, "NORMAL", 6); } else { sb_push_span(&targets, "TANGENT", 7); };
                    sb_push_lit(&targets, "\":", 2);
                    sb_push_i64(&targets, ax as i64);
                    mcj = mcj + 1;
                }
                sb_push_byte(&targets, 125u8);
                mj = mj + 1;
            }
            sb_push_byte(&targets, 93u8);
        };
        // prims
        let prim_frags = fl_new();
        let pi = mesh.pr_off;
        while pi < (mesh.pr_off + mesh.pr_len) {
            let pr = x.prims[pi as usize];
            let mix = ni_get(&gout.frags, &gout.mat_index, x, pr.m_off, pr.m_len);
            if mix < 0 {
                sb_push_lit(&cv.x.msg, "material '", 10);
                sb_push_span(&cv.x.msg, x_ptr(x, pr.m_off), pr.m_len as u64);
                sb_push_lit(&cv.x.msg, "' unknown", 9);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let f = sb_new();
            sb_push_lit(&f, "{\"attributes\":", 14);
            sb_push_span(&f, attrs.data as ptr, attrs.len);
            if has_idx {
                sb_push_lit(&f, ",\"indices\":", 11);
                sb_push_i64(&f, idx_acc as i64);
            };
            sb_push_lit(&f, ",\"material\":", 12);
            sb_push_i64(&f, mix as i64);
            sb_push_lit(&f, ",\"mode\":", 8);
            sb_push_i64(&f, mode as i64);
            sb_push_span(&f, targets.data as ptr, targets.len);
            sb_push_byte(&f, 125u8);
            fl_push(&gout.frags, &prim_frags, &f);
            pi = pi + 1;
        }
        if (mesh.pr_len > 1) && has_idx {
            let mm = sb_new();
            sb_push_lit(&mm, "mesh '", 6);
            sb_push_span(&mm, x_ptr(x, mesh.n_off), mesh.n_len as u64);
            sb_push_lit(&mm, "': ", 3);
            sb_push_i64(&mm, mesh.pr_len as i64);
            sb_push_lit(&mm, " SAX3D primitives share one index set; glTF primitives will overlap-draw (SAX3D v1 primitives carry no index ranges — map §1)", 128);
            cv_led(cv, "APPROX", 6, &mm);
        };
        let mf = sb_new();
        sb_push_lit(&mf, "{\"name\":\"", 9);
        json_esc(&mf, x_ptr(x, mesh.n_off), mesh.n_len as u64);
        sb_push_lit(&mf, "\",\"primitives\":[", 16);
        join_frags(&gout.frags, &mf, &prim_frags.off, &prim_frags.len, 0, prim_frags.off.len());
        sb_push_byte(&mf, 93u8);
        if mesh.mo_len > 0 {
            sb_push_lit(&mf, ",\"extras\":{\"targetNames\":[", 26);
            let mj2 = mesh.mo_off;
            let firstn = true;
            while mj2 < (mesh.mo_off + mesh.mo_len) {
                let mo = x.morphs[mj2 as usize];
                if !firstn { sb_push_byte(&mf, 44u8); };
                firstn = false;
                sb_push_byte(&mf, 34u8);
                json_esc(&mf, x_ptr(x, mo.n_off), mo.n_len as u64);
                sb_push_byte(&mf, 34u8);
                mj2 = mj2 + 1;
            }
            sb_push_lit(&mf, "]}", 2);
        };
        sb_push_byte(&mf, 125u8);
        fl_push(&gout.frags, &gout.meshf, &mf);
        mi = mi + 1;
    }
    return true;
}

// ---- to-gltf: 节点（递归，Zig emitNodeG 同构） ----

fn gltf_node_emit(cv: &CV, x: &X, gout: &GOut, ni: i32, idx_out: &i32) -> bool {
    let nd = x.nodes[ni as usize];
    let my_idx = gout.nodef.off.len() as i32;
    ni_put(&gout.frags, &gout.node_index, x, nd.n_off, nd.n_len, my_idx);
    let empty = sb_new();
    fl_push(&gout.frags, &gout.nodef, &empty);
    // 先递归子节点
    let kids = Vec::new();
    let ci = 0;
    while ci < nd.ch_len {
        let kidx = 0;
        if !gltf_node_emit(cv, x, gout, x.idxpool[(nd.ch_off + ci) as usize], &kidx) { return false; };
        kids.push(kidx);
        ci = ci + 1;
    }
    let f = sb_new();
    sb_push_lit(&f, "{\"name\":\"", 9);
    json_esc(&f, x_ptr(x, nd.n_off), nd.n_len as u64);
    sb_push_byte(&f, 34u8);
    if nd.mtx >= 0 {
        sb_push_lit(&f, ",\"matrix\":[", 11);
        let k = 0;
        while k < 16 {
            if k > 0 { sb_push_byte(&f, 44u8); };
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.mtx + k) as usize]));
            k = k + 1;
        }
        sb_push_byte(&f, 93u8);
    } else if nd.has_tr != 0 {
        if nd.tt >= 0 {
            sb_push_lit(&f, ",\"translation\":[", 16);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[nd.tt as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.tt + 1) as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.tt + 2) as usize]));
            sb_push_byte(&f, 93u8);
        };
        if nd.tr >= 0 {
            sb_push_lit(&f, ",\"rotation\":[", 13);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[nd.tr as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.tr + 1) as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.tr + 2) as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.tr + 3) as usize]));
            sb_push_byte(&f, 93u8);
        };
        if nd.ts >= 0 {
            sb_push_lit(&f, ",\"scale\":[", 10);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[nd.ts as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.ts + 1) as usize]));
            sb_push_byte(&f, 44u8);
            nf_push_f64(&f, nf_f64_from_bits(x.vecpool[(nd.ts + 2) as usize]));
            sb_push_byte(&f, 93u8);
        };
    };
    if nd.mesh_len > 0 {
        let mx = ni_get(&gout.frags, &gout.mesh_index, x, nd.mesh_off, nd.mesh_len);
        if mx < 0 {
            sb_push_lit(&cv.x.msg, "mesh '", 6);
            sb_push_span(&cv.x.msg, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
            sb_push_lit(&cv.x.msg, "' unknown", 9);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        if nd.mat_len > 0 {
            // 材质覆盖：克隆 mesh 片段并替换 material/名
            let src_mi = -1;
            let si2 = 0;
            let nmes = x.meshes.len();
            while si2 < nmes {
                if ar_eq(x, x.meshes[si2 as usize].n_off, x.meshes[si2 as usize].n_len, nd.mesh_off, nd.mesh_len) { src_mi = si2; };
                si2 = si2 + 1;
            }
            if src_mi < 0 {
                sb_push_lit(&cv.x.msg, "mesh '", 6);
                sb_push_span(&cv.x.msg, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
                sb_push_lit(&cv.x.msg, "' not found", 11);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let sm = x.meshes[src_mi as usize];
            if sm.pr_len != 1 {
                sb_push_lit(&cv.x.msg, "node '", 6);
                sb_push_span(&cv.x.msg, x_ptr(x, nd.n_off), nd.n_len as u64);
                sb_push_lit(&cv.x.msg, "': material override on multi-primitive mesh (referee should have caught)", 73);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let spr = x.prims[sm.pr_off as usize];
            let old_mat0 = ni_get(&gout.frags, &gout.mat_index, x, spr.m_off, spr.m_len);
            let old_mat: i32 = if old_mat0 < 0 { 0 } else { old_mat0 };
            let new_mat = ni_get(&gout.frags, &gout.mat_index, x, nd.mat_off, nd.mat_len);
            if new_mat < 0 {
                sb_push_lit(&cv.x.msg, "override material '", 19);
                sb_push_span(&cv.x.msg, x_ptr(x, nd.mat_off), nd.mat_len as u64);
                sb_push_lit(&cv.x.msg, "' unknown", 9);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let clone = sb_new();
            sb_push_span(&clone, sx_ptr_add(gout.frags.data as ptr, gout.meshf.off[mx as usize] as u64), gout.meshf.len[mx as usize] as u64);
            let needle = sb_new();
            sb_push_lit(&needle, "\"material\":", 11);
            sb_push_i64(&needle, old_mat as i64);
            let pos = find_sub(clone.data as ptr, clone.len, needle.data as ptr, needle.len);
            if pos >= 0 {
                let nf = sb_new();
                sb_push_span(&nf, clone.data as ptr, pos as u64);
                sb_push_lit(&nf, "\"material\":", 11);
                sb_push_i64(&nf, new_mat as i64);
                sb_push_span(&nf, sx_ptr_add(clone.data as ptr, (pos as u64) + needle.len), clone.len - (pos as u64) - needle.len);
                clone = nf;
            };
            let oname = sb_new();
            sb_push_lit(&oname, "\"name\":\"", 8);
            json_esc(&oname, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
            sb_push_byte(&oname, 34u8);
            let nname = sb_new();
            sb_push_lit(&nname, "\"name\":\"", 8);
            json_esc(&nname, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
            sb_push_lit(&nname, "__ovr_", 6);
            json_esc(&nname, x_ptr(x, nd.n_off), nd.n_len as u64);
            sb_push_byte(&nname, 34u8);
            let pos2 = find_sub(clone.data as ptr, clone.len, oname.data as ptr, oname.len);
            if pos2 >= 0 {
                let nf2 = sb_new();
                sb_push_span(&nf2, clone.data as ptr, pos2 as u64);
                sb_push_span(&nf2, nname.data as ptr, nname.len);
                sb_push_span(&nf2, sx_ptr_add(clone.data as ptr, (pos2 as u64) + oname.len), clone.len - (pos2 as u64) - oname.len);
                clone = nf2;
            };
            fl_push(&gout.frags, &gout.meshf, &clone);
            mx = gout.meshf.off.len() - 1;
            let ckey = sb_new();
            sb_push_span(&ckey, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
            sb_push_lit(&ckey, "__ovr_", 6);
            sb_push_span(&ckey, x_ptr(x, nd.n_off), nd.n_len as u64);
            ni_put_raw(&gout.frags, &gout.mesh_index, ckey.data as ptr, ckey.len, mx);
            let mm = sb_new();
            sb_push_lit(&mm, "node '", 6);
            sb_push_span(&mm, x_ptr(x, nd.n_off), nd.n_len as u64);
            sb_push_lit(&mm, "': SAX3D material override '", 28);
            sb_push_span(&mm, x_ptr(x, nd.mat_off), nd.mat_len as u64);
            sb_push_lit(&mm, "' has no glTF node-level form; mesh cloned as '", 47);
            sb_push_span(&mm, x_ptr(x, nd.mesh_off), nd.mesh_len as u64);
            sb_push_lit(&mm, "__ovr_", 6);
            sb_push_span(&mm, x_ptr(x, nd.n_off), nd.n_len as u64);
            sb_push_byte(&mm, 39u8);
            cv_led(cv, "APPROX", 6, &mm);
        };
        sb_push_lit(&f, ",\"mesh\":", 8);
        sb_push_i64(&f, mx as i64);
    };
    if nd.skin_len > 0 {
        let sx2 = ni_get(&gout.frags, &gout.skin_index, x, nd.skin_off, nd.skin_len);
        if sx2 < 0 {
            sb_push_lit(&cv.x.msg, "skin '", 6);
            sb_push_span(&cv.x.msg, x_ptr(x, nd.skin_off), nd.skin_len as u64);
            sb_push_lit(&cv.x.msg, "' unknown", 9);
            return cv_fail(cv, "CvtBadInput", 11);
        };
        sb_push_lit(&f, ",\"skin\":", 8);
        sb_push_i64(&f, sx2 as i64);
    };
    if kids.len() > 0 {
        sb_push_lit(&f, ",\"children\":[", 13);
        let ki = 0;
        while ki < kids.len() {
            if ki > 0 { sb_push_byte(&f, 44u8); };
            sb_push_i64(&f, kids[ki as usize] as i64);
            ki = ki + 1;
        }
        sb_push_byte(&f, 93u8);
    };
    sb_push_byte(&f, 125u8);
    fl_set(&gout.frags, &gout.nodef, my_idx, &f);
    *idx_out = my_idx;
    return true;
}

// ---- to-gltf: 场景/骨骼/动画 ----

fn gltf_scenes_skins_anims(cv: &CV, x: &X, gout: &GOut) -> bool {
    let si = 0;
    let nsk = x.skels.len();
    while si < nsk {
        let sk = x.skels[si as usize];
        ni_put(&gout.frags, &gout.skin_index, x, sk.n_off, sk.n_len, si);
        si = si + 1;
    }
    let sci = 0;
    let nsc = x.scenes.len();
    while sci < nsc {
        let sc = x.scenes[sci as usize];
        let roots = Vec::new();
        let rj = 0;
        while rj < sc.r_len {
            let ridx = 0;
            if !gltf_node_emit(cv, x, gout, x.idxpool[(sc.r_off + rj) as usize], &ridx) { return false; };
            roots.push(ridx);
            rj = rj + 1;
        }
        let f = sb_new();
        sb_push_lit(&f, "{\"name\":\"", 9);
        json_esc(&f, x_ptr(x, sc.n_off), sc.n_len as u64);
        sb_push_lit(&f, "\",\"nodes\":[", 11);
        let ki = 0;
        while ki < roots.len() {
            if ki > 0 { sb_push_byte(&f, 44u8); };
            sb_push_i64(&f, roots[ki as usize] as i64);
            ki = ki + 1;
        }
        sb_push_lit(&f, "]}", 2);
        fl_push(&gout.frags, &gout.scenef, &f);
        sci = sci + 1;
    }
    // skins
    let sj = 0;
    while sj < nsk {
        let sk = x.skels[sj as usize];
        let f = sb_new();
        sb_push_lit(&f, "{\"name\":\"", 9);
        json_esc(&f, x_ptr(x, sk.n_off), sk.n_len as u64);
        sb_push_lit(&f, "\",\"joints\":[", 12);
        let jj = sk.j_off;
        let first = true;
        while jj < (sk.j_off + sk.j_len) {
            let jt = x.joints[jj as usize];
            let nx = ni_get(&gout.frags, &gout.node_index, x, jt.n_off, jt.n_len);
            if nx < 0 {
                sb_push_lit(&cv.x.msg, "joint '", 7);
                sb_push_span(&cv.x.msg, x_ptr(x, jt.n_off), jt.n_len as u64);
                sb_push_lit(&cv.x.msg, "' has no scene node", 19);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            if !first { sb_push_byte(&f, 44u8); };
            first = false;
            sb_push_i64(&f, nx as i64);
            jj = jj + 1;
        }
        sb_push_byte(&f, 93u8);
        if sk.ib_len > 0 {
            let bytes = sb_new();
            if !chan_bytes(cv, gout, x, sk.ib_off, sk.ib_len, &bytes) { return false; };
            let ax = go_add_acc(cv, gout, x_ptr(x, sk.ib_off), sk.ib_len as u64, bytes.data as ptr, bytes.len, 5126, "MAT4", 4, false);
            sb_push_lit(&f, ",\"inverseBindMatrices\":", 23);
            sb_push_i64(&f, ax as i64);
        };
        sb_push_byte(&f, 125u8);
        fl_push(&gout.frags, &gout.skinf, &f);
        sj = sj + 1;
    }
    // clips
    let ai = 0;
    let na = x.clips.len();
    while ai < na {
        let cl = x.clips[ai as usize];
        let smp_index = ni_new();
        let smp_frags = fl_new();
        let sj2 = cl.sa_off;
        while sj2 < (cl.sa_off + cl.sa_len) {
            let samp = x.samps[sj2 as usize];
            ni_put(&gout.frags, &smp_index, x, samp.n_off, samp.n_len, sj2 - cl.sa_off);
            let ib = sb_new();
            if !chan_bytes(cv, gout, x, samp.is_off, samp.is_len, &ib) { return false; };
            let in_ax = go_add_acc(cv, gout, x_ptr(x, samp.is_off), samp.is_len as u64, ib.data as ptr, ib.len, 5126, "SCALAR", 6, false);
            let ob = sb_new();
            if !chan_bytes(cv, gout, x, samp.os_off, samp.os_len, &ob) { return false; };
            let otyc = 4;
            if ar_eq_lit(x, samp.ot_off, samp.ot_len, "f32x3", 5) { otyc = 3; }
            else if ar_eq_lit(x, samp.ot_off, samp.ot_len, "f32", 3) { otyc = 6; };
            let out_ax = 0;
            if otyc == 3 { out_ax = go_add_acc(cv, gout, x_ptr(x, samp.os_off), samp.os_len as u64, ob.data as ptr, ob.len, 5126, "VEC3", 4, false); }
            else if otyc == 6 { out_ax = go_add_acc(cv, gout, x_ptr(x, samp.os_off), samp.os_len as u64, ob.data as ptr, ob.len, 5126, "SCALAR", 6, false); }
            else { out_ax = go_add_acc(cv, gout, x_ptr(x, samp.os_off), samp.os_len as u64, ob.data as ptr, ob.len, 5126, "VEC4", 4, false); };
            let sf = sb_new();
            sb_push_lit(&sf, "{\"input\":", 9);
            sb_push_i64(&sf, in_ax as i64);
            sb_push_lit(&sf, ",\"interpolation\":\"", 18);
            if ar_eq_lit(x, samp.ip_off, samp.ip_len, "step", 4) { sb_push_lit(&sf, "STEP", 4); }
            else if ar_eq_lit(x, samp.ip_off, samp.ip_len, "cubic-spline", 12) { sb_push_lit(&sf, "CUBICSPLINE", 11); }
            else { sb_push_lit(&sf, "LINEAR", 6); };
            sb_push_lit(&sf, "\",\"output\":", 11);
            sb_push_i64(&sf, out_ax as i64);
            sb_push_byte(&sf, 125u8);
            fl_push(&gout.frags, &smp_frags, &sf);
            sj2 = sj2 + 1;
        }
        let ch_frags = fl_new();
        let cj = cl.ch_off;
        while cj < (cl.ch_off + cl.ch_len) {
            let cch = x.cchs[cj as usize];
            let nx = ni_get(&gout.frags, &gout.node_index, x, cch.nd_off, cch.nd_len);
            if nx < 0 {
                sb_push_lit(&cv.x.msg, "clip channel node '", 19);
                sb_push_span(&cv.x.msg, x_ptr(x, cch.nd_off), cch.nd_len as u64);
                sb_push_lit(&cv.x.msg, "' not in any scene", 18);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let sx3 = ni_get(&gout.frags, &smp_index, x, cch.sa_off, cch.sa_len);
            if sx3 < 0 {
                sb_push_lit(&cv.x.msg, "clip sampler '", 14);
                sb_push_span(&cv.x.msg, x_ptr(x, cch.sa_off), cch.sa_len as u64);
                sb_push_lit(&cv.x.msg, "' unknown", 9);
                return cv_fail(cv, "CvtBadInput", 11);
            };
            let cf = sb_new();
            sb_push_lit(&cf, "{\"sampler\":", 11);
            sb_push_i64(&cf, sx3 as i64);
            sb_push_lit(&cf, ",\"target\":{\"node\":", 18);
            sb_push_i64(&cf, nx as i64);
            sb_push_lit(&cf, ",\"path\":\"", 9);
            sb_push_span(&cf, x_ptr(x, cch.pa_off), cch.pa_len as u64);
            sb_push_lit(&cf, "\"}}", 3);
            fl_push(&gout.frags, &ch_frags, &cf);
            cj = cj + 1;
        }
        let f = sb_new();
        sb_push_lit(&f, "{\"name\":\"", 9);
        json_esc(&f, x_ptr(x, cl.n_off), cl.n_len as u64);
        sb_push_lit(&f, "\",\"channels\":[", 14);
        join_frags(&gout.frags, &f, &ch_frags.off, &ch_frags.len, 0, ch_frags.off.len());
        sb_push_lit(&f, "],\"samplers\":[", 14);
        join_frags(&gout.frags, &f, &smp_frags.off, &smp_frags.len, 0, smp_frags.off.len());
        sb_push_lit(&f, "]}", 2);
        fl_push(&gout.frags, &gout.animf, &f);
        ai = ai + 1;
    }
    return true;
}

// ---- to-gltf: 收尾（outdir 语义：写 {base}.gltf/.bin/.glb） ----

fn arr_field_raw(frags: &SBuf, j: &SBuf, name: ptr, name_n: u64, offs: &Vec<i32>, lens: &Vec<i32>) {
    if offs.len() == 0 { return; };
    sb_push_byte(j, 44u8);
    sb_push_byte(j, 34u8);
    sb_push_span(j, name, name_n);
    sb_push_lit(j, "\":[", 3);
    join_frags(frags, j, offs, lens, 0, offs.len());
    sb_push_byte(j, 93u8);
}

fn gltf_finish(cv: &CV, x: &X, gout: &GOut, out_p: ptr, out_n: u64) -> bool {
    let base = sb_new();
    if x.a_name_len > 0 {
        sb_push_span(&base, x_ptr(x, x.a_name_off), x.a_name_len as u64);
    } else {
        sb_push_lit(&base, "asset", 5);
    };
    sx_mkdir_p(out_p, out_n);
    let j = sb_new();
    sb_push_lit(&j, "{\"asset\":{\"version\":\"2.0\",\"generator\":\"sax3dcvt\"}", 49);
    if gout.scenef.off.len() > 0 {
        sb_push_lit(&j, ",\"scene\":0,\"scenes\":[", 21);
        join_frags(&gout.frags, &j, &gout.scenef.off, &gout.scenef.len, 0, gout.scenef.off.len());
        sb_push_byte(&j, 93u8);
    };
    arr_field_raw(&gout.frags, &j, "nodes", 5, &gout.nodef.off, &gout.nodef.len);
    arr_field_raw(&gout.frags, &j, "meshes", 6, &gout.meshf.off, &gout.meshf.len);
    arr_field_raw(&gout.frags, &j, "materials", 9, &gout.matf.off, &gout.matf.len);
    arr_field_raw(&gout.frags, &j, "textures", 8, &gout.texf.off, &gout.texf.len);
    arr_field_raw(&gout.frags, &j, "samplers", 8, &gout.smpf.off, &gout.smpf.len);
    arr_field_raw(&gout.frags, &j, "images", 6, &gout.imgf.off, &gout.imgf.len);
    arr_field_raw(&gout.frags, &j, "skins", 5, &gout.skinf.off, &gout.skinf.len);
    arr_field_raw(&gout.frags, &j, "animations", 10, &gout.animf.off, &gout.animf.len);
    if gout.ext_off.len() > 0 {
        sb_push_lit(&j, ",\"extensionsUsed\":[", 19);
        let ei = 0;
        while ei < gout.ext_off.len() {
            if ei > 0 { sb_push_byte(&j, 44u8); };
            sb_push_byte(&j, 34u8);
            put_span(cv, &j, gout.ext_off[ei as usize], gout.ext_len[ei as usize]);
            sb_push_byte(&j, 34u8);
            ei = ei + 1;
        }
        sb_push_byte(&j, 93u8);
    };
    sb_push_lit(&j, ",\"bufferViews\":[", 16);
    join_frags(&gout.frags, &j, &gout.bv_off, &gout.bv_len, 0, gout.bv_off.len());
    sb_push_lit(&j, "],\"accessors\":[", 15);
    join_frags(&gout.frags, &j, &gout.ac_off, &gout.ac_len, 0, gout.ac_off.len());
    sb_push_lit(&j, "],\"buffers\":[{\"byteLength\":", 27);
    sb_push_u64(&j, gout.bin.len);
    sb_push_lit(&j, ",\"uri\":\"", 8);
    sb_push_span(&j, base.data as ptr, base.len);
    sb_push_lit(&j, ".bin\"}]}", 8);
    // 路径
    let gltf_path = sb_new();
    sb_push_span(&gltf_path, out_p, out_n);
    sb_push_byte(&gltf_path, 47u8);
    sb_push_span(&gltf_path, base.data as ptr, base.len);
    sb_push_lit(&gltf_path, ".gltf", 5);
    let bin_path = sb_new();
    sb_push_span(&bin_path, out_p, out_n);
    sb_push_byte(&bin_path, 47u8);
    sb_push_span(&bin_path, base.data as ptr, base.len);
    sb_push_lit(&bin_path, ".bin", 4);
    let glb_path = sb_new();
    sb_push_span(&glb_path, out_p, out_n);
    sb_push_byte(&glb_path, 47u8);
    sb_push_span(&glb_path, base.data as ptr, base.len);
    sb_push_lit(&glb_path, ".glb", 4);
    if sx_write_file(gltf_path.data as ptr, gltf_path.len, j.data as ptr, j.len) != 0 {
        sb_push_lit(&cv.x.msg, "write gltf failed", 17);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    if sx_write_file(bin_path.data as ptr, bin_path.len, gout.bin.data as ptr, gout.bin.len) != 0 {
        sb_push_lit(&cv.x.msg, "write bin failed", 16);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    // GLB
    let glb = sb_new();
    let jp = (4 - (j.len % 4)) % 4;
    let bp = (4 - (gout.bin.len % 4)) % 4;
    let total = 12 + 8 + j.len + jp + 8 + gout.bin.len + bp;
    wr_u32le(&glb, 1179937895);
    wr_u32le(&glb, 2);
    wr_u32le(&glb, total as u32);
    wr_u32le(&glb, (j.len + jp) as u32);
    wr_u32le(&glb, 1313821514);
    sb_push_span(&glb, j.data as ptr, j.len);
    let q = 0;
    while q < jp { sb_push_byte(&glb, 32u8); q = q + 1; }
    wr_u32le(&glb, (gout.bin.len + bp) as u32);
    wr_u32le(&glb, 5130562);
    sb_push_span(&glb, gout.bin.data as ptr, gout.bin.len);
    let q2 = 0;
    while q2 < bp { sb_push_byte(&glb, 0u8); q2 = q2 + 1; }
    if sx_write_file(glb_path.data as ptr, glb_path.len, glb.data as ptr, glb.len) != 0 {
        sb_push_lit(&cv.x.msg, "write glb failed", 16);
        return cv_fail(cv, "CvtBadInput", 11);
    };
    let w = sb_new();
    sb_push_lit(&w, "WROTE ", 6);
    sb_push_span(&w, gltf_path.data as ptr, gltf_path.len);
    sb_push_lit(&w, " / .bin / .glb (json ", 21);
    sb_push_u64(&w, j.len);
    sb_push_lit(&w, "B, bin ", 7);
    sb_push_u64(&w, gout.bin.len);
    sb_push_lit(&w, "B)\n", 3);
    sx_err_buf(&w);
    return true;
}

// ---------------- main ----------------

fn arg_eq(abuf: &SBuf, aoffs: &Vec<i32>, alens: &Vec<i32>, k: i32, lit: ptr, lit_n: u64) -> bool {
    if (alens[k as usize] as u64) != lit_n { return false; };
    return sx_spans_eq(sx_ptr_add(abuf.data as ptr, aoffs[k as usize] as u64), lit_n, lit, lit_n);
}

fn run_main() -> i32 {
    let jh = sa_env_args_json();
    let abuf = sb_new();
    let aoffs: Vec<i32> = Vec::new();
    let alens: Vec<i32> = Vec::new();
    sx_parse_argv(jh, &abuf, &aoffs, &alens);
    let argc = aoffs.len();
    if argc < 2 {
        sx_err("usage: convert <to-sax3d|to-gltf> ...\n", 38);
        return 2;
    };
    let cv = cv_new();
    let ok = true;
    if arg_eq(&abuf, &aoffs, &alens, 1, "to-sax3d", 8) {
        if argc < 4 {
            sx_err("usage: convert to-sax3d <in.gltf|in.glb> <outdir> [--fixtures-dir <dir>]\n", 73);
            return 2;
        };
        let fix_idx = -1;
        let i = 4;
        while i < argc {
            if arg_eq(&abuf, &aoffs, &alens, i, "--fixtures-dir", 14) && ((i + 1) < argc) {
                i = i + 1;
                fix_idx = i;
            };
            i = i + 1;
        }
        if fix_idx >= 0 {
            ok = to_sax3d(&cv, sx_ptr_add(abuf.data as ptr, aoffs[2] as u64), alens[2] as u64, sx_ptr_add(abuf.data as ptr, aoffs[3] as u64), alens[3] as u64, sx_ptr_add(abuf.data as ptr, aoffs[fix_idx as usize] as u64), alens[fix_idx as usize] as u64);
        } else {
            ok = to_sax3d(&cv, sx_ptr_add(abuf.data as ptr, aoffs[2] as u64), alens[2] as u64, sx_ptr_add(abuf.data as ptr, aoffs[3] as u64), alens[3] as u64, "converter/fixtures", 18);
        };
    } else if arg_eq(&abuf, &aoffs, &alens, 1, "to-gltf", 7) {
        if argc < 5 {
            sx_err("usage: convert to-gltf <in.sax3d> <in.saxb3d> <outdir> [--iface <Shader>=<file>]...\n", 84);
            return 2;
        };
        let spec_off: Vec<i32> = Vec::new();
        let spec_len: Vec<i32> = Vec::new();
        let std_off: Vec<i32> = Vec::new();
        let std_len: Vec<i32> = Vec::new();
        let i = 5;
        while i < argc {
            if arg_eq(&abuf, &aoffs, &alens, i, "--iface", 7) && ((i + 1) < argc) {
                i = i + 1;
                let o = 0; let l = 0;
                cv_str(&cv, sx_ptr_add(abuf.data as ptr, aoffs[i as usize] as u64), alens[i as usize] as u64, &o, &l);
                spec_off.push(o);
                spec_len.push(l);
            };
            if arg_eq(&abuf, &aoffs, &alens, i, "--std-shader", 12) && ((i + 1) < argc) {
                i = i + 1;
                let o = 0; let l = 0;
                cv_str(&cv, sx_ptr_add(abuf.data as ptr, aoffs[i as usize] as u64), alens[i as usize] as u64, &o, &l);
                std_off.push(o);
                std_len.push(l);
            };
            i = i + 1;
        }
        ok = to_gltf(&cv, sx_ptr_add(abuf.data as ptr, aoffs[2] as u64), alens[2] as u64, sx_ptr_add(abuf.data as ptr, aoffs[3] as u64), alens[3] as u64, sx_ptr_add(abuf.data as ptr, aoffs[4] as u64), alens[4] as u64, &spec_off, &spec_len, &std_off, &std_len);
    } else {
        let m = sb_new();
        sb_push_lit(&m, "unknown subcommand '", 20);
        sb_push_span(&m, sx_ptr_add(abuf.data as ptr, aoffs[1] as u64), alens[1] as u64);
        sb_push_lit(&m, "'\n", 2);
        sx_err_buf(&m);
        return 2;
    };
    cv_led_print(&cv);
    let mut_code = 0;
    if !ok { mut_code = 1; };
    if diag_count(&cv.x) > 0 {
        diag_print_all(&cv.x);
        mut_code = 1;
    };
    return mut_code;
}

fn main() -> i32 {
    return run_main();
}
