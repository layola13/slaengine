// model.sla  SAX3D  AST  model.zig
// / arena x.ar  (off,len) i32
// len<0  arenaVec<>
//  (off,len)  x.msg 
//  diag_commit  arena 

@import "core.sla"
@import "numfmt.sla"
@import "schema_gen.sla"

struct Diag {
    c_off: i32,
    c_len: i32,
    m_off: i32,
    m_len: i32,
}

// 通用跨度二元组（函数返回值用）
struct Span2 {
    off: i32,
    len: i32,
}

// 字面量（ParamA 的无名形态）：0 标量，1 向量，2 布尔
struct Lit {
    kind: i32,
    val: f64,
    v_off: i32,
    v_len: i32,
    bval: i32,
}

struct SecD {
    n_off: i32, n_len: i32, len: u64,
}

struct ShaderD {
    n_off: i32, n_len: i32, p_off: i32, p_len: i32,
}

struct ChanD {
    n_off: i32, n_len: i32, t_off: i32, t_len: i32, s_off: i32, s_len: i32,
    custom: i32,
}

struct MorphD {
    n_off: i32, n_len: i32, ch_off: i32, ch_len: i32,
}

struct PrimD {
    n_off: i32, n_len: i32, m_off: i32, m_len: i32,
}

struct MeshD {
    n_off: i32, n_len: i32,
    topo_off: i32, topo_len: i32,
    vertices: u64,
    has_bounds: i32, bmin: i32, bmax: i32,
    ch_off: i32, ch_len: i32,
    mo_off: i32, mo_len: i32,
    pr_off: i32, pr_len: i32,
    ity_off: i32, ity_len: i32, isec_off: i32, isec_len: i32, icount: u64,
}

struct JointD {
    n_off: i32, n_len: i32,
    has_parent: i32, p_off: i32, p_len: i32,
    has_bind: i32, bt: i32, br: i32, bs: i32,
}

struct SkelD {
    n_off: i32, n_len: i32, j_off: i32, j_len: i32, ib_off: i32, ib_len: i32,
}

struct ImgD {
    n_off: i32, n_len: i32,
    kind: i32, // 0=section 1=path 
    s_off: i32, s_len: i32,
    f_off: i32, f_len: i32,
    has_size: i32, w: u64, h: u64,
    c_off: i32, c_len: i32,
}

struct TexD {
    n_off: i32, n_len: i32, i_off: i32, i_len: i32,
    smp: i32,
    mag_off: i32, mag_len: i32, min_off: i32, min_len: i32,
    mip_off: i32, mip_len: i32,
    wu_off: i32, wu_len: i32, wv_off: i32, wv_len: i32, ww_off: i32, ww_len: i32,
}

struct ParamA {
    n_off: i32, n_len: i32,
    kind: i32, // 0 1 2 
    val: f64, v_off: i32, v_len: i32, bval: i32,
}

struct TBindD {
    n_off: i32, n_len: i32, t_off: i32, t_len: i32,
}

struct TTrD {
    n_off: i32, n_len: i32, off_v: i32, scl_v: i32, has_rot: i32, rot: f64,
}

struct MatD {
    n_off: i32, n_len: i32, sh_off: i32, sh_len: i32,
    pa_off: i32, pa_len: i32,
    tb_off: i32, tb_len: i32,
    tt_off: i32, tt_len: i32,
    al_off: i32, al_len: i32,
    has_cut: i32, cut: f64,
    ds: i32, dw: i32, // -1 0 false1 true
}

struct NodeD {
    n_off: i32, n_len: i32,
    has_tr: i32, tt: i32, tr: i32, ts: i32,
    mtx: i32,
    mesh_off: i32, mesh_len: i32,
    mat_off: i32, mat_len: i32,
    skin_off: i32, skin_len: i32,
    ch_off: i32, ch_len: i32,
}

struct SceneD {
    n_off: i32, n_len: i32, r_off: i32, r_len: i32,
}

struct SampD {
    n_off: i32, n_len: i32,
    it_off: i32, it_len: i32, is_off: i32, is_len: i32, icnt: u64,
    ot_off: i32, ot_len: i32, os_off: i32, os_len: i32, ocnt: u64,
    ip_off: i32, ip_len: i32,
}

struct CChD {
    nd_off: i32, nd_len: i32, pa_off: i32, pa_len: i32, sa_off: i32, sa_len: i32,
}

struct ClipD {
    n_off: i32, n_len: i32, sa_off: i32, sa_len: i32, ch_off: i32, ch_len: i32,
}

// 
struct IfParam {
    n_off: i32, n_len: i32, t_off: i32, t_len: i32,
    has_def: i32, has_ds: i32, ds: f64,
}

struct IfEnt {
    n_off: i32, n_len: i32, t_off: i32, t_len: i32,
}

struct Iface {
    params: Vec<IfParam>,
    texs: Vec<IfEnt>,
    inputs: Vec<IfEnt>,
}

//  ->  //
struct MapEnt {
    n_off: i32, n_len: i32, v0: i64, v1: i64,
}

struct NodeInfo {
    node: i32, has_parent: i32, p_off: i32, p_len: i32,
}

// One planned section of a binary layout (layout.sla): name span,
// schema kind value, alignment, payload len and assigned file offset.
struct PlanRec {
    n_off: i32, n_len: i32, kind: i32, align: i32, len: u64, offset: u64,
}

struct X {
    ar: SBuf,          //  arena
    msg: SBuf,         // 
    diags: Vec<Diag>,
    // ---- asset parse  Asset  ----
    a_name_off: i32, a_name_len: i32, a_version: u64,
    a_has_binary: i32, a_binfile_off: i32, a_binfile_len: i32,
    secs: Vec<SecD>,
    shaders: Vec<ShaderD>,
    meshes: Vec<MeshD>,
    skels: Vec<SkelD>,
    imgs: Vec<ImgD>,
    texs: Vec<TexD>,
    mats: Vec<MatD>,
    scenes: Vec<SceneD>,
    clips: Vec<ClipD>,
    // ----  ----
    chans: Vec<ChanD>,
    mchans: Vec<ChanD>, // morph channels live apart (Zig: per-morph lists; flat mesh slices must stay base-only)
    morphs: Vec<MorphD>,
    prims: Vec<PrimD>,
    joints: Vec<JointD>,
    params: Vec<ParamA>,
    tbinds: Vec<TBindD>,
    ttrs: Vec<TTrD>,
    nodes: Vec<NodeD>,
    samps: Vec<SampD>,
    cchs: Vec<CChD>,
    vecpool: Vec<u64>, // f64 BIT patterns (GAP-PORT-7: Vec<f64> storage truncates via int conversion)
    idxpool: Vec<i32>,
    // ----  shader  ----
    if_names_off: Vec<i32>,
    if_names_len: Vec<i32>,
    ifaces: Vec<Iface>,
    // ---- check  ----
    sec_lens: Vec<MapEnt>,   //  -> len
    res: Vec<MapEnt>,        //  -> (v0=kind, v1=align)
    // ---- layout / name table (layout.sla) ----
    plans: Vec<PlanRec>,
    lay_end: u64,            // payload end = name table file offset
    nt_noff: Vec<i32>,       // name table: name spans in canonical order
    nt_nlen: Vec<i32>,
    nt_map: Vec<MapEnt>,     // name span -> (v0 = table index, v1 = off in blob)
    nt_blob: SBuf,           // NUL-separated name table bytes
}

fn x_new() -> X {
    return X {
        ar: sb_new(),
        msg: sb_new(),
        diags: Vec::new(),
        a_name_off: 0, a_name_len: 0, a_version: 0,
        a_has_binary: 0, a_binfile_off: 0, a_binfile_len: 0,
        secs: Vec::new(),
        shaders: Vec::new(),
        meshes: Vec::new(),
        skels: Vec::new(),
        imgs: Vec::new(),
        texs: Vec::new(),
        mats: Vec::new(),
        scenes: Vec::new(),
        clips: Vec::new(),
        chans: Vec::new(),
        mchans: Vec::new(),
        morphs: Vec::new(),
        prims: Vec::new(),
        joints: Vec::new(),
        params: Vec::new(),
        tbinds: Vec::new(),
        ttrs: Vec::new(),
        nodes: Vec::new(),
        samps: Vec::new(),
        cchs: Vec::new(),
        vecpool: Vec::new(),
        idxpool: Vec::new(),
        if_names_off: Vec::new(),
        if_names_len: Vec::new(),
        ifaces: Vec::new(),
        sec_lens: Vec::new(),
        res: Vec::new(),
        plans: Vec::new(),
        lay_end: 0,
        nt_noff: Vec::new(),
        nt_nlen: Vec::new(),
        nt_map: Vec::new(),
        nt_blob: sb_new(),
    };
}

//  arena (off,len)
fn x_intern(x: &X, p: ptr, n: u64) -> i32 {
    let off = x.ar.len;
    sb_push_span(&x.ar, p, n);
    return off as i32;
}

fn x_intern_lit(x: &X, p: ptr, n: u64) -> i32 {
    return x_intern(x, p, n);
}

// 
fn x_ptr(x: &X, off: i32) -> ptr {
    return sx_ptr_add(x.ar.data as ptr, off as u64);
}

fn x_byte(x: &X, off: i32) -> u8 {
    return PTR_BYTE_AT(x.ar.data as ptr, off as u64);
}

fn x_eq(x: &X, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    if l1 != l2 || l1 < 0 {
        return false;
    };
    return sx_spans_eq(x_ptr(x, o1), l1 as u64, x_ptr(x, o2), l2 as u64);
}

fn x_eq_lit(x: &X, o: i32, l: i32, lp: ptr, ll: u64) -> bool {
    if l < 0 || (l as u64) != ll {
        return false;
    };
    return sx_spans_eq(x_ptr(x, o), ll, lp, ll);
}

// ------------------------------------------------------------------
// mb_*  x.msg diag_commit 
// ------------------------------------------------------------------

fn mb_clear(x: &X) {
    sb_clear(&x.msg);
}

fn mb_lit(x: &X, p: ptr, n: u64) {
    sb_push_span(&x.msg, p, n);
}

fn mb_span(x: &X, off: i32, len: i32) {
    if len > 0 {
        sb_push_span(&x.msg, x_ptr(x, off), len as u64);
    };
}

fn mb_u64(x: &X, v: u64) {
    sb_push_u64(&x.msg, v);
}

fn mb_i64(x: &X, v: i64) {
    sb_push_i64(&x.msg, v);
}

fn mb_f64(x: &X, v: f64) {
    nf_push_f64(&x.msg, v);
}

fn mb_hex32(x: &X, v: u32) {
    sb_push_hex_u64(&x.msg, v as u64);
}

fn mb_buf(x: &X, b: &SBuf, off: u64, n: u64) {
    sb_push_span(&x.msg, sx_ptr_add(b.data as ptr, off), n);
}

fn diag_commit(x: &X, code_p: ptr, code_n: u64) {
    let c_off = x.ar.len as i32;
    sb_push_span(&x.ar, code_p, code_n);
    let m_off = x.ar.len as i32;
    sb_push_span(&x.ar, x.msg.data as ptr, x.msg.len);
    x.diags.push(Diag { c_off: c_off, c_len: code_n as i32, m_off: m_off, m_len: x.msg.len as i32 });
    sb_clear(&x.msg);
}

fn diag_count(x: &X) -> i32 {
    return x.diags.len() as i32;
}

fn diag_print_all(x: &X) {
    let out = sb_new();
    let i: i32 = 0;
    let n = x.diags.len() as i32;
    while i < n {
        let d = x.diags[i as usize];
        sb_push_lit(&out, STR_PTR("SAX3D-E "), STR_LEN("SAX3D-E "));
        sb_push_span(&out, x_ptr(x, d.c_off), d.c_len as u64);
        sb_push_lit(&out, STR_PTR(": "), STR_LEN(": "));
        sb_push_span(&out, x_ptr(x, d.m_off), d.m_len as u64);
        sb_push_byte(&out, 10);
        i = i + 1;
    }
    sx_err_buf(&out);
}

// ------------------------------------------------------------------
// Literal.typeName 
// ------------------------------------------------------------------

fn lit_type_name(x: &X, kind: i32, vlen: i32, out: &SBuf) {
    if kind == 0 {
        sb_push_lit(out, STR_PTR("f32"), STR_LEN("f32"));
        return;
    };
    if kind == 2 {
        sb_push_lit(out, STR_PTR("bool"), STR_LEN("bool"));
        return;
    };
    if vlen == 2 {
        sb_push_lit(out, STR_PTR("vec2"), STR_LEN("vec2"));
        return;
    };
    if vlen == 3 {
        sb_push_lit(out, STR_PTR("vec3"), STR_LEN("vec3"));
        return;
    };
    if vlen == 4 {
        sb_push_lit(out, STR_PTR("vec4"), STR_LEN("vec4"));
        return;
    };
    if vlen == 16 {
        sb_push_lit(out, STR_PTR("mat4"), STR_LEN("mat4"));
        return;
    };
    sb_push_lit(out, STR_PTR("vecN"), STR_LEN("vecN"));
}

// 
fn is_canon_channel(x: &X, o: i32, l: i32) -> bool {
    if x_eq_lit(x, o, l, STR_PTR("position"), STR_LEN("position")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("normal"), STR_LEN("normal")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("tangent"), STR_LEN("tangent")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv0"), STR_LEN("uv0")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv1"), STR_LEN("uv1")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv2"), STR_LEN("uv2")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv3"), STR_LEN("uv3")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("color0"), STR_LEN("color0")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("joints0"), STR_LEN("joints0")) { return true; };
    if x_eq_lit(x, o, l, STR_PTR("weights0"), STR_LEN("weights0")) { return true; };
    return false;
}

//  -> shader @input  out true
fn channel_input_name(x: &X, o: i32, l: i32, out: &SBuf) -> bool {
    if x_eq_lit(x, o, l, STR_PTR("position"), STR_LEN("position")) { sb_push_lit(out, STR_PTR("position"), STR_LEN("position")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("normal"), STR_LEN("normal")) { sb_push_lit(out, STR_PTR("normal"), STR_LEN("normal")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("tangent"), STR_LEN("tangent")) { sb_push_lit(out, STR_PTR("tangent"), STR_LEN("tangent")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv0"), STR_LEN("uv0")) { sb_push_lit(out, STR_PTR("uv"), STR_LEN("uv")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv1"), STR_LEN("uv1")) { sb_push_lit(out, STR_PTR("uv1"), STR_LEN("uv1")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv2"), STR_LEN("uv2")) { sb_push_lit(out, STR_PTR("uv2"), STR_LEN("uv2")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("uv3"), STR_LEN("uv3")) { sb_push_lit(out, STR_PTR("uv3"), STR_LEN("uv3")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("color0"), STR_LEN("color0")) { sb_push_lit(out, STR_PTR("color"), STR_LEN("color")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("joints0"), STR_LEN("joints0")) { sb_push_lit(out, STR_PTR("joints"), STR_LEN("joints")); return true; };
    if x_eq_lit(x, o, l, STR_PTR("weights0"), STR_LEN("weights0")) { sb_push_lit(out, STR_PTR("weights"), STR_LEN("weights")); return true; };
    return false;
}

// ------------------------------------------------------------------
// MapEnt 
// ------------------------------------------------------------------

// Maps live inside X (sec_lens / res). Access goes through these helpers
// with a map selector: passing &x.field and &x in one call is a
// BorrowConflict, so the field is never lent out separately.
// which_map: 0 = sec_lens, 1 = res.  which_val: 0 = v0, 1 = v1.
fn xmap_len(x: &X, wm: i32) -> i32 {
    if wm == 0 {
        return x.sec_lens.len() as i32;
    };
    return x.res.len() as i32;
}

fn xmap_ent(x: &X, wm: i32, i: i32) -> MapEnt {
    if wm == 0 {
        return x.sec_lens[i as usize];
    };
    return x.res[i as usize];
}

fn xmap_get(x: &X, wm: i32, o: i32, l: i32, wv: i32, out: ptr) -> bool {
    let i: i32 = 0;
    let n = xmap_len(x, wm);
    while i < n {
        let e = xmap_ent(x, wm, i);
        if e.n_len == l && x_eq(x, e.n_off, e.n_len, o, l) {
            if wv == 0 {
                sx_cell_put_u64(out, e.v0 as u64);
            } else {
                sx_cell_put_u64(out, e.v1 as u64);
            };
            return true;
        };
        i = i + 1;
    }
    return false;
}

fn xmap_has(x: &X, wm: i32, o: i32, l: i32) -> bool {
    let i: i32 = 0;
    let n = xmap_len(x, wm);
    while i < n {
        let e = xmap_ent(x, wm, i);
        if e.n_len == l && x_eq(x, e.n_off, e.n_len, o, l) {
            return true;
        };
        i = i + 1;
    }
    return false;
}

fn xmap_put(x: &X, wm: i32, o: i32, l: i32, v0: i64, v1: i64) {
    let i: i32 = 0;
    let n = xmap_len(x, wm);
    while i < n {
        let e = xmap_ent(x, wm, i);
        if e.n_len == l && x_eq(x, e.n_off, e.n_len, o, l) {
            // GAP-PORT-5: storage ops inlined here; routing the MapEnt
            // through a by-value helper param (xmap_set/xmap_push) and
            // then pushing it corrupts the stored entries
            // (probes v_map7/v_map9 broken, v_map10 inlined = clean).
            if wm == 0 {
                x.sec_lens[i as usize] = MapEnt { n_off: o, n_len: l, v0: v0, v1: v1 };
            } else {
                x.res[i as usize] = MapEnt { n_off: o, n_len: l, v0: v0, v1: v1 };
            };
            return;
        };
        i = i + 1;
    }
    if wm == 0 {
        x.sec_lens.push(MapEnt { n_off: o, n_len: l, v0: v0, v1: v1 });
    } else {
        x.res.push(MapEnt { n_off: o, n_len: l, v0: v0, v1: v1 });
    };
}
