@import "../../src/numfmt.sla"
@import "../../src/core.sla"

extern "C" {
    fn malloc(size: usize) -> *u8;
    fn free(p: *u8);
}

fn main() -> i32 {
    let b = sb_new();
    let a = nf_f32_from_bits(1065353217);
    let c = nf_f32_from_bits(855638016);
    let s = a + c;
    sb_push_u64(&b, nf_f32_bits(s) as u64);
    sb_push_byte(&b, 10u8);
    let d = nf_f32_from_bits(1065353217);
    let e = nf_f32_from_bits(1065353216);
    sb_push_u64(&b, nf_f32_bits(d - e) as u64);
    sb_push_byte(&b, 10u8);
    let f = nf_f32_from_bits(1073741824);
    let g = nf_f32_from_bits(1065353216);
    sb_push_u64(&b, nf_f32_bits(f * g) as u64);
    sb_push_byte(&b, 10u8);
    sx_out_buf(&b);
    return 0;
}
