@import "../../src/numfmt.sla"
@import "../../src/core.sla"

extern "C" {
    fn malloc(size: usize) -> *u8;
    fn free(p: *u8);
}

fn main() -> i32 {
    let b = sb_new();
    let x0 = nf_f32_from_bits(1089493180);
    let y0 = nf_f32_from_bits(3255042619);
    let z0 = nf_f32_from_bits(3226947934);
    let a = x0 * x0;
    let c = y0 * y0;
    let d = z0 * z0;
    sb_push_u64(&b, nf_f32_bits(a) as u64);
    sb_push_byte(&b, 10u8);
    sb_push_u64(&b, nf_f32_bits(c) as u64);
    sb_push_byte(&b, 10u8);
    sb_push_u64(&b, nf_f32_bits(d) as u64);
    sb_push_byte(&b, 10u8);
    let e = a + c;
    sb_push_u64(&b, nf_f32_bits(e) as u64);
    sb_push_byte(&b, 10u8);
    let f = e + d;
    sb_push_u64(&b, nf_f32_bits(f) as u64);
    sb_push_byte(&b, 10u8);
    sx_out_buf(&b);
    return 0;
}
