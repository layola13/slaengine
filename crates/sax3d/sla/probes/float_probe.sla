// probe.sla  numfmt/core work/ 
@import "../../src/core.sla"
@import "../../src/numfmt.sla"

extern "C" {
    fn malloc(size: usize) -> *u8;
    fn free(p: *u8);
}

fn main() -> i32 {
    let pats: [u64; 30] = [
        0x0000000000000000u64, 0x8000000000000000u64, 0x3FF0000000000000u64, 0x3FE0000000000000u64,
        0x3FB999999999999Au64, 0x3FC999999999999Au64, 0x3FD3333333333333u64, 0x3FD3333333333334u64,
        0x3FD5555555555555u64, 0x3FE5555555555555u64, 0x3FE3333333333333u64, 0x3FE999999999999Au64,
        0x3FECCCCCCCCCCCCDu64, 0x3FE6666666666666u64, 0x4004000000000000u64, 0x400921FB54442D18u64,
        0x4415AF1D78B58C40u64, 0x444B1AE4D6E2EF50u64, 0x4480F0CF064DD592u64, 0x3EE4F8B588E368F1u64,
        0x3EB0C6F7A0B5ED8Du64, 0x3E7AD7F29ABCAF48u64, 0x0000000000000001u64, 0x0000000000000003u64,
        0x7FEFFFFFFFFFFFFFu64, 0x0010000000000000u64, 0x4340000000000000u64, 0x4059000000000000u64,
        0x3FF0000000000001u64, 0x3FEFFFFFFFFFFFFFu64,
    ];
    let out = sb_new();
    let i: i32 = 0;
    while i < 30 {
        let v = nf_f64_from_bits(pats[i]);
        nf_push_f64(&out, v);
        sb_push_byte(&out, 10);
        i = i + 1;
    }
    sx_out_buf(&out);
    return 0;
}
