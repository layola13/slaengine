// cube.sax3d — SAX3D 工作例：一只立方体 + 一个材质 + 一张贴图
// + 一个 SLASL shader 引用 + 一个旋转动作 clip。
// 拆分形（创作形）：组装文本在外部按名引用几何二进制 cube.saxb3d、
// shader 产物 pbr_std.slasl、接口表夹具 pbr_std.iface.txt（GAP-1 代演）。
// 所有跨层引用一律按名、编译期裁判检查。

asset CubeDemo version 1;

// 二进制伴随文件中的命名段（长度为期望值，编译器对实际段表核验）
binary "cube.saxb3d" {
    section positions 288;
    section normals   288;
    section uvs       192;
    section indices    72;
    section checker    16;
    section spin_times  8;
    section spin_rots  32;
}

// ---- 几何层：通道是具名逻辑通道，恒独立紧密打包，物理交错由消费者派生 ----
mesh Cube {
    vertices 24;
    channel position : f32x3 @ positions;
    channel normal   : f32x3 @ normals;
    channel uv0      : f32x2 @ uvs;
    indices u16 @ indices count 36;
    primitive body { material: RedPlastic; }
}

// ---- 纹理层：采样器状态显式声明，永不猜测 ----
image CheckerImg {
    source @ checker;          // 内嵌原始像素（段 checker）
    format raw-rgba8;
    size 2 2;
    color_space srgb;
}

texture Checker {
    image: CheckerImg;
    sampler { mag: linear; min: linear; mipmap: none; wrap_u: repeat; wrap_v: repeat; }
}

// ---- 材质层：shader 按名引用 SLASL 产物，参数按名对接口表绑定 ----
shader PbrStd: slasl "pbr_std.slasl";

material RedPlastic {
    shader: PbrStd;
    param base_color = [0.8, 0.1, 0.1, 1.0];
    param roughness  = 0.6;
    texture base_color_map: Checker;
    state { alpha: opaque; double_sided: false; }
}

// ---- 装配层：SAX 式声明树，节点按名绑定 mesh ----
scene Main {
    node CubeNode {
        mesh: Cube;
        transform { t: [0.0, 0.0, 0.0]; }
    }
}

// ---- 动画层：clip 即动作；通道/采样器分工同 glTF，但一律按名 ----
clip Spin {
    sampler S0 {
        input:  f32  @ spin_times count 2;
        output: quat @ spin_rots  count 2;
        interpolation: linear;
    }
    channel { node: CubeNode; path: rotation; sampler: S0; }
}
