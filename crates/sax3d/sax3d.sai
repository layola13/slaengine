// sax3d.sai — SAX3D 二进制 schema：唯一真理源。
//
// 本文件钉死 .saxb3d（拆分形几何二进制）与 .sax3dp（合并形交付二进制）
// 的全部记录布局。工具链侧 tools/gen_schema.zig 把本文件编译为
// src/schema_gen.zig；校验器、写入器、打包器、回读校验器只消费生成表，
// 禁止任何第二份手写布局副本。
//
// 版本门纪律（沿 SAB / HL-2）：version_major 变更才许字段改义；
// v1 内字段只增不改义，flags 非 0 一律具名拒绝。

format SAX3D;
version 1 0;

// 两形魔数（各 8 字节）：同一头结构，魔数分形。
magic split  "SAX3DBIN";
magic packed "SAX3DPAK";

// 二进制头（32B）。注：设计稿 §7 的 reserved u8[12] 在此细化为
// nametab_off + nametab_len + reserved u8[4]（总长与既有字段偏移不变，
// 见 SPEC 偏离登记 D-2）。
struct Sax3dBinHeader 32 {
    magic:         u8[8];
    version_major: u16;
    version_minor: u16;
    section_count: u32;
    flags:         u32;
    nametab_off:   u32;
    nametab_len:   u32;
    reserved:      u8[4];
}

// 段表记录（32B）。name_off 为名表内该段名的绝对文件偏移
// （名表位于全部载荷段之后的文件尾，nametab_off 起）。
struct Sax3dSectionRec 32 {
    name_off: u32;
    kind:     u32;
    offset:   u64;
    len:      u64;
    align:    u32;
    reserved: u32;
}

// 段种类封闭集。assembly 仅出现在合并形（编译后组装文本段）。
enum Sax3dSectionKind {
    channel      = 1;
    index        = 2;
    image_raw    = 3;
    anim_input   = 4;
    anim_output  = 5;
    inverse_bind = 6;
    blob         = 7;
    assembly     = 8;
}

// 元素类型表：名、字节大小、字节对齐（SA 标量布局，紧密无 padding）。
// 通道元素类型即 SA 类型；段即该类型数组的 SA 内存镜像。
elem f32     4  4;
elem f32x2   8  8;
elem f32x3   12 4;
elem f32x4   16 16;
elem quat    16 16;
elem u8x4    4  4;
elem u16x4   8  8;
elem u32     4  4;
elem u16     2  2;
elem f32x4x4 64 16;
