// physics.sla — sla_physics 骨架：类型与签名层（地基批 2026-11-01）
//
// 本文件只钉契约（CHARTER.md）：句柄、step(world, dt, inputs)、
// （状态种子， 外力剧本）分支形、WillEvent/OnEvent、扫掠查询签名。
// 函数体全部为 SKELETON 占位（返回零值/无效句柄），无任何求解实现；
// 实现候物理座正式排期。数值一律定点：i64 原始定点值（标度由实现批
// 定版），与章程 §6 定点确定性口径一致。
//
// 句柄：u64 不透明 id，0 = 无效。世界/刚体/碰撞体/分支皆句柄，
// 状态活在引擎侧数据集合中（学 Rapier 集外置形态，见
// docs/REFERENCE_SURVEY.md），步进器无状态、世界可克隆多开。

// ---- 基础值形 -------------------------------------------------------

struct Vec3F {
    x: i64,
    y: i64,
    z: i64,
}

fn vec3f_zero() -> Vec3F {
    return Vec3F { x: 0, y: 0, z: 0 };
}

// ---- 刚体定义与状态 --------------------------------------------------
// kind: 0=静态 1=动态 2=运动学
// shape: 0=球（half.x 为半径） 1=盒（half 为半边长） 2=胶囊（half.x 半径，half.y 半高）

struct BodyDef {
    kind: i32,
    shape: i32,
    pos: Vec3F,
    half: Vec3F,
    mass_inv: i64,
    friction: i64,
    restitution: i64,
}

struct BodyState {
    pos: Vec3F,
    vel: Vec3F,
    ang_vel: Vec3F,
    sleeping: bool,
}

// ---- 步进输入（外力 + 控制面） ---------------------------------------
// inputs 为一等数据（章程 §4/前提四）：力/力矩直给；控制量经参与体
// 控制面（油门/刹车/转向 → 执行器映射）换算，二者同在本结构内。

struct BodyInput {
    body: u64,
    force: Vec3F,
    torque: Vec3F,
    throttle: i64,
    brake: i64,
    steer: i64,
}

// ---- 外力剧本 ---------------------------------------------------------
// channel: 0=油门 1=刹车 2=转向 3=外力.x 4=外力.y 5=外力.z（直给力通道）
// kind: 0=恒定（v0） 1=阶跃（t0 前 v0、t0 起 v1） 2=斜坡（t0..t1 线性 v0→v1）
// t0/t1 为相对分支起点的定点时刻；剧本是纯数据，可重放、可审计。

struct ScriptSeg {
    body: u64,
    channel: i32,
    kind: i32,
    t0: i64,
    t1: i64,
    v0: i64,
    v1: i64,
}

// ---- 分支（未来） ------------------------------------------------------
// 分支 = （状态种子 = 克隆出的世界， 外力剧本）。alive=false 表示该
// 未来已作废（被现实坍缩淘汰或被消费侧关闭），其 will 事件应全数撤回。

struct BranchInfo {
    id: u64,
    world: u64,
    steps_done: i64,
    horizon: i64,
    alive: bool,
}

// ---- 扫掠查询 -----------------------------------------------------------
// toi 为相对当前时刻的定点时间（time-of-impact）；hit=false 时余字段无义。

struct SweepHit {
    hit: bool,
    toi: i64,
    body: u64,
    point: Vec3F,
    normal: Vec3F,
}

fn sweep_miss() -> SweepHit {
    return SweepHit { hit: false, toi: 0, body: 0, point: vec3f_zero(), normal: vec3f_zero() };
}

// ---- 事件 ---------------------------------------------------------------
// WillEvent.state: 0=已预测 1=已确认 2=已修订 3=已撤回 4=已实现（转 on）
// will 携带所属分支与撞后预测（章程 §5）；tti = 预计相撞时刻（相对量）。

struct WillEvent {
    id: u64,
    branch: u64,
    body_a: u64,
    body_b: u64,
    tti: i64,
    point: Vec3F,
    post_vel_a: Vec3F,
    post_vel_b: Vec3F,
    state: i32,
}

struct OnEvent {
    body_a: u64,
    body_b: u64,
    step: i64,
    point: Vec3F,
    normal: Vec3F,
}

// ---- 世界管理（SKELETON） ----------------------------------------------

fn phys_world_new() -> u64 {
    return 0;
}

fn phys_world_clone(world: u64) -> u64 {
    return 0;
}

fn phys_world_free(world: u64) {
}

fn phys_body_add(world: u64, def: BodyDef) -> u64 {
    return 0;
}

fn phys_body_state(world: u64, body: u64) -> BodyState {
    return BodyState { pos: vec3f_zero(), vel: vec3f_zero(), ang_vel: vec3f_zero(), sleeping: false };
}

// ---- 步进契约（SKELETON） -------------------------------------------------
// 唯一推进入口，实时仿真与全部预演分支共用（同源铁规，章程 §4）。
// 返回 0 = 成功；非零为错误码（实现批定版）。

fn phys_step(world: u64, dt: i64, inputs: &Vec<BodyInput>) -> i32 {
    return 0;
}

// ---- 扫掠查询（SKELETON） ---------------------------------------------------

fn phys_cast_shape(world: u64, shape: i32, origin: Vec3F, dir: Vec3F, max_toi: i64) -> SweepHit {
    return sweep_miss();
}

fn phys_time_of_impact(world: u64, a: u64, b: u64, horizon: i64) -> SweepHit {
    return sweep_miss();
}

// ---- 预演分支（SKELETON） -----------------------------------------------------

fn phys_branch_open(world: u64, script: &Vec<ScriptSeg>, horizon: i64) -> u64 {
    return 0;
}

fn phys_branch_advance(branch: u64, steps: i64) -> i32 {
    return 0;
}

fn phys_branch_close(branch: u64) {
}

fn phys_branch_info(branch: u64) -> BranchInfo {
    return BranchInfo { id: 0, world: 0, steps_done: 0, horizon: 0, alive: false };
}

// ---- 事件读取（SKELETON，计数+按索引取，消费侧聚合口径自定） -------------------

fn phys_will_count(branch: u64) -> i64 {
    return 0;
}

fn phys_will_at(branch: u64, idx: i64) -> WillEvent {
    return WillEvent { id: 0, branch: 0, body_a: 0, body_b: 0, tti: 0, point: vec3f_zero(), post_vel_a: vec3f_zero(), post_vel_b: vec3f_zero(), state: 3 };
}

fn phys_on_count(world: u64) -> i64 {
    return 0;
}

fn phys_on_at(world: u64, idx: i64) -> OnEvent {
    return OnEvent { body_a: 0, body_b: 0, step: 0, point: vec3f_zero(), normal: vec3f_zero() };
}
