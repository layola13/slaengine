// SLASL demo fragment: base pass (textured, tinted by a base color).
shader Base {
    priority 0;
    @global struct Camera { view_proj: mat4; }
    @input position: vec3;
    @input uv: vec2;
    @param base_color: vec4;
    @param tex: sampler2D;
    var v_uv: vec2;
    vertex {
        v_uv = uv;
        clip_position = Camera.view_proj * vec4(position, 1.0);
    }
    fragment {
        frag_color = tex.get(v_uv) * base_color;
    }
}
