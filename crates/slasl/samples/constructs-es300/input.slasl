// SLASL enrichment sample: principled + agx constructs (GLSL family).
shader Constructs {
    priority 0;
    @global struct Scene { light_dir: vec3; light_color: vec3; cam_pos: vec3; }
    @input position: vec3;
    @input normal: vec3;
    @input uv: vec2;
    @param base_color: vec4;
    @param metallic: float;
    @param roughness: float;
    @param env: sampler2D;
    @param irr: sampler2D;
    var v_normal: vec3;
    var v_world: vec3;
    vertex {
        v_normal = normal;
        v_world = position;
        clip_position = vec4(position, 1.0);
    }
    fragment {
        frag_color = vec4(agx(principled(base_color.rgb, metallic, roughness, v_normal, Scene.cam_pos - v_world, Scene.light_dir, Scene.light_color)), base_color.a);
    }
}
