// SLASL demo fragment: tint effect composed over Base.
// dead_weight + scratch form a dead chain on purpose: the linker must
// eliminate both from the AST, the parameter layout and every backend.
// The init block is written out of dependency order on purpose:
// tint_pre uses tint_boost before tint_boost is assigned.
shader Tint {
    priority 10;
    @param tint: vec4;
    @param dead_weight: vec4;
    @const USE_TINT: bool = true;
    var scratch: vec4;
    var tint_boost: vec4;
    var tint_pre: vec4;
    init {
        scratch = tint * dead_weight;
        tint_pre = tint_boost + tint;
        tint_boost = tint * 0.5;
    }
    fragment {
        if USE_TINT {
            frag_color = frag_color * tint_pre;
        }
    }
}
