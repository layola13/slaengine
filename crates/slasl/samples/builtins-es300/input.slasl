// SLASL enrichment sample: math builtins only (no construct helpers emitted).
shader Constructs {
    priority 0;
    @global struct Scene { light_dir: vec3; light_color: vec3; cam_pos: vec3; }
    @input position: vec3;
    @input normal: vec3;
    @input uv: vec2;
    @param base_color: vec4;
    @param metallic: float;
    @param roughness: float;
    @param env: sampler2D;
    @param irr: sampler2D;
    var v_normal: vec3;
    var v_world: vec3;
    vertex {
        v_normal = normal;
        v_world = position;
        clip_position = vec4(position, 1.0);
    }
    fragment {
        frag_color = vec4(normalize(cross(v_normal, vec3(0.0, 1.0, 0.0))) * length(v_world) + reflect(v_normal, v_normal) + vec3(sign(v_normal.x), abs(v_normal.y), floor(v_normal.z)) + vec3(sqrt(max(dot(v_normal, Scene.light_dir), 0.0)), log2(2.0), exp2(1.0)) + mix(base_color.rgb, vec3(1.0, 1.0, 1.0), sin(0.5) * cos(0.5)), 1.0);
    }
}
