shader Def1 {
    priority 5;
    @input position: vec3;
    @const SCALE: float = 2.0;
    @const STEPS: int = 3;
    @param tint2: vec4;
    var v_s: float;
    var v_t: float;
    vertex {
        v_s = SCALE;
        v_t = SCALE * 3.0;
        clip_position = vec4(position * SCALE, 1.0);
    }
    fragment {
        frag_color = tint2 * (v_s + v_t);
    }
}
