// SLASL compiler core (P2) — SLA implementation.
//
// One .slasl source set + a target -> that target's shader file set.
// Pipeline: lex -> parse -> check -> link (unify, @const fold,
// component-mask DCE, init dependency weaving, logical layout) ->
// emit (GLSL ES 3.00 / GLSL ES 1.00 / HLSL SM5 / WGSL + reflection
// manifest; more targets in emit2). Products are files only; no
// engine/runtime lives here (user ruling 2026-10-31 09:54).
//
// The semantic reference is the P0 Zig prototype
// (~/workspace/sla-shader-local/proto/src/main.zig); the eight P0
// golden files are reproduced byte-for-byte (see run_tests.sh).
//
// Implementation discipline (empirically pinned on the a121c04c
// toolchain, probes in work/): no String values and no format() in
// the data path (String == is identity, format length/mapping is
// unreliable); all text is (off,len) spans into one byte arena;
// all AST collections are flat structs in Vec arenas with span
// (off,len) child lists in shared pools.

@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/io.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

extern "C" {
    fn malloc(size: usize) -> *u8;
    fn free(p: *u8);
}

// ------------------------------------------------------------------
// type codes (mirror proto Ty order of definition)
// ------------------------------------------------------------------
// 0 float, 1 int, 2 uint, 3 bool, 4 vec2, 5 vec3, 6 vec4,
// 7 mat3, 8 mat4, 9 sampler2D

fn ty_from_name(c: &Ctx, off: i32, len: i32) -> i32 {
    if span_eq_lit(c, off, len, STR_PTR("float"), STR_LEN("float")) { return 0; };
    if span_eq_lit(c, off, len, STR_PTR("int"), STR_LEN("int")) { return 1; };
    if span_eq_lit(c, off, len, STR_PTR("uint"), STR_LEN("uint")) { return 2; };
    if span_eq_lit(c, off, len, STR_PTR("bool"), STR_LEN("bool")) { return 3; };
    if span_eq_lit(c, off, len, STR_PTR("vec2"), STR_LEN("vec2")) { return 4; };
    if span_eq_lit(c, off, len, STR_PTR("vec3"), STR_LEN("vec3")) { return 5; };
    if span_eq_lit(c, off, len, STR_PTR("vec4"), STR_LEN("vec4")) { return 6; };
    if span_eq_lit(c, off, len, STR_PTR("mat3"), STR_LEN("mat3")) { return 7; };
    if span_eq_lit(c, off, len, STR_PTR("mat4"), STR_LEN("mat4")) { return 8; };
    if span_eq_lit(c, off, len, STR_PTR("sampler2D"), STR_LEN("sampler2D")) { return 9; };
    return -1;
}

fn ty_name_into(b: &Buf, ty: i32) {
    if ty == 0 { buf_push_lit(b, STR_PTR("float"), STR_LEN("float")); return; };
    if ty == 1 { buf_push_lit(b, STR_PTR("int"), STR_LEN("int")); return; };
    if ty == 2 { buf_push_lit(b, STR_PTR("uint"), STR_LEN("uint")); return; };
    if ty == 3 { buf_push_lit(b, STR_PTR("bool"), STR_LEN("bool")); return; };
    if ty == 4 { buf_push_lit(b, STR_PTR("vec2"), STR_LEN("vec2")); return; };
    if ty == 5 { buf_push_lit(b, STR_PTR("vec3"), STR_LEN("vec3")); return; };
    if ty == 6 { buf_push_lit(b, STR_PTR("vec4"), STR_LEN("vec4")); return; };
    if ty == 7 { buf_push_lit(b, STR_PTR("mat3"), STR_LEN("mat3")); return; };
    if ty == 8 { buf_push_lit(b, STR_PTR("mat4"), STR_LEN("mat4")); return; };
    buf_push_lit(b, STR_PTR("sampler2D"), STR_LEN("sampler2D"));
}

fn ty_hlsl_into(b: &Buf, ty: i32) {
    if ty == 4 { buf_push_lit(b, STR_PTR("float2"), STR_LEN("float2")); return; };
    if ty == 5 { buf_push_lit(b, STR_PTR("float3"), STR_LEN("float3")); return; };
    if ty == 6 { buf_push_lit(b, STR_PTR("float4"), STR_LEN("float4")); return; };
    if ty == 7 { buf_push_lit(b, STR_PTR("float3x3"), STR_LEN("float3x3")); return; };
    if ty == 8 { buf_push_lit(b, STR_PTR("float4x4"), STR_LEN("float4x4")); return; };
    if ty == 9 { buf_push_lit(b, STR_PTR("Texture2D"), STR_LEN("Texture2D")); return; };
    ty_name_into(b, ty);
}

fn ty_vec_len(ty: i32) -> i32 {
    if ty == 4 { return 2; };
    if ty == 5 { return 3; };
    if ty == 6 { return 4; };
    if ty == 7 || ty == 8 || ty == 9 { return 0; };
    return 1;
}

fn ty_is_vec(ty: i32) -> bool {
    return ty == 4 || ty == 5 || ty == 6;
}

fn ty_is_mat(ty: i32) -> bool {
    return ty == 7 || ty == 8;
}

fn ty_is_scalar(ty: i32) -> bool {
    return ty == 0 || ty == 1 || ty == 2 || ty == 3;
}

fn ty_size(ty: i32) -> i32 {
    if ty == 4 { return 8; };
    if ty == 5 { return 12; };
    if ty == 6 { return 16; };
    if ty == 7 { return 48; };
    if ty == 8 { return 64; };
    if ty == 9 { return 0; };
    return 4;
}

fn ty_align(ty: i32) -> i32 {
    if ty == 4 { return 8; };
    if ty == 5 || ty == 6 || ty == 7 || ty == 8 { return 16; };
    return 4;
}

fn ty_full_mask(ty: i32) -> i32 {
    let n = ty_vec_len(ty);
    if n == 1 { return 1; };
    if n == 2 { return 3; };
    if n == 3 { return 7; };
    return 15;
}

// ------------------------------------------------------------------
// byte buffer (own growable buffer; the only text sink in the tool)
// ------------------------------------------------------------------

struct Buf {
    data: *u8,
    len: u64,
    cap: u64,
}

fn buf_new() -> Buf {
    let d = malloc(256);
    return Buf { data: d, len: 0, cap: 256 };
}

fn buf_reserve(b: &Buf, extra: u64) {
    if b.len + extra <= b.cap {
        return;
    };
    let ncap: u64 = b.cap * 2;
    if ncap < b.len + extra {
        ncap = b.len + extra + 64;
    };
    let nd = malloc(ncap);
    let bp: ptr = b.data as ptr;
    let i: u64 = 0;
    while i < b.len {
        write_byte(nd, i, PTR_BYTE_AT(bp, i));
        i = i + 1;
    }
    free(b.data);
    b.data = nd;
    b.cap = ncap;
}

fn buf_push_byte(b: &Buf, x: u8) {
    buf_reserve(b, 1);
    write_byte(b.data, b.len, x);
    b.len = b.len + 1;
}

fn buf_push_span(b: &Buf, p: ptr, n: u64) {
    buf_reserve(b, n);
    let i: u64 = 0;
    while i < n {
        write_byte(b.data, b.len + i, PTR_BYTE_AT(p, i));
        i = i + 1;
    }
    b.len = b.len + n;
}

fn buf_push_lit(b: &Buf, p: ptr, n: u64) {
    buf_push_span(b, p, n);
}

fn buf_push_u64(b: &Buf, v: u64) {
    let tmp: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x: u64 = v;
    if x == 0 {
        buf_push_byte(b, 48);
        return;
    };
    while x > 0 {
        tmp[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i: u64 = 0;
    while i < n {
        buf_push_byte(b, tmp[n - 1 - i]);
        i = i + 1;
    }
}

fn buf_push_i64(b: &Buf, v: i64) {
    if v < 0 {
        buf_push_byte(b, 45);
        buf_push_u64(b, (0 - v) as u64);
        return;
    };
    buf_push_u64(b, v as u64);
}

fn write_byte(p: *u8, off: u64, x: u8) {
    unsafe { *(p.add(off as usize)) = x; };
}

// ------------------------------------------------------------------
// compiler context: one text arena + flat AST arenas
// ------------------------------------------------------------------

// Expr kinds: 0 num, 1 boolean, 2 ident, 3 field, 4 binop, 5 neg,
// 6 call, 7 ctor. a/b are child expr indices (field: a=base;
// binop: a=l, b=r; neg: a=inner; call: a=callee; ctor: ty set).
struct Expr {
    kind: i32,
    a: i32,
    b: i32,
    op: i32,
    ty: i32,
    name_off: i32,
    name_len: i32,
    bval: bool,
    args_off: i32,
    args_len: i32,
}

// Stmt kinds: 0 assign (target/value expr idx), 1 ifs (cond + body
// span in pool), 2 block (body span in pool).
struct Stmt {
    kind: i32,
    target: i32,
    value: i32,
    cond: i32,
    body_off: i32,
    body_len: i32,
}

struct Field {
    name_off: i32,
    name_len: i32,
    ty: i32,
}

struct Group {
    name_off: i32,
    name_len: i32,
    fields_off: i32,
    fields_len: i32,
}

struct ConstDecl {
    name_off: i32,
    name_len: i32,
    ty: i32,
    value: i32,
}

struct Shader {
    name_off: i32,
    name_len: i32,
    priority: i64,
    gs_off: i32,
    gs_len: i32,
    gr_off: i32,
    gr_len: i32,
    in_off: i32,
    in_len: i32,
    pa_off: i32,
    pa_len: i32,
    co_off: i32,
    co_len: i32,
    va_off: i32,
    va_len: i32,
    init_off: i32,
    init_len: i32,
    vert_off: i32,
    vert_len: i32,
    frag_off: i32,
    frag_len: i32,
}

// symbol kinds: 0 input, 1 param, 2 constant, 3 var, 4 global_single,
// 5 special
struct Sym {
    name_off: i32,
    name_len: i32,
    ty: i32,
    kind: i32,
}

// key for read/write/live maps: a plain name (g=false, o1/l1) or a
// global-group field (g=true, o1/l1 = group name, o2/l2 = field
// name) — mirrors the proto's "{group}.{field}" hash keys without
// materializing strings.
struct LiveEnt {
    g: bool,
    o1: i32,
    l1: i32,
    o2: i32,
    l2: i32,
    mask: i32,
}

struct Tok {
    kind: i32,
    off: i32,
    len: i32,
}

// token kinds: 0 ident, 1 number, 2 at, 3 lbrace, 4 rbrace, 5 lparen,
// 6 rparen, 7 semi, 8 colon, 9 comma, 10 dot, 11 eq, 12 plus,
// 13 minus, 14 star, 15 slash, 16 eof

struct Ctx {
    text: Buf,
    exprs: Vec<Expr>,
    stmts: Vec<Stmt>,
    fields: Vec<Field>,
    groups: Vec<Group>,
    consts: Vec<ConstDecl>,
    shaders: Vec<Shader>,
    pool: Vec<i32>,
    n_pool: i32,
    ipool: Vec<i32>,
    n_ipool: i32,
    toks: Vec<Tok>,
    err: Buf,
    failed: bool,
    spc_off: i32,
    spc_len: i32,
    spf_off: i32,
    spf_len: i32,
    // linker state
    sh_order: Vec<i32>,
    m_gs_off: i32,
    m_gs_len: i32,
    m_gr_off: i32,
    m_gr_len: i32,
    m_in_off: i32,
    m_in_len: i32,
    m_pa_off: i32,
    m_pa_len: i32,
    m_co_off: i32,
    m_co_len: i32,
    m_va_off: i32,
    m_va_len: i32,
    lk_init_off: i32,
    lk_init_len: i32,
    lk_vert_off: i32,
    lk_vert_len: i32,
    lk_frag_off: i32,
    lk_frag_len: i32,
    needed: Vec<bool>,
    stage: Vec<Field>,
    env: Vec<Sym>,
    n_env: i32,
    scratch: Vec<LiveEnt>,
    scratch2: Vec<LiveEnt>,
    acc: Vec<LiveEnt>,
    n_toks: i32,
    n_exprs: i32,
    n_stmts: i32,
    n_fields: i32,
    n_groups: i32,
    n_consts: i32,
    n_shaders: i32,
    n_live: i32,
    n_scratch: i32,
    n_scratch2: i32,
    n_acc: i32,
    n_vreads: i32,
    n_freads: i32,
    n_vwrites: i32,
    n_fwrites: i32,
    n_iwrites: i32,
    n_vwoven: i32,
    n_fwoven: i32,
    live: Vec<LiveEnt>,
    live_grew: bool,
    // emitter state
    v_reads: Vec<LiveEnt>,
    f_reads: Vec<LiveEnt>,
    v_woven_reads: Vec<LiveEnt>,
    f_woven_reads: Vec<LiveEnt>,
    v_writes: Vec<LiveEnt>,
    f_writes: Vec<LiveEnt>,
    i_writes: Vec<LiveEnt>,
    varyings: Vec<i32>,
    v_woven_off: i32,
    v_woven_len: i32,
    f_woven_off: i32,
    f_woven_len: i32,
}

fn ctx_new() -> Ctx {
    return Ctx {
        text: buf_new(),
        exprs: Vec::new(),
        stmts: Vec::new(),
        fields: Vec::new(),
        groups: Vec::new(),
        consts: Vec::new(),
        shaders: Vec::new(),
        pool: Vec::new(),
        n_pool: 0,
        ipool: Vec::new(),
        n_ipool: 0,
        toks: Vec::new(),
        err: buf_new(),
        failed: false,
        spc_off: 0, spc_len: 0,
        spf_off: 0, spf_len: 0,
        sh_order: Vec::new(),
        m_gs_off: 0, m_gs_len: 0,
        m_gr_off: 0, m_gr_len: 0,
        m_in_off: 0, m_in_len: 0,
        m_pa_off: 0, m_pa_len: 0,
        m_co_off: 0, m_co_len: 0,
        m_va_off: 0, m_va_len: 0,
        lk_init_off: 0, lk_init_len: 0,
        lk_vert_off: 0, lk_vert_len: 0,
        lk_frag_off: 0, lk_frag_len: 0,
        needed: Vec::new(),
        stage: Vec::new(),
        env: Vec::new(),
        n_env: 0,
        scratch: Vec::new(),
        scratch2: Vec::new(),
        acc: Vec::new(),
        n_toks: 0,
        n_exprs: 0,
        n_stmts: 0,
        n_fields: 0,
        n_groups: 0,
        n_consts: 0,
        n_shaders: 0,
        n_live: 0,
        n_scratch: 0,
        n_scratch2: 0,
        n_acc: 0,
        n_vreads: 0,
        n_freads: 0,
        n_vwrites: 0,
        n_fwrites: 0,
        n_iwrites: 0,
        n_vwoven: 0,
        n_fwoven: 0,
        live: Vec::new(),
        live_grew: false,
        v_reads: Vec::new(),
        f_reads: Vec::new(),
        v_woven_reads: Vec::new(),
        f_woven_reads: Vec::new(),
        v_writes: Vec::new(),
        f_writes: Vec::new(),
        i_writes: Vec::new(),
        varyings: Vec::new(),
        v_woven_off: 0, v_woven_len: 0,
        f_woven_off: 0, f_woven_len: 0,
    };
}

fn ctx_fail(c: &Ctx) {
    c.failed = true;
}

// error message assembly: parts appended into c.err
fn err_lit(c: &Ctx, p: ptr, n: u64) {
    buf_push_span(&c.err, p, n);
}

fn err_span(c: &Ctx, off: i32, len: i32) {
    buf_push_span(&c.err, (c.text.data.add(off as usize)) as ptr, len as u64);
}

fn err_ty(c: &Ctx, ty: i32) {
    ty_name_into(&c.err, ty);
}

fn err_num(c: &Ctx, v: i64) {
    buf_push_i64(&c.err, v);
}

// span helpers over the text arena
fn span_byte(c: &Ctx, off: i32) -> u8 {
    return PTR_BYTE_AT(c.text.data as ptr, off as u64);
}

fn span_eq(c: &Ctx, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    if l1 != l2 {
        return false;
    };
    let i: i32 = 0;
    while i < l1 {
        if span_byte(c, o1 + i) != span_byte(c, o2 + i) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn span_eq_lit(c: &Ctx, off: i32, len: i32, lp: ptr, ll: u64) -> bool {
    if (len as u64) != ll {
        return false;
    };
    let i: u64 = 0;
    while i < ll {
        if span_byte(c, off + (i as i32)) != PTR_BYTE_AT(lp, i) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn span_has_dot(c: &Ctx, off: i32, len: i32) -> bool {
    let i: i32 = 0;
    while i < len {
        if span_byte(c, off + i) == 46 {
            return true;
        };
        i = i + 1;
    }
    return false;
}

// ------------------------------------------------------------------
// lexer (byte level, mirrors proto Lexer)
// ------------------------------------------------------------------

fn is_digit(x: u8) -> bool {
    return x >= 48 && x <= 57;
}

fn is_alpha(x: u8) -> bool {
    return (x >= 65 && x <= 90) || (x >= 97 && x <= 122);
}

fn push_tok(c: &Ctx, kind: i32, off: i32, len: i32) {
    let t = Tok { kind: kind, off: off, len: len };
    let idx = c.n_toks;
    c.toks[idx] = t;
    c.n_toks = idx + 1;
}

fn lex_all(c: &Ctx, src_off: i32, src_len: i32) {
    let end = src_off + src_len;
    let i = src_off;
    let done: bool = false;
    while !done {
        // skip whitespace and // comments
        let skipping: bool = true;
        while skipping && i < end {
            let ch = span_byte(c, i);
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
                i = i + 1;
            } else {
                if ch == 47 && i + 1 < end {
                    if span_byte(c, i + 1) == 47 {
                        while i < end && span_byte(c, i) != 10 {
                            i = i + 1;
                        }
                    } else {
                        skipping = false;
                    };
                } else {
                    skipping = false;
                };
            };
        }
        if i >= end {
            push_tok(c, 16, i, 0);
            done = true;
        } else {
            let ch = span_byte(c, i);
            let single: i32 = -1;
            if ch == 64 { single = 2; };
            if ch == 123 { single = 3; };
            if ch == 125 { single = 4; };
            if ch == 40 { single = 5; };
            if ch == 41 { single = 6; };
            if ch == 59 { single = 7; };
            if ch == 58 { single = 8; };
            if ch == 44 { single = 9; };
            if ch == 46 { single = 10; };
            if ch == 61 { single = 11; };
            if ch == 43 { single = 12; };
            if ch == 45 { single = 13; };
            if ch == 42 { single = 14; };
            if ch == 47 { single = 15; };
            let handled: bool = false;
            if single >= 0 {
                if single == 10 && i + 1 < end {
                    if is_digit(span_byte(c, i + 1)) {
                        handled = false;
                    } else {
                        push_tok(c, 10, i, 1);
                        i = i + 1;
                        handled = true;
                    };
                } else {
                    push_tok(c, single, i, 1);
                    i = i + 1;
                    handled = true;
                };
            };
            if !handled {
                if is_digit(ch) || (ch == 46 && i + 1 < end && is_digit(span_byte(c, i + 1))) {
                    let start = i;
                    let seen_dot: bool = false;
                    let going: bool = true;
                    while going && i < end {
                        let d = span_byte(c, i);
                        if is_digit(d) {
                            i = i + 1;
                        } else {
                            if d == 46 && !seen_dot {
                                seen_dot = true;
                                i = i + 1;
                            } else {
                                going = false;
                            };
                        };
                    }
                    push_tok(c, 1, start, i - start);
                } else {
                    if is_alpha(ch) || ch == 95 {
                        let start = i;
                        while i < end {
                            let d = span_byte(c, i);
                            if is_alpha(d) || is_digit(d) || d == 95 {
                                i = i + 1;
                            } else {
                                break;
                            };
                        }
                        push_tok(c, 0, start, i - start);
                    } else {
                        // unknown byte: proto emits an eof token
                        push_tok(c, 16, i, 0);
                        i = i + 1;
                    };
                };
            };
        };
    }
}

// ------------------------------------------------------------------
// parser (mirrors proto Parser, including message texts)
// ------------------------------------------------------------------

struct P {
    pos: i32,
}

fn tok_kind_name_into(b: &Buf, kind: i32) {
    if kind == 0 { buf_push_lit(b, STR_PTR("ident"), STR_LEN("ident")); return; };
    if kind == 1 { buf_push_lit(b, STR_PTR("number"), STR_LEN("number")); return; };
    if kind == 2 { buf_push_lit(b, STR_PTR("at"), STR_LEN("at")); return; };
    if kind == 3 { buf_push_lit(b, STR_PTR("lbrace"), STR_LEN("lbrace")); return; };
    if kind == 4 { buf_push_lit(b, STR_PTR("rbrace"), STR_LEN("rbrace")); return; };
    if kind == 5 { buf_push_lit(b, STR_PTR("lparen"), STR_LEN("lparen")); return; };
    if kind == 6 { buf_push_lit(b, STR_PTR("rparen"), STR_LEN("rparen")); return; };
    if kind == 7 { buf_push_lit(b, STR_PTR("semi"), STR_LEN("semi")); return; };
    if kind == 8 { buf_push_lit(b, STR_PTR("colon"), STR_LEN("colon")); return; };
    if kind == 9 { buf_push_lit(b, STR_PTR("comma"), STR_LEN("comma")); return; };
    if kind == 10 { buf_push_lit(b, STR_PTR("dot"), STR_LEN("dot")); return; };
    if kind == 11 { buf_push_lit(b, STR_PTR("eq"), STR_LEN("eq")); return; };
    if kind == 12 { buf_push_lit(b, STR_PTR("plus"), STR_LEN("plus")); return; };
    if kind == 13 { buf_push_lit(b, STR_PTR("minus"), STR_LEN("minus")); return; };
    if kind == 14 { buf_push_lit(b, STR_PTR("star"), STR_LEN("star")); return; };
    if kind == 15 { buf_push_lit(b, STR_PTR("slash"), STR_LEN("slash")); return; };
    buf_push_lit(b, STR_PTR("eof"), STR_LEN("eof"));
}

fn p_peek(c: &Ctx, p: &P) -> i32 {
    return c.toks[p.pos].kind;
}

fn p_peek_off(c: &Ctx, p: &P) -> i32 {
    return c.toks[p.pos].off;
}

fn p_peek_len(c: &Ctx, p: &P) -> i32 {
    return c.toks[p.pos].len;
}

fn p_next(c: &Ctx, p: &P) {
    if p.pos + 1 < c.n_toks {
        p.pos = p.pos + 1;
    };
}

fn p_fail(c: &Ctx) {
    c.failed = true;
}

fn p_expect(c: &Ctx, p: &P, kind: i32) -> bool {
    let k = p_peek(c, p);
    let o = p_peek_off(c, p);
    let l = p_peek_len(c, p);
    p_next(c, p);
    if k != kind {
        err_lit(c, STR_PTR("expected "), STR_LEN("expected "));
        tok_kind_name_into(&c.err, kind);
        err_lit(c, STR_PTR(", got '"), STR_LEN(", got '"));
        err_span(c, o, l);
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        p_fail(c);
        return false;
    };
    return true;
}

fn p_expect_ident(c: &Ctx, p: &P, lp: ptr, ll: u64) -> bool {
    let k = p_peek(c, p);
    let o = p_peek_off(c, p);
    let l = p_peek_len(c, p);
    p_next(c, p);
    let same: bool = k == 0 && (l as u64) == ll;
    if same {
        let i: u64 = 0;
        while i < ll {
            if span_byte(c, o + (i as i32)) != PTR_BYTE_AT(lp, i) {
                same = false;
            };
            i = i + 1;
        }
    };
    if !same {
        err_lit(c, STR_PTR("expected '"), STR_LEN("expected '"));
        err_lit(c, lp, ll);
        err_lit(c, STR_PTR("', got '"), STR_LEN("', got '"));
        err_span(c, o, l);
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        p_fail(c);
        return false;
    };
    return true;
}

fn p_accept(c: &Ctx, p: &P, kind: i32) -> bool {
    if p_peek(c, p) == kind {
        p_next(c, p);
        return true;
    };
    return false;
}

fn p_at_ident(c: &Ctx, p: &P, lp: ptr, ll: u64) -> bool {
    if p_peek(c, p) != 0 {
        return false;
    };
    return span_eq_lit(c, p_peek_off(c, p), p_peek_len(c, p), lp, ll);
}

fn pool_span(c: &Ctx, v: &Vec<i32>) -> i32 {
    let off = c.n_pool;
    let i: i32 = 0;
    while i < v.len() {
        let el = v[i];
        let idx = c.n_pool;
        c.pool[idx] = el;
        c.n_pool = idx + 1;
        i = i + 1;
    }
    return off;
}

fn copy_stage(c: &Ctx, region: i32, len: i32) -> i32 {
    let off = c.n_fields;
    let i: i32 = 0;
    while i < len {
        let fel = c.stage[region + i];
        let idx = c.n_fields;
        c.fields[idx] = fel;
        c.n_fields = idx + 1;
        i = i + 1;
    }
    return off;
}

fn unify_stage(c: &Ctx, region: i32, len: i32, f: Field, o_len: &i32) -> bool {
    let i: i32 = 0;
    while i < len {
        let ef = c.stage[region + i];
        if span_eq(c, ef.name_off, ef.name_len, f.name_off, f.name_len) {
            if ef.ty != f.ty {
                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                err_span(c, f.name_off, f.name_len);
                err_lit(c, STR_PTR("' declared with conflicting types "), STR_LEN("' declared with conflicting types "));
                err_ty(c, ef.ty);
                err_lit(c, STR_PTR(" vs "), STR_LEN(" vs "));
                err_ty(c, f.ty);
                c.failed = true;
                *o_len = len;
                return false;
            };
            *o_len = len;
            return true;
        };
        i = i + 1;
    }
    c.stage[region + len] = f;
    *o_len = len + 1;
    return true;
}

fn unify_arena(c: &Ctx, off: i32, len: i32, f: Field, o_len: &i32) -> bool {
    let i: i32 = 0;
    while i < len {
        let ef = c.fields[off + i];
        if span_eq(c, ef.name_off, ef.name_len, f.name_off, f.name_len) {
            if ef.ty != f.ty {
                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                err_span(c, f.name_off, f.name_len);
                err_lit(c, STR_PTR("' declared with conflicting types "), STR_LEN("' declared with conflicting types "));
                err_ty(c, ef.ty);
                err_lit(c, STR_PTR(" vs "), STR_LEN(" vs "));
                err_ty(c, f.ty);
                c.failed = true;
                *o_len = len;
                return false;
            };
            *o_len = len;
            return true;
        };
        i = i + 1;
    }
    let idx = c.n_fields;
    c.fields[idx] = f;
    c.n_fields = idx + 1;
    *o_len = len + 1;
    return true;
}

fn new_expr(c: &Ctx, kind: i32, a: i32, b: i32, op: i32, ty: i32, name_off: i32, name_len: i32, bval: bool, args_off: i32, args_len: i32) -> i32 {
    let e = Expr { kind: kind, a: a, b: b, op: op, ty: ty, name_off: name_off, name_len: name_len, bval: bval, args_off: args_off, args_len: args_len };
    let idx = c.n_exprs;
    c.exprs[idx] = e;
    c.n_exprs = idx + 1;
    return idx;
}

fn new_stmt(c: &Ctx, kind: i32, target: i32, value: i32, cond: i32, body_off: i32, body_len: i32) -> i32 {
    let st = Stmt { kind: kind, target: target, value: value, cond: cond, body_off: body_off, body_len: body_len };
    let idx = c.n_stmts;
    c.stmts[idx] = st;
    c.n_stmts = idx + 1;
    return idx;
}

fn parse_field(c: &Ctx, p: &P, out: &Field) -> bool {
    if !p_expect(c, p, 0) { return false; };
    let noff = c.toks[p.pos - 1].off;
    let nlen = c.toks[p.pos - 1].len;
    // note: p_expect advanced; recover token span from previous token
    out.name_off = noff;
    out.name_len = nlen;
    if !p_expect(c, p, 8) { return false; };
    if !p_expect(c, p, 0) { return false; };
    let toff = c.toks[p.pos - 1].off;
    let tlen = c.toks[p.pos - 1].len;
    let ty = ty_from_name(c, toff, tlen);
    if ty < 0 {
        err_lit(c, STR_PTR("unknown type '"), STR_LEN("unknown type '"));
        err_span(c, toff, tlen);
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        p_fail(c);
        return false;
    };
    out.ty = ty;
    if !p_expect(c, p, 7) { return false; };
    return true;
}

fn parse_expr(c: &Ctx, p: &P) -> i32 {
    return parse_add(c, p);
}

fn parse_add(c: &Ctx, p: &P) -> i32 {
    let l = parse_mul(c, p);
    if c.failed { return -1; };
    while p_peek(c, p) == 12 || p_peek(c, p) == 13 {
        let op: i32 = 43;
        if p_peek(c, p) == 13 {
            op = 45;
        };
        p_next(c, p);
        let r = parse_mul(c, p);
        if c.failed { return -1; };
        l = new_expr(c, 4, l, r, op, -1, 0, 0, false, 0, 0);
    }
    return l;
}

fn parse_mul(c: &Ctx, p: &P) -> i32 {
    let l = parse_unary(c, p);
    if c.failed { return -1; };
    while p_peek(c, p) == 14 || p_peek(c, p) == 15 {
        let op: i32 = 42;
        if p_peek(c, p) == 15 {
            op = 47;
        };
        p_next(c, p);
        let r = parse_unary(c, p);
        if c.failed { return -1; };
        l = new_expr(c, 4, l, r, op, -1, 0, 0, false, 0, 0);
    }
    return l;
}

fn parse_unary(c: &Ctx, p: &P) -> i32 {
    if p_peek(c, p) == 13 {
        p_next(c, p);
        let inner = parse_unary(c, p);
        if c.failed { return -1; };
        return new_expr(c, 5, inner, -1, 0, -1, 0, 0, false, 0, 0);
    };
    return parse_postfix(c, p);
}

fn parse_args(c: &Ctx, p: &P) -> (bool, Vec<i32>) {
    let out: Vec<i32> = Vec::new();
    if !p_expect(c, p, 5) { return (false, out); };
    if p_peek(c, p) != 6 {
        let more: bool = true;
        while more {
            let a = parse_expr(c, p);
            if c.failed { return (false, out); };
            out.push(a);
            if !p_accept(c, p, 9) {
                more = false;
            };
        }
    };
    if !p_expect(c, p, 6) { return (false, out); };
    return (true, out);
}

fn parse_postfix(c: &Ctx, p: &P) -> i32 {
    let e = parse_primary(c, p);
    if c.failed { return -1; };
    while p_peek(c, p) == 10 {
        p_next(c, p);
        if !p_expect(c, p, 0) { return -1; };
        let foff = c.toks[p.pos - 1].off;
        let flen = c.toks[p.pos - 1].len;
        e = new_expr(c, 3, e, -1, 0, -1, foff, flen, false, 0, 0);
        if p_peek(c, p) == 5 {
            let (aok, args) = parse_args(c, p);
            if !aok { return -1; };
            let aoff = pool_span(c, &args);
            e = new_expr(c, 6, e, -1, 0, -1, 0, 0, false, aoff, args.len());
        };
    }
    return e;
}

fn parse_primary(c: &Ctx, p: &P) -> i32 {
    let k = p_peek(c, p);
    let o = p_peek_off(c, p);
    let l = p_peek_len(c, p);
    p_next(c, p);
    if k == 1 {
        return new_expr(c, 0, -1, -1, 0, -1, o, l, false, 0, 0);
    };
    if k == 5 {
        let inner = parse_expr(c, p);
        if c.failed { return -1; };
        if !p_expect(c, p, 6) { return -1; };
        return inner;
    };
    if k == 0 {
        if span_eq_lit(c, o, l, STR_PTR("true"), STR_LEN("true")) || span_eq_lit(c, o, l, STR_PTR("false"), STR_LEN("false")) {
            let bv: bool = span_eq_lit(c, o, l, STR_PTR("true"), STR_LEN("true"));
            return new_expr(c, 1, -1, -1, 0, -1, 0, 0, bv, 0, 0);
        };
        let ty = ty_from_name(c, o, l);
        if ty >= 0 {
            if p_peek(c, p) == 5 {
                let (aok, args) = parse_args(c, p);
                if !aok { return -1; };
                let aoff = pool_span(c, &args);
                return new_expr(c, 7, -1, -1, 0, ty, 0, 0, false, aoff, args.len());
            };
        };
        let e = new_expr(c, 2, -1, -1, 0, -1, o, l, false, 0, 0);
        if p_peek(c, p) == 5 {
            let (aok, args) = parse_args(c, p);
            if !aok { return -1; };
            let aoff = pool_span(c, &args);
            return new_expr(c, 6, e, -1, 0, -1, 0, 0, false, aoff, args.len());
        };
        return e;
    };
    err_lit(c, STR_PTR("unexpected token '"), STR_LEN("unexpected token '"));
    err_span(c, o, l);
    err_lit(c, STR_PTR("' in expression"), STR_LEN("' in expression"));
    p_fail(c);
    return -1;
}

fn parse_block(c: &Ctx, p: &P) -> (bool, Vec<i32>) {
    let out: Vec<i32> = Vec::new();
    if !p_expect(c, p, 3) { return (false, out); };
    while p_peek(c, p) != 4 {
        let st = parse_stmt(c, p);
        if c.failed { return (false, out); };
        out.push(st);
    }
    if !p_expect(c, p, 4) { return (false, out); };
    return (true, out);
}

fn parse_stmt(c: &Ctx, p: &P) -> i32 {
    if p_peek(c, p) == 3 {
        let (bok, body) = parse_block(c, p);
        if !bok { return -1; };
        if p_accept(c, p, 7) { };
        let boff = pool_span(c, &body);
        return new_stmt(c, 2, -1, -1, -1, boff, body.len());
    };
    if p_at_ident(c, p, STR_PTR("if"), STR_LEN("if")) {
        p_next(c, p);
        let paren = p_accept(c, p, 5);
        let cond = parse_expr(c, p);
        if c.failed { return -1; };
        if paren {
            if !p_expect(c, p, 6) { return -1; };
        };
        let (bok, body) = parse_block(c, p);
        if !bok { return -1; };
        if p_accept(c, p, 7) { };
        let boff = pool_span(c, &body);
        return new_stmt(c, 1, -1, -1, cond, boff, body.len());
    };
    let lhs = parse_expr(c, p);
    if c.failed { return -1; };
    if !p_expect(c, p, 11) { return -1; };
    let rhs = parse_expr(c, p);
    if c.failed { return -1; };
    if !p_expect(c, p, 7) { return -1; };
    return new_stmt(c, 0, lhs, rhs, -1, 0, 0);
}

fn parse_i64_span(c: &Ctx, off: i32, len: i32, o_val: &i64) -> bool {
    let v: i64 = 0;
    let i: i32 = 0;
    if len == 0 {
        return false;
    };
    while i < len {
        let d = span_byte(c, off + i);
        if !is_digit(d) {
            return false;
        };
        v = v * 10 + ((d - 48) as i64);
        i = i + 1;
    }
    *o_val = v;
    return true;
}

fn parse_shader(c: &Ctx, p: &P) -> bool {
    if !p_expect_ident(c, p, STR_PTR("shader"), STR_LEN("shader")) { return false; };
    if !p_expect(c, p, 0) { return false; };
    let sh_name_off = c.toks[p.pos - 1].off;
    let sh_name_len = c.toks[p.pos - 1].len;
    if !p_expect(c, p, 3) { return false; };
    let sh = Shader {
        name_off: sh_name_off, name_len: sh_name_len, priority: 0,
        gs_off: 0, gs_len: 0, gr_off: 0, gr_len: 0,
        in_off: 0, in_len: 0, pa_off: 0, pa_len: 0,
        co_off: 0, co_len: 0, va_off: 0, va_len: 0,
        init_off: 0, init_len: 0, vert_off: 0, vert_len: 0,
        frag_off: 0, frag_len: 0,
    };
    let n_gs: i32 = 0;
    let n_in: i32 = 0;
    let n_pa: i32 = 0;
    let n_va: i32 = 0;
    let gr_base = c.n_groups;
    let co_base = c.n_consts;
    let init: Vec<i32> = Vec::new();
    let vert: Vec<i32> = Vec::new();
    let frag: Vec<i32> = Vec::new();
    while p_peek(c, p) != 4 {
        if p_peek(c, p) == 2 {
            p_next(c, p);
            if !p_expect(c, p, 0) { return false; };
            let qoff = c.toks[p.pos - 1].off;
            let qlen = c.toks[p.pos - 1].len;
            if span_eq_lit(c, qoff, qlen, STR_PTR("global"), STR_LEN("global")) {
                if p_at_ident(c, p, STR_PTR("struct"), STR_LEN("struct")) {
                    p_next(c, p);
                    if !p_expect(c, p, 0) { return false; };
                    let gnoff = c.toks[p.pos - 1].off;
                    let gnlen = c.toks[p.pos - 1].len;
                    if !p_expect(c, p, 3) { return false; };
                    let gf_n: i32 = 0;
                    while p_peek(c, p) != 4 {
                        let f = Field { name_off: 0, name_len: 0, ty: 0 };
                        if !parse_field(c, p, &f) { return false; };
                        c.stage[16384 + gf_n] = f;
                        gf_n = gf_n + 1;
                    }
                    if !p_expect(c, p, 4) { return false; };
                    if p_accept(c, p, 7) { };
                    let foff = copy_stage(c, 16384, gf_n);
                    let ng = Group { name_off: gnoff, name_len: gnlen, fields_off: foff, fields_len: gf_n };
                    let ngidx = c.n_groups;
                    c.groups[ngidx] = ng;
                    c.n_groups = ngidx + 1;
                } else {
                    let f = Field { name_off: 0, name_len: 0, ty: 0 };
                    if !parse_field(c, p, &f) { return false; };
                    c.stage[0 + n_gs] = f;
                    n_gs = n_gs + 1;
                };
            } else {
                if span_eq_lit(c, qoff, qlen, STR_PTR("input"), STR_LEN("input")) {
                    let f = Field { name_off: 0, name_len: 0, ty: 0 };
                    if !parse_field(c, p, &f) { return false; };
                    c.stage[4096 + n_in] = f;
                    n_in = n_in + 1;
                } else {
                    if span_eq_lit(c, qoff, qlen, STR_PTR("param"), STR_LEN("param")) {
                        let f = Field { name_off: 0, name_len: 0, ty: 0 };
                        if !parse_field(c, p, &f) { return false; };
                        c.stage[8192 + n_pa] = f;
                        n_pa = n_pa + 1;
                    } else {
                        if span_eq_lit(c, qoff, qlen, STR_PTR("const"), STR_LEN("const")) {
                            if !p_expect(c, p, 0) { return false; };
                            let cnoff = c.toks[p.pos - 1].off;
                            let cnlen = c.toks[p.pos - 1].len;
                            if !p_expect(c, p, 8) { return false; };
                            if !p_expect(c, p, 0) { return false; };
                            let toff = c.toks[p.pos - 1].off;
                            let tlen = c.toks[p.pos - 1].len;
                            let ty = ty_from_name(c, toff, tlen);
                            if ty < 0 {
                                err_lit(c, STR_PTR("unknown type '"), STR_LEN("unknown type '"));
                                err_span(c, toff, tlen);
                                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                                p_fail(c);
                                return false;
                            };
                            if !p_expect(c, p, 11) { return false; };
                            let val = parse_expr(c, p);
                            if c.failed { return false; };
                            if !p_expect(c, p, 7) { return false; };
                            let ncd = ConstDecl { name_off: cnoff, name_len: cnlen, ty: ty, value: val };
                            let ncidx = c.n_consts;
                            c.consts[ncidx] = ncd;
                            c.n_consts = ncidx + 1;
                        } else {
                            err_lit(c, STR_PTR("unknown qualifier '@"), STR_LEN("unknown qualifier '@"));
                            err_span(c, qoff, qlen);
                            err_lit(c, STR_PTR("'"), STR_LEN("'"));
                            p_fail(c);
                            return false;
                        };
                    };
                };
            };
        } else {
            if p_at_ident(c, p, STR_PTR("priority"), STR_LEN("priority")) {
                p_next(c, p);
                if !p_expect(c, p, 1) { return false; };
                let noff = c.toks[p.pos - 1].off;
                let nlen = c.toks[p.pos - 1].len;
                let pv: i64 = 0;
                let pok = parse_i64_span(c, noff, nlen, &pv);
                if !pok {
                    err_lit(c, STR_PTR("bad priority '"), STR_LEN("bad priority '"));
                    err_span(c, noff, nlen);
                    err_lit(c, STR_PTR("'"), STR_LEN("'"));
                    p_fail(c);
                    return false;
                };
                sh.priority = pv;
                if !p_expect(c, p, 7) { return false; };
            } else {
                if p_at_ident(c, p, STR_PTR("var"), STR_LEN("var")) {
                    p_next(c, p);
                    let f = Field { name_off: 0, name_len: 0, ty: 0 };
                    if !parse_field(c, p, &f) { return false; };
                    c.stage[12288 + n_va] = f;
                    n_va = n_va + 1;
                } else {
                    if p_at_ident(c, p, STR_PTR("init"), STR_LEN("init")) {
                        p_next(c, p);
                        let (bok_init, blk_init) = parse_block(c, p);
                        if !bok_init { return false; };
                        let bi_init: i32 = 0;
                        while bi_init < blk_init.len() {
                            init.push(blk_init[bi_init]);
                            bi_init = bi_init + 1;
                        }
                    } else {
                        if p_at_ident(c, p, STR_PTR("vertex"), STR_LEN("vertex")) {
                            p_next(c, p);
                            let (bok_vert, blk_vert) = parse_block(c, p);
                        if !bok_vert { return false; };
                        let bi_vert: i32 = 0;
                        while bi_vert < blk_vert.len() {
                            vert.push(blk_vert[bi_vert]);
                            bi_vert = bi_vert + 1;
                        }
                        } else {
                            if p_at_ident(c, p, STR_PTR("fragment"), STR_LEN("fragment")) {
                                p_next(c, p);
                                let (bok_frag, blk_frag) = parse_block(c, p);
                        if !bok_frag { return false; };
                        let bi_frag: i32 = 0;
                        while bi_frag < blk_frag.len() {
                            frag.push(blk_frag[bi_frag]);
                            bi_frag = bi_frag + 1;
                        }
                            } else {
                                err_lit(c, STR_PTR("unexpected member '"), STR_LEN("unexpected member '"));
                                err_span(c, p_peek_off(c, p), p_peek_len(c, p));
                                err_lit(c, STR_PTR("' in shader '"), STR_LEN("' in shader '"));
                                err_span(c, sh_name_off, sh_name_len);
                                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                                p_fail(c);
                                return false;
                            };
                        };
                    };
                };
            };
        };
    }
    if !p_expect(c, p, 4) { return false; };
    sh.gs_off = copy_stage(c, 0, n_gs);
    sh.gs_len = n_gs;
    sh.gr_off = gr_base;
    sh.gr_len = c.n_groups - gr_base;
    sh.in_off = copy_stage(c, 4096, n_in);
    sh.in_len = n_in;
    sh.pa_off = copy_stage(c, 8192, n_pa);
    sh.pa_len = n_pa;
    sh.co_off = co_base;
    sh.co_len = c.n_consts - co_base;
    sh.va_off = copy_stage(c, 12288, n_va);
    sh.va_len = n_va;
    sh.init_off = pool_span(c, &init);
    sh.init_len = init.len();
    sh.vert_off = pool_span(c, &vert);
    sh.vert_len = vert.len();
    sh.frag_off = pool_span(c, &frag);
    sh.frag_len = frag.len();
    let sidx = c.n_shaders;
    c.shaders[sidx] = sh;
    c.n_shaders = sidx + 1;
    return true;
}

fn parse_file(c: &Ctx, p: &P) -> bool {
    while p_peek(c, p) != 16 {
        if !parse_shader(c, p) {
            return false;
        };
    }
    return true;
}

// ------------------------------------------------------------------
// checker (mirrors proto Checker). Diagnostics from the DESIGN
// section 6.2 rule families carry the J-5 check-hook names as a
// prefix: ShaderDuplicateName / ShaderStageViolation /
// ShaderDimensionMismatch. All other messages keep the prototype
// text verbatim.
// stage codes: 0 init, 1 vertex, 2 fragment
// sym kinds: 0 input, 1 param, 2 constant, 3 var, 4 global_single,
// 5 special
// ------------------------------------------------------------------

fn env_find(c: &Ctx, off: i32, len: i32) -> i32 {
    let i: i32 = 0;
    while i < c.n_env {
        if span_eq(c, c.env[i].name_off, c.env[i].name_len, off, len) {
            return i;
        };
        i = i + 1;
    }
    return -1;
}

fn env_check(c: &Ctx, off: i32, len: i32) -> bool {
    if env_find(c, off, len) != -1 {
        err_lit(c, STR_PTR("ShaderDuplicateName: duplicate declaration of '"), STR_LEN("ShaderDuplicateName: duplicate declaration of '"));
        err_span(c, off, len);
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        c.failed = true;
        return false;
    };
    return true;
}

fn shader_group_idx(c: &Ctx, sh: i32, off: i32, len: i32) -> i32 {
    let s = c.shaders[sh];
    let i: i32 = 0;
    while i < s.gr_len {
        let g = c.groups[s.gr_off + i];
        if span_eq(c, g.name_off, g.name_len, off, len) {
            return s.gr_off + i;
        };
        i = i + 1;
    }
    return -1;
}

fn num_is_float(c: &Ctx, e: i32) -> bool {
    let x = c.exprs[e];
    if x.kind != 0 {
        return false;
    };
    return span_has_dot(c, x.name_off, x.name_len);
}

fn swizzle_index_of(ch: u8) -> i32 {
    if ch == 120 || ch == 114 { return 0; };
    if ch == 121 || ch == 103 { return 1; };
    if ch == 122 || ch == 98 { return 2; };
    if ch == 119 || ch == 97 { return 3; };
    return -1;
}

fn swizzle_ty(c: &Ctx, base: i32, off: i32, len: i32, out_ty: &i32) -> bool {
    if !ty_is_vec(base) {
        err_lit(c, STR_PTR("ShaderDimensionMismatch: swizzle on non-vector "), STR_LEN("ShaderDimensionMismatch: swizzle on non-vector "));
        err_ty(c, base);
        c.failed = true;
        return false;
    };
    if len == 0 || len > 4 {
        err_lit(c, STR_PTR("ShaderDimensionMismatch: bad swizzle '"), STR_LEN("ShaderDimensionMismatch: bad swizzle '"));
        err_span(c, off, len);
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        c.failed = true;
        return false;
    };
    let first = span_byte(c, off);
    let xyzw: bool = swizzle_index_of(first) >= 0 && (first == 120 || first == 121 || first == 122 || first == 119);
    let i: i32 = 0;
    while i < len {
        let ch = span_byte(c, off + i);
        let in_set: bool = false;
        if xyzw {
            in_set = ch == 120 || ch == 121 || ch == 122 || ch == 119;
        } else {
            in_set = ch == 114 || ch == 103 || ch == 98 || ch == 97;
        };
        if !in_set {
            err_lit(c, STR_PTR("ShaderDimensionMismatch: mixed/invalid swizzle '"), STR_LEN("ShaderDimensionMismatch: mixed/invalid swizzle '"));
            err_span(c, off, len);
            err_lit(c, STR_PTR("'"), STR_LEN("'"));
            c.failed = true;
            return false;
        };
        let idx = swizzle_index_of(ch);
        if idx >= ty_vec_len(base) {
            err_lit(c, STR_PTR("ShaderDimensionMismatch: swizzle component '"), STR_LEN("ShaderDimensionMismatch: swizzle component '"));
            err_span(c, off + i, 1);
            err_lit(c, STR_PTR("' out of range for "), STR_LEN("' out of range for "));
            err_ty(c, base);
            c.failed = true;
            return false;
        };
        i = i + 1;
    }
    if len == 1 { *out_ty = 0; };
    if len == 2 { *out_ty = 4; };
    if len == 3 { *out_ty = 5; };
    if len == 4 { *out_ty = 6; };
    return true;
}

fn chk_expr(c: &Ctx, sh: i32, e: i32, stage: i32, out_ty: &i32) -> bool {
    let x = c.exprs[e];
    if x.kind == 0 {
        if span_has_dot(c, x.name_off, x.name_len) {
            *out_ty = 0;
        } else {
            *out_ty = 1;
        };
        return true;
    };
    if x.kind == 1 {
        *out_ty = 3;
        return true;
    };
    if x.kind == 2 {
        let si = env_find(c, x.name_off, x.name_len);
        if si < 0 {
            err_lit(c, STR_PTR("undefined identifier '"), STR_LEN("undefined identifier '"));
            err_span(c, x.name_off, x.name_len);
            err_lit(c, STR_PTR("'"), STR_LEN("'"));
            c.failed = true;
            return false;
        };
        let sym = c.env[si];
        if sym.kind == 0 && stage != 1 {
            err_lit(c, STR_PTR("ShaderStageViolation: @input '"), STR_LEN("ShaderStageViolation: @input '"));
            err_span(c, x.name_off, x.name_len);
            err_lit(c, STR_PTR("' may only be read in vertex"), STR_LEN("' may only be read in vertex"));
            c.failed = true;
            return false;
        };
        if sym.kind == 5 {
            if span_eq_lit(c, x.name_off, x.name_len, STR_PTR("clip_position"), STR_LEN("clip_position")) {
                err_lit(c, STR_PTR("ShaderStageViolation: clip_position is write-only"), STR_LEN("ShaderStageViolation: clip_position is write-only"));
                c.failed = true;
                return false;
            };
            if span_eq_lit(c, x.name_off, x.name_len, STR_PTR("frag_color"), STR_LEN("frag_color")) && stage != 2 {
                err_lit(c, STR_PTR("ShaderStageViolation: frag_color may only be read in fragment"), STR_LEN("ShaderStageViolation: frag_color may only be read in fragment"));
                c.failed = true;
                return false;
            };
        };
        *out_ty = sym.ty;
        return true;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind == 2 {
            let gi = shader_group_idx(c, sh, base.name_off, base.name_len);
            if gi >= 0 {
                let g = c.groups[gi];
                let fi: i32 = 0;
                while fi < g.fields_len {
                    let gf = c.fields[g.fields_off + fi];
                    if span_eq(c, gf.name_off, gf.name_len, x.name_off, x.name_len) {
                        *out_ty = gf.ty;
                        return true;
                    };
                    fi = fi + 1;
                }
                err_lit(c, STR_PTR("group '"), STR_LEN("group '"));
                err_span(c, base.name_off, base.name_len);
                err_lit(c, STR_PTR("' has no field '"), STR_LEN("' has no field '"));
                err_span(c, x.name_off, x.name_len);
                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                c.failed = true;
                return false;
            };
        };
        let bty: i32 = -1;
        if !chk_expr(c, sh, x.a, stage, &bty) { return false; };
        return swizzle_ty(c, bty, x.name_off, x.name_len, out_ty);
    };
    if x.kind == 4 {
        let lt: i32 = -1;
        let rt: i32 = -1;
        if !chk_expr(c, sh, x.a, stage, &lt) { return false; };
        if !chk_expr(c, sh, x.b, stage, &rt) { return false; };
        return binop_ty(c, lt, rt, x.a, x.b, out_ty);
    };
    if x.kind == 5 {
        let ity: i32 = -1;
        if !chk_expr(c, sh, x.a, stage, &ity) { return false; };
        if ity == 3 || ity == 9 {
            err_lit(c, STR_PTR("cannot negate "), STR_LEN("cannot negate "));
            err_ty(c, ity);
            c.failed = true;
            return false;
        };
        *out_ty = ity;
        return true;
    };
    if x.kind == 7 {
        if ty_is_mat(x.ty) {
            err_lit(c, STR_PTR("matrix constructors not in prototype subset"), STR_LEN("matrix constructors not in prototype subset"));
            c.failed = true;
            return false;
        };
        let total: i32 = 0;
        let ai: i32 = 0;
        while ai < x.args_len {
            let at: i32 = -1;
            if !chk_expr(c, sh, c.pool[x.args_off + ai], stage, &at) { return false; };
            if ty_is_scalar(at) {
                total = total + 1;
            } else {
                if ty_is_vec(at) {
                    total = total + ty_vec_len(at);
                } else {
                    err_lit(c, STR_PTR("ShaderDimensionMismatch: bad constructor argument type "), STR_LEN("ShaderDimensionMismatch: bad constructor argument type "));
                    err_ty(c, at);
                    c.failed = true;
                    return false;
                };
            };
            ai = ai + 1;
        }
        if x.args_len == 1 {
            let at0: i32 = -1;
            if !chk_expr(c, sh, c.pool[x.args_off], stage, &at0) { return false; };
            if ty_is_scalar(at0) {
                *out_ty = x.ty;
                return true;
            };
        };
        if total != ty_vec_len(x.ty) {
            err_lit(c, STR_PTR("ShaderDimensionMismatch: constructor for "), STR_LEN("ShaderDimensionMismatch: constructor for "));
            err_ty(c, x.ty);
            err_lit(c, STR_PTR(" needs "), STR_LEN(" needs "));
            err_num(c, ty_vec_len(x.ty));
            err_lit(c, STR_PTR(" components, got "), STR_LEN(" components, got "));
            err_num(c, total);
            c.failed = true;
            return false;
        };
        *out_ty = x.ty;
        return true;
    };
    if x.kind == 6 {
        let callee = c.exprs[x.a];
        if callee.kind == 3 {
            let cbase = c.exprs[callee.a];
            if span_eq_lit(c, callee.name_off, callee.name_len, STR_PTR("get"), STR_LEN("get")) && cbase.kind == 2 {
                let si = env_find(c, cbase.name_off, cbase.name_len);
                if si < 0 {
                    err_lit(c, STR_PTR("undefined identifier '"), STR_LEN("undefined identifier '"));
                    err_span(c, cbase.name_off, cbase.name_len);
                    err_lit(c, STR_PTR("'"), STR_LEN("'"));
                    c.failed = true;
                    return false;
                };
                let sym = c.env[si];
                if sym.ty != 9 {
                    err_lit(c, STR_PTR("'.get' on non-sampler '"), STR_LEN("'.get' on non-sampler '"));
                    err_span(c, cbase.name_off, cbase.name_len);
                    err_lit(c, STR_PTR("'"), STR_LEN("'"));
                    c.failed = true;
                    return false;
                };
                if x.args_len != 1 {
                    err_lit(c, STR_PTR("sampler .get takes exactly 1 argument"), STR_LEN("sampler .get takes exactly 1 argument"));
                    c.failed = true;
                    return false;
                };
                let at: i32 = -1;
                if !chk_expr(c, sh, c.pool[x.args_off], stage, &at) { return false; };
                if at != 4 {
                    err_lit(c, STR_PTR("ShaderDimensionMismatch: sampler .get coordinate must be vec2, got "), STR_LEN("ShaderDimensionMismatch: sampler .get coordinate must be vec2, got "));
                    err_ty(c, at);
                    c.failed = true;
                    return false;
                };
                *out_ty = 6;
                return true;
            };
        };
        err_lit(c, STR_PTR("unsupported call in prototype subset (only sampler .get)"), STR_LEN("unsupported call in prototype subset (only sampler .get)"));
        c.failed = true;
        return false;
    };
    err_lit(c, STR_PTR("unsupported expression"), STR_LEN("unsupported expression"));
    c.failed = true;
    return false;
}

fn binop_ty(c: &Ctx, lt: i32, rt: i32, le: i32, re: i32, out_ty: &i32) -> bool {
    if lt == 3 || rt == 3 {
        err_lit(c, STR_PTR("ShaderDimensionMismatch: bool in arithmetic expression"), STR_LEN("ShaderDimensionMismatch: bool in arithmetic expression"));
        c.failed = true;
        return false;
    };
    if lt == rt {
        if ty_is_scalar(lt) || ty_is_vec(lt) || ty_is_mat(lt) {
            *out_ty = lt;
            return true;
        };
        err_lit(c, STR_PTR("ShaderDimensionMismatch: unsupported operand type "), STR_LEN("ShaderDimensionMismatch: unsupported operand type "));
        err_ty(c, lt);
        c.failed = true;
        return false;
    };
    if lt == 8 && rt == 6 { *out_ty = 6; return true; };
    if lt == 6 && rt == 8 { *out_ty = 6; return true; };
    if lt == 7 && rt == 5 { *out_ty = 5; return true; };
    if lt == 5 && rt == 7 { *out_ty = 5; return true; };
    if ty_is_vec(lt) && ty_is_scalar(rt) {
        if rt == 1 {
            let rnum: bool = c.exprs[re].kind == 0;
            if !rnum {
                err_lit(c, STR_PTR("ShaderDimensionMismatch: int value used with "), STR_LEN("ShaderDimensionMismatch: int value used with "));
                err_ty(c, lt);
                err_lit(c, STR_PTR(" without conversion"), STR_LEN(" without conversion"));
                c.failed = true;
                return false;
            };
        };
        *out_ty = lt;
        return true;
    };
    if ty_is_vec(rt) && ty_is_scalar(lt) {
        if lt == 1 {
            let lnum: bool = c.exprs[le].kind == 0;
            if !lnum {
                err_lit(c, STR_PTR("ShaderDimensionMismatch: int value used with "), STR_LEN("ShaderDimensionMismatch: int value used with "));
                err_ty(c, rt);
                err_lit(c, STR_PTR(" without conversion"), STR_LEN(" without conversion"));
                c.failed = true;
                return false;
            };
        };
        *out_ty = rt;
        return true;
    };
    let lok: bool = lt == 1 && rt == 0 && c.exprs[le].kind == 0;
    let rok: bool = lt == 0 && rt == 1 && c.exprs[re].kind == 0;
    if lok || rok {
        *out_ty = 0;
        return true;
    };
    err_lit(c, STR_PTR("ShaderDimensionMismatch: type mismatch in binary expression: "), STR_LEN("ShaderDimensionMismatch: type mismatch in binary expression: "));
    err_ty(c, lt);
    err_lit(c, STR_PTR(" vs "), STR_LEN(" vs "));
    err_ty(c, rt);
    c.failed = true;
    return false;
}

fn target_ty(c: &Ctx, sh: i32, t: i32, stage: i32, out_ty: &i32) -> bool {
    let x = c.exprs[t];
    if x.kind == 2 {
        let si = env_find(c, x.name_off, x.name_len);
        if si < 0 {
            err_lit(c, STR_PTR("undefined identifier '"), STR_LEN("undefined identifier '"));
            err_span(c, x.name_off, x.name_len);
            err_lit(c, STR_PTR("'"), STR_LEN("'"));
            c.failed = true;
            return false;
        };
        let sym = c.env[si];
        if sym.kind == 3 {
            *out_ty = sym.ty;
            return true;
        };
        if sym.kind == 5 {
            if span_eq_lit(c, x.name_off, x.name_len, STR_PTR("clip_position"), STR_LEN("clip_position")) && stage != 1 {
                err_lit(c, STR_PTR("ShaderStageViolation: clip_position may only be written in vertex"), STR_LEN("ShaderStageViolation: clip_position may only be written in vertex"));
                c.failed = true;
                return false;
            };
            if span_eq_lit(c, x.name_off, x.name_len, STR_PTR("frag_color"), STR_LEN("frag_color")) && stage != 2 {
                err_lit(c, STR_PTR("ShaderStageViolation: frag_color may only be written in fragment"), STR_LEN("ShaderStageViolation: frag_color may only be written in fragment"));
                c.failed = true;
                return false;
            };
            *out_ty = sym.ty;
            return true;
        };
        err_lit(c, STR_PTR("'"), STR_LEN("'"));
        err_span(c, x.name_off, x.name_len);
        err_lit(c, STR_PTR("' is not assignable"), STR_LEN("' is not assignable"));
        c.failed = true;
        return false;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind != 2 {
            err_lit(c, STR_PTR("unsupported assignment target"), STR_LEN("unsupported assignment target"));
            c.failed = true;
            return false;
        };
        let si = env_find(c, base.name_off, base.name_len);
        if si < 0 {
            err_lit(c, STR_PTR("undefined identifier '"), STR_LEN("undefined identifier '"));
            err_span(c, base.name_off, base.name_len);
            err_lit(c, STR_PTR("'"), STR_LEN("'"));
            c.failed = true;
            return false;
        };
        let sym = c.env[si];
        if sym.kind != 3 {
            err_lit(c, STR_PTR("field assignment only on var in prototype"), STR_LEN("field assignment only on var in prototype"));
            c.failed = true;
            return false;
        };
        let rty: i32 = -1;
        if !swizzle_ty(c, sym.ty, x.name_off, x.name_len, &rty) { return false; };
        let seen: i32 = 0;
        let ci: i32 = 0;
        while ci < x.name_len {
            let bit = 1 << swizzle_index_of(span_byte(c, x.name_off + ci));
            if (seen & bit) != 0 {
                err_lit(c, STR_PTR("ShaderDimensionMismatch: duplicate component in lvalue swizzle '"), STR_LEN("ShaderDimensionMismatch: duplicate component in lvalue swizzle '"));
                err_span(c, x.name_off, x.name_len);
                err_lit(c, STR_PTR("'"), STR_LEN("'"));
                c.failed = true;
                return false;
            };
            seen = seen | bit;
            ci = ci + 1;
        }
        *out_ty = rty;
        return true;
    };
    err_lit(c, STR_PTR("unsupported assignment target"), STR_LEN("unsupported assignment target"));
    c.failed = true;
    return false;
}

fn chk_stmts(c: &Ctx, sh: i32, off: i32, len: i32, stage: i32) -> bool {
    let i: i32 = 0;
    while i < len {
        if !chk_stmt(c, sh, c.pool[off + i], stage) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn chk_stmt(c: &Ctx, sh: i32, s: i32, stage: i32) -> bool {
    let x = c.stmts[s];
    if x.kind == 0 {
        let tty: i32 = -1;
        if !target_ty(c, sh, x.target, stage, &tty) { return false; };
        let vty: i32 = -1;
        if !chk_expr(c, sh, x.value, stage, &vty) { return false; };
        if vty != tty {
            let vx = c.exprs[x.value];
            if tty == 0 && vx.kind == 0 && !num_is_float(c, x.value) {
                return true;
            };
            err_lit(c, STR_PTR("assignment type mismatch: target "), STR_LEN("assignment type mismatch: target "));
            err_ty(c, tty);
            err_lit(c, STR_PTR(", value "), STR_LEN(", value "));
            err_ty(c, vty);
            c.failed = true;
            return false;
        };
        return true;
    };
    if x.kind == 1 {
        let cond = c.exprs[x.cond];
        if cond.kind == 2 {
            let si = env_find(c, cond.name_off, cond.name_len);
            if si >= 0 {
                let sym = c.env[si];
                if sym.kind == 2 {
                    if sym.ty != 3 {
                        err_lit(c, STR_PTR("if condition @const must be bool"), STR_LEN("if condition @const must be bool"));
                        c.failed = true;
                        return false;
                    };
                    return chk_stmts(c, sh, x.body_off, x.body_len, stage);
                };
            };
        };
        let cty: i32 = -1;
        if !chk_expr(c, sh, x.cond, stage, &cty) { return false; };
        if cty != 3 {
            err_lit(c, STR_PTR("if condition must be bool, got "), STR_LEN("if condition must be bool, got "));
            err_ty(c, cty);
            c.failed = true;
            return false;
        };
        return chk_stmts(c, sh, x.body_off, x.body_len, stage);
    };
    return chk_stmts(c, sh, x.body_off, x.body_len, stage);
}

fn assigns_to(c: &Ctx, off: i32, len: i32, noff: i32, nlen: i32) -> bool {
    let i: i32 = 0;
    while i < len {
        let x = c.stmts[c.pool[off + i]];
        if x.kind == 0 {
            let t = c.exprs[x.target];
            if t.kind == 2 && span_eq(c, t.name_off, t.name_len, noff, nlen) {
                return true;
            };
        };
        if x.kind == 1 || x.kind == 2 {
            if assigns_to(c, x.body_off, x.body_len, noff, nlen) {
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

fn chk_shader(c: &Ctx, sh: i32) -> bool {
    let s = c.shaders[sh];
    c.n_env = 0;
    // specials first (proto order); their name spans point at the
    // literal copies main placed in the text arena before parsing
    if !env_check(c, c.spc_off, c.spc_len) { return false; };
        let es1 = Sym { name_off: c.spc_off, name_len: c.spc_len, ty: 6, kind: 5 };
        let ev1 = c.n_env;
        c.env[ev1] = es1;
        c.n_env = ev1 + 1;
    if !env_check(c, c.spf_off, c.spf_len) { return false; };
        let es2 = Sym { name_off: c.spf_off, name_len: c.spf_len, ty: 6, kind: 5 };
        let ev2 = c.n_env;
        c.env[ev2] = es2;
        c.n_env = ev2 + 1;
    let i: i32 = 0;
    while i < s.gs_len {
        let f = c.fields[s.gs_off + i];
        if !env_check(c, f.name_off, f.name_len) { return false; };
        let es3 = Sym { name_off: f.name_off, name_len: f.name_len, ty: f.ty, kind: 4 };
        let ev3 = c.n_env;
        c.env[ev3] = es3;
        c.n_env = ev3 + 1;
        i = i + 1;
    }
    i = 0;
    while i < s.in_len {
        let f = c.fields[s.in_off + i];
        if !env_check(c, f.name_off, f.name_len) { return false; };
        let es4 = Sym { name_off: f.name_off, name_len: f.name_len, ty: f.ty, kind: 0 };
        let ev4 = c.n_env;
        c.env[ev4] = es4;
        c.n_env = ev4 + 1;
        i = i + 1;
    }
    i = 0;
    while i < s.pa_len {
        let f = c.fields[s.pa_off + i];
        if !env_check(c, f.name_off, f.name_len) { return false; };
        let es5 = Sym { name_off: f.name_off, name_len: f.name_len, ty: f.ty, kind: 1 };
        let ev5 = c.n_env;
        c.env[ev5] = es5;
        c.n_env = ev5 + 1;
        i = i + 1;
    }
    i = 0;
    while i < s.co_len {
        let cd = c.consts[s.co_off + i];
        if !env_check(c, cd.name_off, cd.name_len) { return false; };
        let es6 = Sym { name_off: cd.name_off, name_len: cd.name_len, ty: cd.ty, kind: 2 };
        let ev6 = c.n_env;
        c.env[ev6] = es6;
        c.n_env = ev6 + 1;
        i = i + 1;
    }
    i = 0;
    while i < s.va_len {
        let f = c.fields[s.va_off + i];
        if !env_check(c, f.name_off, f.name_len) { return false; };
        let es7 = Sym { name_off: f.name_off, name_len: f.name_len, ty: f.ty, kind: 3 };
        let ev7 = c.n_env;
        c.env[ev7] = es7;
        c.n_env = ev7 + 1;
        i = i + 1;
    }
    i = 0;
    while i < s.gr_len {
        let g = c.groups[s.gr_off + i];
        let j: i32 = 0;
        let dup: bool = false;
        while j < i {
            let og = c.groups[s.gr_off + j];
            if span_eq(c, og.name_off, og.name_len, g.name_off, g.name_len) {
                dup = true;
            };
            j = j + 1;
        }
        if dup {
            err_lit(c, STR_PTR("ShaderDuplicateName: duplicate group '"), STR_LEN("ShaderDuplicateName: duplicate group '"));
            err_span(c, g.name_off, g.name_len);
            err_lit(c, STR_PTR("'"), STR_LEN("'"));
            c.failed = true;
            return false;
        };
        i = i + 1;
    }
    // const defaults
    i = 0;
    while i < s.co_len {
        let cd = c.consts[s.co_off + i];
        let vty: i32 = -1;
        if !chk_expr(c, sh, cd.value, 0, &vty) { return false; };
        if vty != cd.ty {
            err_lit(c, STR_PTR("@const '"), STR_LEN("@const '"));
            err_span(c, cd.name_off, cd.name_len);
            err_lit(c, STR_PTR("': default has type "), STR_LEN("': default has type "));
            err_ty(c, vty);
            err_lit(c, STR_PTR(", declared "), STR_LEN(", declared "));
            err_ty(c, cd.ty);
            c.failed = true;
            return false;
        };
        let vx = c.exprs[cd.value];
        if vx.kind != 0 && vx.kind != 1 {
            err_lit(c, STR_PTR("@const '"), STR_LEN("@const '"));
            err_span(c, cd.name_off, cd.name_len);
            err_lit(c, STR_PTR("': default must be a literal"), STR_LEN("': default must be a literal"));
            c.failed = true;
            return false;
        };
        i = i + 1;
    }
    if !chk_stmts(c, sh, s.init_off, s.init_len, 0) { return false; };
    if !chk_stmts(c, sh, s.vert_off, s.vert_len, 1) { return false; };
    if !chk_stmts(c, sh, s.frag_off, s.frag_len, 2) { return false; };
    return true;
}

// ------------------------------------------------------------------
// linker (mirrors proto Linker). Read/write/live maps are keyed by
// span identity: plain name (g=false) or group field (g=true).
// ------------------------------------------------------------------

fn span_eq_tp(tp: ptr, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    if l1 != l2 {
        return false;
    };
    let i: i32 = 0;
    while i < l1 {
        if PTR_BYTE_AT(tp, (o1 + i) as u64) != PTR_BYTE_AT(tp, (o2 + i) as u64) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn ent_matches(tp: ptr, e: LiveEnt, g: bool, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    if e.g != g {
        return false;
    };
    if !span_eq_tp(tp, e.o1, e.l1, o1, l1) {
        return false;
    };
    if g {
        return span_eq_tp(tp, e.o2, e.l2, o2, l2);
    };
    return true;
}

fn map_mask(tp: ptr, list: &Vec<LiveEnt>, n: i32, g: bool, o1: i32, l1: i32, o2: i32, l2: i32) -> i32 {
    let i: i32 = 0;
    while i < n {
        let e = list[i];
        if ent_matches(tp, e, g, o1, l1, o2, l2) {
            return e.mask;
        };
        i = i + 1;
    }
    return 0;
}

fn map_has(tp: ptr, list: &Vec<LiveEnt>, n: i32, g: bool, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    let i: i32 = 0;
    while i < n {
        let e = list[i];
        if ent_matches(tp, e, g, o1, l1, o2, l2) {
            return true;
        };
        i = i + 1;
    }
    return false;
}

fn ent_add_into(tp: ptr, list: &Vec<LiveEnt>, n: i32, g: bool, o1: i32, l1: i32, o2: i32, l2: i32, mask: i32, o_n: &i32) -> bool {
    let i: i32 = 0;
    while i < n {
        let e = list[i];
        if ent_matches(tp, e, g, o1, l1, o2, l2) {
            let nv = e.mask | mask;
            if nv != e.mask {
                list[i].mask = nv;
                *o_n = n;
                return true;
            };
            *o_n = n;
            return false;
        };
        i = i + 1;
    }
    if mask != 0 {
        let ent = LiveEnt { g: g, o1: o1, l1: l1, o2: o2, l2: l2, mask: mask };
        list[n] = ent;
        *o_n = n + 1;
        return true;
    };
    *o_n = n;
    return false;
}

fn ent_add(c: &Ctx, sel: i32, g: bool, o1: i32, l1: i32, o2: i32, l2: i32, mask: i32) -> bool {
    let tp = c.text.data as ptr;
    if sel == 0 {
        let nn: i32 = 0;
        let grew = ent_add_into(tp, &c.scratch, c.n_scratch, g, o1, l1, o2, l2, mask, &nn);
        c.n_scratch = nn;
        return grew;
    };
    if sel == 1 {
        let nn: i32 = 0;
        let grew = ent_add_into(tp, &c.scratch2, c.n_scratch2, g, o1, l1, o2, l2, mask, &nn);
        c.n_scratch2 = nn;
        return grew;
    };
    if sel == 2 {
        let nn: i32 = 0;
        let grew = ent_add_into(tp, &c.acc, c.n_acc, g, o1, l1, o2, l2, mask, &nn);
        c.n_acc = nn;
        return grew;
    };
    let nn: i32 = 0;
    let grew = ent_add_into(tp, &c.live, c.n_live, g, o1, l1, o2, l2, mask, &nn);
    c.n_live = nn;
    return grew;
}



// merge collected reads into the live map (DCE), tracking growth
fn merge_live(c: &Ctx) {
    let i: i32 = 0;
    while i < c.n_scratch {
        let e = c.scratch[i];
        if ent_add(c, 3, e.g, e.o1, e.l1, e.o2, e.l2, e.mask) {
            c.live_grew = true;
        };
        i = i + 1;
    }
}

fn lk_group(c: &Ctx, off: i32, len: i32) -> i32 {
    let i: i32 = 0;
    while i < c.m_gr_len {
        let g = c.groups[c.m_gr_off + i];
        if span_eq(c, g.name_off, g.name_len, off, len) {
            return c.m_gr_off + i;
        };
        i = i + 1;
    }
    return -1;
}

// merged environment lookup; scan order reverses the proto's put
// order (consts, vars, params, inputs, singles, specials) so later
// puts win, exactly like the proto's hash map.
fn lk_ty_of(c: &Ctx, off: i32, len: i32, out_ty: &i32, out_kind: &i32) -> bool {
    let i: i32 = 0;
    while i < c.m_co_len {
        let cd = c.consts[c.m_co_off + i];
        if span_eq(c, cd.name_off, cd.name_len, off, len) {
            *out_ty = cd.ty;
            *out_kind = 2;
            return true;
        };
        i = i + 1;
    }
    i = 0;
    while i < c.m_va_len {
        let f = c.fields[c.m_va_off + i];
        if span_eq(c, f.name_off, f.name_len, off, len) {
            *out_ty = f.ty;
            *out_kind = 3;
            return true;
        };
        i = i + 1;
    }
    i = 0;
    while i < c.m_pa_len {
        let f = c.fields[c.m_pa_off + i];
        if span_eq(c, f.name_off, f.name_len, off, len) {
            *out_ty = f.ty;
            *out_kind = 1;
            return true;
        };
        i = i + 1;
    }
    i = 0;
    while i < c.m_in_len {
        let f = c.fields[c.m_in_off + i];
        if span_eq(c, f.name_off, f.name_len, off, len) {
            *out_ty = f.ty;
            *out_kind = 0;
            return true;
        };
        i = i + 1;
    }
    i = 0;
    while i < c.m_gs_len {
        let f = c.fields[c.m_gs_off + i];
        if span_eq(c, f.name_off, f.name_len, off, len) {
            *out_ty = f.ty;
            *out_kind = 4;
            return true;
        };
        i = i + 1;
    }
    if span_eq(c, c.spc_off, c.spc_len, off, len) {
        *out_ty = 6;
        *out_kind = 5;
        return true;
    };
    if span_eq(c, c.spf_off, c.spf_len, off, len) {
        *out_ty = 6;
        *out_kind = 5;
        return true;
    };
    return false;
}

fn const_by_name(c: &Ctx, off: i32, len: i32) -> i32 {
    let i: i32 = 0;
    while i < c.m_co_len {
        let cd = c.consts[c.m_co_off + i];
        if span_eq(c, cd.name_off, cd.name_len, off, len) {
            return c.m_co_off + i;
        };
        i = i + 1;
    }
    return -1;
}


fn subst_expr(c: &Ctx, e: i32) -> i32 {
    let x = c.exprs[e];
    if x.kind == 2 {
        let ci = const_by_name(c, x.name_off, x.name_len);
        if ci >= 0 {
            return subst_expr(c, c.consts[ci].value);
        };
        return e;
    };
    if x.kind == 3 {
        let nb = subst_expr(c, x.a);
        return new_expr(c, 3, nb, -1, 0, -1, x.name_off, x.name_len, false, 0, 0);
    };
    if x.kind == 4 {
        let nl = subst_expr(c, x.a);
        let nr = subst_expr(c, x.b);
        return new_expr(c, 4, nl, nr, x.op, -1, 0, 0, false, 0, 0);
    };
    if x.kind == 5 {
        let ni = subst_expr(c, x.a);
        return new_expr(c, 5, ni, -1, 0, -1, 0, 0, false, 0, 0);
    };
    if x.kind == 6 {
        let nc = subst_expr(c, x.a);
        let args: Vec<i32> = Vec::new();
        let i: i32 = 0;
        while i < x.args_len {
            args.push(subst_expr(c, c.pool[x.args_off + i]));
            i = i + 1;
        }
        let aoff = pool_span(c, &args);
        return new_expr(c, 6, nc, -1, 0, -1, 0, 0, false, aoff, args.len());
    };
    if x.kind == 7 {
        let args: Vec<i32> = Vec::new();
        let i: i32 = 0;
        while i < x.args_len {
            args.push(subst_expr(c, c.pool[x.args_off + i]));
            i = i + 1;
        }
        let aoff = pool_span(c, &args);
        return new_expr(c, 7, -1, -1, 0, x.ty, 0, 0, false, aoff, args.len());
    };
    return e;
}

fn fold_stmts(c: &Ctx, off: i32, len: i32, o_off: &i32, o_len: &i32) {
    let base = c.n_ipool;
    let cnt: i32 = 0;
    let i: i32 = 0;
    while i < len {
        let s = c.pool[off + i];
        let x = c.stmts[s];
        if x.kind == 0 {
            let nt = subst_expr(c, x.target);
            let nv = subst_expr(c, x.value);
            let nid = new_stmt(c, 0, nt, nv, -1, 0, 0);
            c.ipool[base + cnt] = nid;
            cnt = cnt + 1;
        };
        if x.kind == 1 {
            let cond = c.exprs[x.cond];
            let folded_away: bool = false;
            let spliced: bool = false;
            if cond.kind == 2 {
                let ci = const_by_name(c, cond.name_off, cond.name_len);
                if ci >= 0 {
                    let cd = c.consts[ci];
                    let vx = c.exprs[cd.value];
                    if cd.ty == 3 && vx.kind == 1 {
                        if vx.bval {
                            c.n_ipool = base + cnt;
                            let bo: i32 = 0;
                            let bl: i32 = 0;
                            fold_stmts(c, x.body_off, x.body_len, &bo, &bl);
                            let bi: i32 = 0;
                            while bi < bl {
                                let bel = c.pool[bo + bi];
                                c.ipool[base + cnt] = bel;
                                cnt = cnt + 1;
                                bi = bi + 1;
                            }
                            spliced = true;
                        } else {
                            folded_away = true;
                        };
                    };
                };
            };
            if !folded_away && !spliced {
                let nc = subst_expr(c, x.cond);
                c.n_ipool = base + cnt;
                let bo: i32 = 0;
                let bl: i32 = 0;
                fold_stmts(c, x.body_off, x.body_len, &bo, &bl);
                let nid = new_stmt(c, 1, -1, -1, nc, bo, bl);
                c.ipool[base + cnt] = nid;
                cnt = cnt + 1;
            };
        };
        if x.kind == 2 {
            c.n_ipool = base + cnt;
            let bo: i32 = 0;
            let bl: i32 = 0;
            fold_stmts(c, x.body_off, x.body_len, &bo, &bl);
            let nid = new_stmt(c, 2, -1, -1, -1, bo, bl);
            c.ipool[base + cnt] = nid;
            cnt = cnt + 1;
        };
        i = i + 1;
    }
    let ooff = c.n_pool;
    let wi: i32 = 0;
    while wi < cnt {
        let wel = c.ipool[base + wi];
        let widx = c.n_pool;
        c.pool[widx] = wel;
        c.n_pool = widx + 1;
        wi = wi + 1;
    }
    c.n_ipool = base;
    *o_off = ooff;
    *o_len = cnt;
}

fn link(c: &Ctx) -> bool {
    // stable insertion sort of shader indices by priority ascending
    let n = c.n_shaders;
    let i0: i32 = 0;
    while i0 < n {
        c.sh_order.push(i0);
        i0 = i0 + 1;
    }
    let i: i32 = 1;
    while i < n {
        let key = c.sh_order[i];
        let kp = c.shaders[key].priority;
        let j = i - 1;
        while j >= 0 {
            if c.shaders[c.sh_order[j]].priority > kp {
                c.sh_order[j + 1] = c.sh_order[j];
                j = j - 1;
            } else {
                break;
            };
        }
        c.sh_order[j + 1] = key;
        i = i + 1;
    }
    let n_mgs: i32 = 0;
    let n_min: i32 = 0;
    let n_mpa: i32 = 0;
    let n_mva: i32 = 0;
    let m_gr_base = c.n_groups;
    let m_co_base = c.n_consts;
    let init_l: Vec<i32> = Vec::new();
    let vert_l: Vec<i32> = Vec::new();
    let frag_l: Vec<i32> = Vec::new();
    let si: i32 = 0;
    while si < n {
        let s = c.shaders[c.sh_order[si]];
        let gi: i32 = 0;
        while gi < s.gr_len {
            let g = c.groups[s.gr_off + gi];
            let mi: i32 = -1;
            let mj: i32 = 0;
            while mj < c.n_groups - m_gr_base {
                if span_eq(c, c.groups[m_gr_base + mj].name_off, c.groups[m_gr_base + mj].name_len, g.name_off, g.name_len) {
                    mi = m_gr_base + mj;
                };
                mj = mj + 1;
            }
            if mi >= 0 {
                let mg = c.groups[mi];
                let foff = c.n_fields;
                let fk: i32 = 0;
                while fk < mg.fields_len {
                    let nfld = c.fields[mg.fields_off + fk];
                    let nidx = c.n_fields;
                    c.fields[nidx] = nfld;
                    c.n_fields = nidx + 1;
                    fk = fk + 1;
                }
                let nfl: i32 = mg.fields_len;
                let fj: i32 = 0;
                while fj < g.fields_len {
                    let gf2 = c.fields[g.fields_off + fj];
                    if !unify_arena(c, foff, nfl, gf2, &nfl) { return false; };
                    fj = fj + 1;
                }
                c.groups[mi].fields_off = foff;
                c.groups[mi].fields_len = nfl;
            } else {
                let ng2 = Group { name_off: g.name_off, name_len: g.name_len, fields_off: g.fields_off, fields_len: g.fields_len };
                let ngidx2 = c.n_groups;
                c.groups[ngidx2] = ng2;
                c.n_groups = ngidx2 + 1;
            };
            gi = gi + 1;
        }
        let fi: i32 = 0;
        while fi < s.gs_len {
            let uf = c.fields[s.gs_off + fi];
            if !unify_stage(c, 0, n_mgs, uf, &n_mgs) { return false; };
            fi = fi + 1;
        }
        fi = 0;
        while fi < s.in_len {
            let uf = c.fields[s.in_off + fi];
            if !unify_stage(c, 4096, n_min, uf, &n_min) { return false; };
            fi = fi + 1;
        }
        fi = 0;
        while fi < s.pa_len {
            let uf = c.fields[s.pa_off + fi];
            if !unify_stage(c, 8192, n_mpa, uf, &n_mpa) { return false; };
            fi = fi + 1;
        }
        fi = 0;
        while fi < s.va_len {
            let uf = c.fields[s.va_off + fi];
            if !unify_stage(c, 12288, n_mva, uf, &n_mva) { return false; };
            fi = fi + 1;
        }
        let ci: i32 = 0;
        while ci < s.co_len {
            let cd = c.consts[s.co_off + ci];
            let dup: bool = false;
            let cj: i32 = 0;
            while cj < c.n_consts - m_co_base {
                let mc = c.consts[m_co_base + cj];
                if span_eq(c, mc.name_off, mc.name_len, cd.name_off, cd.name_len) {
                    if mc.ty != cd.ty {
                        err_lit(c, STR_PTR("@const '"), STR_LEN("@const '"));
                        err_span(c, cd.name_off, cd.name_len);
                        err_lit(c, STR_PTR("' redefined with different type"), STR_LEN("' redefined with different type"));
                        c.failed = true;
                        return false;
                    };
                    dup = true;
                };
                cj = cj + 1;
            }
            if !dup {
                let mcidx = c.n_consts;
                c.consts[mcidx] = cd;
                c.n_consts = mcidx + 1;
            };
            ci = ci + 1;
        }
        let ti: i32 = 0;
        while ti < s.init_len {
            init_l.push(c.pool[s.init_off + ti]);
            ti = ti + 1;
        }
        ti = 0;
        while ti < s.vert_len {
            vert_l.push(c.pool[s.vert_off + ti]);
            ti = ti + 1;
        }
        ti = 0;
        while ti < s.frag_len {
            frag_l.push(c.pool[s.frag_off + ti]);
            ti = ti + 1;
        }
        si = si + 1;
    }
    c.m_gs_off = copy_stage(c, 0, n_mgs);
    c.m_gs_len = n_mgs;
    c.m_in_off = copy_stage(c, 4096, n_min);
    c.m_in_len = n_min;
    c.m_pa_off = copy_stage(c, 8192, n_mpa);
    c.m_pa_len = n_mpa;
    c.m_va_off = copy_stage(c, 12288, n_mva);
    c.m_va_len = n_mva;
    c.m_gr_off = m_gr_base;
    c.m_gr_len = c.n_groups - m_gr_base;
    c.m_co_off = m_co_base;
    c.m_co_len = c.n_consts - m_co_base;
    let p_init = pool_span(c, &init_l);
    let p_vert = pool_span(c, &vert_l);
    let p_frag = pool_span(c, &frag_l);
    let fi_o: i32 = 0;
    let fi_l: i32 = 0;
    fold_stmts(c, p_init, init_l.len(), &fi_o, &fi_l);
    c.lk_init_off = fi_o;
    c.lk_init_len = fi_l;
    let fv_o: i32 = 0;
    let fv_l: i32 = 0;
    fold_stmts(c, p_vert, vert_l.len(), &fv_o, &fv_l);
    c.lk_vert_off = fv_o;
    c.lk_vert_len = fv_l;
    let ff_o: i32 = 0;
    let ff_l: i32 = 0;
    fold_stmts(c, p_frag, frag_l.len(), &ff_o, &ff_l);
    c.lk_frag_off = ff_o;
    c.lk_frag_len = ff_l;
    if !assigns_to(c, c.lk_vert_off, c.lk_vert_len, c.spc_off, c.spc_len) {
        err_lit(c, STR_PTR("merged vertex never writes clip_position"), STR_LEN("merged vertex never writes clip_position"));
        c.failed = true;
        return false;
    };
    if !assigns_to(c, c.lk_frag_off, c.lk_frag_len, c.spf_off, c.spf_len) {
        err_lit(c, STR_PTR("merged fragment never writes frag_color"), STR_LEN("merged fragment never writes frag_color"));
        c.failed = true;
        return false;
    };
    let ni: i32 = 0;
    while ni < c.n_stmts {
        c.needed[ni] = false;
        ni = ni + 1;
    }
    run_dce(c);
    return true;
}

// ---- DCE ----

fn swizzle_mask_of(c: &Ctx, off: i32, len: i32) -> i32 {
    let mask: i32 = 0;
    let i: i32 = 0;
    while i < len {
        let idx = swizzle_index_of(span_byte(c, off + i));
        if idx >= 0 {
            mask = mask | (1 << idx);
        };
        i = i + 1;
    }
    return mask;
}

fn collect_reads(c: &Ctx, e: i32, sel: i32) {
    let x = c.exprs[e];
    if x.kind == 0 || x.kind == 1 {
        return;
    };
    if x.kind == 2 {
        if lk_group(c, x.name_off, x.name_len) >= 0 {
            return;
        };
        let ty: i32 = -1;
        let kind: i32 = -1;
        if lk_ty_of(c, x.name_off, x.name_len, &ty, &kind) {
            if ent_add(c, sel, false, x.name_off, x.name_len, 0, 0, ty_full_mask(ty)) { };
        };
        return;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind == 2 {
            let gi = lk_group(c, base.name_off, base.name_len);
            if gi >= 0 {
                let g = c.groups[gi];
                let fi: i32 = 0;
                while fi < g.fields_len {
                    let gf = c.fields[g.fields_off + fi];
                    if span_eq(c, gf.name_off, gf.name_len, x.name_off, x.name_len) {
                        if ent_add(c, sel, true, base.name_off, base.name_len, x.name_off, x.name_len, ty_full_mask(gf.ty)) { };
                    };
                    fi = fi + 1;
                }
                return;
            };
            let mask = swizzle_mask_of(c, x.name_off, x.name_len);
            if mask != 0 {
                if ent_add(c, sel, false, base.name_off, base.name_len, 0, 0, mask) { };
                return;
            };
        };
        collect_reads(c, x.a, sel);
        return;
    };
    if x.kind == 4 {
        collect_reads(c, x.a, sel);
        collect_reads(c, x.b, sel);
        return;
    };
    if x.kind == 5 {
        collect_reads(c, x.a, sel);
        return;
    };
    if x.kind == 6 || x.kind == 7 {
        if x.kind == 6 {
            collect_reads(c, x.a, sel);
        };
        let i: i32 = 0;
        while i < x.args_len {
            collect_reads(c, c.pool[x.args_off + i], sel);
            i = i + 1;
        }
        return;
    };
}

fn write_target(c: &Ctx, e: i32, out: &LiveEnt) -> bool {
    let x = c.exprs[e];
    if x.kind == 2 {
        let ty: i32 = -1;
        let kind: i32 = -1;
        if !lk_ty_of(c, x.name_off, x.name_len, &ty, &kind) {
            return false;
        };
        out.g = false;
        out.o1 = x.name_off;
        out.l1 = x.name_len;
        out.o2 = 0;
        out.l2 = 0;
        out.mask = ty_full_mask(ty);
        return true;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind == 2 {
            let mask = swizzle_mask_of(c, x.name_off, x.name_len);
            if mask != 0 {
                out.g = false;
                out.o1 = base.name_off;
                out.l1 = base.name_len;
                out.o2 = 0;
                out.l2 = 0;
                out.mask = mask;
                return true;
            };
        };
        return false;
    };
    return false;
}

fn mark_stmt(c: &Ctx, s: i32) -> bool {
    if c.needed[s] {
        return true;
    };
    let x = c.stmts[s];
    if x.kind == 0 {
        let wt = LiveEnt { g: false, o1: 0, l1: 0, o2: 0, l2: 0, mask: 0 };
        if !write_target(c, x.target, &wt) {
            return false;
        };
        let live_mask = map_mask(c.text.data as ptr, &c.live, c.n_live, wt.g, wt.o1, wt.l1, wt.o2, wt.l2);
        let is_root: bool = span_eq(c, wt.o1, wt.l1, c.spc_off, c.spc_len) || span_eq(c, wt.o1, wt.l1, c.spf_off, c.spf_len);
        if is_root || (live_mask & wt.mask) != 0 {
            c.needed[s] = true;
            c.n_scratch = 0;
            collect_reads(c, x.value, 0);
            merge_live(c);
            return true;
        };
        return false;
    };
    if x.kind == 1 || x.kind == 2 {
        let any: bool = false;
        let i: i32 = 0;
        while i < x.body_len {
            if mark_stmt(c, c.pool[x.body_off + i]) {
                any = true;
            };
            i = i + 1;
        }
        if any {
            c.needed[s] = true;
            if x.kind == 1 {
                c.n_scratch = 0;
                collect_reads(c, x.cond, 0);
                merge_live(c);
            };
            return true;
        };
        return false;
    };
    return false;
}

fn run_dce(c: &Ctx) {
    let seed1 = LiveEnt { g: false, o1: c.spc_off, l1: c.spc_len, o2: 0, l2: 0, mask: 15 };
    let sidx1 = c.n_live;
    c.live[sidx1] = seed1;
    c.n_live = sidx1 + 1;
    let seed2 = LiveEnt { g: false, o1: c.spf_off, l1: c.spf_len, o2: 0, l2: 0, mask: 15 };
    let sidx2 = c.n_live;
    c.live[sidx2] = seed2;
    c.n_live = sidx2 + 1;
    let running: bool = true;
    while running {
        let before: i32 = 0;
        let i: i32 = 0;
        while i < c.n_stmts {
            if c.needed[i] {
                before = before + 1;
            };
            i = i + 1;
        }
        c.live_grew = false;
        let j: i32 = 0;
        while j < c.lk_vert_len {
            if mark_stmt(c, c.pool[c.lk_vert_off + j]) { };
            j = j + 1;
        }
        j = 0;
        while j < c.lk_frag_len {
            if mark_stmt(c, c.pool[c.lk_frag_off + j]) { };
            j = j + 1;
        }
        j = 0;
        while j < c.lk_init_len {
            if mark_stmt(c, c.pool[c.lk_init_off + j]) { };
            j = j + 1;
        }
        let after: i32 = 0;
        i = 0;
        while i < c.n_stmts {
            if c.needed[i] {
                after = after + 1;
            };
            i = i + 1;
        }
        if after == before && !c.live_grew {
            running = false;
        };
    }
}

fn is_live_key(c: &Ctx, g: bool, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    return map_mask(c.text.data as ptr, &c.live, c.n_live, g, o1, l1, o2, l2) != 0;
}

fn reads_of_list(c: &Ctx, list: &Vec<i32>, sel: i32) {
    let i: i32 = 0;
    while i < list.len() {
        reads_of_stmt(c, list[i], sel);
        i = i + 1;
    }
}

fn reads_of_stmt(c: &Ctx, s: i32, sel: i32) {
    if !c.needed[s] {
        return;
    };
    let x = c.stmts[s];
    if x.kind == 0 {
        collect_reads(c, x.value, sel);
        return;
    };
    if x.kind == 1 {
        collect_reads(c, x.cond, sel);
        let i: i32 = 0;
        while i < x.body_len {
            reads_of_stmt(c, c.pool[x.body_off + i], sel);
            i = i + 1;
        }
        return;
    };
    if x.kind == 2 {
        let i: i32 = 0;
        while i < x.body_len {
            reads_of_stmt(c, c.pool[x.body_off + i], sel);
            i = i + 1;
        }
        return;
    };
}

fn reads_of_span(c: &Ctx, off: i32, len: i32, sel: i32) {
    let i: i32 = 0;
    while i < len {
        reads_of_stmt(c, c.pool[off + i], sel);
        i = i + 1;
    }
}

fn writes_of_list(c: &Ctx, list: &Vec<i32>, sel: i32) {
    let i: i32 = 0;
    while i < list.len() {
        writes_of_stmt(c, list[i], sel);
        i = i + 1;
    }
}

fn writes_of_stmt(c: &Ctx, s: i32, sel: i32) {
    if !c.needed[s] {
        return;
    };
    let x = c.stmts[s];
    if x.kind == 0 {
        let wt = LiveEnt { g: false, o1: 0, l1: 0, o2: 0, l2: 0, mask: 0 };
        if write_target(c, x.target, &wt) {
            if ent_add(c, sel, wt.g, wt.o1, wt.l1, wt.o2, wt.l2, 1) { };
        };
        return;
    };
    if x.kind == 1 || x.kind == 2 {
        let i: i32 = 0;
        while i < x.body_len {
            writes_of_stmt(c, c.pool[x.body_off + i], sel);
            i = i + 1;
        }
        return;
    };
}

fn writes_of_span(c: &Ctx, off: i32, len: i32, sel: i32) {
    let i: i32 = 0;
    while i < len {
        writes_of_stmt(c, c.pool[off + i], sel);
        i = i + 1;
    }
}

// init statements woven into a stage, in stable dependency order
fn woven_init(c: &Ctx, stage_reads: &Vec<LiveEnt>, o_off: &i32, o_len: &i32) -> bool {
    c.n_acc = 0;
    let ai: i32 = 0;
    while ai < stage_reads.len() {
        let e = stage_reads[ai];
        if ent_add(c, 2, e.g, e.o1, e.l1, e.o2, e.l2, e.mask) { };
        ai = ai + 1;
    }
    let included: Vec<i32> = Vec::new();
    let progress: bool = true;
    while progress {
        progress = false;
        let si: i32 = 0;
        while si < c.lk_init_len {
            let s = c.pool[c.lk_init_off + si];
            si = si + 1;
            if !c.needed[s] {
                continue;
            };
            let already: bool = false;
            let ii: i32 = 0;
            while ii < included.len() {
                if included[ii] == s {
                    already = true;
                };
                ii = ii + 1;
            }
            if already {
                continue;
            };
            let one: Vec<i32> = Vec::new();
            one.push(s);
            c.n_scratch = 0;
            writes_of_list(c, &one, 0);
            let hit: bool = false;
            let wi: i32 = 0;
            while wi < c.n_scratch {
                let w = c.scratch[wi];
                if map_has(c.text.data as ptr, &c.acc, c.n_acc, w.g, w.o1, w.l1, w.o2, w.l2) {
                    hit = true;
                };
                wi = wi + 1;
            }
            if hit {
                included.push(s);
                reads_of_list(c, &one, 2);
                progress = true;
            };
        }
    }
    let ordered: Vec<i32> = Vec::new();
    let remaining: Vec<i32> = Vec::new();
    let ri: i32 = 0;
    while ri < included.len() {
        let rel = included[ri];
        remaining.push(rel);
        ri = ri + 1;
    }
    while remaining.len() > 0 {
        let picked: i32 = -1;
        let idx: i32 = 0;
        while idx < remaining.len() && picked < 0 {
            let s = remaining[idx];
            let one: Vec<i32> = Vec::new();
            one.push(s);
            c.n_scratch = 0;
            reads_of_list(c, &one, 0);
            let rn = c.n_scratch;
            let blocked: bool = false;
            let oj: i32 = 0;
            while oj < remaining.len() && !blocked {
                if oj != idx {
                    let oneo: Vec<i32> = Vec::new();
                    let oel = remaining[oj];
                    oneo.push(oel);
                    c.n_scratch2 = 0;
                    writes_of_list(c, &oneo, 1);
                    let rj: i32 = 0;
                    while rj < rn {
                        let rk = c.scratch[rj];
                        if map_has(c.text.data as ptr, &c.scratch2, c.n_scratch2, rk.g, rk.o1, rk.l1, rk.o2, rk.l2) {
                            blocked = true;
                        };
                        rj = rj + 1;
                    }
                };
                oj = oj + 1;
            }
            if !blocked {
                picked = idx;
            };
            idx = idx + 1;
        }
        if picked < 0 {
            err_lit(c, STR_PTR("cycle in init dependencies"), STR_LEN("cycle in init dependencies"));
            c.failed = true;
            *o_off = 0;
            *o_len = 0;
            return false;
        };
        let pel = remaining[picked];
        ordered.push(pel);
        remaining.remove(picked);
    }
    *o_len = ordered.len();
    *o_off = pool_span(c, &ordered);
    return true;
}

// ------------------------------------------------------------------
// emitter state + shared expression printing (mirrors proto
// Emitter). Dialects: 0 = glsl-es300, 1 = glsl-es100, 2 = hlsl.
// ------------------------------------------------------------------

fn em_init(c: &Ctx) -> bool {
    let tp = c.text.data as ptr;
    c.n_scratch = 0;
    reads_of_span(c, c.lk_vert_off, c.lk_vert_len, 0);
    let pa1: i32 = 0;
    while pa1 < c.n_scratch {
        let entpa1 = c.scratch[pa1];
        let ixpa1 = c.n_vreads;
        c.v_reads[ixpa1] = entpa1;
        c.n_vreads = ixpa1 + 1;
        pa1 = pa1 + 1;
    }
    c.n_scratch = 0;
    reads_of_span(c, c.lk_frag_off, c.lk_frag_len, 0);
    let pa2: i32 = 0;
    while pa2 < c.n_scratch {
        let entpa2 = c.scratch[pa2];
        let ixpa2 = c.n_freads;
        c.f_reads[ixpa2] = entpa2;
        c.n_freads = ixpa2 + 1;
        pa2 = pa2 + 1;
    }
    c.n_scratch = 0;
    writes_of_span(c, c.lk_vert_off, c.lk_vert_len, 0);
    let pa3: i32 = 0;
    while pa3 < c.n_scratch {
        let entpa3 = c.scratch[pa3];
        let ixpa3 = c.n_vwrites;
        c.v_writes[ixpa3] = entpa3;
        c.n_vwrites = ixpa3 + 1;
        pa3 = pa3 + 1;
    }
    c.n_scratch = 0;
    writes_of_span(c, c.lk_frag_off, c.lk_frag_len, 0);
    let pa4: i32 = 0;
    while pa4 < c.n_scratch {
        let entpa4 = c.scratch[pa4];
        let ixpa4 = c.n_fwrites;
        c.f_writes[ixpa4] = entpa4;
        c.n_fwrites = ixpa4 + 1;
        pa4 = pa4 + 1;
    }
    c.n_scratch = 0;
    writes_of_span(c, c.lk_init_off, c.lk_init_len, 0);
    let pa5: i32 = 0;
    while pa5 < c.n_scratch {
        let entpa5 = c.scratch[pa5];
        let ixpa5 = c.n_iwrites;
        c.i_writes[ixpa5] = entpa5;
        c.n_iwrites = ixpa5 + 1;
        pa5 = pa5 + 1;
    }
    let i: i32 = 0;
    while i < c.m_va_len {
        let f = c.fields[c.m_va_off + i];
        if map_has(tp, &c.v_writes, c.n_vwrites, false, f.name_off, f.name_len, 0, 0) {
            if map_mask(tp, &c.f_reads, c.n_freads, false, f.name_off, f.name_len, 0, 0) != 0 {
                c.varyings.push(c.m_va_off + i);
            };
        };
        i = i + 1;
    }
    let vr_copy: Vec<LiveEnt> = Vec::new();
    let pa20: i32 = 0;
    while pa20 < c.n_vreads {
        let entpa20 = c.v_reads[pa20];
        vr_copy.push(entpa20);
        pa20 = pa20 + 1;
    }
    let wo1: i32 = 0;
    let wl1: i32 = 0;
    let ok1 = woven_init(c, &vr_copy, &wo1, &wl1);
    if !ok1 {
        return false;
    };
    c.v_woven_off = wo1;
    c.v_woven_len = wl1;
    let fr_copy: Vec<LiveEnt> = Vec::new();
    let pa21: i32 = 0;
    while pa21 < c.n_freads {
        let entpa21 = c.f_reads[pa21];
        fr_copy.push(entpa21);
        pa21 = pa21 + 1;
    }
    let wo2: i32 = 0;
    let wl2: i32 = 0;
    let ok2 = woven_init(c, &fr_copy, &wo2, &wl2);
    if !ok2 {
        return false;
    };
    c.f_woven_off = wo2;
    c.f_woven_len = wl2;
    c.n_scratch = 0;
    reads_of_span(c, c.v_woven_off, c.v_woven_len, 0);
    let pa6: i32 = 0;
    while pa6 < c.n_scratch {
        let entpa6 = c.scratch[pa6];
        let ixpa6 = c.n_vwoven;
        c.v_woven_reads[ixpa6] = entpa6;
        c.n_vwoven = ixpa6 + 1;
        pa6 = pa6 + 1;
    }
    c.n_scratch = 0;
    reads_of_span(c, c.f_woven_off, c.f_woven_len, 0);
    let pa7: i32 = 0;
    while pa7 < c.n_scratch {
        let entpa7 = c.scratch[pa7];
        let ixpa7 = c.n_fwoven;
        c.f_woven_reads[ixpa7] = entpa7;
        c.n_fwoven = ixpa7 + 1;
        pa7 = pa7 + 1;
    }
    return true;
}

fn is_varying(c: &Ctx, off: i32, len: i32) -> bool {
    let i: i32 = 0;
    while i < c.varyings.len() {
        let f = c.fields[c.varyings[i]];
        if span_eq(c, f.name_off, f.name_len, off, len) {
            return true;
        };
        i = i + 1;
    }
    return false;
}

fn used_in(c: &Ctx, stage: i32, off: i32, len: i32) -> bool {
    if stage == 1 {
        if map_mask(c.text.data as ptr, &c.v_reads, c.n_vreads, false, off, len, 0, 0) != 0 {
            return true;
        };
        return map_mask(c.text.data as ptr, &c.v_woven_reads, c.n_vwoven, false, off, len, 0, 0) != 0;
    };
    if map_mask(c.text.data as ptr, &c.f_reads, c.n_freads, false, off, len, 0, 0) != 0 {
        return true;
    };
    return map_mask(c.text.data as ptr, &c.f_woven_reads, c.n_fwoven, false, off, len, 0, 0) != 0;
}

fn is_local_to(c: &Ctx, stage: i32, off: i32, len: i32) -> bool {
    if is_varying(c, off, len) {
        return false;
    };
    let inw: bool = false;
    if stage == 1 {
        inw = map_has(c.text.data as ptr, &c.v_writes, c.n_vwrites, false, off, len, 0, 0);
    } else {
        inw = map_has(c.text.data as ptr, &c.f_writes, c.n_fwrites, false, off, len, 0, 0);
    };
    if !inw {
        if !map_has(c.text.data as ptr, &c.i_writes, c.n_iwrites, false, off, len, 0, 0) {
            return false;
        };
    };
    return used_in(c, stage, off, len);
}

fn type_of_expr(c: &Ctx, e: i32) -> i32 {
    let x = c.exprs[e];
    if x.kind == 0 {
        if span_has_dot(c, x.name_off, x.name_len) {
            return 0;
        };
        return 1;
    };
    if x.kind == 1 {
        return 3;
    };
    if x.kind == 2 {
        let ty: i32 = -1;
        let kind: i32 = -1;
        if lk_ty_of(c, x.name_off, x.name_len, &ty, &kind) {
            return ty;
        };
        return 0;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind == 2 {
            let gi = lk_group(c, base.name_off, base.name_len);
            if gi >= 0 {
                let g = c.groups[gi];
                let fi: i32 = 0;
                while fi < g.fields_len {
                    let gf = c.fields[g.fields_off + fi];
                    if span_eq(c, gf.name_off, gf.name_len, x.name_off, x.name_len) {
                        return gf.ty;
                    };
                    fi = fi + 1;
                }
                return 0;
            };
        };
        if x.name_len == 1 { return 0; };
        if x.name_len == 2 { return 4; };
        if x.name_len == 3 { return 5; };
        return 6;
    };
    if x.kind == 4 {
        let lt = type_of_expr(c, x.a);
        let rt = type_of_expr(c, x.b);
        if lt == rt { return lt; };
        if lt == 8 && rt == 6 { return 6; };
        if lt == 6 && rt == 8 { return 6; };
        if lt == 7 && rt == 5 { return 5; };
        if lt == 5 && rt == 7 { return 5; };
        if ty_is_vec(lt) { return lt; };
        if ty_is_vec(rt) { return rt; };
        if lt == 0 || rt == 0 { return 0; };
        return lt;
    };
    if x.kind == 5 {
        return type_of_expr(c, x.a);
    };
    if x.kind == 7 {
        return x.ty;
    };
    return 6;
}

fn out_span(c: &Ctx, out: &Buf, off: i32, len: i32) {
    buf_push_span(out, (c.text.data.add(off as usize)) as ptr, len as u64);
}

fn ty_wgsl_into(b: &Buf, ty: i32) {
    if ty == 0 { buf_push_lit(b, STR_PTR("f32"), STR_LEN("f32")); return; };
    if ty == 1 { buf_push_lit(b, STR_PTR("i32"), STR_LEN("i32")); return; };
    if ty == 2 { buf_push_lit(b, STR_PTR("u32"), STR_LEN("u32")); return; };
    if ty == 3 { buf_push_lit(b, STR_PTR("bool"), STR_LEN("bool")); return; };
    if ty == 4 { buf_push_lit(b, STR_PTR("vec2<f32>"), STR_LEN("vec2<f32>")); return; };
    if ty == 5 { buf_push_lit(b, STR_PTR("vec3<f32>"), STR_LEN("vec3<f32>")); return; };
    if ty == 6 { buf_push_lit(b, STR_PTR("vec4<f32>"), STR_LEN("vec4<f32>")); return; };
    if ty == 7 { buf_push_lit(b, STR_PTR("mat3x3<f32>"), STR_LEN("mat3x3<f32>")); return; };
    if ty == 8 { buf_push_lit(b, STR_PTR("mat4x4<f32>"), STR_LEN("mat4x4<f32>")); return; };
    buf_push_lit(b, STR_PTR("texture_2d<f32>"), STR_LEN("texture_2d<f32>"));
}

fn ty_msl_into(b: &Buf, ty: i32) {
    if ty == 0 { buf_push_lit(b, STR_PTR("float"), STR_LEN("float")); return; };
    if ty == 1 { buf_push_lit(b, STR_PTR("int"), STR_LEN("int")); return; };
    if ty == 2 { buf_push_lit(b, STR_PTR("uint"), STR_LEN("uint")); return; };
    if ty == 3 { buf_push_lit(b, STR_PTR("bool"), STR_LEN("bool")); return; };
    if ty == 4 { buf_push_lit(b, STR_PTR("float2"), STR_LEN("float2")); return; };
    if ty == 5 { buf_push_lit(b, STR_PTR("float3"), STR_LEN("float3")); return; };
    if ty == 6 { buf_push_lit(b, STR_PTR("float4"), STR_LEN("float4")); return; };
    if ty == 7 { buf_push_lit(b, STR_PTR("float3x3"), STR_LEN("float3x3")); return; };
    if ty == 8 { buf_push_lit(b, STR_PTR("float4x4"), STR_LEN("float4x4")); return; };
    buf_push_lit(b, STR_PTR("texture2d<float>"), STR_LEN("texture2d<float>"));
}

fn out_ty(c: &Ctx, out: &Buf, dialect: i32, ty: i32) {
    if dialect == 2 || dialect == 5 || dialect == 7 {
        ty_hlsl_into(out, ty);
        return;
    };
    if dialect == 3 {
        ty_wgsl_into(out, ty);
        return;
    };
    if dialect == 4 {
        ty_msl_into(out, ty);
        return;
    };
    ty_name_into(out, ty);
}

fn ty_blender_into(out: &Buf, ty: i32) {
    if ty == 0 { buf_push_lit(out, STR_PTR("float"), STR_LEN("float")); return; };
    if ty == 1 { buf_push_lit(out, STR_PTR("int"), STR_LEN("int")); return; };
    if ty == 2 { buf_push_lit(out, STR_PTR("uint"), STR_LEN("uint")); return; };
    if ty == 3 { buf_push_lit(out, STR_PTR("bool"), STR_LEN("bool")); return; };
    if ty == 4 { buf_push_lit(out, STR_PTR("vec2"), STR_LEN("vec2")); return; };
    if ty == 5 { buf_push_lit(out, STR_PTR("vec3"), STR_LEN("vec3")); return; };
    if ty == 6 { buf_push_lit(out, STR_PTR("vec4"), STR_LEN("vec4")); return; };
    if ty == 7 { buf_push_lit(out, STR_PTR("mat3"), STR_LEN("mat3")); return; };
    if ty == 8 { buf_push_lit(out, STR_PTR("mat4"), STR_LEN("mat4")); return; };
    buf_push_lit(out, STR_PTR("sampler2D"), STR_LEN("sampler2D"));
}

// HLSL-style type name into a buf (unreal glue SHADER_PARAMETER types)
fn ty_hlsl_name_into(out: &Buf, ty: i32) {
    if ty == 0 { buf_push_lit(out, STR_PTR("float"), STR_LEN("float")); return; };
    if ty == 1 { buf_push_lit(out, STR_PTR("int32"), STR_LEN("int32")); return; };
    if ty == 2 { buf_push_lit(out, STR_PTR("uint32"), STR_LEN("uint32")); return; };
    if ty == 3 { buf_push_lit(out, STR_PTR("bool"), STR_LEN("bool")); return; };
    if ty == 4 { buf_push_lit(out, STR_PTR("float2"), STR_LEN("float2")); return; };
    if ty == 5 { buf_push_lit(out, STR_PTR("float3"), STR_LEN("float3")); return; };
    if ty == 6 { buf_push_lit(out, STR_PTR("float4"), STR_LEN("float4")); return; };
    if ty == 7 { buf_push_lit(out, STR_PTR("float3x3"), STR_LEN("float3x3")); return; };
    buf_push_lit(out, STR_PTR("float4x4"), STR_LEN("float4x4"));
}

fn print_ident(c: &Ctx, off: i32, len: i32, dialect: i32, stage: i32, out: &Buf) {
    if span_eq(c, off, len, c.spc_off, c.spc_len) {
        if dialect == 3 {
            buf_push_lit(out, STR_PTR("output.clip_position"), STR_LEN("output.clip_position"));
        } else {
            if dialect == 2 || dialect == 4 || dialect == 5 || dialect == 7 {
                buf_push_lit(out, STR_PTR("output.position"), STR_LEN("output.position"));
            } else {
                buf_push_lit(out, STR_PTR("gl_Position"), STR_LEN("gl_Position"));
            };
        };
        return;
    };
    if span_eq(c, off, len, c.spf_off, c.spf_len) {
        if dialect == 0 {
            buf_push_lit(out, STR_PTR("slasl_frag_color"), STR_LEN("slasl_frag_color"));
            return;
        };
        if dialect == 1 {
            buf_push_lit(out, STR_PTR("gl_FragColor"), STR_LEN("gl_FragColor"));
            return;
        };
        buf_push_lit(out, STR_PTR("frag_color"), STR_LEN("frag_color"));
        return;
    };
    if dialect == 3 || dialect == 4 {
        let ty3: i32 = -1;
        let kind3: i32 = 3;
        if lk_ty_of(c, off, len, &ty3, &kind3) { };
        if kind3 == 0 {
            buf_push_lit(out, STR_PTR("input."), STR_LEN("input."));
            out_span(c, out, off, len);
            return;
        };
        if kind3 == 1 {
            buf_push_lit(out, STR_PTR("params."), STR_LEN("params."));
            out_span(c, out, off, len);
            return;
        };
        if kind3 == 4 {
            buf_push_lit(out, STR_PTR("globals."), STR_LEN("globals."));
            out_span(c, out, off, len);
            return;
        };
        if is_varying(c, off, len) {
            if stage == 1 {
                buf_push_lit(out, STR_PTR("output."), STR_LEN("output."));
            } else {
                buf_push_lit(out, STR_PTR("input."), STR_LEN("input."));
            };
            out_span(c, out, off, len);
            return;
        };
        out_span(c, out, off, len);
        return;
    };
    if dialect == 6 {
        if is_varying(c, off, len) {
            if stage == 1 {
                buf_push_lit(out, STR_PTR("stage_out."), STR_LEN("stage_out."));
            } else {
                buf_push_lit(out, STR_PTR("stage_in."), STR_LEN("stage_in."));
            };
            out_span(c, out, off, len);
            return;
        };
        out_span(c, out, off, len);
        return;
    };
    if dialect == 2 || dialect == 5 || dialect == 7 {
        let ty: i32 = -1;
        let kind: i32 = 3;
        if lk_ty_of(c, off, len, &ty, &kind) { };
        if kind == 0 {
            buf_push_lit(out, STR_PTR("input."), STR_LEN("input."));
            out_span(c, out, off, len);
            return;
        };
        if is_varying(c, off, len) {
            if stage == 1 {
                buf_push_lit(out, STR_PTR("output."), STR_LEN("output."));
            } else {
                buf_push_lit(out, STR_PTR("input."), STR_LEN("input."));
            };
            out_span(c, out, off, len);
            return;
        };
    };
    out_span(c, out, off, len);
}

fn print_expr(c: &Ctx, e: i32, dialect: i32, stage: i32, out: &Buf) {
    let x = c.exprs[e];
    if x.kind == 0 {
        out_span(c, out, x.name_off, x.name_len);
        if dialect == 3 && type_of_expr(c, e) == 0 {
            let hasdot: bool = false;
            let li: i32 = 0;
            while li < x.name_len {
                let b = span_byte(c, x.name_off + li);
                if b == 46 || b == 101 || b == 69 {
                    hasdot = true;
                };
                li = li + 1;
            }
            if !hasdot {
                buf_push_lit(out, STR_PTR(".0"), STR_LEN(".0"));
            };
        };
        return;
    };
    if x.kind == 1 {
        if x.bval {
            buf_push_lit(out, STR_PTR("true"), STR_LEN("true"));
        } else {
            buf_push_lit(out, STR_PTR("false"), STR_LEN("false"));
        };
        return;
    };
    if x.kind == 2 {
        print_ident(c, x.name_off, x.name_len, dialect, stage, out);
        return;
    };
    if x.kind == 3 {
        let base = c.exprs[x.a];
        if base.kind == 2 {
            if lk_group(c, base.name_off, base.name_len) >= 0 {
                if dialect == 3 || dialect == 4 {
                    out_span(c, out, base.name_off, base.name_len);
                    buf_push_byte(out, 46);
                    out_span(c, out, x.name_off, x.name_len);
                    return;
                };
                if dialect == 7 {
                    out_span(c, out, base.name_off, base.name_len);
                    buf_push_byte(out, 95);
                    out_span(c, out, x.name_off, x.name_len);
                    return;
                };
                out_span(c, out, x.name_off, x.name_len);
                return;
            };
        };
        print_expr(c, x.a, dialect, stage, out);
        buf_push_byte(out, 46);
        out_span(c, out, x.name_off, x.name_len);
        return;
    };
    if x.kind == 4 {
        let lt = type_of_expr(c, x.a);
        let rt = type_of_expr(c, x.b);
        if (dialect == 2 || dialect == 5 || dialect == 7) && (ty_is_mat(lt) || ty_is_mat(rt)) {
            buf_push_lit(out, STR_PTR("mul("), STR_LEN("mul("));
            print_expr(c, x.a, dialect, stage, out);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
            print_expr(c, x.b, dialect, stage, out);
            buf_push_byte(out, 41);
            return;
        };
        buf_push_byte(out, 40);
        print_expr(c, x.a, dialect, stage, out);
        buf_push_byte(out, 32);
        buf_push_byte(out, x.op as u8);
        buf_push_byte(out, 32);
        print_expr(c, x.b, dialect, stage, out);
        buf_push_byte(out, 41);
        return;
    };
    if x.kind == 5 {
        buf_push_lit(out, STR_PTR("(-"), STR_LEN("(-"));
        print_expr(c, x.a, dialect, stage, out);
        buf_push_byte(out, 41);
        return;
    };
    if x.kind == 7 {
        out_ty(c, out, dialect, x.ty);
        buf_push_byte(out, 40);
        let i: i32 = 0;
        while i < x.args_len {
            if i > 0 {
                buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
            };
            print_expr(c, c.pool[x.args_off + i], dialect, stage, out);
            i = i + 1;
        }
        buf_push_byte(out, 41);
        return;
    };
    if x.kind == 6 {
        let callee = c.exprs[x.a];
        let cbase = c.exprs[callee.a];
        if dialect == 0 {
            buf_push_lit(out, STR_PTR("texture("), STR_LEN("texture("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
        };
        if dialect == 1 {
            buf_push_lit(out, STR_PTR("texture2D("), STR_LEN("texture2D("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
        };
        if dialect == 2 {
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(".Sample("), STR_LEN(".Sample("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR("_sampler, "), STR_LEN("_sampler, "));
        };
        if dialect == 3 {
            buf_push_lit(out, STR_PTR("textureSample("), STR_LEN("textureSample("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR("_sampler, "), STR_LEN("_sampler, "));
        };
        if dialect == 4 {
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(".sample("), STR_LEN(".sample("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR("_sampler, "), STR_LEN("_sampler, "));
        };
        if dialect == 5 {
            buf_push_lit(out, STR_PTR("SAMPLE_TEXTURE2D("), STR_LEN("SAMPLE_TEXTURE2D("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", sampler"), STR_LEN(", sampler"));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
        };
        if dialect == 6 {
            buf_push_lit(out, STR_PTR("texture("), STR_LEN("texture("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
        };
        if dialect == 7 {
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR(".Sample("), STR_LEN(".Sample("));
            out_span(c, out, cbase.name_off, cbase.name_len);
            buf_push_lit(out, STR_PTR("Sampler, "), STR_LEN("Sampler, "));
        };
        print_expr(c, c.pool[x.args_off], dialect, stage, out);
        buf_push_byte(out, 41);
        return;
    };
}

fn print_pad(out: &Buf, indent: i32) {
    let i: i32 = 0;
    while i < indent * 4 {
        buf_push_byte(out, 32);
        i = i + 1;
    }
}

fn print_stmts(c: &Ctx, off: i32, len: i32, dialect: i32, stage: i32, indent: i32, out: &Buf) {
    let i: i32 = 0;
    while i < len {
        let s = c.pool[off + i];
        if c.needed[s] {
            print_stmt(c, s, dialect, stage, indent, out);
        };
        i = i + 1;
    }
}

fn print_stmt(c: &Ctx, s: i32, dialect: i32, stage: i32, indent: i32, out: &Buf) {
    let x = c.stmts[s];
    if x.kind == 0 {
        print_pad(out, indent);
        print_expr(c, x.target, dialect, stage, out);
        buf_push_lit(out, STR_PTR(" = "), STR_LEN(" = "));
        print_expr(c, x.value, dialect, stage, out);
        buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        return;
    };
    if x.kind == 1 {
        print_pad(out, indent);
        buf_push_lit(out, STR_PTR("if ("), STR_LEN("if ("));
        print_expr(c, x.cond, dialect, stage, out);
        buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
        print_pad(out, indent);
        buf_push_lit(out, STR_PTR("{\n"), STR_LEN("{\n"));
        print_stmts(c, x.body_off, x.body_len, dialect, stage, indent + 1, out);
        print_pad(out, indent);
        buf_push_lit(out, STR_PTR("}\n"), STR_LEN("}\n"));
        return;
    };
    if x.kind == 2 {
        print_stmts(c, x.body_off, x.body_len, dialect, stage, indent, out);
        return;
    };
}

fn live_params(c: &Ctx) -> Vec<i32> {
    let out: Vec<i32> = Vec::new();
    let i: i32 = 0;
    while i < c.m_pa_len {
        let f = c.fields[c.m_pa_off + i];
        if f.ty != 9 {
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                out.push(c.m_pa_off + i);
            };
        };
        i = i + 1;
    }
    return out;
}

fn live_samplers(c: &Ctx) -> Vec<i32> {
    let out: Vec<i32> = Vec::new();
    let i: i32 = 0;
    while i < c.m_pa_len {
        let f = c.fields[c.m_pa_off + i];
        if f.ty == 9 {
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                out.push(c.m_pa_off + i);
            };
        };
        i = i + 1;
    }
    return out;
}

fn emit_glsl(c: &Ctx, dialect: i32, stage: i32, out: &Buf) {
    if dialect == 0 {
        buf_push_lit(out, STR_PTR("#version 300 es\n"), STR_LEN("#version 300 es\n"));
    };
    buf_push_lit(out, STR_PTR("precision highp float;\nprecision highp int;\n\n"), STR_LEN("precision highp float;\nprecision highp int;\n\n"));
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let live_fields: Vec<i32> = Vec::new();
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                live_fields.push(g.fields_off + fi);
            };
            fi = fi + 1;
        }
        if live_fields.len() > 0 {
            if dialect == 0 {
                buf_push_lit(out, STR_PTR("layout(std140) uniform "), STR_LEN("layout(std140) uniform "));
                out_span(c, out, g.name_off, g.name_len);
                buf_push_lit(out, STR_PTR("\n{\n"), STR_LEN("\n{\n"));
                let li: i32 = 0;
                while li < live_fields.len() {
                    let gf = c.fields[live_fields[li]];
                    buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                    out_ty(c, out, dialect, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                    li = li + 1;
                }
                buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
            } else {
                let li: i32 = 0;
                while li < live_fields.len() {
                    let gf = c.fields[live_fields[li]];
                    buf_push_lit(out, STR_PTR("uniform "), STR_LEN("uniform "));
                    out_ty(c, out, dialect, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                    li = li + 1;
                }
                buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
            };
        };
        gi = gi + 1;
    }
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            buf_push_lit(out, STR_PTR("uniform "), STR_LEN("uniform "));
            out_ty(c, out, dialect, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        si = si + 1;
    }
    let lp = live_params(c);
    if lp.len() > 0 {
        if dialect == 0 {
            buf_push_lit(out, STR_PTR("layout(std140) uniform Params\n{\n"), STR_LEN("layout(std140) uniform Params\n{\n"));
            let li: i32 = 0;
            while li < lp.len() {
                let f = c.fields[lp[li]];
                buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                out_ty(c, out, dialect, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                li = li + 1;
            }
            buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
        } else {
            let li: i32 = 0;
            while li < lp.len() {
                let f = c.fields[lp[li]];
                buf_push_lit(out, STR_PTR("uniform "), STR_LEN("uniform "));
                out_ty(c, out, dialect, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                li = li + 1;
            }
            buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        };
    };
    let ls = live_samplers(c);
    let any_sampler: bool = false;
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        if used_in(c, stage, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("uniform sampler2D "), STR_LEN("uniform sampler2D "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            any_sampler = true;
        };
        sai = sai + 1;
    }
    if any_sampler {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    if stage == 1 {
        let ii: i32 = 0;
        while ii < c.m_in_len {
            let f = c.fields[c.m_in_off + ii];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                if dialect == 0 {
                    buf_push_lit(out, STR_PTR("in "), STR_LEN("in "));
                } else {
                    buf_push_lit(out, STR_PTR("attribute "), STR_LEN("attribute "));
                };
                out_ty(c, out, dialect, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            ii = ii + 1;
        }
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        let vi: i32 = 0;
        while vi < c.m_va_len {
            let v = c.fields[c.m_va_off + vi];
            if is_varying(c, v.name_off, v.name_len) {
                if dialect == 0 {
                    buf_push_lit(out, STR_PTR("out "), STR_LEN("out "));
                } else {
                    buf_push_lit(out, STR_PTR("varying "), STR_LEN("varying "));
                };
                out_ty(c, out, dialect, v.ty);
                buf_push_byte(out, 32);
                out_span(c, out, v.name_off, v.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            vi = vi + 1;
        }
    } else {
        let vi: i32 = 0;
        while vi < c.m_va_len {
            let v = c.fields[c.m_va_off + vi];
            if is_varying(c, v.name_off, v.name_len) {
                if dialect == 0 {
                    buf_push_lit(out, STR_PTR("in "), STR_LEN("in "));
                } else {
                    buf_push_lit(out, STR_PTR("varying "), STR_LEN("varying "));
                };
                out_ty(c, out, dialect, v.ty);
                buf_push_byte(out, 32);
                out_span(c, out, v.name_off, v.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            vi = vi + 1;
        }
        if dialect == 0 {
            buf_push_lit(out, STR_PTR("out vec4 slasl_frag_color;\n"), STR_LEN("out vec4 slasl_frag_color;\n"));
        };
    };
    buf_push_lit(out, STR_PTR("\nvoid main()\n{\n"), STR_LEN("\nvoid main()\n{\n"));
    let li2: i32 = 0;
    while li2 < c.m_va_len {
        let v = c.fields[c.m_va_off + li2];
        if is_local_to(c, stage, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, dialect, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        li2 = li2 + 1;
    }
    if stage == 1 {
        print_stmts(c, c.v_woven_off, c.v_woven_len, dialect, stage, 1, out);
        print_stmts(c, c.lk_vert_off, c.lk_vert_len, dialect, stage, 1, out);
    } else {
        print_stmts(c, c.f_woven_off, c.f_woven_len, dialect, stage, 1, out);
        print_stmts(c, c.lk_frag_off, c.lk_frag_len, dialect, stage, 1, out);
    };
    buf_push_lit(out, STR_PTR("}\n"), STR_LEN("}\n"));
}

fn input_semantic(c: &Ctx, off: i32, len: i32, counter: &i32, out: &Buf) {
    if span_eq_lit(c, off, len, STR_PTR("position"), STR_LEN("position")) {
        buf_push_lit(out, STR_PTR("POSITION"), STR_LEN("POSITION"));
        return;
    };
    if span_eq_lit(c, off, len, STR_PTR("normal"), STR_LEN("normal")) {
        buf_push_lit(out, STR_PTR("NORMAL"), STR_LEN("NORMAL"));
        return;
    };
    if span_eq_lit(c, off, len, STR_PTR("tangent"), STR_LEN("tangent")) {
        buf_push_lit(out, STR_PTR("TANGENT"), STR_LEN("TANGENT"));
        return;
    };
    if span_eq_lit(c, off, len, STR_PTR("color"), STR_LEN("color")) {
        buf_push_lit(out, STR_PTR("COLOR0"), STR_LEN("COLOR0"));
        return;
    };
    buf_push_lit(out, STR_PTR("TEXCOORD"), STR_LEN("TEXCOORD"));
    let cv: i32 = *counter;
    buf_push_i64(out, cv);
    *counter = cv + 1;
}

fn emit_hlsl(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("// SLASL merged output (HLSL)\n"), STR_LEN("// SLASL merged output (HLSL)\n"));
    let reg: i32 = 0;
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("\ncbuffer "), STR_LEN("\ncbuffer "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(" : register(b"), STR_LEN(" : register(b"));
            buf_push_i64(out, reg);
            buf_push_lit(out, STR_PTR(")\n{\n"), STR_LEN(")\n{\n"));
            reg = reg + 1;
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                    out_ty(c, out, 2, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("};\n"), STR_LEN("};\n"));
        };
        gi = gi + 1;
    }
    let lp = live_params(c);
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("\ncbuffer Params : register(b"), STR_LEN("\ncbuffer Params : register(b"));
        buf_push_i64(out, reg);
        buf_push_lit(out, STR_PTR(")\n{\n"), STR_LEN(")\n{\n"));
        reg = reg + 1;
        let li: i32 = 0;
        while li < lp.len() {
            let f = c.fields[lp[li]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 2, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("};\n"), STR_LEN("};\n"));
    };
    let ls = live_samplers(c);
    if ls.len() > 0 {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        buf_push_lit(out, STR_PTR("Texture2D "), STR_LEN("Texture2D "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(" : register(t"), STR_LEN(" : register(t"));
        buf_push_i64(out, sai);
        buf_push_lit(out, STR_PTR(");\n"), STR_LEN(");\n"));
        buf_push_lit(out, STR_PTR("SamplerState "), STR_LEN("SamplerState "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("_sampler : register(s"), STR_LEN("_sampler : register(s"));
        buf_push_i64(out, sai);
        buf_push_lit(out, STR_PTR(");\n"), STR_LEN(");\n"));
        sai = sai + 1;
    }
    buf_push_lit(out, STR_PTR("\nstruct VSIn\n{\n"), STR_LEN("\nstruct VSIn\n{\n"));
    let counter: i32 = 0;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 2, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(" : "), STR_LEN(" : "));
            input_semantic(c, f.name_off, f.name_len, &counter, out);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("};\n"), STR_LEN("};\n"));
    buf_push_lit(out, STR_PTR("\nstruct VSOut\n{\n    float4 position : SV_Position;\n"), STR_LEN("\nstruct VSOut\n{\n    float4 position : SV_Position;\n"));
    let vcounter: i32 = 0;
    let vi: i32 = 0;
    while vi < c.m_va_len {
        let v = c.fields[c.m_va_off + vi];
        if is_varying(c, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 2, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(" : TEXCOORD"), STR_LEN(" : TEXCOORD"));
            buf_push_i64(out, vcounter);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            vcounter = vcounter + 1;
        };
        vi = vi + 1;
    }
    buf_push_lit(out, STR_PTR("};\n"), STR_LEN("};\n"));
    buf_push_lit(out, STR_PTR("\nVSOut VSMain(VSIn input)\n{\n    VSOut output;\n"), STR_LEN("\nVSOut VSMain(VSIn input)\n{\n    VSOut output;\n"));
    let li2: i32 = 0;
    while li2 < c.m_va_len {
        let v = c.fields[c.m_va_off + li2];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 2, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        li2 = li2 + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 2, 1, 1, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 2, 1, 1, out);
    buf_push_lit(out, STR_PTR("    return output;\n}\n"), STR_LEN("    return output;\n}\n"));
    buf_push_lit(out, STR_PTR("\nfloat4 PSMain(VSOut input) : SV_Target\n{\n"), STR_LEN("\nfloat4 PSMain(VSOut input) : SV_Target\n{\n"));
    li2 = 0;
    while li2 < c.m_va_len {
        let v = c.fields[c.m_va_off + li2];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 2, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        li2 = li2 + 1;
    }
    buf_push_lit(out, STR_PTR("    float4 frag_color;\n"), STR_LEN("    float4 frag_color;\n"));
    print_stmts(c, c.f_woven_off, c.f_woven_len, 2, 2, 1, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 2, 2, 1, out);
    buf_push_lit(out, STR_PTR("    return frag_color;\n}\n"), STR_LEN("    return frag_color;\n}\n"));
}

// ---- layout dumps ----

fn align_fwd(v: i32, a: i32) -> i32 {
    return (v + a - 1) / a * a;
}

fn layout_total(c: &Ctx, fields: &Vec<i32>) -> i32 {
    let cursor: i32 = 0;
    let i: i32 = 0;
    while i < fields.len() {
        let f = c.fields[fields[i]];
        cursor = align_fwd(cursor, ty_align(f.ty));
        cursor = cursor + ty_size(f.ty);
        i = i + 1;
    }
    return align_fwd(cursor, 16);
}

fn dump_block(c: &Ctx, out: &Buf, name_off: i32, name_len: i32, fields: &Vec<i32>) {
    buf_push_lit(out, STR_PTR("block "), STR_LEN("block "));
    out_span(c, out, name_off, name_len);
    buf_push_lit(out, STR_PTR(" (size "), STR_LEN(" (size "));
    buf_push_i64(out, layout_total(c, fields));
    buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
    let cursor: i32 = 0;
    let i: i32 = 0;
    while i < fields.len() {
        let f = c.fields[fields[i]];
        cursor = align_fwd(cursor, ty_align(f.ty));
        buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
        ty_name_into(out, f.ty);
        buf_push_lit(out, STR_PTR(", offset "), STR_LEN(", offset "));
        buf_push_i64(out, cursor);
        buf_push_lit(out, STR_PTR(", size "), STR_LEN(", size "));
        buf_push_i64(out, ty_size(f.ty));
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        cursor = cursor + ty_size(f.ty);
        i = i + 1;
    }
}

fn dump_layout(c: &Ctx, after: bool, out: &Buf) {
    buf_push_lit(out, STR_PTR("== globals ==\n"), STR_LEN("== globals ==\n"));
    let any_g: bool = false;
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let fl: Vec<i32> = Vec::new();
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            let keep: bool = true;
            if after {
                keep = is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len);
            };
            if keep {
                fl.push(g.fields_off + fi);
            };
            fi = fi + 1;
        }
        if fl.len() > 0 {
            any_g = true;
            dump_block(c, out, g.name_off, g.name_len, &fl);
        };
        gi = gi + 1;
    }
    if !any_g {
        buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
    };
    buf_push_lit(out, STR_PTR("== params ==\n"), STR_LEN("== params ==\n"));
    let pf: Vec<i32> = Vec::new();
    let pi: i32 = 0;
    while pi < c.m_pa_len {
        let f = c.fields[c.m_pa_off + pi];
        if f.ty != 9 {
            let keep: bool = true;
            if after {
                keep = is_live_key(c, false, f.name_off, f.name_len, 0, 0);
            };
            if keep {
                pf.push(c.m_pa_off + pi);
            };
        };
        pi = pi + 1;
    }
    if pf.len() == 0 {
        buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
    } else {
        // header uses the Params block name (literal, not arena span)
        buf_push_lit(out, STR_PTR("block Params (size "), STR_LEN("block Params (size "));
        buf_push_i64(out, layout_total(c, &pf));
        buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
        let cursor: i32 = 0;
        let i: i32 = 0;
        while i < pf.len() {
            let f = c.fields[pf[i]];
            cursor = align_fwd(cursor, ty_align(f.ty));
            buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_name_into(out, f.ty);
            buf_push_lit(out, STR_PTR(", offset "), STR_LEN(", offset "));
            buf_push_i64(out, cursor);
            buf_push_lit(out, STR_PTR(", size "), STR_LEN(", size "));
            buf_push_i64(out, ty_size(f.ty));
            buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
            cursor = cursor + ty_size(f.ty);
            i = i + 1;
        }
    };
    buf_push_lit(out, STR_PTR("== textures ==\n"), STR_LEN("== textures ==\n"));
    let slot: i32 = 0;
    let any_t: bool = false;
    let ti: i32 = 0;
    while ti < c.m_pa_len {
        let f = c.fields[c.m_pa_off + ti];
        if f.ty == 9 {
            let keep: bool = true;
            if after {
                keep = is_live_key(c, false, f.name_off, f.name_len, 0, 0);
            };
            if keep {
                buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(": sampler2D, slot "), STR_LEN(": sampler2D, slot "));
                buf_push_i64(out, slot);
                buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
                slot = slot + 1;
                any_t = true;
            };
        };
        ti = ti + 1;
    }
    if !any_t {
        buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
    };
    buf_push_lit(out, STR_PTR("== inputs ==\n"), STR_LEN("== inputs ==\n"));
    let any_i: bool = false;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        let keep: bool = true;
        if after {
            keep = is_live_key(c, false, f.name_off, f.name_len, 0, 0);
        };
        if keep {
            buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_name_into(out, f.ty);
            buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
            any_i = true;
        };
        ii = ii + 1;
    }
    if !any_i {
        buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
    };
    buf_push_lit(out, STR_PTR("== vars ==\n"), STR_LEN("== vars ==\n"));
    let any_v: bool = false;
    let vi: i32 = 0;
    while vi < c.m_va_len {
        let v = c.fields[c.m_va_off + vi];
        let keep: bool = true;
        if after {
            keep = is_live_key(c, false, v.name_off, v.name_len, 0, 0);
        };
        if keep {
            any_v = true;
            buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_name_into(out, v.ty);
            if after {
                if is_varying(c, v.name_off, v.name_len) {
                    buf_push_lit(out, STR_PTR(" (varying)"), STR_LEN(" (varying)"));
                } else {
                    if is_local_to(c, 2, v.name_off, v.name_len) {
                        buf_push_lit(out, STR_PTR(" (fragment local)"), STR_LEN(" (fragment local)"));
                    } else {
                        if is_local_to(c, 1, v.name_off, v.name_len) {
                            buf_push_lit(out, STR_PTR(" (vertex local)"), STR_LEN(" (vertex local)"));
                        };
                    };
                };
            };
            buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        };
        vi = vi + 1;
    }
    if !any_v {
        buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
    };
    if after {
        buf_push_lit(out, STR_PTR("== eliminated ==\n"), STR_LEN("== eliminated ==\n"));
        let any_e: bool = false;
        let ei: i32 = 0;
        while ei < c.m_pa_len {
            let f = c.fields[c.m_pa_off + ei];
            if f.ty != 9 {
                if !is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                    buf_push_lit(out, STR_PTR("  param "), STR_LEN("  param "));
                    out_span(c, out, f.name_off, f.name_len);
                    buf_push_lit(out, STR_PTR(": no live read\n"), STR_LEN(": no live read\n"));
                    any_e = true;
                };
            };
            ei = ei + 1;
        }
        let gi2: i32 = 0;
        while gi2 < c.m_gr_len {
            let g = c.groups[c.m_gr_off + gi2];
            let fi: i32 = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if !is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("  global "), STR_LEN("  global "));
                    out_span(c, out, g.name_off, g.name_len);
                    buf_push_byte(out, 46);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(": no live read\n"), STR_LEN(": no live read\n"));
                    any_e = true;
                };
                fi = fi + 1;
            }
            gi2 = gi2 + 1;
        }
        let ii2: i32 = 0;
        while ii2 < c.m_in_len {
            let f = c.fields[c.m_in_off + ii2];
            if !is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("  input "), STR_LEN("  input "));
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(": no live read\n"), STR_LEN(": no live read\n"));
                any_e = true;
            };
            ii2 = ii2 + 1;
        }
        let vi2: i32 = 0;
        while vi2 < c.m_va_len {
            let v = c.fields[c.m_va_off + vi2];
            if !is_live_key(c, false, v.name_off, v.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("  var "), STR_LEN("  var "));
                out_span(c, out, v.name_off, v.name_len);
                buf_push_lit(out, STR_PTR(": no live read\n"), STR_LEN(": no live read\n"));
                any_e = true;
            };
            vi2 = vi2 + 1;
        }
        if !any_e {
            buf_push_lit(out, STR_PTR("  (none)\n"), STR_LEN("  (none)\n"));
        };
    };
}

fn dump_variants(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("== variants (link-time @const values) ==\n"), STR_LEN("== variants (link-time @const values) ==\n"));
    let i: i32 = 0;
    while i < c.m_co_len {
        let cd = c.consts[c.m_co_off + i];
        let vx = c.exprs[cd.value];
        out_span(c, out, cd.name_off, cd.name_len);
        buf_push_lit(out, STR_PTR(" = "), STR_LEN(" = "));
        if vx.kind == 1 {
            if vx.bval {
                buf_push_lit(out, STR_PTR("true"), STR_LEN("true"));
            } else {
                buf_push_lit(out, STR_PTR("false"), STR_LEN("false"));
            };
        } else {
            if vx.kind == 0 {
                out_span(c, out, vx.name_off, vx.name_len);
            } else {
                buf_push_byte(out, 63);
            };
        };
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        i = i + 1;
    }
}

// ------------------------------------------------------------------
// main: argument handling, file IO, target dispatch.
// Modes:
//   slasl <outdir> <file.slasl> [more...]            P0 bundle (8)
//   slasl --target <id> <outdir> <file.slasl> [...]  one target
//   slasl --check <file.slasl> [...]                 check+link only
// ------------------------------------------------------------------

fn cell_u64(p: ptr) -> u64 {
    let v: u64 = 0;
    let mul: u64 = 1;
    let i: u64 = 0;
    while i < 8 {
        let b: u8 = PTR_BYTE_AT(p, i);
        v = v + (b as u64) * mul;
        mul = mul * 256;
        i = i + 1;
    }
    return v;
}

fn eprint(b: &Buf) {
    let n = sa_io_write_all(sa_io_stderr(), b.data as ptr, b.len);
}

fn eprint_span(p: ptr, n: u64) {
    let b = buf_new();
    buf_push_span(&b, p, n);
    eprint(&b);
}

fn arg_eq(abuf: &Buf, off: i32, len: i32, lp: ptr, ll: u64) -> bool {
    if (len as u64) != ll {
        return false;
    };
    let bp: ptr = abuf.data as ptr;
    let i: u64 = 0;
    while i < ll {
        if PTR_BYTE_AT(bp, (off as u64) + i) != PTR_BYTE_AT(lp, i) {
            return false;
        };
        i = i + 1;
    }
    return true;
}

// parse sa_env_args_json bytes into spans in abuf
fn parse_argv(jh: u64, abuf: &Buf, offs: &Vec<i32>, lens: &Vec<i32>) -> bool {
    let jp: ptr = sa_env_buffer_data(jh);
    let jlen = sa_env_buffer_len(jh);
    let i: u64 = 0;
    // skip ws and '['
    let scanning: bool = true;
    while scanning && i < jlen {
        let ch = PTR_BYTE_AT(jp, i);
        if ch == 91 {
            scanning = false;
            i = i + 1;
        } else {
            if ch == 32 || ch == 10 || ch == 9 || ch == 13 {
                i = i + 1;
            } else {
                return false;
            };
        };
    }
    let more: bool = true;
    while more {
        // skip ws
        while i < jlen {
            let ch = PTR_BYTE_AT(jp, i);
            if ch == 32 || ch == 10 || ch == 9 || ch == 13 {
                i = i + 1;
            } else {
                break;
            };
        }
        if i >= jlen {
            return false;
        };
        let ch = PTR_BYTE_AT(jp, i);
        if ch == 93 {
            more = false;
        } else {
            if ch != 34 {
                return false;
            };
            i = i + 1;
            let start = abuf.len;
            let instr: bool = true;
            while instr && i < jlen {
                let c2 = PTR_BYTE_AT(jp, i);
                if c2 == 34 {
                    instr = false;
                    i = i + 1;
                } else {
                    if c2 == 92 && i + 1 < jlen {
                        let esc = PTR_BYTE_AT(jp, i + 1);
                        i = i + 2;
                        if esc == 110 { buf_push_byte(abuf, 10); };
                        if esc == 116 { buf_push_byte(abuf, 9); };
                        if esc == 114 { buf_push_byte(abuf, 13); };
                        if esc == 34 { buf_push_byte(abuf, 34); };
                        if esc == 92 { buf_push_byte(abuf, 92); };
                        if esc == 47 { buf_push_byte(abuf, 47); };
                        if esc == 98 { buf_push_byte(abuf, 8); };
                        if esc == 102 { buf_push_byte(abuf, 12); };
                        if esc == 117 {
                            // \uXXXX: not decoded (paths do not need it)
                            i = i + 4;
                            buf_push_byte(abuf, 63);
                        };
                    } else {
                        buf_push_byte(abuf, c2);
                        i = i + 1;
                    };
                };
            }
            offs.push(start as i32);
            lens.push((abuf.len - start) as i32);
            // skip ws, optional comma
            while i < jlen {
                let c3 = PTR_BYTE_AT(jp, i);
                if c3 == 32 || c3 == 10 || c3 == 9 || c3 == 13 {
                    i = i + 1;
                } else {
                    break;
                };
            }
            if i < jlen && PTR_BYTE_AT(jp, i) == 44 {
                i = i + 1;
            };
        };
    }
    return true;
}

fn read_whole_file(pp: ptr, plen: u64, out: &Buf) -> bool {
    let lcell = malloc(8);
    let rc = sa_std_fs_len(pp, plen, lcell as ptr);
    if rc != 0 {
        return false;
    };
    let flen = cell_u64(lcell as ptr);
    let hcell = malloc(8);
    let rc2 = sa_std_fs_open_read(pp, plen, hcell as ptr);
    if rc2 != 0 {
        return false;
    };
    let handle = cell_u64(hcell as ptr);
    let fbuf = malloc(flen + 1);
    let off: u64 = 0;
    while off < flen {
        let rcell = malloc(8);
        let nread: u64 = 0;
        let rc3 = sa_std_fs_file_read(handle, (fbuf.add(off as usize)) as ptr, flen - off, rcell as ptr);
        if rc3 != 0 {
            sa_fs_file_close(handle);
            return false;
        };
        nread = cell_u64(rcell as ptr);
        if nread == 0 {
            sa_fs_file_close(handle);
            return false;
        };
        off = off + nread;
    }
    sa_fs_file_close(handle);
    buf_push_span(out, fbuf as ptr, flen);
    free(fbuf);
    return true;
}

fn write_product(c: &Ctx, dir: &Buf, np: ptr, nl: u64, content: &Buf, count: &i32) -> bool {
    let path = buf_new();
    buf_push_span(&path, dir.data as ptr, dir.len);
    buf_push_byte(&path, 47);
    buf_push_span(&path, np, nl);
    let rc = sa_fs_write_file(path.data as ptr, path.len, content.data as ptr, content.len);
    if rc != 0 {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: cannot write "), STR_LEN("slasl: cannot write "));
        buf_push_span(&msg, path.data as ptr, path.len);
        buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
        eprint(&msg);
        return false;
    };
    let cv: i32 = *count;
    *count = cv + 1;
    return true;
}

fn emit_file(c: &Ctx, dir: &Buf, np: ptr, nl: u64, content: &Buf, count: &i32) -> bool {
    return write_product(c, dir, np, nl, content, count);
}

fn run_target(c: &Ctx, tid: i32, dir: &Buf, count: &i32) -> bool {
    if tid == 0 || tid == 1 {
        let b = buf_new();
        emit_glsl(c, 0, 1, &b);
        if !emit_file(c, dir, STR_PTR("merged.glsl-es300.vert"), STR_LEN("merged.glsl-es300.vert"), &b, count) { return false; };
        let b2 = buf_new();
        emit_glsl(c, 0, 2, &b2);
        if !emit_file(c, dir, STR_PTR("merged.glsl-es300.frag"), STR_LEN("merged.glsl-es300.frag"), &b2, count) { return false; };
        if tid == 1 {
            return true;
        };
    };
    if tid == 0 || tid == 2 {
        let b = buf_new();
        emit_glsl(c, 1, 1, &b);
        if !emit_file(c, dir, STR_PTR("merged.glsl-es100.vert"), STR_LEN("merged.glsl-es100.vert"), &b, count) { return false; };
        let b2 = buf_new();
        emit_glsl(c, 1, 2, &b2);
        if !emit_file(c, dir, STR_PTR("merged.glsl-es100.frag"), STR_LEN("merged.glsl-es100.frag"), &b2, count) { return false; };
        if tid == 2 {
            return true;
        };
    };
    if tid == 0 || tid == 3 {
        let b = buf_new();
        emit_hlsl(c, &b);
        if !emit_file(c, dir, STR_PTR("merged.hlsl"), STR_LEN("merged.hlsl"), &b, count) { return false; };
        if tid == 3 {
            return true;
        };
    };
    if tid == 0 {
        let b = buf_new();
        dump_layout(c, false, &b);
        if !emit_file(c, dir, STR_PTR("layout_before.txt"), STR_LEN("layout_before.txt"), &b, count) { return false; };
        let b2 = buf_new();
        dump_layout(c, true, &b2);
        if !emit_file(c, dir, STR_PTR("layout_after.txt"), STR_LEN("layout_after.txt"), &b2, count) { return false; };
        let b3 = buf_new();
        dump_variants(c, &b3);
        if !emit_file(c, dir, STR_PTR("variants.txt"), STR_LEN("variants.txt"), &b3, count) { return false; };
        return true;
    };
    if tid == 4 {
        return run_target_wgsl(c, dir, count);
    };
    if tid == 5 {
        return run_target_msl(c, dir, count);
    };
    if tid == 6 {
        return run_target_unity(c, dir, count);
    };
    if tid == 7 {
        return run_target_blender(c, dir, count);
    };
    if tid == 8 {
        return run_target_unreal(c, dir, count);
    };
    return false;
}

fn target_id_of(abuf: &Buf, off: i32, len: i32) -> i32 {
    if arg_eq(abuf, off, len, STR_PTR("glsl-es300"), STR_LEN("glsl-es300")) { return 1; };
    if arg_eq(abuf, off, len, STR_PTR("glsl-es100"), STR_LEN("glsl-es100")) { return 2; };
    if arg_eq(abuf, off, len, STR_PTR("hlsl"), STR_LEN("hlsl")) { return 3; };
    if arg_eq(abuf, off, len, STR_PTR("hlsl-sm5"), STR_LEN("hlsl-sm5")) { return 3; };
    if arg_eq(abuf, off, len, STR_PTR("webgpu"), STR_LEN("webgpu")) { return 4; };
    if arg_eq(abuf, off, len, STR_PTR("wgsl"), STR_LEN("wgsl")) { return 4; };
    if arg_eq(abuf, off, len, STR_PTR("msl"), STR_LEN("msl")) { return 5; };
    if arg_eq(abuf, off, len, STR_PTR("unity"), STR_LEN("unity")) { return 6; };
    if arg_eq(abuf, off, len, STR_PTR("blender"), STR_LEN("blender")) { return 7; };
    if arg_eq(abuf, off, len, STR_PTR("unreal-global"), STR_LEN("unreal-global")) { return 8; };
    return -1;
}

fn main() -> i32 {
    let jh = sa_env_args_json();
    let abuf = buf_new();
    let aoffs: Vec<i32> = Vec::new();
    let alens: Vec<i32> = Vec::new();
    if !parse_argv(jh, &abuf, &aoffs, &alens) {
        eprint_span(STR_PTR("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"), STR_LEN("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"));
        return 2;
    };
    let argc = aoffs.len();
    if argc < 2 {
        eprint_span(STR_PTR("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"), STR_LEN("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"));
        return 2;
    };
    let mode: i32 = 0; // 0 bundle, 1 target, 2 check
    let tid: i32 = 0;
    let dir = buf_new();
    let first_file: i32 = 2;
    if arg_eq(&abuf, aoffs[1], alens[1], STR_PTR("--target"), STR_LEN("--target")) {
        if argc < 5 {
            eprint_span(STR_PTR("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"), STR_LEN("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"));
            return 2;
        };
        mode = 1;
        tid = target_id_of(&abuf, aoffs[2], alens[2]);
        if tid < 0 {
            let msg = buf_new();
            buf_push_lit(&msg, STR_PTR("slasl: unknown target '"), STR_LEN("slasl: unknown target '"));
            buf_push_span(&msg, (abuf.data.add(aoffs[2] as usize)) as ptr, alens[2] as u64);
            buf_push_lit(&msg, STR_PTR("'\n"), STR_LEN("'\n"));
            eprint(&msg);
            return 2;
        };
        buf_push_span(&dir, (abuf.data.add(aoffs[3] as usize)) as ptr, alens[3] as u64);
        first_file = 4;
    } else {
        if arg_eq(&abuf, aoffs[1], alens[1], STR_PTR("--check"), STR_LEN("--check")) {
            if argc < 3 {
                eprint_span(STR_PTR("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"), STR_LEN("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"));
                return 2;
            };
            mode = 2;
            first_file = 2;
        } else {
            if argc < 3 {
                eprint_span(STR_PTR("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"), STR_LEN("usage: slasl <outdir> <file.slasl> [more.slasl...]\n"));
                return 2;
            };
            buf_push_span(&dir, (abuf.data.add(aoffs[1] as usize)) as ptr, alens[1] as u64);
            first_file = 2;
        };
    };
    let ctx = ctx_new();
    ctx.spc_off = 0;
    buf_push_lit(&ctx.text, STR_PTR("clip_position"), STR_LEN("clip_position"));
    ctx.spc_len = 13;
    ctx.spf_off = 13;
    buf_push_lit(&ctx.text, STR_PTR("frag_color"), STR_LEN("frag_color"));
    ctx.spf_len = 10;
    let base_text = ctx.text.len;
    let pk: i32 = 0;
    let dtok = Tok { kind: 0, off: 0, len: 0 };
    while pk < 65536 {
        ctx.toks.push(dtok);
        pk = pk + 1;
    }
    pk = 0;
    let dexpr = Expr { kind: 0, a: 0, b: 0, op: 0, ty: 0, name_off: 0, name_len: 0, bval: false, args_off: 0, args_len: 0 };
    while pk < 65536 {
        ctx.exprs.push(dexpr);
        pk = pk + 1;
    }
    pk = 0;
    let dstmt = Stmt { kind: 0, target: 0, value: 0, cond: 0, body_off: 0, body_len: 0 };
    while pk < 32768 {
        ctx.stmts.push(dstmt);
        pk = pk + 1;
    }
    pk = 0;
    let dfield = Field { name_off: 0, name_len: 0, ty: 0 };
    while pk < 16384 {
        ctx.fields.push(dfield);
        pk = pk + 1;
    }
    pk = 0;
    let dgroup = Group { name_off: 0, name_len: 0, fields_off: 0, fields_len: 0 };
    while pk < 4096 {
        ctx.groups.push(dgroup);
        pk = pk + 1;
    }
    pk = 0;
    let dconst = ConstDecl { name_off: 0, name_len: 0, ty: 0, value: 0 };
    while pk < 16384 {
        ctx.consts.push(dconst);
        pk = pk + 1;
    }
    pk = 0;
    let dshader = Shader { name_off: 0, name_len: 0, priority: 0, gs_off: 0, gs_len: 0, gr_off: 0, gr_len: 0, in_off: 0, in_len: 0, pa_off: 0, pa_len: 0, co_off: 0, co_len: 0, va_off: 0, va_len: 0, init_off: 0, init_len: 0, vert_off: 0, vert_len: 0, frag_off: 0, frag_len: 0 };
    while pk < 512 {
        ctx.shaders.push(dshader);
        pk = pk + 1;
    }
    pk = 0;
    let dent = LiveEnt { g: false, o1: 0, l1: 0, o2: 0, l2: 0, mask: 0 };
    while pk < 32768 {
        ctx.live.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 8192 {
        ctx.scratch.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 8192 {
        ctx.scratch2.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.acc.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.v_reads.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.f_reads.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.v_writes.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.f_writes.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.i_writes.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.v_woven_reads.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.f_woven_reads.push(dent);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 32768 {
        ctx.needed.push(false);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 20480 {
        ctx.stage.push(dfield);
        pk = pk + 1;
    }
    pk = 0;
    let dsym = Sym { name_off: 0, name_len: 0, ty: 0, kind: 0 };
    while pk < 8192 {
        ctx.env.push(dsym);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 262144 {
        ctx.pool.push(0);
        pk = pk + 1;
    }
    pk = 0;
    while pk < 262144 {
        ctx.ipool.push(0);
        pk = pk + 1;
    }
    let fi: i32 = first_file;
    while fi < argc {
        let poff = aoffs[fi];
        let plen = alens[fi];
        let pp = (abuf.data.add(poff as usize)) as ptr;
        let src_off = ctx.text.len;
        if !read_whole_file(pp, plen as u64, &ctx.text) {
            let msg = buf_new();
            buf_push_lit(&msg, STR_PTR("slasl: cannot read "), STR_LEN("slasl: cannot read "));
            buf_push_span(&msg, pp, plen as u64);
            buf_push_lit(&msg, STR_PTR(": FileNotFound\n"), STR_LEN(": FileNotFound\n"));
            eprint(&msg);
            return 1;
        };
        let src_len = (ctx.text.len - src_off) as i32;
        let toks_start = ctx.n_toks;
        lex_all(&ctx, src_off as i32, src_len);
        let pr = P { pos: toks_start };
        let before = ctx.n_shaders;
        if !parse_file(&ctx, &pr) {
            let msg = buf_new();
            buf_push_lit(&msg, STR_PTR("slasl: parse error in "), STR_LEN("slasl: parse error in "));
            buf_push_span(&msg, pp, plen as u64);
            buf_push_lit(&msg, STR_PTR(": "), STR_LEN(": "));
            buf_push_span(&msg, ctx.err.data as ptr, ctx.err.len);
            buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
            eprint(&msg);
            return 1;
        };
        let si = before;
        while si < ctx.n_shaders {
            if !chk_shader(&ctx, si) {
                let msg = buf_new();
                buf_push_lit(&msg, STR_PTR("slasl: check error in "), STR_LEN("slasl: check error in "));
                buf_push_span(&msg, pp, plen as u64);
                buf_push_lit(&msg, STR_PTR(" (shader "), STR_LEN(" (shader "));
                let sname = ctx.shaders[si];
                out_span(&ctx, &msg, sname.name_off, sname.name_len);
                buf_push_lit(&msg, STR_PTR("): "), STR_LEN("): "));
                buf_push_span(&msg, ctx.err.data as ptr, ctx.err.len);
                buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
                eprint(&msg);
                return 1;
            };
            si = si + 1;
        }
        fi = fi + 1;
    }
    if !link(&ctx) {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: link error: "), STR_LEN("slasl: link error: "));
        buf_push_span(&msg, ctx.err.data as ptr, ctx.err.len);
        buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
        eprint(&msg);
        return 1;
    };
    if !em_init(&ctx) {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: link error: "), STR_LEN("slasl: link error: "));
        buf_push_span(&msg, ctx.err.data as ptr, ctx.err.len);
        buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
        eprint(&msg);
        return 1;
    };
    // --check runs the full link analysis (merge, contracts, DCE and
    // the init weave) so every named link diagnostic is reachable from
    // the standalone check path; it just writes no products.
    if mode == 2 {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: check ok ("), STR_LEN("slasl: check ok ("));
        buf_push_i64(&msg, ctx.n_shaders);
        buf_push_lit(&msg, STR_PTR(" fragment(s))\n"), STR_LEN(" fragment(s))\n"));
        eprint(&msg);
        return 0;
    };
    let drc = sa_fs_mkdir_p(dir.data as ptr, dir.len);
    if drc != 0 {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: cannot create outdir "), STR_LEN("slasl: cannot create outdir "));
        buf_push_span(&msg, dir.data as ptr, dir.len);
        buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
        eprint(&msg);
        return 1;
    };
    let count: i32 = 0;
    if !run_target(&ctx, tid, &dir, &count) {
        return 1;
    };
    let msg = buf_new();
    buf_push_lit(&msg, STR_PTR("slasl: merged "), STR_LEN("slasl: merged "));
    buf_push_i64(&msg, ctx.n_shaders);
    buf_push_lit(&msg, STR_PTR(" fragment(s), wrote "), STR_LEN(" fragment(s), wrote "));
    buf_push_i64(&msg, count);
    buf_push_lit(&msg, STR_PTR(" files to "), STR_LEN(" files to "));
    buf_push_span(&msg, dir.data as ptr, dir.len);
    buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
    eprint(&msg);
    return 0;
}

// ------------------------------------------------------------------
// webgpu target (DESIGN section 9.4): WGSL dialect + thin convention.
// group 0 = frame globals (merged groups, then global singles struct),
// group 1 = material (Params struct, then texture/sampler split pairs).
// The reflection manifest is a mandatory co-product, generated from
// the same merged interface table.
// ------------------------------------------------------------------

fn stage_reads_has(c: &Ctx, stage: i32, g: bool, o1: i32, l1: i32, o2: i32, l2: i32) -> bool {
    let tp = c.text.data as ptr;
    if stage == 1 {
        if map_mask(tp, &c.v_reads, c.n_vreads, g, o1, l1, o2, l2) != 0 { return true; };
        return map_mask(tp, &c.v_woven_reads, c.n_vwoven, g, o1, l1, o2, l2) != 0;
    };
    if map_mask(tp, &c.f_reads, c.n_freads, g, o1, l1, o2, l2) != 0 { return true; };
    return map_mask(tp, &c.f_woven_reads, c.n_fwoven, g, o1, l1, o2, l2) != 0;
}

fn wgsl_bool_field(c: &Ctx) -> bool {
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if gf.ty == 3 && is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                err_lit(c, STR_PTR("UnsupportedInBackend: bool uniform field '"), STR_LEN("UnsupportedInBackend: bool uniform field '"));
                err_span(c, gf.name_off, gf.name_len);
                err_lit(c, STR_PTR("' in webgpu target"), STR_LEN("' in webgpu target"));
                c.failed = true;
                return true;
            };
            fi = fi + 1;
        }
        gi = gi + 1;
    }
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if f.ty == 3 && is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            err_lit(c, STR_PTR("UnsupportedInBackend: bool uniform field '"), STR_LEN("UnsupportedInBackend: bool uniform field '"));
            err_span(c, f.name_off, f.name_len);
            err_lit(c, STR_PTR("' in webgpu target"), STR_LEN("' in webgpu target"));
            c.failed = true;
            return true;
        };
        si = si + 1;
    }
    let pi2: i32 = 0;
    while pi2 < c.m_pa_len {
        let f = c.fields[c.m_pa_off + pi2];
        if f.ty == 3 && f.ty != 9 && is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            err_lit(c, STR_PTR("UnsupportedInBackend: bool uniform field '"), STR_LEN("UnsupportedInBackend: bool uniform field '"));
            err_span(c, f.name_off, f.name_len);
            err_lit(c, STR_PTR("' in webgpu target"), STR_LEN("' in webgpu target"));
            c.failed = true;
            return true;
        };
        pi2 = pi2 + 1;
    }
    return false;
}

fn emit_wgsl(c: &Ctx, out: &Buf) {
    let b0: i32 = 0;
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("struct "), STR_LEN("struct "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("Block {\n"), STR_LEN("Block {\n"));
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
                    ty_wgsl_into(out, gf.ty);
                    buf_push_lit(out, STR_PTR(",\n"), STR_LEN(",\n"));
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("}\n@group(0) @binding("), STR_LEN("}\n@group(0) @binding("));
            buf_push_i64(out, b0);
            buf_push_lit(out, STR_PTR(") var<uniform> "), STR_LEN(") var<uniform> "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("Block;\n\n"), STR_LEN("Block;\n\n"));
            b0 = b0 + 1;
        };
        gi = gi + 1;
    }
    let gs_any: bool = false;
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            gs_any = true;
        };
        si = si + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR("struct Globals {\n"), STR_LEN("struct Globals {\n"));
        si = 0;
        while si < c.m_gs_len {
            let f = c.fields[c.m_gs_off + si];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
                ty_wgsl_into(out, f.ty);
                buf_push_lit(out, STR_PTR(",\n"), STR_LEN(",\n"));
            };
            si = si + 1;
        }
        buf_push_lit(out, STR_PTR("}\n@group(0) @binding("), STR_LEN("}\n@group(0) @binding("));
        buf_push_i64(out, b0);
        buf_push_lit(out, STR_PTR(") var<uniform> globals: Globals;\n\n"), STR_LEN(") var<uniform> globals: Globals;\n\n"));
        b0 = b0 + 1;
    };
    let lp = live_params(c);
    let b1: i32 = 0;
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("struct Params {\n"), STR_LEN("struct Params {\n"));
        let li: i32 = 0;
        while li < lp.len() {
            let f = c.fields[lp[li]];
            buf_push_lit(out, STR_PTR("  "), STR_LEN("  "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_wgsl_into(out, f.ty);
            buf_push_lit(out, STR_PTR(",\n"), STR_LEN(",\n"));
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("}\n@group(1) @binding(0) var<uniform> params: Params;\n\n"), STR_LEN("}\n@group(1) @binding(0) var<uniform> params: Params;\n\n"));
        b1 = 1;
    };
    let ls = live_samplers(c);
    let li2: i32 = 0;
    while li2 < ls.len() {
        let f = c.fields[ls[li2]];
        buf_push_lit(out, STR_PTR("@group(1) @binding("), STR_LEN("@group(1) @binding("));
        buf_push_i64(out, b1);
        buf_push_lit(out, STR_PTR(") var "), STR_LEN(") var "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(": texture_2d<f32>;\n@group(1) @binding("), STR_LEN(": texture_2d<f32>;\n@group(1) @binding("));
        buf_push_i64(out, b1 + 1);
        buf_push_lit(out, STR_PTR(") var "), STR_LEN(") var "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("_sampler: sampler;\n\n"), STR_LEN("_sampler: sampler;\n\n"));
        b1 = b1 + 2;
        li2 = li2 + 1;
    }
    let ci: i32 = 0;
    let oid: i32 = 0;
    while ci < c.m_co_len {
        let cd = c.consts[c.m_co_off + ci];
        if cd.ty <= 3 {
            buf_push_lit(out, STR_PTR("@id("), STR_LEN("@id("));
            buf_push_i64(out, oid);
            buf_push_lit(out, STR_PTR(") override "), STR_LEN(") override "));
            out_span(c, out, cd.name_off, cd.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_wgsl_into(out, cd.ty);
            buf_push_lit(out, STR_PTR(" = "), STR_LEN(" = "));
            let vx = c.exprs[cd.value];
            print_expr(c, cd.value, 3, 0, out);
            if vx.kind != 0 && vx.kind != 1 {
                // non-literal defaults are substituted at use sites; a
                // ctor default here is already a literal tree
            };
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            oid = oid + 1;
        };
        ci = ci + 1;
    }
    if oid > 0 {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    buf_push_lit(out, STR_PTR("struct VertexIn {\n"), STR_LEN("struct VertexIn {\n"));
    let ii: i32 = 0;
    let loc: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("  @location("), STR_LEN("  @location("));
            buf_push_i64(out, loc);
            buf_push_lit(out, STR_PTR(") "), STR_LEN(") "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_wgsl_into(out, f.ty);
            buf_push_lit(out, STR_PTR(",\n"), STR_LEN(",\n"));
            loc = loc + 1;
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("}\n\nstruct VertexOut {\n  @builtin(position) clip_position: vec4<f32>,\n"), STR_LEN("}\n\nstruct VertexOut {\n  @builtin(position) clip_position: vec4<f32>,\n"));
    let vi2: i32 = 0;
    while vi2 < c.varyings.len() {
        let f = c.fields[c.varyings[vi2]];
        buf_push_lit(out, STR_PTR("  @location("), STR_LEN("  @location("));
        buf_push_i64(out, vi2);
        buf_push_lit(out, STR_PTR(") "), STR_LEN(") "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
        ty_wgsl_into(out, f.ty);
        buf_push_lit(out, STR_PTR(",\n"), STR_LEN(",\n"));
        vi2 = vi2 + 1;
    }
    buf_push_lit(out, STR_PTR("}\n\nstruct FragmentOut {\n  @location(0) frag_color: vec4<f32>,\n}\n\n"), STR_LEN("}\n\nstruct FragmentOut {\n  @location(0) frag_color: vec4<f32>,\n}\n\n"));
    buf_push_lit(out, STR_PTR("@vertex\nfn vertex_main(input: VertexIn) -> VertexOut {\n    var output: VertexOut;\n"), STR_LEN("@vertex\nfn vertex_main(input: VertexIn) -> VertexOut {\n    var output: VertexOut;\n"));
    let di: i32 = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    var "), STR_LEN("    var "));
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_wgsl_into(out, v.ty);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 3, 1, 1, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 3, 1, 1, out);
    buf_push_lit(out, STR_PTR("    return output;\n}\n\n"), STR_LEN("    return output;\n}\n\n"));
    buf_push_lit(out, STR_PTR("@fragment\nfn fragment_main(input: VertexOut) -> FragmentOut {\n    var output: FragmentOut;\n    var frag_color: vec4<f32>;\n"), STR_LEN("@fragment\nfn fragment_main(input: VertexOut) -> FragmentOut {\n    var output: FragmentOut;\n    var frag_color: vec4<f32>;\n"));
    di = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    var "), STR_LEN("    var "));
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(": "), STR_LEN(": "));
            ty_wgsl_into(out, v.ty);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.f_woven_off, c.f_woven_len, 3, 2, 1, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 3, 2, 1, out);
    buf_push_lit(out, STR_PTR("    output.frag_color = frag_color;\n    return output;\n}\n"), STR_LEN("    output.frag_color = frag_color;\n    return output;\n}\n"));
}

fn json_escape_span(c: &Ctx, out: &Buf, off: i32, len: i32) {
    let i: i32 = 0;
    while i < len {
        let b = span_byte(c, off + i);
        if b == 34 || b == 92 {
            buf_push_byte(out, 92);
        };
        buf_push_byte(out, b);
        i = i + 1;
    }
}

fn json_name(c: &Ctx, out: &Buf, off: i32, len: i32) {
    buf_push_byte(out, 34);
    json_escape_span(c, out, off, len);
    buf_push_byte(out, 34);
}

fn json_ty(c: &Ctx, out: &Buf, ty: i32) {
    buf_push_byte(out, 34);
    ty_name_into(out, ty);
    buf_push_byte(out, 34);
}

fn wgsl_block_size(c: &Ctx, off: i32, len: i32, live_only: bool, gname_off: i32, gname_len: i32) -> i32 {
    let cur: i32 = 0;
    let maxa: i32 = 1;
    let i: i32 = 0;
    while i < len {
        let f = c.fields[off + i];
        let live: bool = true;
        if live_only {
            if gname_len > 0 {
                live = is_live_key(c, true, gname_off, gname_len, f.name_off, f.name_len);
            } else {
                live = is_live_key(c, false, f.name_off, f.name_len, 0, 0);
            };
        };
        if live {
            let a = ty_align(f.ty);
            if a > maxa { maxa = a; };
            let rem = cur % a;
            if rem != 0 { cur = cur + (a - rem); };
            cur = cur + ty_size(f.ty);
        };
        i = i + 1;
    }
    let rem2 = cur % maxa;
    if rem2 != 0 { cur = cur + (maxa - rem2); };
    return cur;
}

fn emit_manifest(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("{\n  \"target\": \"webgpu\",\n  \"entries\": [\n"), STR_LEN("{\n  \"target\": \"webgpu\",\n  \"entries\": [\n"));
    let st: i32 = 1;
    while st <= 2 {
        if st == 1 {
            buf_push_lit(out, STR_PTR("    {\"name\": \"vertex_main\", \"stage\": \"vertex\", \"uses\": ["), STR_LEN("    {\"name\": \"vertex_main\", \"stage\": \"vertex\", \"uses\": ["));
        } else {
            buf_push_lit(out, STR_PTR(",\n    {\"name\": \"fragment_main\", \"stage\": \"fragment\", \"uses\": ["), STR_LEN(",\n    {\"name\": \"fragment_main\", \"stage\": \"fragment\", \"uses\": ["));
        };
        let first: bool = true;
        let b0: i32 = 0;
        let gi: i32 = 0;
        while gi < c.m_gr_len {
            let g = c.groups[c.m_gr_off + gi];
            let any: bool = false;
            let fi: i32 = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    any = true;
                };
                fi = fi + 1;
            }
            if any {
                let used: bool = false;
                fi = 0;
                while fi < g.fields_len {
                    let gf = c.fields[g.fields_off + fi];
                    if stage_reads_has(c, st, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                        used = true;
                    };
                    fi = fi + 1;
                }
                if used {
                    if !first { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
                    first = false;
                    buf_push_lit(out, STR_PTR("{\"group\": 0, \"binding\": "), STR_LEN("{\"group\": 0, \"binding\": "));
                    buf_push_i64(out, b0);
                    buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
                    json_name(c, out, g.name_off, g.name_len);
                    buf_push_lit(out, STR_PTR(", \"kind\": \"uniform\"}"), STR_LEN(", \"kind\": \"uniform\"}"));
                };
                b0 = b0 + 1;
            };
            gi = gi + 1;
        }
        let gs_any: bool = false;
        let si: i32 = 0;
        while si < c.m_gs_len {
            let f = c.fields[c.m_gs_off + si];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                gs_any = true;
            };
            si = si + 1;
        }
        if gs_any {
            let used2: bool = false;
            si = 0;
            while si < c.m_gs_len {
                let f = c.fields[c.m_gs_off + si];
                if stage_reads_has(c, st, false, f.name_off, f.name_len, 0, 0) {
                    used2 = true;
                };
                si = si + 1;
            }
            if used2 {
                if !first { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
                first = false;
                buf_push_lit(out, STR_PTR("{\"group\": 0, \"binding\": "), STR_LEN("{\"group\": 0, \"binding\": "));
                buf_push_i64(out, b0);
                buf_push_lit(out, STR_PTR(", \"name\": \"Globals\", \"kind\": \"uniform\"}"), STR_LEN(", \"name\": \"Globals\", \"kind\": \"uniform\"}"));
            };
            b0 = b0 + 1;
        };
        let lp = live_params(c);
        if lp.len() > 0 {
            let used3: bool = false;
            let li: i32 = 0;
            while li < lp.len() {
                let f = c.fields[lp[li]];
                if stage_reads_has(c, st, false, f.name_off, f.name_len, 0, 0) {
                    used3 = true;
                };
                li = li + 1;
            }
            if used3 {
                if !first { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
                first = false;
                buf_push_lit(out, STR_PTR("{\"group\": 1, \"binding\": 0, \"name\": \"Params\", \"kind\": \"uniform\"}"), STR_LEN("{\"group\": 1, \"binding\": 0, \"name\": \"Params\", \"kind\": \"uniform\"}"));
            };
        };
        let ls = live_samplers(c);
        let b1: i32 = 0;
        if lp.len() > 0 { b1 = 1; };
        let li2: i32 = 0;
        while li2 < ls.len() {
            let f = c.fields[ls[li2]];
            if stage_reads_has(c, st, false, f.name_off, f.name_len, 0, 0) {
                if !first { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
                first = false;
                buf_push_lit(out, STR_PTR("{\"group\": 1, \"binding\": "), STR_LEN("{\"group\": 1, \"binding\": "));
                buf_push_i64(out, b1);
                buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
                json_name(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(", \"kind\": \"texture\"}"), STR_LEN(", \"kind\": \"texture\"}"));
                buf_push_lit(out, STR_PTR(", {\"group\": 1, \"binding\": "), STR_LEN(", {\"group\": 1, \"binding\": "));
                buf_push_i64(out, b1 + 1);
                buf_push_lit(out, STR_PTR(", \"name\": \""), STR_LEN(", \"name\": \""));
                json_escape_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR("_sampler\", \"kind\": \"sampler\"}"), STR_LEN("_sampler\", \"kind\": \"sampler\"}"));
            };
            b1 = b1 + 2;
            li2 = li2 + 1;
        }
        buf_push_lit(out, STR_PTR("]}"), STR_LEN("]}"));
        st = st + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"buffers\": ["), STR_LEN("],\n  \"buffers\": ["));
    let firstb: bool = true;
    let b0b: i32 = 0;
    let gi2: i32 = 0;
    while gi2 < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi2];
        let any2: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any2 = true;
            };
            fi = fi + 1;
        }
        if any2 {
            if !firstb { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
            firstb = false;
            buf_push_lit(out, STR_PTR("{\"group\": 0, \"binding\": "), STR_LEN("{\"group\": 0, \"binding\": "));
            buf_push_i64(out, b0b);
            buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
            json_name(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(", \"size\": "), STR_LEN(", \"size\": "));
            buf_push_i64(out, wgsl_block_size(c, g.fields_off, g.fields_len, true, g.name_off, g.name_len));
            buf_push_lit(out, STR_PTR(", \"fields\": ["), STR_LEN(", \"fields\": ["));
            let firstf: bool = true;
            let cur: i32 = 0;
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    let a = ty_align(gf.ty);
                    let rem = cur % a;
                    if rem != 0 { cur = cur + (a - rem); };
                    if !firstf { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
                    firstf = false;
                    buf_push_lit(out, STR_PTR("{\"name\": "), STR_LEN("{\"name\": "));
                    json_name(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(", \"type\": "), STR_LEN(", \"type\": "));
                    json_ty(c, out, gf.ty);
                    buf_push_lit(out, STR_PTR(", \"offset\": "), STR_LEN(", \"offset\": "));
                    buf_push_i64(out, cur);
                    buf_push_lit(out, STR_PTR(", \"size\": "), STR_LEN(", \"size\": "));
                    buf_push_i64(out, ty_size(gf.ty));
                    buf_push_byte(out, 125);
                    cur = cur + ty_size(gf.ty);
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("]}"), STR_LEN("]}"));
            b0b = b0b + 1;
        };
        gi2 = gi2 + 1;
    }
    let lp2 = live_params(c);
    if lp2.len() > 0 {
        if !firstb { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
        firstb = false;
        buf_push_lit(out, STR_PTR("{\"group\": 1, \"binding\": 0, \"name\": \"Params\", \"size\": "), STR_LEN("{\"group\": 1, \"binding\": 0, \"name\": \"Params\", \"size\": "));
        let psz: i32 = 0;
        let pmaxa: i32 = 1;
        let li: i32 = 0;
        while li < lp2.len() {
            let f = c.fields[lp2[li]];
            let a = ty_align(f.ty);
            if a > pmaxa { pmaxa = a; };
            let rem = psz % a;
            if rem != 0 { psz = psz + (a - rem); };
            psz = psz + ty_size(f.ty);
            li = li + 1;
        }
        let rem2 = psz % pmaxa;
        if rem2 != 0 { psz = psz + (pmaxa - rem2); };
        buf_push_i64(out, psz);
        buf_push_lit(out, STR_PTR(", \"fields\": ["), STR_LEN(", \"fields\": ["));
        let firstf2: bool = true;
        let cur2: i32 = 0;
        li = 0;
        while li < lp2.len() {
            let f = c.fields[lp2[li]];
            let a = ty_align(f.ty);
            let rem = cur2 % a;
            if rem != 0 { cur2 = cur2 + (a - rem); };
            if !firstf2 { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
            firstf2 = false;
            buf_push_lit(out, STR_PTR("{\"name\": "), STR_LEN("{\"name\": "));
            json_name(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(", \"type\": "), STR_LEN(", \"type\": "));
            json_ty(c, out, f.ty);
            buf_push_lit(out, STR_PTR(", \"offset\": "), STR_LEN(", \"offset\": "));
            buf_push_i64(out, cur2);
            buf_push_lit(out, STR_PTR(", \"size\": "), STR_LEN(", \"size\": "));
            buf_push_i64(out, ty_size(f.ty));
            buf_push_byte(out, 125);
            cur2 = cur2 + ty_size(f.ty);
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("]}"), STR_LEN("]}"));
    };
    buf_push_lit(out, STR_PTR("],\n  \"textures\": ["), STR_LEN("],\n  \"textures\": ["));
    let ls2 = live_samplers(c);
    let b1b: i32 = 0;
    if lp2.len() > 0 { b1b = 1; };
    let firstt: bool = true;
    let ti2: i32 = 0;
    while ti2 < ls2.len() {
        let f = c.fields[ls2[ti2]];
        if !firstt { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
        firstt = false;
        buf_push_lit(out, STR_PTR("{\"group\": 1, \"binding\": "), STR_LEN("{\"group\": 1, \"binding\": "));
        buf_push_i64(out, b1b);
        buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
        json_name(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(", \"kind\": \"texture_2d\", \"sampler_binding\": "), STR_LEN(", \"kind\": \"texture_2d\", \"sampler_binding\": "));
        buf_push_i64(out, b1b + 1);
        buf_push_byte(out, 125);
        b1b = b1b + 2;
        ti2 = ti2 + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"samplers\": ["), STR_LEN("],\n  \"samplers\": ["));
    let b1c: i32 = 0;
    if lp2.len() > 0 { b1c = 1; };
    let firsts: bool = true;
    let si2: i32 = 0;
    while si2 < ls2.len() {
        let f = c.fields[ls2[si2]];
        if !firsts { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
        firsts = false;
        buf_push_lit(out, STR_PTR("{\"group\": 1, \"binding\": "), STR_LEN("{\"group\": 1, \"binding\": "));
        buf_push_i64(out, b1c + 1);
        buf_push_lit(out, STR_PTR(", \"name\": \""), STR_LEN(", \"name\": \""));
        json_escape_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("_sampler\", \"for\": "), STR_LEN("_sampler\", \"for\": "));
        json_name(c, out, f.name_off, f.name_len);
        buf_push_byte(out, 125);
        b1c = b1c + 2;
        si2 = si2 + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"overrides\": ["), STR_LEN("],\n  \"overrides\": ["));
    let firsto: bool = true;
    let ci: i32 = 0;
    let oid: i32 = 0;
    while ci < c.m_co_len {
        let cd = c.consts[c.m_co_off + ci];
        if cd.ty <= 3 {
            if !firsto { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
            firsto = false;
            buf_push_lit(out, STR_PTR("{\"name\": "), STR_LEN("{\"name\": "));
            json_name(c, out, cd.name_off, cd.name_len);
            buf_push_lit(out, STR_PTR(", \"id\": "), STR_LEN(", \"id\": "));
            buf_push_i64(out, oid);
            buf_push_lit(out, STR_PTR(", \"type\": "), STR_LEN(", \"type\": "));
            json_ty(c, out, cd.ty);
            buf_push_lit(out, STR_PTR(", \"default\": "), STR_LEN(", \"default\": "));
            print_expr(c, cd.value, 3, 0, out);
            buf_push_lit(out, STR_PTR(", \"required\": false}"), STR_LEN(", \"required\": false}"));
            oid = oid + 1;
        };
        ci = ci + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"inputs\": ["), STR_LEN("],\n  \"inputs\": ["));
    let firsti: bool = true;
    let ii: i32 = 0;
    let loc: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            if !firsti { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
            firsti = false;
            buf_push_lit(out, STR_PTR("{\"location\": "), STR_LEN("{\"location\": "));
            buf_push_i64(out, loc);
            buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
            json_name(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(", \"type\": "), STR_LEN(", \"type\": "));
            json_ty(c, out, f.ty);
            buf_push_byte(out, 125);
            loc = loc + 1;
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"varyings\": ["), STR_LEN("],\n  \"varyings\": ["));
    let vi3: i32 = 0;
    while vi3 < c.varyings.len() {
        let f = c.fields[c.varyings[vi3]];
        if vi3 > 0 { buf_push_lit(out, STR_PTR(", "), STR_LEN(", ")); };
        buf_push_lit(out, STR_PTR("{\"location\": "), STR_LEN("{\"location\": "));
        buf_push_i64(out, vi3);
        buf_push_lit(out, STR_PTR(", \"name\": "), STR_LEN(", \"name\": "));
        json_name(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(", \"type\": "), STR_LEN(", \"type\": "));
        json_ty(c, out, f.ty);
        buf_push_byte(out, 125);
        vi3 = vi3 + 1;
    }
    buf_push_lit(out, STR_PTR("],\n  \"outputs\": [{\"location\": 0, \"name\": \"frag_color\", \"type\": \"vec4\"}]\n}\n"), STR_LEN("],\n  \"outputs\": [{\"location\": 0, \"name\": \"frag_color\", \"type\": \"vec4\"}]\n}\n"));
}


// ------------------------------------------------------------------
// msl target (DESIGN section 8.2, P3): Metal Shading Language dialect.
// Buffers in merged order: groups, Globals, Params. Textures and
// samplers get split slots in declaration order.
// ------------------------------------------------------------------

fn emit_msl(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("#include <metal_stdlib>\nusing namespace metal;\n\n"), STR_LEN("#include <metal_stdlib>\nusing namespace metal;\n\n"));
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("struct "), STR_LEN("struct "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(" {\n"), STR_LEN(" {\n"));
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                    ty_msl_into(out, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
        };
        gi = gi + 1;
    }
    let gs_any: bool = false;
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            gs_any = true;
        };
        si = si + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR("struct Globals {\n"), STR_LEN("struct Globals {\n"));
        si = 0;
        while si < c.m_gs_len {
            let f = c.fields[c.m_gs_off + si];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                ty_msl_into(out, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            si = si + 1;
        }
        buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
    };
    let lp = live_params(c);
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("struct Params {\n"), STR_LEN("struct Params {\n"));
        let li: i32 = 0;
        while li < lp.len() {
            let f = c.fields[lp[li]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            ty_msl_into(out, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
    };
    buf_push_lit(out, STR_PTR("struct VertexIn {\n"), STR_LEN("struct VertexIn {\n"));
    let ii: i32 = 0;
    let loc: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            ty_msl_into(out, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(" [[attribute("), STR_LEN(" [[attribute("));
            buf_push_i64(out, loc);
            buf_push_lit(out, STR_PTR(")]];\n"), STR_LEN(")]];\n"));
            loc = loc + 1;
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("};\n\nstruct VertexOut {\n    float4 position [[position]];\n"), STR_LEN("};\n\nstruct VertexOut {\n    float4 position [[position]];\n"));
    let vi2: i32 = 0;
    while vi2 < c.varyings.len() {
        let f = c.fields[c.varyings[vi2]];
        buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
        ty_msl_into(out, f.ty);
        buf_push_byte(out, 32);
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        vi2 = vi2 + 1;
    }
    buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
    // vertex entry
    buf_push_lit(out, STR_PTR("vertex VertexOut vertex_main(VertexIn input [[stage_in]]"), STR_LEN("vertex VertexOut vertex_main(VertexIn input [[stage_in]]"));
    let bidx: i32 = 0;
    gi = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any2: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any2 = true;
            };
            fi = fi + 1;
        }
        if any2 {
            buf_push_lit(out, STR_PTR(",\n    constant "), STR_LEN(",\n    constant "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("& "), STR_LEN("& "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(" [[buffer("), STR_LEN(" [[buffer("));
            buf_push_i64(out, bidx);
            buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
            bidx = bidx + 1;
        };
        gi = gi + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR(",\n    constant Globals& globals [[buffer("), STR_LEN(",\n    constant Globals& globals [[buffer("));
        buf_push_i64(out, bidx);
        buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
        bidx = bidx + 1;
    };
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR(",\n    constant Params& params [[buffer("), STR_LEN(",\n    constant Params& params [[buffer("));
        buf_push_i64(out, bidx);
        buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
        bidx = bidx + 1;
    };
    buf_push_lit(out, STR_PTR(")\n{\n    VertexOut output;\n"), STR_LEN(")\n{\n    VertexOut output;\n"));
    let di: i32 = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            ty_msl_into(out, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 4, 1, 1, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 4, 1, 1, out);
    buf_push_lit(out, STR_PTR("    return output;\n}\n\n"), STR_LEN("    return output;\n}\n\n"));
    // fragment entry
    buf_push_lit(out, STR_PTR("fragment float4 fragment_main(VertexOut input [[stage_in]]"), STR_LEN("fragment float4 fragment_main(VertexOut input [[stage_in]]"));
    let bidx2: i32 = 0;
    gi = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any3: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any3 = true;
            };
            fi = fi + 1;
        }
        if any3 {
            buf_push_lit(out, STR_PTR(",\n    constant "), STR_LEN(",\n    constant "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("& "), STR_LEN("& "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR(" [[buffer("), STR_LEN(" [[buffer("));
            buf_push_i64(out, bidx2);
            buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
            bidx2 = bidx2 + 1;
        };
        gi = gi + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR(",\n    constant Globals& globals [[buffer("), STR_LEN(",\n    constant Globals& globals [[buffer("));
        buf_push_i64(out, bidx2);
        buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
        bidx2 = bidx2 + 1;
    };
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR(",\n    constant Params& params [[buffer("), STR_LEN(",\n    constant Params& params [[buffer("));
        buf_push_i64(out, bidx2);
        buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
        bidx2 = bidx2 + 1;
    };
    let ls = live_samplers(c);
    let ti3: i32 = 0;
    while ti3 < ls.len() {
        let f = c.fields[ls[ti3]];
        buf_push_lit(out, STR_PTR(",\n    texture2d<float> "), STR_LEN(",\n    texture2d<float> "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(" [[texture("), STR_LEN(" [[texture("));
        buf_push_i64(out, ti3);
        buf_push_lit(out, STR_PTR(")]],\n    sampler "), STR_LEN(")]],\n    sampler "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("_sampler [[sampler("), STR_LEN("_sampler [[sampler("));
        buf_push_i64(out, ti3);
        buf_push_lit(out, STR_PTR(")]]"), STR_LEN(")]]"));
        ti3 = ti3 + 1;
    }
    buf_push_lit(out, STR_PTR(")\n{\n    float4 frag_color;\n"), STR_LEN(")\n{\n    float4 frag_color;\n"));
    di = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            ty_msl_into(out, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.f_woven_off, c.f_woven_len, 4, 2, 1, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 4, 2, 1, out);
    buf_push_lit(out, STR_PTR("    return frag_color;\n}\n"), STR_LEN("    return frag_color;\n}\n"));
}

// ------------------------------------------------------------------
// unity target (DESIGN section 9.1, P3 first): HLSL dialect + Unity
// convention layer, URP flavor. Full ShaderLab asset; all material
// params in the single UnityPerMaterial cbuffer (SRP Batcher hard
// contract); textures via the TEXTURE2D/SAMPLER/SAMPLE_TEXTURE2D
// macro triplet, never raw .Sample().
// ------------------------------------------------------------------

fn unity_property(c: &Ctx, out: &Buf, f: Field) {
    buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
    out_span(c, out, f.name_off, f.name_len);
    buf_push_lit(out, STR_PTR(" (\""), STR_LEN(" (\""));
    out_span(c, out, f.name_off, f.name_len);
    if f.ty == 6 {
        buf_push_lit(out, STR_PTR("\", Color) = (1, 1, 1, 1)\n"), STR_LEN("\", Color) = (1, 1, 1, 1)\n"));
        return;
    };
    if f.ty == 5 || f.ty == 4 {
        buf_push_lit(out, STR_PTR("\", Vector) = (0, 0, 0, 0)\n"), STR_LEN("\", Vector) = (0, 0, 0, 0)\n"));
        return;
    };
    if f.ty == 0 || f.ty == 3 {
        buf_push_lit(out, STR_PTR("\", Float) = 0\n"), STR_LEN("\", Float) = 0\n"));
        return;
    };
    if f.ty == 1 || f.ty == 2 {
        buf_push_lit(out, STR_PTR("\", Int) = 0\n"), STR_LEN("\", Int) = 0\n"));
        return;
    };
}

fn emit_unity(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("Shader \"SLASL/Merged\"\n{\n    Properties\n    {\n"), STR_LEN("Shader \"SLASL/Merged\"\n{\n    Properties\n    {\n"));
    let pi2: i32 = 0;
    while pi2 < c.m_pa_len {
        let f = c.fields[c.m_pa_off + pi2];
        if f.ty == 9 {
            buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(" (\""), STR_LEN(" (\""));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR("\", 2D) = \"white\" {}\n"), STR_LEN("\", 2D) = \"white\" {}\n"));
        } else {
            if f.ty <= 6 {
                if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                    unity_property(c, out, f);
                };
            };
        };
        pi2 = pi2 + 1;
    }
    buf_push_lit(out, STR_PTR("    }\n    HLSLINCLUDE\n    #include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"\n\n"), STR_LEN("    }\n    HLSLINCLUDE\n    #include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"\n\n"));
    let lp = live_params(c);
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("    CBUFFER_START(UnityPerMaterial)\n"), STR_LEN("    CBUFFER_START(UnityPerMaterial)\n"));
        let li: i32 = 0;
        while li < lp.len() {
            let f = c.fields[lp[li]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 5, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("    CBUFFER_END\n\n"), STR_LEN("    CBUFFER_END\n\n"));
    };
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("    cbuffer "), STR_LEN("    cbuffer "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("\n    {\n"), STR_LEN("\n    {\n"));
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
                    out_ty(c, out, 5, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("    };\n\n"), STR_LEN("    };\n\n"));
        };
        gi = gi + 1;
    }
    let gs_any: bool = false;
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            gs_any = true;
        };
        si = si + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR("    cbuffer Globals\n    {\n"), STR_LEN("    cbuffer Globals\n    {\n"));
        si = 0;
        while si < c.m_gs_len {
            let f = c.fields[c.m_gs_off + si];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
                out_ty(c, out, 5, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            si = si + 1;
        }
        buf_push_lit(out, STR_PTR("    };\n\n"), STR_LEN("    };\n\n"));
    };
    let ls = live_samplers(c);
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        buf_push_lit(out, STR_PTR("    TEXTURE2D("), STR_LEN("    TEXTURE2D("));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(");\n    SAMPLER(sampler"), STR_LEN(");\n    SAMPLER(sampler"));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(");\n"), STR_LEN(");\n"));
        sai = sai + 1;
    }
    if ls.len() > 0 {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    buf_push_lit(out, STR_PTR("    struct Attributes\n    {\n"), STR_LEN("    struct Attributes\n    {\n"));
    let counter: i32 = 0;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
            out_ty(c, out, 5, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(" : "), STR_LEN(" : "));
            input_semantic(c, f.name_off, f.name_len, &counter, out);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("    };\n\n    struct Varyings\n    {\n        float4 position : SV_POSITION;\n"), STR_LEN("    };\n\n    struct Varyings\n    {\n        float4 position : SV_POSITION;\n"));
    let vcounter: i32 = 0;
    let vi2: i32 = 0;
    while vi2 < c.varyings.len() {
        let f = c.fields[c.varyings[vi2]];
        buf_push_lit(out, STR_PTR("        "), STR_LEN("        "));
        out_ty(c, out, 5, f.ty);
        buf_push_byte(out, 32);
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(" : TEXCOORD"), STR_LEN(" : TEXCOORD"));
        buf_push_i64(out, vcounter);
        buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        vcounter = vcounter + 1;
        vi2 = vi2 + 1;
    }
    buf_push_lit(out, STR_PTR("    };\n    ENDHLSL\n\n    SubShader\n    {\n        Tags { \"RenderType\" = \"Opaque\" \"RenderPipeline\" = \"UniversalPipeline\" }\n        Pass\n        {\n            HLSLPROGRAM\n            #pragma vertex vertex_main\n            #pragma fragment fragment_main\n            #pragma target 3.5\n\n"), STR_LEN("    };\n    ENDHLSL\n\n    SubShader\n    {\n        Tags { \"RenderType\" = \"Opaque\" \"RenderPipeline\" = \"UniversalPipeline\" }\n        Pass\n        {\n            HLSLPROGRAM\n            #pragma vertex vertex_main\n            #pragma fragment fragment_main\n            #pragma target 3.5\n\n"));
    buf_push_lit(out, STR_PTR("            Varyings vertex_main(Attributes input)\n            {\n                Varyings output;\n"), STR_LEN("            Varyings vertex_main(Attributes input)\n            {\n                Varyings output;\n"));
    let di: i32 = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("                "), STR_LEN("                "));
            out_ty(c, out, 5, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 5, 1, 4, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 5, 1, 4, out);
    buf_push_lit(out, STR_PTR("                return output;\n            }\n\n"), STR_LEN("                return output;\n            }\n\n"));
    buf_push_lit(out, STR_PTR("            float4 fragment_main(Varyings input) : SV_Target\n            {\n                float4 frag_color;\n"), STR_LEN("            float4 fragment_main(Varyings input) : SV_Target\n            {\n                float4 frag_color;\n"));
    di = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("                "), STR_LEN("                "));
            out_ty(c, out, 5, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.f_woven_off, c.f_woven_len, 5, 2, 4, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 5, 2, 4, out);
    buf_push_lit(out, STR_PTR("                return frag_color;\n            }\n            ENDHLSL\n        }\n    }\n}\n"), STR_LEN("                return frag_color;\n            }\n            ENDHLSL\n        }\n    }\n}\n"));
}

// ------------------------------------------------------------------
// blender target (DESIGN section 9.3, P3): one GLSL source with NO
// #version (the host injects it), stages selected by the
// GPU_VERTEX_SHADER / GPU_FRAGMENT_SHADER defines, std140 uniform
// blocks, a named StageInterface block for varyings. Second product:
// merged_info.py, the GPUShaderCreateInfo equivalent as a Python
// builder (info-equivalent declaration face).
// ------------------------------------------------------------------

fn emit_blender(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("/* SLASL merged output (Blender convention). No #version: the host injects it. */\n\n"), STR_LEN("/* SLASL merged output (Blender convention). No #version: the host injects it. */\n\n"));
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("layout(std140) uniform "), STR_LEN("layout(std140) uniform "));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("\n{\n"), STR_LEN("\n{\n"));
            fi = 0;
            while fi < g.fields_len {
                let gf = c.fields[g.fields_off + fi];
                if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                    buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                    out_ty(c, out, 0, gf.ty);
                    buf_push_byte(out, 32);
                    out_span(c, out, gf.name_off, gf.name_len);
                    buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
                };
                fi = fi + 1;
            }
            buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
        };
        gi = gi + 1;
    }
    let gs_any: bool = false;
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            gs_any = true;
        };
        si = si + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR("layout(std140) uniform Globals\n{\n"), STR_LEN("layout(std140) uniform Globals\n{\n"));
        si = 0;
        while si < c.m_gs_len {
            let f = c.fields[c.m_gs_off + si];
            if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
                buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
                out_ty(c, out, 0, f.ty);
                buf_push_byte(out, 32);
                out_span(c, out, f.name_off, f.name_len);
                buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            };
            si = si + 1;
        }
        buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
    };
    let lp = live_params(c);
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("layout(std140) uniform Params\n{\n"), STR_LEN("layout(std140) uniform Params\n{\n"));
        let li: i32 = 0;
        while li < lp.len() {
            let f = c.fields[lp[li]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 0, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            li = li + 1;
        }
        buf_push_lit(out, STR_PTR("};\n\n"), STR_LEN("};\n\n"));
    };
    let ls = live_samplers(c);
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        buf_push_lit(out, STR_PTR("uniform sampler2D "), STR_LEN("uniform sampler2D "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        sai = sai + 1;
    }
    if ls.len() > 0 {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    buf_push_lit(out, STR_PTR("#ifdef GPU_VERTEX_SHADER\n"), STR_LEN("#ifdef GPU_VERTEX_SHADER\n"));
    let loc: i32 = 0;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("layout(location = "), STR_LEN("layout(location = "));
            buf_push_i64(out, loc);
            buf_push_lit(out, STR_PTR(") in "), STR_LEN(") in "));
            out_ty(c, out, 0, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            loc = loc + 1;
        };
        ii = ii + 1;
    }
    if c.varyings.len() > 0 {
        buf_push_lit(out, STR_PTR("\nout StageInterface\n{\n"), STR_LEN("\nout StageInterface\n{\n"));
        let vi2: i32 = 0;
        while vi2 < c.varyings.len() {
            let f = c.fields[c.varyings[vi2]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 0, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            vi2 = vi2 + 1;
        }
        buf_push_lit(out, STR_PTR("} stage_out;\n"), STR_LEN("} stage_out;\n"));
    };
    buf_push_lit(out, STR_PTR("\nvoid main()\n{\n"), STR_LEN("\nvoid main()\n{\n"));
    let di: i32 = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 0, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 6, 1, 1, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 6, 1, 1, out);
    buf_push_lit(out, STR_PTR("}\n#endif\n\n#ifdef GPU_FRAGMENT_SHADER\n"), STR_LEN("}\n#endif\n\n#ifdef GPU_FRAGMENT_SHADER\n"));
    if c.varyings.len() > 0 {
        buf_push_lit(out, STR_PTR("in StageInterface\n{\n"), STR_LEN("in StageInterface\n{\n"));
        let vi3: i32 = 0;
        while vi3 < c.varyings.len() {
            let f = c.fields[c.varyings[vi3]];
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 0, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
            vi3 = vi3 + 1;
        }
        buf_push_lit(out, STR_PTR("} stage_in;\n\n"), STR_LEN("} stage_in;\n\n"));
    };
    buf_push_lit(out, STR_PTR("layout(location = 0) out vec4 frag_color;\n\nvoid main()\n{\n"), STR_LEN("layout(location = 0) out vec4 frag_color;\n\nvoid main()\n{\n"));
    di = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 0, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.f_woven_off, c.f_woven_len, 6, 2, 1, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 6, 2, 1, out);
    buf_push_lit(out, STR_PTR("}\n#endif\n"), STR_LEN("}\n#endif\n"));
}

fn emit_blender_info(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("# GPUShaderCreateInfo equivalent for merged.glsl (generated by SLASL; do not edit).\nimport gpu\nfrom gpu.types import GPUShaderCreateInfo, GPUStageInterfaceInfo\n\n"), STR_LEN("# GPUShaderCreateInfo equivalent for merged.glsl (generated by SLASL; do not edit).\nimport gpu\nfrom gpu.types import GPUShaderCreateInfo, GPUStageInterfaceInfo\n\n"));
    if c.varyings.len() > 0 {
        buf_push_lit(out, STR_PTR("VERTEX_OUT = GPUStageInterfaceInfo(\"StageInterface\")\n"), STR_LEN("VERTEX_OUT = GPUStageInterfaceInfo(\"StageInterface\")\n"));
        let vi2: i32 = 0;
        while vi2 < c.varyings.len() {
            let f = c.fields[c.varyings[vi2]];
            buf_push_lit(out, STR_PTR("VERTEX_OUT.smooth(\""), STR_LEN("VERTEX_OUT.smooth(\""));
            ty_blender_into(out, f.ty);
            buf_push_lit(out, STR_PTR("\", \""), STR_LEN("\", \""));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR("\")\n"), STR_LEN("\")\n"));
            vi2 = vi2 + 1;
        }
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    buf_push_lit(out, STR_PTR("info = GPUShaderCreateInfo()\n"), STR_LEN("info = GPUShaderCreateInfo()\n"));
    let loc: i32 = 0;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("info.vertex_in("), STR_LEN("info.vertex_in("));
            buf_push_i64(out, loc);
            buf_push_lit(out, STR_PTR(", \""), STR_LEN(", \""));
            ty_blender_into(out, f.ty);
            buf_push_lit(out, STR_PTR("\", \""), STR_LEN("\", \""));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR("\")\n"), STR_LEN("\")\n"));
            loc = loc + 1;
        };
        ii = ii + 1;
    }
    if c.varyings.len() > 0 {
        buf_push_lit(out, STR_PTR("info.vertex_out(VERTEX_OUT)\n"), STR_LEN("info.vertex_out(VERTEX_OUT)\n"));
    };
    buf_push_lit(out, STR_PTR("info.fragment_out(0, \"vec4\", \"frag_color\")\n"), STR_LEN("info.fragment_out(0, \"vec4\", \"frag_color\")\n"));
    let slot: i32 = 0;
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let any: bool = false;
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                any = true;
            };
            fi = fi + 1;
        }
        if any {
            buf_push_lit(out, STR_PTR("info.uniform_buf("), STR_LEN("info.uniform_buf("));
            buf_push_i64(out, slot);
            buf_push_lit(out, STR_PTR(", \""), STR_LEN(", \""));
            out_span(c, out, g.name_off, g.name_len);
            buf_push_lit(out, STR_PTR("\")\n"), STR_LEN("\")\n"));
            slot = slot + 1;
        };
        gi = gi + 1;
    }
    let gs_any: bool = false;
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            gs_any = true;
        };
        si = si + 1;
    }
    if gs_any {
        buf_push_lit(out, STR_PTR("info.uniform_buf("), STR_LEN("info.uniform_buf("));
        buf_push_i64(out, slot);
        buf_push_lit(out, STR_PTR(", \"Globals\")\n"), STR_LEN(", \"Globals\")\n"));
        slot = slot + 1;
    };
    let lp = live_params(c);
    if lp.len() > 0 {
        buf_push_lit(out, STR_PTR("info.uniform_buf("), STR_LEN("info.uniform_buf("));
        buf_push_i64(out, slot);
        buf_push_lit(out, STR_PTR(", \"Params\")\n"), STR_LEN(", \"Params\")\n"));
        slot = slot + 1;
    };
    let ls = live_samplers(c);
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        buf_push_lit(out, STR_PTR("info.sampler("), STR_LEN("info.sampler("));
        buf_push_i64(out, sai);
        buf_push_lit(out, STR_PTR(", \"sampler2D\", \""), STR_LEN(", \"sampler2D\", \""));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("\")\n"), STR_LEN("\")\n"));
        sai = sai + 1;
    }
    buf_push_lit(out, STR_PTR("info.vertex_source(\"merged.glsl\")\ninfo.fragment_source(\"merged.glsl\")\n\nshader = gpu.shader.create_from_info(info)\n"), STR_LEN("info.vertex_source(\"merged.glsl\")\ninfo.fragment_source(\"merged.glsl\")\n\nshader = gpu.shader.create_from_info(info)\n"));
}

// ------------------------------------------------------------------
// unreal-global target (DESIGN section 9.2, P3): FGlobalShader trio.
// merged.ush holds the shared IO declarations, merged.usf the two
// stage entries, merged_glue.cpp the parameter structs + shader
// classes + permutation domain for the bool @consts. Parameters are
// logical names only; group fields are flattened <Group>_<field>.
// ------------------------------------------------------------------

fn emit_unreal_ush(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("/* merged.ush - generated by SLASL; shared declarations for the Merged global shaders. */\n#pragma once\n\n"), STR_LEN("/* merged.ush - generated by SLASL; shared declarations for the Merged global shaders. */\n#pragma once\n\n"));
    buf_push_lit(out, STR_PTR("struct FMergedVertexIn\n{\n"), STR_LEN("struct FMergedVertexIn\n{\n"));
    let counter: i32 = 0;
    let ii: i32 = 0;
    while ii < c.m_in_len {
        let f = c.fields[c.m_in_off + ii];
        if used_in(c, 1, f.name_off, f.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 7, f.ty);
            buf_push_byte(out, 32);
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(" : "), STR_LEN(" : "));
            input_semantic(c, f.name_off, f.name_len, &counter, out);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        ii = ii + 1;
    }
    buf_push_lit(out, STR_PTR("};\n\nstruct FMergedVertexOut\n{\n    float4 position : SV_POSITION;\n"), STR_LEN("};\n\nstruct FMergedVertexOut\n{\n    float4 position : SV_POSITION;\n"));
    let vcounter: i32 = 0;
    let vi2: i32 = 0;
    while vi2 < c.varyings.len() {
        let f = c.fields[c.varyings[vi2]];
        buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
        out_ty(c, out, 7, f.ty);
        buf_push_byte(out, 32);
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(" : TEXCOORD"), STR_LEN(" : TEXCOORD"));
        buf_push_i64(out, vcounter);
        buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        vcounter = vcounter + 1;
        vi2 = vi2 + 1;
    }
    buf_push_lit(out, STR_PTR("};\n"), STR_LEN("};\n"));
}

fn emit_unreal_usf(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("/* merged.usf - generated by SLASL; do not edit. */\n#include \"/Plugin/SLASL/Private/Merged.ush\"\n\n"), STR_LEN("/* merged.usf - generated by SLASL; do not edit. */\n#include \"/Plugin/SLASL/Private/Merged.ush\"\n\n"));
    buf_push_lit(out, STR_PTR("FMergedVertexOut MergedVS(FMergedVertexIn input)\n{\n    FMergedVertexOut output;\n"), STR_LEN("FMergedVertexOut MergedVS(FMergedVertexIn input)\n{\n    FMergedVertexOut output;\n"));
    let di: i32 = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 1, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 7, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.v_woven_off, c.v_woven_len, 7, 1, 1, out);
    print_stmts(c, c.lk_vert_off, c.lk_vert_len, 7, 1, 1, out);
    buf_push_lit(out, STR_PTR("    return output;\n}\n\n"), STR_LEN("    return output;\n}\n\n"));
    buf_push_lit(out, STR_PTR("float4 MergedPS(FMergedVertexOut input) : SV_Target\n{\n    float4 frag_color;\n"), STR_LEN("float4 MergedPS(FMergedVertexOut input) : SV_Target\n{\n    float4 frag_color;\n"));
    di = 0;
    while di < c.m_va_len {
        let v = c.fields[c.m_va_off + di];
        if is_local_to(c, 2, v.name_off, v.name_len) {
            buf_push_lit(out, STR_PTR("    "), STR_LEN("    "));
            out_ty(c, out, 7, v.ty);
            buf_push_byte(out, 32);
            out_span(c, out, v.name_off, v.name_len);
            buf_push_lit(out, STR_PTR(";\n"), STR_LEN(";\n"));
        };
        di = di + 1;
    }
    print_stmts(c, c.f_woven_off, c.f_woven_len, 7, 2, 1, out);
    print_stmts(c, c.lk_frag_off, c.lk_frag_len, 7, 2, 1, out);
    buf_push_lit(out, STR_PTR("    return frag_color;\n}\n"), STR_LEN("    return frag_color;\n}\n"));
}

fn emit_unreal_glue(c: &Ctx, out: &Buf) {
    buf_push_lit(out, STR_PTR("/* merged_glue.cpp - generated by SLASL; C++ glue for the Merged global shaders. */\n#include \"GlobalShader.h\"\n#include \"ShaderParameterStruct.h\"\n\n"), STR_LEN("/* merged_glue.cpp - generated by SLASL; C++ glue for the Merged global shaders. */\n#include \"GlobalShader.h\"\n#include \"ShaderParameterStruct.h\"\n\n"));
    buf_push_lit(out, STR_PTR("// Variants: SLASL @const values are folded at SLASL link time. The\n// permutation domain below mirrors the bool @const registry so the\n// host can request a variant; each value set is produced by a\n// separate SLASL compilation of the same sources.\n\n"), STR_LEN("// Variants: SLASL @const values are folded at SLASL link time. The\n// permutation domain below mirrors the bool @const registry so the\n// host can request a variant; each value set is produced by a\n// separate SLASL compilation of the same sources.\n\n"));
    buf_push_lit(out, STR_PTR("BEGIN_SHADER_PARAMETER_STRUCT(FMergedDataParameters, )\n"), STR_LEN("BEGIN_SHADER_PARAMETER_STRUCT(FMergedDataParameters, )\n"));
    let gi: i32 = 0;
    while gi < c.m_gr_len {
        let g = c.groups[c.m_gr_off + gi];
        let fi: i32 = 0;
        while fi < g.fields_len {
            let gf = c.fields[g.fields_off + fi];
            if is_live_key(c, true, g.name_off, g.name_len, gf.name_off, gf.name_len) {
                buf_push_lit(out, STR_PTR("    SHADER_PARAMETER("), STR_LEN("    SHADER_PARAMETER("));
                ty_hlsl_name_into(out, gf.ty);
                buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
                out_span(c, out, g.name_off, g.name_len);
                buf_push_byte(out, 95);
                out_span(c, out, gf.name_off, gf.name_len);
                buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
            };
            fi = fi + 1;
        }
        gi = gi + 1;
    }
    let si: i32 = 0;
    while si < c.m_gs_len {
        let f = c.fields[c.m_gs_off + si];
        if is_live_key(c, false, f.name_off, f.name_len, 0, 0) {
            buf_push_lit(out, STR_PTR("    SHADER_PARAMETER("), STR_LEN("    SHADER_PARAMETER("));
            ty_hlsl_name_into(out, f.ty);
            buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
            out_span(c, out, f.name_off, f.name_len);
            buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
        };
        si = si + 1;
    }
    let lp = live_params(c);
    let li: i32 = 0;
    while li < lp.len() {
        let f = c.fields[lp[li]];
        buf_push_lit(out, STR_PTR("    SHADER_PARAMETER("), STR_LEN("    SHADER_PARAMETER("));
        ty_hlsl_name_into(out, f.ty);
        buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(")\n"), STR_LEN(")\n"));
        li = li + 1;
    }
    let ls = live_samplers(c);
    let sai: i32 = 0;
    while sai < ls.len() {
        let f = c.fields[ls[sai]];
        buf_push_lit(out, STR_PTR("    SHADER_PARAMETER_TEXTURE(Texture2D, "), STR_LEN("    SHADER_PARAMETER_TEXTURE(Texture2D, "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR(")\n    SHADER_PARAMETER_SAMPLER(SamplerState, "), STR_LEN(")\n    SHADER_PARAMETER_SAMPLER(SamplerState, "));
        out_span(c, out, f.name_off, f.name_len);
        buf_push_lit(out, STR_PTR("Sampler)\n"), STR_LEN("Sampler)\n"));
        sai = sai + 1;
    }
    buf_push_lit(out, STR_PTR("END_SHADER_PARAMETER_STRUCT()\n\n"), STR_LEN("END_SHADER_PARAMETER_STRUCT()\n\n"));
    buf_push_lit(out, STR_PTR("BEGIN_SHADER_PARAMETER_STRUCT(FMergedPSParameters, )\n    SHADER_PARAMETER_STRUCT_INCLUDE(FMergedDataParameters)\n    RENDER_TARGET_BINDING_SLOTS()\nEND_SHADER_PARAMETER_STRUCT()\n\n"), STR_LEN("BEGIN_SHADER_PARAMETER_STRUCT(FMergedPSParameters, )\n    SHADER_PARAMETER_STRUCT_INCLUDE(FMergedDataParameters)\n    RENDER_TARGET_BINDING_SLOTS()\nEND_SHADER_PARAMETER_STRUCT()\n\n"));
    buf_push_lit(out, STR_PTR("class FMergedShaderVS : public FGlobalShader\n{\n    DECLARE_GLOBAL_SHADER(FMergedShaderVS);\n    SHADER_USE_PARAMETER_STRUCT(FMergedShaderVS, FGlobalShader);\n};\nIMPLEMENT_GLOBAL_SHADER(FMergedShaderVS, \"/Plugin/SLASL/Private/Merged.usf\", \"MergedVS\", SF_Vertex);\n\n"), STR_LEN("class FMergedShaderVS : public FGlobalShader\n{\n    DECLARE_GLOBAL_SHADER(FMergedShaderVS);\n    SHADER_USE_PARAMETER_STRUCT(FMergedShaderVS, FGlobalShader);\n};\nIMPLEMENT_GLOBAL_SHADER(FMergedShaderVS, \"/Plugin/SLASL/Private/Merged.usf\", \"MergedVS\", SF_Vertex);\n\n"));
    buf_push_lit(out, STR_PTR("class FMergedShaderPS : public FGlobalShader\n{\n    DECLARE_GLOBAL_SHADER(FMergedShaderPS);\n    SHADER_USE_PARAMETER_STRUCT(FMergedShaderPS, FGlobalShader);\n"), STR_LEN("class FMergedShaderPS : public FGlobalShader\n{\n    DECLARE_GLOBAL_SHADER(FMergedShaderPS);\n    SHADER_USE_PARAMETER_STRUCT(FMergedShaderPS, FGlobalShader);\n"));
    let nbc: i32 = 0;
    let ci2: i32 = 0;
    while ci2 < c.m_co_len {
        let k2 = c.consts[c.m_co_off + ci2];
        if k2.ty == 3 {
            if true {
                nbc = nbc + 1;
            };
        };
        ci2 = ci2 + 1;
    }
    if nbc > 0 {
        buf_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        let ci3: i32 = 0;
        while ci3 < c.m_co_len {
            let k3 = c.consts[c.m_co_off + ci3];
            if k3.ty == 3 {
                if true {
                    buf_push_lit(out, STR_PTR("    class F"), STR_LEN("    class F"));
                    out_span(c, out, k3.name_off, k3.name_len);
                    buf_push_lit(out, STR_PTR("Dim : SHADER_PERMUTATION_BOOL(\""), STR_LEN("Dim : SHADER_PERMUTATION_BOOL(\""));
                    out_span(c, out, k3.name_off, k3.name_len);
                    buf_push_lit(out, STR_PTR("\");\n"), STR_LEN("\");\n"));
                };
            };
            ci3 = ci3 + 1;
        }
        buf_push_lit(out, STR_PTR("    using FPermutationDomain = TShaderPermutationDomain<"), STR_LEN("    using FPermutationDomain = TShaderPermutationDomain<"));
        let ci4: i32 = 0;
        let first_b: bool = true;
        while ci4 < c.m_co_len {
            let k4 = c.consts[c.m_co_off + ci4];
            if k4.ty == 3 {
                if true {
                    if !first_b {
                        buf_push_lit(out, STR_PTR(", "), STR_LEN(", "));
                    };
                    first_b = false;
                    buf_push_byte(out, 70);
                    out_span(c, out, k4.name_off, k4.name_len);
                    buf_push_lit(out, STR_PTR("Dim"), STR_LEN("Dim"));
                };
            };
            ci4 = ci4 + 1;
        }
        buf_push_lit(out, STR_PTR(">;\n"), STR_LEN(">;\n"));
    };
    buf_push_lit(out, STR_PTR("};\nIMPLEMENT_GLOBAL_SHADER(FMergedShaderPS, \"/Plugin/SLASL/Private/Merged.usf\", \"MergedPS\", SF_Pixel);\n"), STR_LEN("};\nIMPLEMENT_GLOBAL_SHADER(FMergedShaderPS, \"/Plugin/SLASL/Private/Merged.usf\", \"MergedPS\", SF_Pixel);\n"));
}


// TEMPORARY stubs — replaced chunk by chunk as each target lands.
// They fail loudly; nothing silently degrades.
fn run_target_wgsl(c: &Ctx, dir: &Buf, count: &i32) -> bool {
    if wgsl_bool_field(c) {
        let msg = buf_new();
        buf_push_lit(&msg, STR_PTR("slasl: link error: "), STR_LEN("slasl: link error: "));
        buf_push_span(&msg, c.err.data as ptr, c.err.len);
        buf_push_lit(&msg, STR_PTR("\n"), STR_LEN("\n"));
        eprint(&msg);
        return false;
    };
    let b = buf_new();
    emit_wgsl(c, &b);
    if !emit_file(c, dir, STR_PTR("merged.wgsl"), STR_LEN("merged.wgsl"), &b, count) { return false; };
    let b2 = buf_new();
    emit_manifest(c, &b2);
    if !emit_file(c, dir, STR_PTR("merged.reflection.json"), STR_LEN("merged.reflection.json"), &b2, count) { return false; };
    return true;
}

fn run_target_msl(c: &Ctx, dir: &Buf, count: &i32) -> bool {
    let b = buf_new();
    emit_msl(c, &b);
    if !emit_file(c, dir, STR_PTR("merged.msl"), STR_LEN("merged.msl"), &b, count) { return false; };
    return true;
}

fn run_target_unity(c: &Ctx, dir: &Buf, count: &i32) -> bool {
    let b = buf_new();
    emit_unity(c, &b);
    if !emit_file(c, dir, STR_PTR("merged.shader"), STR_LEN("merged.shader"), &b, count) { return false; };
    return true;
}

fn run_target_blender(c: &Ctx, dir: &Buf, count: &i32) -> bool {
    let b = buf_new();
    emit_blender(c, &b);
    if !emit_file(c, dir, STR_PTR("merged.glsl"), STR_LEN("merged.glsl"), &b, count) { return false; };
    let b2 = buf_new();
    emit_blender_info(c, &b2);
    if !emit_file(c, dir, STR_PTR("merged_info.py"), STR_LEN("merged_info.py"), &b2, count) { return false; };
    return true;
}

fn run_target_unreal(c: &Ctx, dir: &Buf, count: &i32) -> bool {
    let b = buf_new();
    emit_unreal_usf(c, &b);
    if !emit_file(c, dir, STR_PTR("merged.usf"), STR_LEN("merged.usf"), &b, count) { return false; };
    let b2 = buf_new();
    emit_unreal_ush(c, &b2);
    if !emit_file(c, dir, STR_PTR("merged.ush"), STR_LEN("merged.ush"), &b2, count) { return false; };
    let b3 = buf_new();
    emit_unreal_glue(c, &b3);
    if !emit_file(c, dir, STR_PTR("merged_glue.cpp"), STR_LEN("merged_glue.cpp"), &b3, count) { return false; };
    return true;
}
