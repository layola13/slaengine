{
  "target": "webgpu",
  "entries": [
    {"name": "vertex_main", "stage": "vertex", "uses": [{"group": 0, "binding": 0, "name": "Camera", "kind": "uniform"}]},
    {"name": "fragment_main", "stage": "fragment", "uses": [{"group": 1, "binding": 0, "name": "Params", "kind": "uniform"}, {"group": 1, "binding": 1, "name": "tex", "kind": "texture"}, {"group": 1, "binding": 2, "name": "tex_sampler", "kind": "sampler"}]}],
  "buffers": [{"group": 0, "binding": 0, "name": "Camera", "size": 64, "fields": [{"name": "view_proj", "type": "mat4", "offset": 0, "size": 64}]}, {"group": 1, "binding": 0, "name": "Params", "size": 32, "fields": [{"name": "base_color", "type": "vec4", "offset": 0, "size": 16}, {"name": "tint", "type": "vec4", "offset": 16, "size": 16}]}],
  "textures": [{"group": 1, "binding": 1, "name": "tex", "kind": "texture_2d", "sampler_binding": 2}],
  "samplers": [{"group": 1, "binding": 2, "name": "tex_sampler", "for": "tex"}],
  "overrides": [{"name": "USE_TINT", "id": 0, "type": "bool", "default": true, "required": false}],
  "inputs": [{"location": 0, "name": "position", "type": "vec3"}, {"location": 1, "name": "uv", "type": "vec2"}],
  "varyings": [{"location": 0, "name": "v_uv", "type": "vec2"}],
  "outputs": [{"location": 0, "name": "frag_color", "type": "vec4"}]
}
