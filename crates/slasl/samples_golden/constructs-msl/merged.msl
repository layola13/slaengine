#include <metal_stdlib>
using namespace metal;

struct VertexIn {
    float3 position [[attribute(0)]];
    float3 normal [[attribute(1)]];
};

struct VertexOut {
    float4 position [[position]];
    float3 v_normal;
};

float4 slasl_probe_sphere(texture2d<float> env, sampler env_sampler, float3 dir)
{
    float3 d = normalize(dir);
    float2 uv = float2(atan2(d.z, d.x) * 0.15915494 + 0.5, acos(clamp(d.y, -1.0, 1.0)) * 0.31830989);
    return env.sample(env_sampler, uv);
}

float4 slasl_probe_volume(texture2d<float> env, sampler env_sampler, float3 dir)
{
    float3 d = normalize(dir);
    float2 uv = float2(atan2(d.z, d.x) * 0.15915494 + 0.5, acos(clamp(d.y, -1.0, 1.0)) * 0.31830989);
    return env.sample(env_sampler, uv);
}

vertex VertexOut vertex_main(VertexIn input [[stage_in]])
{
    VertexOut output;
    output.v_normal = input.normal;
    output.position = float4(input.position, 1.0);
    return output;
}

fragment float4 fragment_main(VertexOut input [[stage_in]],
    texture2d<float> env [[texture(0)]],
    sampler env_sampler [[sampler(0)]],
    texture2d<float> irr [[texture(1)]],
    sampler irr_sampler [[sampler(1)]])
{
    float4 frag_color;
    frag_color = ((slasl_probe_sphere(env, env_sampler, input.v_normal) * 0.7) + (slasl_probe_volume(irr, irr_sampler, input.v_normal) * 0.3));
    return frag_color;
}
