#include <metal_stdlib>
using namespace metal;

struct Params {
    float4 tint2;
};

struct VertexIn {
    float3 position [[attribute(0)]];
};

struct VertexOut {
    float4 position [[position]];
    float v_s;
    float v_t;
};

vertex VertexOut vertex_main(VertexIn input [[stage_in]],
    constant Params& params [[buffer(0)]])
{
    VertexOut output;
    output.v_s = 2.0;
    output.v_t = (2.0 * 3.0);
    output.position = float4((input.position * 2.0), 1.0);
    return output;
}

fragment float4 fragment_main(VertexOut input [[stage_in]],
    constant Params& params [[buffer(0)]])
{
    float4 frag_color;
    frag_color = (params.tint2 * (input.v_s + input.v_t));
    return frag_color;
}
