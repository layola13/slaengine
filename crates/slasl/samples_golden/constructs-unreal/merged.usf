float4 slasl_probe_sphere(Texture2D env, SamplerState env_sampler, float3 dir)
{
    float3 d = normalize(dir);
    float2 uv = float2(atan2(d.z, d.x) * 0.15915494 + 0.5, acos(clamp(d.y, -1.0, 1.0)) * 0.31830989);
    return env.Sample(env_sampler, uv);
}

float3 slasl_agx(float3 color)
{
    float3 c = max(color, float3(0.0001, 0.0001, 0.0001));
    float3 x = clamp((log2(c) + 6.0) / 12.0, 0.0, 1.0);
    float3 xp = pow(x, float3(2.4, 2.4, 2.4));
    float3 nxp = pow(float3(1.0, 1.0, 1.0) - x, float3(2.4, 2.4, 2.4));
    float3 y = xp / (xp + nxp);
    float lum = dot(y, float3(0.2126, 0.7152, 0.0722));
    float3 outc = lerp(float3(lum, lum, lum), y, 1.0 - 0.4 * lum * lum);
    return clamp(outc, 0.0, 1.0);
}

FMergedVertexOut MergedVS(FMergedVertexIn input)
{
    FMergedVertexOut output;
