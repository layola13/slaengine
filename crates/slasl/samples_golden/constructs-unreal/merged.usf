    output.position = float4(input.position, 1.0);
    return output;
}

float4 MergedPS(FMergedVertexOut input) : SV_Target
{
    float4 frag_color;
    frag_color = float4(slasl_agx(slasl_probe_sphere(env, envSampler, input.v_normal).rgb), 1.0);
