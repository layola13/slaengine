#include <metal_stdlib>
using namespace metal;

struct Camera {
    float4x4 view_proj;
};

struct Params {
    float4 base_color;
    float4 tint;
};

struct VertexIn {
    float3 position [[attribute(0)]];
    float2 uv [[attribute(1)]];
};

struct VertexOut {
    float4 position [[position]];
    float2 v_uv;
};

vertex VertexOut vertex_main(VertexIn input [[stage_in]],
    constant Camera& Camera [[buffer(0)]],
    constant Params& params [[buffer(1)]])
{
    VertexOut output;
    output.v_uv = input.uv;
    output.position = (Camera.view_proj * float4(input.position, 1.0));
    return output;
}

fragment float4 fragment_main(VertexOut input [[stage_in]],
    constant Camera& Camera [[buffer(0)]],
    constant Params& params [[buffer(1)]],
    texture2d<float> tex [[texture(0)]],
    sampler tex_sampler [[sampler(0)]])
{
    float4 frag_color;
    float4 tint_boost;
    float4 tint_pre;
    tint_boost = (params.tint * 0.5);
    tint_pre = (tint_boost + params.tint);
    frag_color = (tex.sample(tex_sampler, input.v_uv) * params.base_color);
    frag_color = (frag_color * tint_pre);
    return frag_color;
}
