    let w0 = table_erased_relationship_test_world_new();
    let (w1, kind) = table_erased_relationship_world_register_many<TableErasedTime, TableErasedEvent>(w0, true, false);
    let (w2, root) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(w1);
    let (w3, child) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    let w4 = table_erased_relationship_world_set_related<TableErasedTime, TableErasedEvent>(w3, kind.id, child, root);
    let w5 = TableErasedRelationshipWorld<TableErasedTime, TableErasedEvent> { table: table_erased_world_write_message<TableErasedTime, TableErasedEvent>(w4.table, TableErasedEvent { amount: 5 }), relationships: w4.relationships };
    let w6 = TableErasedRelationshipWorld<TableErasedTime, TableErasedEvent> { table: table_erased_world_write_message<TableErasedTime, TableErasedEvent>(w5.table, TableErasedEvent { amount: 7 }), relationships: w5.relationships };
    let (w7, reader1) = table_erased_relationship_run_message_mutator_system<TableErasedTime, TableErasedEvent>(w6, message_reader_new(), table_erased_relationship_param_message_mutator_system);
    if reader1.cursor != 3 { panic(14934); };
    if table_erased_relationship_world_source_count<TableErasedTime, TableErasedEvent>(w7, kind.id, root) != 1 { panic(14935); };
    if entity_eq(table_erased_relationship_world_related<TableErasedTime, TableErasedEvent>(w7, kind.id, child), root) != true { panic(14936); };

    let check0 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, message_reader_new(), table_erased_event_default());
    let check1 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check0.reader, table_erased_event_default());
    let check2 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check1.reader, table_erased_event_default());
    let check3 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check2.reader, table_erased_event_default());
    let check4 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check3.reader, table_erased_event_default());
    let check5 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check4.reader, table_erased_event_default());
    let check6 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, check5.reader, table_erased_event_default());
    if check0.value.amount != 305 { panic(14937); };
    if check1.value.amount != 307 { panic(14938); };
    if check2.value.amount != 306 { panic(14939); };
    if check3.value.amount != 13 { panic(14940); };
    if check4.value.amount != 15 { panic(14941); };
    if check5.value.amount != 17 { panic(14942); };
    if check6.value.amount != 0 { panic(14943); };
    if message_id_typed_value<TableErasedEvent>(table_erased_relationship_world_current_update_message_id_at<TableErasedTime, TableErasedEvent>(w7, 6, table_erased_event_default()).id) != 6 { panic(14944); };

    let next = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w7.table, reader1, table_erased_event_default());
    if next.has_value != true { panic(14941); };
    if next.value.amount != 13 { panic(14942); };
