    if table_erased_world_get_resource<TableErasedTime, TableErasedEvent>(entity_single.table).tick != 500 + only.id { panic(15000); };
    let entity_optional = table_erased_relationship_run_entity_optional_single_resource_system<TableErasedTime, TableErasedEvent>(entity_w1, table_erased_relationship_entity_default, table_erased_relationship_entity_optional_single_system);
