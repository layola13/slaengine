fn table_erased_relationship_query_optional_single<I>(query: Query<I>, default_item: fn() -> I) -> TableErasedOptional<I> {
    let cnt = len(query.items);
    if cnt == 0 { return TableErasedOptional<I> { has_value: false, value: default_item() }; };
    if cnt > 1 { panic(14990); };
    return TableErasedOptional<I> { has_value: true, value: query.items[0] };
}

fn table_erased_relationship_query_populated<I>(query: Query<I>) -> Query<I> {
    if len(query.items) == 0 { panic(14991); };
    return query;
}

