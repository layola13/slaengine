    let w8 = table_erased_relationship_world_set_related<TableErasedTime, TableErasedEvent>(w7, kind.id, child, root);
    let w9 = TableErasedRelationshipWorld<TableErasedTime, TableErasedEvent> { table: table_erased_world_write_message<TableErasedTime, TableErasedEvent>(w8.table, TableErasedEvent { amount: 7 }), relationships: w8.relationships };
    let before = w9.table.registry.change_tick;
    let (w10, reader1) = table_erased_relationship_run_pair_mut_message_reader_commands_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w9, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, message_reader_new(), table_erased_event_default(), table_erased_relationship_pair_mut_message_reader_commands_system);
    if reader1.cursor != 1 { panic(12670); };
    if table_erased_relationship_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w10, child, position.id, TABLE_ERASED_POS_TYPE).x != 18 { panic(12671); };
    if table_erased_relationship_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w10, child, position.id, TABLE_ERASED_POS_TYPE).y != 7 { panic(12672); };
