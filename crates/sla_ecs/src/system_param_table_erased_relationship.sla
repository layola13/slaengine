@test "table erased relationship pair mut commands param writes query before commands apply"() {
    let w0 = table_erased_relationship_test_world_new();
    let (w1, position) = table_erased_relationship_world_register_table<TableErasedTime, TableErasedEvent>(w0, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w2, velocity) = table_erased_relationship_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w3, kind) = table_erased_relationship_world_register_many<TableErasedTime, TableErasedEvent>(w2, true, false);
    let (w4, root) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(w3);
    let (w5, child) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(w4);
    let w6 = table_erased_relationship_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w5, child, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 8, y: 0 });
    let w7 = table_erased_relationship_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w6, child, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 3, y: 0 });
    let w8 = table_erased_relationship_world_set_related<TableErasedTime, TableErasedEvent>(w7, kind.id, child, root);
    let before = w8.table.registry.change_tick;
    let w9 = table_erased_relationship_run_pair_mut_commands_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w8, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, table_erased_relationship_pair_mut_commands_system);
    if table_erased_relationship_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w9, child, position.id, TABLE_ERASED_POS_TYPE).x != 11 { panic(12508); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w9.table, child, position.id, before - 1) != true { panic(12509); };
    if table_erased_relationship_world_source_count<TableErasedTime, TableErasedEvent>(w9, kind.id, root) != 2 { panic(12527); };
    if entity_eq(table_erased_relationship_world_related<TableErasedTime, TableErasedEvent>(w9, kind.id, child), root) != true { panic(12528); };
    let query = table_erased_world_query_pair_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w9.table, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE);
    if len(query.items) != 2 { panic(12529); };
    let found_spawned = false;
    let spawned = entity_placeholder();
    let i: i64 = 0;
    let cnt = len(query.items) as i64;
    while i < cnt {
        if query.items[i].first.x == 88 {
            found_spawned = true;
            spawned = query.items[i].entity;
            if query.items[i].second.x != 7 { panic(12530); };
        };
        i = i + 1;
    }
    if found_spawned != true { panic(12531); };
    if entity_eq(table_erased_relationship_world_related<TableErasedTime, TableErasedEvent>(w9, kind.id, spawned), root) != true { panic(12532); };
    let spawned_by = table_erased_world_spawned_by<TableErasedTime, TableErasedEvent>(w9.table, spawned);
    if spawned_by.file_id != 103 { panic(12533); };
}

@test "table erased relationship pair mut message reader commands param writes all"() {
    let w0 = table_erased_relationship_test_world_new();
