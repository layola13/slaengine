fn table_erased_relationship_apply_pair_mut_updates<A, B, R, M>(world: TableErasedRelationshipWorld<R, M>, updated: Query<TableErasedPairMut<A, B>>) -> TableErasedRelationshipWorld<R, M> {
    let i: i64 = 0;
    let cnt = len(updated.items) as i64;
    while i < cnt {
        let item = updated.items[i];
        world.table = table_erased_world_pair_write_first<A, B, R, M>(world.table, item, item.first.value);
        i = i + 1;
    }
    return world;
}

fn table_erased_relationship_item_query_resource_count<I, R>(param: TableErasedRelationshipItemQueryResourceParam<I, R>) -> i64 {
    return len(param.query.items) as i64;
}

fn table_erased_relationship_query_resource_count<R>(param: TableErasedRelationshipQueryResourceParam<R>) -> i64 {
    return len(param.related.items) as i64;
}

fn table_erased_relationship_query_resource_is_empty<R>(param: TableErasedRelationshipQueryResourceParam<R>) -> bool {
    return len(param.related.items) == 0;
}

fn table_erased_relationship_query_resource_contains<R>(param: TableErasedRelationshipQueryResourceParam<R>, entity: Entity) -> bool {
    let i: i64 = 0;
    let cnt = len(param.related.items) as i64;
    while i < cnt {
        if param.related.items[i] == entity { return true; };
        i = i + 1;
    }
    return false;
}

fn table_erased_relationship_item_query_resource_is_empty<I, R>(param: TableErasedRelationshipItemQueryResourceParam<I, R>) -> bool {
    return table_erased_query_is_empty<I>(param.query);
}

