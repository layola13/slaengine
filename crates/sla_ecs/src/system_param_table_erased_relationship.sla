    if len(query.items) != 2 { panic(12606); };
    let found_spawned = false;
    let spawned = entity_placeholder();
    let i: i64 = 0;
    let cnt = len(query.items) as i64;
    while i < cnt {
        if query.items[i].first.x == 41 {
            found_spawned = true;
            spawned = query.items[i].entity;
            if query.items[i].second.x != 6 { panic(12607); };
        };
        i = i + 1;
    }
    if found_spawned != true { panic(12608); };
    if entity_eq(table_erased_relationship_world_related<TableErasedTime, TableErasedEvent>(w10, kind.id, spawned), root) != true { panic(12609); };
    let spawned_by = table_erased_world_spawned_by<TableErasedTime, TableErasedEvent>(w10.table, spawned);
    if spawned_by.file_id != 115 { panic(12610); };
}

