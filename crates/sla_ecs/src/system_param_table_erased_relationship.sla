    if len(query.items) != 2 { panic(12676); };
    let found_spawned = false;
    let spawned = entity_placeholder();
    let i: i64 = 0;
    let cnt = len(query.items) as i64;
    while i < cnt {
        if query.items[i].first.x == 93 {
            found_spawned = true;
            spawned = query.items[i].entity;
            if query.items[i].first.y != 7 { panic(12677); };
            if query.items[i].second.x != 6 { panic(12678); };
        };
        i = i + 1;
    }
    if found_spawned != true { panic(12679); };
    if entity_eq(table_erased_relationship_world_related<TableErasedTime, TableErasedEvent>(w10, kind.id, spawned), root) != true { panic(12680); };
    let spawned_by = table_erased_world_spawned_by<TableErasedTime, TableErasedEvent>(w10.table, spawned);
    if spawned_by.file_id != 132 { panic(12681); };
