    let before = w9.table.registry.change_tick;
    let w10 = table_erased_relationship_run_pair_mut_res_mut_commands_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w9, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, table_erased_relationship_pair_mut_res_mut_commands_system);
    if table_erased_world_get_resource<TableErasedTime, TableErasedEvent>(w10.table).tick != 41 { panic(12600); };
    if table_erased_relationship_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w10, child, position.id, TABLE_ERASED_POS_TYPE).x != 52 { panic(12601); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w10.table, child, position.id, before - 1) != true { panic(12602); };
    if table_erased_world_resource_changed_since<TableErasedTime, TableErasedEvent>(w10.table, before - 1) != true { panic(12603); };
