    if reader1.cursor != 3 { panic(14830); };

    let check0 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, message_reader_new(), table_erased_event_default());
    let check1 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check0.reader, table_erased_event_default());
    let check2 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check1.reader, table_erased_event_default());
    let check3 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check2.reader, table_erased_event_default());
    let check4 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check3.reader, table_erased_event_default());
    let check5 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check4.reader, table_erased_event_default());
    let check6 = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, check5.reader, table_erased_event_default());
    if check0.value.amount != 205 { panic(14831); };
    if check1.value.amount != 207 { panic(14832); };
    if check2.value.amount != 204 { panic(14833); };
    if check3.value.amount != 12 { panic(14834); };
    if check4.value.amount != 14 { panic(14838); };
    if check5.value.amount != 16 { panic(14839); };
    if check6.value.amount != 0 { panic(14840); };
    if message_id_typed_value<TableErasedEvent>(table_erased_observer_world_current_update_message_id_at<TableErasedTime, TableErasedEvent>(w3, 6, table_erased_event_default()).id) != 6 { panic(14841); };

    let next = table_erased_world_read_message<TableErasedTime, TableErasedEvent>(w3.table, reader1, table_erased_event_default());
    if next.has_value != true { panic(14835); };
    if next.value.amount != 12 { panic(14836); };
    if w3.observers.trigger_count != w2.observers.trigger_count { panic(14837); };
}

