    let w0 = table_erased_observer_test_world_new();
    let w1 = TableErasedObserverWorld<TableErasedTime, TableErasedEvent> { table: table_erased_world_write_message<TableErasedTime, TableErasedEvent>(w0.table, TableErasedEvent { amount: 5 }), observers: w0.observers };
