    let w14 = table_erased_observer_world_insert<TableErasedMarker, TableErasedTime, TableErasedEvent>(w13, e3, marker.id, TABLE_ERASED_MARKER_TYPE, TableErasedMarker { value: 7 });
    let w15 = table_erased_observer_world_insert<TableErasedTag, TableErasedTime, TableErasedEvent>(w14, e3, tag.id, TABLE_ERASED_TAG_TYPE, TableErasedTag { value: 8 });
    let before = w15.table.registry.change_tick;
