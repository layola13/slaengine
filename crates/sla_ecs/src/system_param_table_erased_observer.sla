fn table_erased_observer_param_direct_event_system(param: TableErasedObserverEventTriggerParam<TableErasedTime, TableErasedEvent>) -> TableErasedObserverEventTriggerParam<TableErasedTime, TableErasedEvent> {
    if len(param.world.table.archetypes[0].entity_ids) <= 0 { return param; };
    let entity_id = param.world.table.archetypes[0].entity_ids[0];
    let entity = entity_new(entity_id, param.world.table.registry.entities.generations[entity_id]);
    return table_erased_observer_event_trigger_param_trigger_entity<TableErasedObserverPing, TableErasedTime, TableErasedEvent>(param, entity, TableErasedObserverPing::event_type_id(), ecs_box_drop<TableErasedObserverPing>, TableErasedObserverPing { amount: 9 });
}

@test "table erased observer pair mut param writes back"() {
    let w0 = table_erased_observer_test_world_new();
    let (w1, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w0, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w2, velocity) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w3, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    let w4 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w3, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 8, y: 0 });
    let w5 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w4, entity, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 4, y: 0 });
    let before = w5.table.registry.change_tick;
    let w6 = table_erased_observer_run_pair_mut_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w5, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, table_erased_observer_param_movement_system);
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w6, entity, position.id, TABLE_ERASED_POS_TYPE).x != 12 { panic(14400); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w6.table, entity, position.id, before - 1) != true { panic(14401); };
}

@test "table erased observer ParamSet permits conflicting pair read and pair mut"() {
    let w0 = table_erased_observer_test_world_new();
    let (w1, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w0, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w2, velocity) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w3, e1) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    let (w4, e2) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w3);
    let w5 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, e1, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 6, y: 0 });
    let w6 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w5, e1, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 2, y: 0 });
    let w7 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w6, e2, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 21, y: 0 });
    let w8 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w7, e2, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 4, y: 0 });
    let before = w8.table.registry.change_tick;
    let w9 = table_erased_observer_run_pair_mut_readonly_pair_param_set_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w8, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, table_erased_observer_pair_mut_readonly_pair_param_set_system);
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w9, e1, position.id, TABLE_ERASED_POS_TYPE).x != 35 { panic(14402); };
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w9, e2, position.id, TABLE_ERASED_POS_TYPE).x != 52 { panic(14403); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w9.table, e2, position.id, before - 1) != true { panic(14404); };
    if table_erased_world_query_pair_count_auto<TableErasedTime, TableErasedEvent>(w9.table, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE) != 2 { panic(14405); };
}

