fn table_erased_observer_message_reader_writer_param_set<M>(read: MessageRead<M>, writer: MessageWriter<M>) -> TableErasedObserverMessageReaderWriterParamSet<M> {
    return TableErasedObserverMessageReaderWriterParamSet<M> { read: read, writer: writer };
}

fn table_erased_observer_message_mutator_param<M>(messages: Messages<M>, reader: MessageReader) -> TableErasedObserverMessageMutatorParam<M> {
    return TableErasedObserverMessageMutatorParam<M> { messages: messages, reader: reader };
}

fn table_erased_observer_message_mutator_len<M>(param: TableErasedObserverMessageMutatorParam<M>) -> i64 {
    return messages_mutator_len<M>(param.messages, param.reader);
}

fn table_erased_observer_message_mutator_read_next<M>(param: TableErasedObserverMessageMutatorParam<M>, default_value: M) -> (TableErasedObserverMessageMutatorParam<M>, MessageMutRead<M>) {
    let read = messages_mutator_read_next<M>(param.messages, param.reader, default_value);
    param.reader = read.reader;
    return (param, read);
}

fn table_erased_observer_message_mutator_write_back<M>(param: TableErasedObserverMessageMutatorParam<M>, item: MessageMut<M>) -> TableErasedObserverMessageMutatorParam<M> {
    param.messages = messages_mutator_write_back<M>(param.messages, item);
    return param;
}

fn table_erased_observer_message_mutator_write<M>(param: TableErasedObserverMessageMutatorParam<M>, value: M) -> TableErasedObserverMessageMutatorParam<M> {
    param.messages = messages_mutator_write<M>(param.messages, value);
    return param;
}

fn table_erased_observer_message_mutator_write_with_message_id<M>(param: TableErasedObserverMessageMutatorParam<M>, value: M) -> (TableErasedObserverMessageMutatorParam<M>, MessageId<M>) {
    let written = messages_mutator_write_with_message_id<M>(param.messages, value);
    param.messages = written.messages;
    return (param, written.id);
}

fn table_erased_observer_message_mutator_write_batch_with_message_id<M>(param: TableErasedObserverMessageMutatorParam<M>, writer: MessageWriter<M>) -> (TableErasedObserverMessageMutatorParam<M>, MessageBatchWriteWithMessageId<M>) {
    let written = messages_mutator_write_batch_with_message_id<M>(param.messages, writer);
    param.messages = written.messages;
    return (param, written);
}

fn table_erased_observer_message_mutator_write_default_with_message_id<M>(param: TableErasedObserverMessageMutatorParam<M>, default_value: M) -> (TableErasedObserverMessageMutatorParam<M>, MessageId<M>) {
    let written = messages_mutator_write_default_with_message_id<M>(param.messages, default_value);
    param.messages = written.messages;
    return (param, written.id);
}

