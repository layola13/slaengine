    let w10 = table_erased_observer_world_insert<TableErasedMarker, TableErasedTime, TableErasedEvent>(w9, e1, marker.id, TABLE_ERASED_MARKER_TYPE, TableErasedMarker { value: 10 });
    let w11 = table_erased_observer_world_insert<TableErasedTag, TableErasedTime, TableErasedEvent>(w10, e1, tag.id, TABLE_ERASED_TAG_TYPE, TableErasedTag { value: 3 });
    let w12 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w11, e2, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 20, y: 0 });
