@test "table erased observer pair mut commands param writes query before commands apply"() {
    let w0 = table_erased_observer_test_world_new();
    let (w1, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w0, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w2, velocity) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w3, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    let w4 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w3, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 8, y: 0 });
    let w5 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w4, entity, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 3, y: 0 });
    let before = w5.table.registry.change_tick;
    let w6 = table_erased_observer_run_pair_mut_commands_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w5, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, table_erased_observer_pair_mut_commands_system);
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w6, entity, position.id, TABLE_ERASED_POS_TYPE).x != 11 { panic(14406); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w6.table, entity, position.id, before - 1) != true { panic(14407); };
    let query = table_erased_world_query_pair_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w6.table, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE);
    if len(query.items) != 2 { panic(14408); };
    let found_spawned = false;
    let spawned = entity_placeholder();
    let i: i64 = 0;
    let cnt = len(query.items) as i64;
    while i < cnt {
        if query.items[i].first.x == 77 {
            found_spawned = true;
            spawned = query.items[i].entity;
            if query.items[i].second.x != 6 { panic(14409); };
        };
        i = i + 1;
    }
    if found_spawned != true { panic(14419); };
    let spawned_by = table_erased_world_spawned_by<TableErasedTime, TableErasedEvent>(w6.table, spawned);
    if spawned_by.file_id != 102 { panic(14428); };
}

@test "table erased observer pair mut message reader commands param writes all"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let (w2, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w3, velocity) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w2, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w4, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w3);
    let w5 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 8, y: 0 });
    let w6 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w5, entity, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 3, y: 0 });
    let w7 = TableErasedObserverWorld<TableErasedTime, TableErasedEvent> { table: table_erased_world_write_message<TableErasedTime, TableErasedEvent>(w6.table, TableErasedEvent { amount: 6 }), observers: w6.observers };
    let before = w7.table.registry.change_tick;
    let trigger_before = w7.observers.trigger_count;
    let (w8, reader1) = table_erased_observer_run_pair_mut_message_reader_commands_system_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w7, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, message_reader_new(), table_erased_event_default(), table_erased_observer_pair_mut_message_reader_commands_system);
    if reader1.cursor != 1 { panic(14550); };
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w8, entity, position.id, TABLE_ERASED_POS_TYPE).x != 17 { panic(14551); };
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w8, entity, position.id, TABLE_ERASED_POS_TYPE).y != 6 { panic(14552); };
    if table_erased_world_changed_since<TableErasedTime, TableErasedEvent>(w8.table, entity, position.id, before - 1) != true { panic(14553); };
    let query = table_erased_world_query_pair_auto<TableErasedPos, TableErasedVel, TableErasedTime, TableErasedEvent>(w8.table, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE);
    if len(query.items) != 2 { panic(14554); };
    let spawned = query.items[1].entity;
    if query.items[1].first.x != 89 { panic(14555); };
    if query.items[1].first.y != 6 { panic(14556); };
    if query.items[1].second.x != 4 { panic(14557); };
    if w8.observers.trigger_count <= trigger_before { panic(14558); };
    let spawned_by = table_erased_world_spawned_by<TableErasedTime, TableErasedEvent>(w8.table, spawned);
    if spawned_by.file_id != 130 { panic(14559); };
}

