// Isolated mutable parallel runner (Bevy multi-threaded executor parity).
//
// Lives in its own module so the `Arc<*World>` + `thread::spawn` codegen does
// not pay for the full ecs_world transitive import chain at the call site.
// Mirrors Bevy's disjoint mutable parallel execution: two systems with
// non-conflicting access run on threads sharing one world by raw pointer.
@import "world_table_erased.sla"
@import "table_erased_access.sla"
@import "executor_multi_threaded.sla"
@import "thread_executor.sla"
@import "sa_std/core/arc.sa"
@import "sa_std/thread.sa"

struct EcsParallelReadyBatchRunResult {
    plan: EcsExecutorRunPlan,
    thread_sum: i32,
    ran_count: i64,
    skipped_count: i64,
    used_threads: bool,
    mismatch: bool,
}

struct EcsParallelCatalogReadySelection {
    plan: EcsExecutorRunPlan,
    batch: EcsExecutorReadyBatch,
    skipped_count: i64,
    mismatch: bool,
}

struct EcsParallelFnCatalog<R, M> {
    system_indexes: Vec<i64>,
    runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32>,
    accesses: Vec<TableErasedSystemAccess>,
}

struct EcsParallelTaskPool {
    worker_count: i64,
    max_batch_width: i64,
}

struct EcsParallelTaskPoolLifecycleWorkerResult {
    spawn_value: i32,
    destroy_value: i32,
}

struct EcsParallelTaskPoolLifecycleResult {
    worker_count: i64,
    spawn_count: i64,
    destroy_count: i64,
    spawn_sum: i32,
    destroy_sum: i32,
    used_threads: bool,
    mismatch: bool,
}

struct EcsParallelMainThreadExecutor {
    executor: EcsThreadExecutor,
}

struct EcsParallelScopeOptions {
    tick_task_pool_executor: bool,
    use_external_executor: bool,
    external_executor_is_scope: bool,
}

struct EcsParallelScopeRunResult {
    thread_sum: i32,
    result_values: Vec<i32>,
    result_rounds: Vec<i64>,
    result_lanes: Vec<i64>,
    ran_count: i64,
    local_count: i64,
    external_count: i64,
    wave_count: i64,
    child_scope_count: i64,
    child_scope_pool_count: i64,
    child_scope_local_count: i64,
    child_scope_external_count: i64,
    child_scope_wave_count: i64,
    child_scope_result_wave_count: i64,
    child_scope_result_count: i64,
    generated_task_count: i64,
    recursive_depth: i64,
    used_threads: bool,
    ticked_pool_executor: bool,
    ticked_scope_executor: bool,
    ticked_external_executor: bool,
    mismatch: bool,
}

struct EcsParallelScopedTaskSet<R, M> {
    runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32>,
    on_scope_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32>,
    external_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32>,
    child_scope_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>>,
    child_scope_run_lanes: Vec<i64>,
    child_scope_result_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32>,
    child_scope_result_child_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>>,
    child_scope_result_lanes: Vec<i64>,
    run_order_positions: Vec<i64>,
    on_scope_order_positions: Vec<i64>,
    external_order_positions: Vec<i64>,
}

fn ecs_parallel_ready_batch_run_result(plan: EcsExecutorRunPlan, thread_sum: i32, ran_count: i64, skipped_count: i64, used_threads: bool, mismatch: bool) -> EcsParallelReadyBatchRunResult {
    return EcsParallelReadyBatchRunResult { plan: plan, thread_sum: thread_sum, ran_count: ran_count, skipped_count: skipped_count, used_threads: used_threads, mismatch: mismatch };
}

fn ecs_parallel_catalog_ready_selection(plan: EcsExecutorRunPlan, batch: EcsExecutorReadyBatch, skipped_count: i64, mismatch: bool) -> EcsParallelCatalogReadySelection {
    return EcsParallelCatalogReadySelection { plan: plan, batch: batch, skipped_count: skipped_count, mismatch: mismatch };
}

fn ecs_parallel_task_pool_lifecycle_worker_result(spawn_value: i32, destroy_value: i32) -> EcsParallelTaskPoolLifecycleWorkerResult {
    return EcsParallelTaskPoolLifecycleWorkerResult { spawn_value: spawn_value, destroy_value: destroy_value };
}

fn ecs_parallel_task_pool_lifecycle_result(worker_count: i64, spawn_count: i64, destroy_count: i64, spawn_sum: i32, destroy_sum: i32, used_threads: bool, mismatch: bool) -> EcsParallelTaskPoolLifecycleResult {
    return EcsParallelTaskPoolLifecycleResult { worker_count: worker_count, spawn_count: spawn_count, destroy_count: destroy_count, spawn_sum: spawn_sum, destroy_sum: destroy_sum, used_threads: used_threads, mismatch: mismatch };
}

fn ecs_parallel_task_pool_lifecycle_worker_run(on_spawn: fn() -> i32, on_destroy: fn() -> i32) -> EcsParallelTaskPoolLifecycleWorkerResult {
    let spawn_value = on_spawn();
    let destroy_value = on_destroy();
    return ecs_parallel_task_pool_lifecycle_worker_result(spawn_value, destroy_value);
}

fn ecs_parallel_main_thread_executor_new(owner_thread_id: i64) -> EcsParallelMainThreadExecutor {
    return EcsParallelMainThreadExecutor { executor: ecs_thread_executor_new(owner_thread_id) };
}

fn ecs_parallel_main_thread_executor_new_with_id(owner_thread_id: i64, executor_id: i64) -> EcsParallelMainThreadExecutor {
    return EcsParallelMainThreadExecutor { executor: ecs_thread_executor_new_with_id(owner_thread_id, executor_id) };
}

fn ecs_parallel_main_thread_executor_default() -> EcsParallelMainThreadExecutor {
    return ecs_parallel_main_thread_executor_new(0);
}

fn ecs_parallel_main_thread_executor_owner_thread_id(main: EcsParallelMainThreadExecutor) -> i64 {
    return main.executor.owner_thread_id;
}

fn ecs_parallel_main_thread_executor_id(main: EcsParallelMainThreadExecutor) -> i64 {
    return main.executor.executor_id;
}

fn ecs_parallel_main_thread_executor_has_ticker(main: EcsParallelMainThreadExecutor, current_thread_id: i64) -> bool {
    let ticker = ecs_thread_executor_ticker(main.executor, current_thread_id);
    return ticker.has_ticker;
}

fn ecs_parallel_main_thread_executor_is_same_id(first: EcsParallelMainThreadExecutor, second: EcsParallelMainThreadExecutor) -> bool {
    return ecs_thread_executor_is_same_id(first.executor, second.executor);
}

fn ecs_parallel_scope_options_default() -> EcsParallelScopeOptions {
    return EcsParallelScopeOptions { tick_task_pool_executor: true, use_external_executor: false, external_executor_is_scope: true };
}

fn ecs_parallel_scope_options_with_executor(tick_task_pool_executor: bool, use_external_executor: bool) -> EcsParallelScopeOptions {
    return EcsParallelScopeOptions { tick_task_pool_executor: tick_task_pool_executor, use_external_executor: use_external_executor, external_executor_is_scope: use_external_executor != true };
}

fn ecs_parallel_scope_options_with_external_identity(tick_task_pool_executor: bool, use_external_executor: bool, external_executor_is_scope: bool) -> EcsParallelScopeOptions {
    return EcsParallelScopeOptions { tick_task_pool_executor: tick_task_pool_executor, use_external_executor: use_external_executor, external_executor_is_scope: external_executor_is_scope };
}

fn ecs_parallel_scope_options_with_main_thread_executor(main: EcsParallelMainThreadExecutor, current_thread_id: i64, scope_executor_id: i64, tick_task_pool_executor: bool) -> EcsParallelScopeOptions {
    let ticker = ecs_thread_executor_ticker(main.executor, current_thread_id);
    let same_scope = main.executor.executor_id == scope_executor_id;
    return EcsParallelScopeOptions { tick_task_pool_executor: tick_task_pool_executor, use_external_executor: ticker.has_ticker, external_executor_is_scope: same_scope };
}

fn ecs_parallel_scope_run_result(thread_sum: i32, ran_count: i64, local_count: i64, external_count: i64, wave_count: i64, used_threads: bool, mismatch: bool) -> EcsParallelScopeRunResult {
    let result_values: Vec<i32> = Vec::new();
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    return EcsParallelScopeRunResult { thread_sum: thread_sum, result_values: result_values, result_rounds: result_rounds, result_lanes: result_lanes, ran_count: ran_count, local_count: local_count, external_count: external_count, wave_count: wave_count, child_scope_count: 0, child_scope_pool_count: 0, child_scope_local_count: 0, child_scope_external_count: 0, child_scope_wave_count: 0, child_scope_result_wave_count: 0, child_scope_result_count: 0, generated_task_count: 0, recursive_depth: 0, used_threads: used_threads, ticked_pool_executor: used_threads, ticked_scope_executor: local_count > 0, ticked_external_executor: false, mismatch: mismatch };
}

fn ecs_parallel_scope_run_result_with_values(thread_sum: i32, result_values: Vec<i32>, ran_count: i64, local_count: i64, external_count: i64, wave_count: i64, used_threads: bool, mismatch: bool) -> EcsParallelScopeRunResult {
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let i: i64 = 0;
    while i < len(result_values) as i64 {
        result_rounds.push(0);
        result_lanes.push(0);
        i = i + 1;
    }
    return EcsParallelScopeRunResult { thread_sum: thread_sum, result_values: result_values, result_rounds: result_rounds, result_lanes: result_lanes, ran_count: ran_count, local_count: local_count, external_count: external_count, wave_count: wave_count, child_scope_count: 0, child_scope_pool_count: 0, child_scope_local_count: 0, child_scope_external_count: 0, child_scope_wave_count: 0, child_scope_result_wave_count: 0, child_scope_result_count: 0, generated_task_count: 0, recursive_depth: 0, used_threads: used_threads, ticked_pool_executor: used_threads, ticked_scope_executor: local_count > 0, ticked_external_executor: false, mismatch: mismatch };
}

fn ecs_parallel_scope_run_result_with_values_and_executor_flags(thread_sum: i32, result_values: Vec<i32>, ran_count: i64, local_count: i64, external_count: i64, wave_count: i64, used_threads: bool, ticked_pool_executor: bool, ticked_scope_executor: bool, ticked_external_executor: bool, mismatch: bool) -> EcsParallelScopeRunResult {
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let i: i64 = 0;
    while i < len(result_values) as i64 {
        result_rounds.push(0);
        result_lanes.push(0);
        i = i + 1;
    }
    return EcsParallelScopeRunResult { thread_sum: thread_sum, result_values: result_values, result_rounds: result_rounds, result_lanes: result_lanes, ran_count: ran_count, local_count: local_count, external_count: external_count, wave_count: wave_count, child_scope_count: 0, child_scope_pool_count: 0, child_scope_local_count: 0, child_scope_external_count: 0, child_scope_wave_count: 0, child_scope_result_wave_count: 0, child_scope_result_count: 0, generated_task_count: 0, recursive_depth: 0, used_threads: used_threads, ticked_pool_executor: ticked_pool_executor, ticked_scope_executor: ticked_scope_executor, ticked_external_executor: ticked_external_executor, mismatch: mismatch };
}

fn ecs_parallel_scope_run_result_with_metadata_and_executor_flags(thread_sum: i32, result_values: Vec<i32>, result_rounds: Vec<i64>, result_lanes: Vec<i64>, ran_count: i64, local_count: i64, external_count: i64, wave_count: i64, used_threads: bool, ticked_pool_executor: bool, ticked_scope_executor: bool, ticked_external_executor: bool, mismatch: bool) -> EcsParallelScopeRunResult {
    return EcsParallelScopeRunResult { thread_sum: thread_sum, result_values: result_values, result_rounds: result_rounds, result_lanes: result_lanes, ran_count: ran_count, local_count: local_count, external_count: external_count, wave_count: wave_count, child_scope_count: 0, child_scope_pool_count: 0, child_scope_local_count: 0, child_scope_external_count: 0, child_scope_wave_count: 0, child_scope_result_wave_count: 0, child_scope_result_count: 0, generated_task_count: 0, recursive_depth: 0, used_threads: used_threads, ticked_pool_executor: ticked_pool_executor, ticked_scope_executor: ticked_scope_executor, ticked_external_executor: ticked_external_executor, mismatch: mismatch };
}

fn ecs_parallel_scope_run_result_recursive(thread_sum: i32, result_values: Vec<i32>, result_rounds: Vec<i64>, result_lanes: Vec<i64>, ran_count: i64, local_count: i64, external_count: i64, wave_count: i64, child_scope_count: i64, child_scope_pool_count: i64, child_scope_local_count: i64, child_scope_external_count: i64, child_scope_wave_count: i64, child_scope_result_wave_count: i64, child_scope_result_count: i64, generated_task_count: i64, recursive_depth: i64, used_threads: bool, ticked_pool_executor: bool, ticked_scope_executor: bool, ticked_external_executor: bool, mismatch: bool) -> EcsParallelScopeRunResult {
    return EcsParallelScopeRunResult { thread_sum: thread_sum, result_values: result_values, result_rounds: result_rounds, result_lanes: result_lanes, ran_count: ran_count, local_count: local_count, external_count: external_count, wave_count: wave_count, child_scope_count: child_scope_count, child_scope_pool_count: child_scope_pool_count, child_scope_local_count: child_scope_local_count, child_scope_external_count: child_scope_external_count, child_scope_wave_count: child_scope_wave_count, child_scope_result_wave_count: child_scope_result_wave_count, child_scope_result_count: child_scope_result_count, generated_task_count: generated_task_count, recursive_depth: recursive_depth, used_threads: used_threads, ticked_pool_executor: ticked_pool_executor, ticked_scope_executor: ticked_scope_executor, ticked_external_executor: ticked_external_executor, mismatch: mismatch };
}

fn ecs_parallel_scope_run_result_len(result: EcsParallelScopeRunResult) -> i64 {
    return len(result.result_values) as i64;
}

fn ecs_parallel_scope_run_result_at(result: EcsParallelScopeRunResult, index: i64) -> i32 {
    return result.result_values[index];
}

fn ecs_parallel_scope_run_result_round_at(result: EcsParallelScopeRunResult, index: i64) -> i64 {
    return result.result_rounds[index];
}

fn ecs_parallel_scope_run_result_lane_at(result: EcsParallelScopeRunResult, index: i64) -> i64 {
    return result.result_lanes[index];
}

fn ecs_parallel_fn_catalog_new<R, M>() -> EcsParallelFnCatalog<R, M> {
    let system_indexes: Vec<i64> = Vec::new();
    let runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32> = Vec::new();
    let accesses: Vec<TableErasedSystemAccess> = Vec::new();
    return EcsParallelFnCatalog<R, M> { system_indexes: system_indexes, runs: runs, accesses: accesses };
}

fn ecs_parallel_fn_catalog_add<R, M>(catalog: EcsParallelFnCatalog<R, M>, system_index: i64, run: fn(Arc<*TableErasedWorld<R, M>>) -> i32, access: TableErasedSystemAccess) -> EcsParallelFnCatalog<R, M> {
    catalog.system_indexes.push(system_index);
    catalog.runs.push(run);
    catalog.accesses.push(access);
    return catalog;
}

fn ecs_parallel_fn_catalog_len<R, M>(catalog: EcsParallelFnCatalog<R, M>) -> i64 {
    return len(catalog.system_indexes) as i64;
}

fn ecs_parallel_fn_catalog_find_slot<R, M>(catalog: EcsParallelFnCatalog<R, M>, system_index: i64) -> i64 {
    let i: i64 = 0;
    let n = ecs_parallel_fn_catalog_len<R, M>(catalog);
    while i < n {
        if catalog.system_indexes[i] == system_index { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_parallel_scoped_task_set_new<R, M>() -> EcsParallelScopedTaskSet<R, M> {
    let runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32> = Vec::new();
    let on_scope_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32> = Vec::new();
    let external_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32> = Vec::new();
    let child_scope_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>> = Vec::new();
    let child_scope_run_lanes: Vec<i64> = Vec::new();
    let child_scope_result_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> i32> = Vec::new();
    let child_scope_result_child_runs: Vec<fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>> = Vec::new();
    let child_scope_result_lanes: Vec<i64> = Vec::new();
    let run_order_positions: Vec<i64> = Vec::new();
    let on_scope_order_positions: Vec<i64> = Vec::new();
    let external_order_positions: Vec<i64> = Vec::new();
    return EcsParallelScopedTaskSet<R, M> { runs: runs, on_scope_runs: on_scope_runs, external_runs: external_runs, child_scope_runs: child_scope_runs, child_scope_run_lanes: child_scope_run_lanes, child_scope_result_runs: child_scope_result_runs, child_scope_result_child_runs: child_scope_result_child_runs, child_scope_result_lanes: child_scope_result_lanes, run_order_positions: run_order_positions, on_scope_order_positions: on_scope_order_positions, external_order_positions: external_order_positions };
}

fn ecs_parallel_scoped_task_set_spawn<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> i32) -> EcsParallelScopedTaskSet<R, M> {
    let order_pos = ecs_parallel_scoped_task_set_len<R, M>(tasks);
    tasks.runs.push(run);
    tasks.run_order_positions.push(order_pos);
    return tasks;
}

fn ecs_parallel_scoped_task_set_spawn_on_scope<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> i32) -> EcsParallelScopedTaskSet<R, M> {
    let order_pos = ecs_parallel_scoped_task_set_len<R, M>(tasks);
    tasks.on_scope_runs.push(run);
    tasks.on_scope_order_positions.push(order_pos);
    return tasks;
}

fn ecs_parallel_scoped_task_set_spawn_on_external<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> i32) -> EcsParallelScopedTaskSet<R, M> {
    let order_pos = ecs_parallel_scoped_task_set_len<R, M>(tasks);
    tasks.external_runs.push(run);
    tasks.external_order_positions.push(order_pos);
    return tasks;
}

fn ecs_parallel_scoped_task_set_spawn_child_scope<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_lane<R, M>(tasks, run, 0);
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_with_lane<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>, lane: i64) -> EcsParallelScopedTaskSet<R, M> {
    tasks.child_scope_runs.push(run);
    tasks.child_scope_run_lanes.push(lane);
    return tasks;
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_on_scope<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_lane<R, M>(tasks, run, 1);
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_on_external<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_lane<R, M>(tasks, run, 2);
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_with_result<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, result_run: fn(Arc<*TableErasedWorld<R, M>>) -> i32, child_run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_result_lane<R, M>(tasks, result_run, child_run, 0);
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_with_result_lane<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, result_run: fn(Arc<*TableErasedWorld<R, M>>) -> i32, child_run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>, lane: i64) -> EcsParallelScopedTaskSet<R, M> {
    tasks.child_scope_result_runs.push(result_run);
    tasks.child_scope_result_child_runs.push(child_run);
    tasks.child_scope_result_lanes.push(lane);
    return tasks;
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_with_result_on_scope<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, result_run: fn(Arc<*TableErasedWorld<R, M>>) -> i32, child_run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_result_lane<R, M>(tasks, result_run, child_run, 1);
}

fn ecs_parallel_scoped_task_set_spawn_child_scope_with_result_on_external<R, M>(tasks: EcsParallelScopedTaskSet<R, M>, result_run: fn(Arc<*TableErasedWorld<R, M>>) -> i32, child_run: fn(Arc<*TableErasedWorld<R, M>>) -> EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    return ecs_parallel_scoped_task_set_spawn_child_scope_with_result_lane<R, M>(tasks, result_run, child_run, 2);
}

fn ecs_parallel_scoped_task_set_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return (len(tasks.runs) + len(tasks.on_scope_runs) + len(tasks.external_runs)) as i64;
}

fn ecs_parallel_scoped_task_set_threaded_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return len(tasks.runs) as i64;
}

fn ecs_parallel_scoped_task_set_on_scope_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return len(tasks.on_scope_runs) as i64;
}

fn ecs_parallel_scoped_task_set_external_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return len(tasks.external_runs) as i64;
}

fn ecs_parallel_scoped_task_set_child_scope_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return len(tasks.child_scope_runs) as i64;
}

fn ecs_parallel_scoped_task_set_child_scope_result_len<R, M>(tasks: EcsParallelScopedTaskSet<R, M>) -> i64 {
    return len(tasks.child_scope_result_runs) as i64;
}

fn ecs_parallel_scoped_task_set_find_order_slot(positions: Vec<i64>, order_pos: i64) -> i64 {
    let i: i64 = 0;
    let n = len(positions) as i64;
    while i < n {
        if positions[i] == order_pos { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_parallel_scoped_task_set_extend<R, M>(parent: EcsParallelScopedTaskSet<R, M>, child: EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopedTaskSet<R, M> {
    let order_pos: i64 = 0;
    let total = ecs_parallel_scoped_task_set_len<R, M>(child);
    while order_pos < total {
        let threaded_slot = ecs_parallel_scoped_task_set_find_order_slot(child.run_order_positions, order_pos);
        if threaded_slot >= 0 {
            parent = ecs_parallel_scoped_task_set_spawn<R, M>(parent, child.runs[threaded_slot]);
        } else {
            let local_slot = ecs_parallel_scoped_task_set_find_order_slot(child.on_scope_order_positions, order_pos);
            if local_slot >= 0 {
                parent = ecs_parallel_scoped_task_set_spawn_on_scope<R, M>(parent, child.on_scope_runs[local_slot]);
            } else {
                let external_slot = ecs_parallel_scoped_task_set_find_order_slot(child.external_order_positions, order_pos);
                if external_slot >= 0 {
                    parent = ecs_parallel_scoped_task_set_spawn_on_external<R, M>(parent, child.external_runs[external_slot]);
                };
            };
        };
        order_pos = order_pos + 1;
    }
    let child_scope_i: i64 = 0;
    let child_scope_n = ecs_parallel_scoped_task_set_child_scope_len<R, M>(child);
    while child_scope_i < child_scope_n {
        parent = ecs_parallel_scoped_task_set_spawn_child_scope_with_lane<R, M>(parent, child.child_scope_runs[child_scope_i], child.child_scope_run_lanes[child_scope_i]);
        child_scope_i = child_scope_i + 1;
    }
    let child_scope_result_i: i64 = 0;
    let child_scope_result_n = ecs_parallel_scoped_task_set_child_scope_result_len<R, M>(child);
    while child_scope_result_i < child_scope_result_n {
        parent = ecs_parallel_scoped_task_set_spawn_child_scope_with_result_lane<R, M>(parent, child.child_scope_result_runs[child_scope_result_i], child.child_scope_result_child_runs[child_scope_result_i], child.child_scope_result_lanes[child_scope_result_i]);
        child_scope_result_i = child_scope_result_i + 1;
    }
    return parent;
}

fn ecs_parallel_task_pool_new(worker_count: i64) -> EcsParallelTaskPool {
    let workers = worker_count;
    if workers < 0 { workers = 0; };
    let width = workers;
    return EcsParallelTaskPool { worker_count: workers, max_batch_width: width };
}

fn ecs_parallel_task_pool_with_batch_width(worker_count: i64, max_batch_width: i64) -> EcsParallelTaskPool {
    let workers = worker_count;
    if workers < 0 { workers = 0; };
    let width = max_batch_width;
    if width < 0 { width = 0; };
    if width > workers { width = workers; };
    return EcsParallelTaskPool { worker_count: workers, max_batch_width: width };
}

fn ecs_parallel_task_pool_worker_count(pool: EcsParallelTaskPool) -> i64 {
    return pool.worker_count;
}

fn ecs_parallel_task_pool_batch_width(pool: EcsParallelTaskPool) -> i64 {
    return pool.max_batch_width;
}

fn ecs_parallel_task_pool_run_lifecycle_callbacks(pool: EcsParallelTaskPool, on_spawn: fn() -> i32, on_destroy: fn() -> i32) -> EcsParallelTaskPoolLifecycleResult {
    if pool.worker_count <= 0 { return ecs_parallel_task_pool_lifecycle_result(pool.worker_count, 0, 0, 0, 0, false, false); };
    let handles: Vec<JoinHandle<EcsParallelTaskPoolLifecycleWorkerResult>> = Vec::new();
    let spawn_i: i64 = 0;
    while spawn_i < pool.worker_count {
        handles.push(thread::spawn(^|| ecs_parallel_task_pool_lifecycle_worker_run(on_spawn, on_destroy)));
        spawn_i = spawn_i + 1;
    }
    let spawn_count: i64 = 0;
    let destroy_count: i64 = 0;
    let spawn_sum: i32 = 0;
    let destroy_sum: i32 = 0;
    let join_i: i64 = 0;
    while join_i < len(handles) as i64 {
        let worker_result = handles[join_i].join().unwrap();
        spawn_count = spawn_count + 1;
        destroy_count = destroy_count + 1;
        spawn_sum = spawn_sum + worker_result.spawn_value;
        destroy_sum = destroy_sum + worker_result.destroy_value;
        join_i = join_i + 1;
    }
    let mismatch = spawn_count != pool.worker_count || destroy_count != pool.worker_count;
    return ecs_parallel_task_pool_lifecycle_result(pool.worker_count, spawn_count, destroy_count, spawn_sum, destroy_sum, true, mismatch);
}

fn ecs_parallel_run_mut_batch<R, M>(world: TableErasedWorld<R, M>, first: fn(Arc<*TableErasedWorld<R, M>>) -> i32, second: fn(Arc<*TableErasedWorld<R, M>>) -> i32, first_access: TableErasedSystemAccess, second_access: TableErasedSystemAccess) -> i32 {
    if table_erased_access_conflicts(first_access, second_access) { panic(23010); };
    let world_box = Box::new(world);
    let world_ptr = Box::into_raw(world_box);
    let shared = Arc::new(world_ptr);
    let first_ptr = shared.clone();
    let second_ptr = shared.clone();
    let first_handle = thread::spawn(^|| first(first_ptr));
    let second_handle = thread::spawn(^|| second(second_ptr));
    return first_handle.join().unwrap() + second_handle.join().unwrap();
}

