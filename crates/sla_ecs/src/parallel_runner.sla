        if ecs_executor_ready_batch_count(batch) >= width { return ecs_parallel_catalog_ready_selection(p, batch, skipped_count, false); };
        if ecs_executor_state_is_ready(p.executor.state, i) {
            if ecs_executor_state_is_completed(p.executor.state, i) != true {
                if ecs_executor_state_is_running(p.executor.state, i) != true {
                    let spec = ecs_executor_run_plan_spec_at(p, i);
                    if spec.should_run != true {
                        p = ecs_executor_run_plan_skip_ready(p, i);
                        batch.skipped.push(i);
                        skipped_count = skipped_count + 1;
                    } else {
                        let slot = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, i);
                        if slot < 0 {
                            if ecs_executor_ready_batch_count(batch) == 0 { return ecs_parallel_catalog_ready_selection(p, batch, skipped_count, true); };
                            return ecs_parallel_catalog_ready_selection(p, batch, skipped_count, false);
                        };
                        if spec.is_exclusive || spec.is_local {
                            if ecs_executor_ready_batch_count(batch) == 0 {
                                batch.systems.push(i);
                                batch.is_exclusive = spec.is_exclusive;
                                batch.is_local = spec.is_local;
                            };
                            return ecs_parallel_catalog_ready_selection(p, batch, skipped_count, false);
                        };
                        if ecs_parallel_dynamic_catalog_conflicts_with_batch<R, M>(catalog, batch, i) != true {
                            batch.systems.push(i);
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    return ecs_parallel_catalog_ready_selection(p, batch, skipped_count, false);
}

fn ecs_parallel_run_selected_dynamic_catalog_batch_unbounded<R, M>(world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, batch: EcsExecutorReadyBatch, skipped: i64, catalog: EcsParallelFnCatalog<R, M>) -> EcsParallelReadyBatchRunResult {
    let count = ecs_executor_ready_batch_count(batch);
    if count <= 9 { return ecs_parallel_run_selected_dynamic_catalog_batch_up_to9<R, M>(world, plan, batch, skipped, catalog); };
    if ecs_executor_ready_batch_is_exclusive(batch) { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
    if ecs_executor_ready_batch_is_local(batch) { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
    let check: i64 = 0;
    while check < count {
        let system_index = ecs_executor_ready_batch_at(batch, check);
        let slot = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, system_index);
        if slot < 0 { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
        check = check + 1;
    }
    let world_box = Box::new(world);
    let world_ptr = Box::into_raw(world_box);
    let shared = Arc::new(world_ptr);
    let handles: Vec<JoinHandle<i32>> = Vec::new();
    let i: i64 = 0;
    while i < count {
        let system_index = ecs_executor_ready_batch_at(batch, i);
        let slot = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, system_index);
        let run = catalog.runs[slot];
        let task_world = shared.clone();
        let handle = thread::spawn(^|| run(task_world));
        handles.push(handle);
        i = i + 1;
    }
    let sum: i32 = 0;
    let j: i64 = 0;
    while j < len(handles) as i64 {
        sum = sum + handles[j].join().unwrap();
        j = j + 1;
    }
    return ecs_parallel_catalog_complete_batch(plan, batch, sum, count, skipped, true);
}

fn ecs_parallel_run_ready_dynamic_catalog_batch_unbounded<R, M>(world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>, max_width: i64) -> EcsParallelReadyBatchRunResult {
    let selected = ecs_parallel_take_ready_dynamic_catalog_batch_unbounded<R, M>(plan, catalog, max_width);
    if selected.mismatch { return ecs_parallel_ready_batch_run_result(selected.plan, 0, 0, selected.skipped_count, false, true); };
    return ecs_parallel_run_selected_dynamic_catalog_batch_unbounded<R, M>(world, selected.plan, selected.batch, selected.skipped_count, catalog);
}

fn ecs_parallel_run_ready_all_dynamic_catalog_unbounded<R, M>(world: TableErasedWorld<R, M>, p: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>, max_width: i64) -> EcsParallelReadyBatchRunResult {
    let total_sum: i32 = 0;
    let total_ran: i64 = 0;
    let total_skipped: i64 = 0;
    let any_threads = false;
    let guard: i64 = 0;
    let limit = p.executor.state.system_count * 2 + 1;
    while guard < limit {
        if ecs_executor_state_completed_count(p.executor.state) >= p.executor.state.system_count {
            return ecs_parallel_ready_batch_run_result(p, total_sum, total_ran, total_skipped, any_threads, false);
        };
        let before = ecs_executor_state_completed_count(p.executor.state);
        let result = ecs_parallel_run_ready_dynamic_catalog_batch_unbounded<R, M>(world, p, catalog, max_width);
        p = result.plan;
        if result.used_threads { any_threads = true; };
        total_sum = total_sum + result.thread_sum;
        total_ran = total_ran + result.ran_count;
        total_skipped = total_skipped + result.skipped_count;
        if result.mismatch {
            if ecs_executor_state_completed_count(p.executor.state) < p.executor.state.system_count { p.stalled = true; };
            return ecs_parallel_ready_batch_run_result(p, total_sum, total_ran, total_skipped, any_threads, true);
        };
        let after = ecs_executor_state_completed_count(p.executor.state);
        if after == before {
            if after < p.executor.state.system_count { p.stalled = true; };
            return ecs_parallel_ready_batch_run_result(p, total_sum, total_ran, total_skipped, any_threads, true);
        };
        guard = guard + 1;
    }
    p.stalled = true;
    return ecs_parallel_ready_batch_run_result(p, total_sum, total_ran, total_skipped, any_threads, true);
}

fn ecs_parallel_task_pool_run_ready_dynamic_catalog_batch<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>) -> EcsParallelReadyBatchRunResult {
    return ecs_parallel_run_ready_dynamic_catalog_batch_unbounded<R, M>(world, plan, catalog, pool.max_batch_width);
}

fn ecs_parallel_task_pool_run_ready_all_dynamic_catalog<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>) -> EcsParallelReadyBatchRunResult {
    return ecs_parallel_run_ready_all_dynamic_catalog_unbounded<R, M>(world, plan, catalog, pool.max_batch_width);
}

fn ecs_parallel_task_pool_scope_run_ready_dynamic_catalog_batch<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>) -> EcsParallelReadyBatchRunResult {
    return ecs_parallel_task_pool_run_ready_dynamic_catalog_batch<R, M>(pool, world, plan, catalog);
}

fn ecs_parallel_task_pool_scope_run_ready_all_dynamic_catalog<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, plan: EcsExecutorRunPlan, catalog: EcsParallelFnCatalog<R, M>) -> EcsParallelReadyBatchRunResult {
    return ecs_parallel_task_pool_run_ready_all_dynamic_catalog<R, M>(pool, world, plan, catalog);
}

fn ecs_parallel_task_pool_scope_run_tasks<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, tasks: EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopeRunResult {
    return ecs_parallel_task_pool_scope_run_tasks_with_options<R, M>(pool, world, tasks, ecs_parallel_scope_options_default());
}

fn ecs_parallel_task_pool_scope_run_tasks_with_options<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, tasks: EcsParallelScopedTaskSet<R, M>, options: EcsParallelScopeOptions) -> EcsParallelScopeRunResult {
    let world_box = Box::new(world);
    let world_ptr = Box::into_raw(world_box);
    let shared = Arc::new(world_ptr);
    return ecs_parallel_task_pool_scope_run_tasks_shared<R, M>(pool, shared, tasks, options);
}

fn ecs_parallel_task_pool_scope_run_tasks_shared_serial<R, M>(shared: Arc<*TableErasedWorld<R, M>>, tasks: EcsParallelScopedTaskSet<R, M>, options: EcsParallelScopeOptions) -> EcsParallelScopeRunResult {
    let count = ecs_parallel_scoped_task_set_threaded_len<R, M>(tasks);
    let local_count = ecs_parallel_scoped_task_set_on_scope_len<R, M>(tasks);
    let external_count = ecs_parallel_scoped_task_set_external_len<R, M>(tasks);
    let total_count = count + local_count + external_count;
    let total_sum: i32 = 0;
    let total_ran: i64 = 0;
    let result_values: Vec<i32> = Vec::new();
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let value_i: i64 = 0;
    while value_i < total_count {
        result_values.push(0);
        result_rounds.push(0);
        result_lanes.push(0);
        value_i = value_i + 1;
    }
    let serial_i: i64 = 0;
    while serial_i < count {
        let run = tasks.runs[serial_i];
        let task_world = shared.clone();
        let value = run(task_world);
        let order_pos = tasks.run_order_positions[serial_i];
        result_values[order_pos] = value;
        result_rounds[order_pos] = 0;
        result_lanes[order_pos] = 0;
        total_sum = total_sum + value;
        total_ran = total_ran + 1;
        serial_i = serial_i + 1;
    }
    let local_i: i64 = 0;
    while local_i < local_count {
        let run = tasks.on_scope_runs[local_i];
        let task_world = shared.clone();
        let value = run(task_world);
        let order_pos = tasks.on_scope_order_positions[local_i];
        result_values[order_pos] = value;
        result_rounds[order_pos] = 0;
        result_lanes[order_pos] = 1;
        total_sum = total_sum + value;
        total_ran = total_ran + 1;
        local_i = local_i + 1;
    }
    let external_i: i64 = 0;
    while external_i < external_count {
        let run = tasks.external_runs[external_i];
        let task_world = shared.clone();
        let value = run(task_world);
        let order_pos = tasks.external_order_positions[external_i];
        result_values[order_pos] = value;
        result_rounds[order_pos] = 0;
        result_lanes[order_pos] = 2;
        total_sum = total_sum + value;
        total_ran = total_ran + 1;
        external_i = external_i + 1;
    }
    return ecs_parallel_scope_run_result_with_metadata_and_executor_flags(total_sum, result_values, result_rounds, result_lanes, total_ran, local_count, external_count, 0, false, count > 0, local_count > 0 || (external_count > 0 && options.external_executor_is_scope), external_count > 0 && options.use_external_executor && options.external_executor_is_scope != true, false);
}

fn ecs_parallel_task_pool_scope_run_tasks_shared<R, M>(pool: EcsParallelTaskPool, shared: Arc<*TableErasedWorld<R, M>>, tasks: EcsParallelScopedTaskSet<R, M>, options: EcsParallelScopeOptions) -> EcsParallelScopeRunResult {
    let count = ecs_parallel_scoped_task_set_threaded_len<R, M>(tasks);
    let local_count = ecs_parallel_scoped_task_set_on_scope_len<R, M>(tasks);
    let external_count = ecs_parallel_scoped_task_set_external_len<R, M>(tasks);
    let total_count = count + local_count + external_count;
    if total_count == 0 { return ecs_parallel_scope_run_result(0, 0, 0, 0, 0, false, false); };
    let width = pool.max_batch_width;
    if width <= 0 { return ecs_parallel_task_pool_scope_run_tasks_shared_serial<R, M>(shared, tasks, options); };
    let total_sum: i32 = 0;
    let total_ran: i64 = 0;
    let waves: i64 = 0;
    let result_values: Vec<i32> = Vec::new();
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let value_i: i64 = 0;
    while value_i < total_count {
        result_values.push(0);
        result_rounds.push(0);
        result_lanes.push(0);
        value_i = value_i + 1;
    }
    let offset: i64 = 0;
    while offset < count {
        let batch_count = width;
        let remaining = count - offset;
        if batch_count > remaining { batch_count = remaining; };
        let handles: Vec<JoinHandle<i32>> = Vec::new();
        let i: i64 = 0;
        while i < batch_count {
            let run = tasks.runs[offset + i];
            let task_world = shared.clone();
            let handle = thread::spawn(^|| run(task_world));
            handles.push(handle);
            i = i + 1;
        }
        let j: i64 = 0;
        while j < len(handles) as i64 {
            let value = handles[j].join().unwrap();
            let order_pos = tasks.run_order_positions[offset + j];
            result_values[order_pos] = value;
            result_rounds[order_pos] = 0;
            result_lanes[order_pos] = 0;
            total_sum = total_sum + value;
            j = j + 1;
        }
        total_ran = total_ran + batch_count;
        waves = waves + 1;
        offset = offset + batch_count;
    }
    let local_i: i64 = 0;
    while local_i < local_count {
        let run = tasks.on_scope_runs[local_i];
        let task_world = shared.clone();
        let value = run(task_world);
        let order_pos = tasks.on_scope_order_positions[local_i];
        result_values[order_pos] = value;
        result_rounds[order_pos] = 0;
        result_lanes[order_pos] = 1;
        total_sum = total_sum + value;
        total_ran = total_ran + 1;
        local_i = local_i + 1;
    }
    let external_i: i64 = 0;
    while external_i < external_count {
        let run = tasks.external_runs[external_i];
        let task_world = shared.clone();
        let value = run(task_world);
        let order_pos = tasks.external_order_positions[external_i];
        result_values[order_pos] = value;
        result_rounds[order_pos] = 0;
        result_lanes[order_pos] = 2;
        total_sum = total_sum + value;
        total_ran = total_ran + 1;
        external_i = external_i + 1;
    }
    return ecs_parallel_scope_run_result_with_metadata_and_executor_flags(total_sum, result_values, result_rounds, result_lanes, total_ran, local_count, external_count, waves, count > 0, count > 0 && options.tick_task_pool_executor, local_count > 0 || (external_count > 0 && options.external_executor_is_scope), external_count > 0 && options.use_external_executor && options.external_executor_is_scope != true, false);
}

fn ecs_parallel_task_pool_scope_run_tasks_recursive<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, tasks: EcsParallelScopedTaskSet<R, M>) -> EcsParallelScopeRunResult {
    return ecs_parallel_task_pool_scope_run_tasks_recursive_with_options<R, M>(pool, world, tasks, ecs_parallel_scope_options_default());
}

fn ecs_parallel_task_pool_scope_run_tasks_recursive_with_options<R, M>(pool: EcsParallelTaskPool, world: TableErasedWorld<R, M>, tasks: EcsParallelScopedTaskSet<R, M>, options: EcsParallelScopeOptions) -> EcsParallelScopeRunResult {
    let world_box = Box::new(world);
    let world_ptr = Box::into_raw(world_box);
    let shared = Arc::new(world_ptr);
    let total_sum: i32 = 0;
    let total_ran: i64 = 0;
    let total_local: i64 = 0;
    let total_external: i64 = 0;
    let total_waves: i64 = 0;
    let total_child_scopes: i64 = 0;
    let total_child_scope_pool: i64 = 0;
    let total_child_scope_local: i64 = 0;
    let total_child_scope_external: i64 = 0;
    let total_child_scope_waves: i64 = 0;
    let total_child_scope_result_waves: i64 = 0;
    let total_child_scope_results: i64 = 0;
    let total_generated_tasks: i64 = 0;
    let depth: i64 = 0;
    let any_threads = false;
    let ticked_pool = false;
    let ticked_scope = false;
    let ticked_external = false;
    let result_values: Vec<i32> = Vec::new();
    let result_rounds: Vec<i64> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let guard: i64 = 0;

    let root_direct_count = ecs_parallel_scoped_task_set_len<R, M>(tasks);
    let root_child_scope_count = ecs_parallel_scoped_task_set_child_scope_len<R, M>(tasks);
    let root_child_scope_result_count = ecs_parallel_scoped_task_set_child_scope_result_len<R, M>(tasks);
    if root_direct_count == 0 {
        if root_child_scope_count == 0 {
            if root_child_scope_result_count == 0 { return ecs_parallel_scope_run_result_recursive(total_sum, result_values, result_rounds, result_lanes, total_ran, total_local, total_external, total_waves, total_child_scopes, total_child_scope_pool, total_child_scope_local, total_child_scope_external, total_child_scope_waves, total_child_scope_result_waves, total_child_scope_results, total_generated_tasks, depth, any_threads, ticked_pool, ticked_scope, ticked_external, false); };
        };
    };
    let pending = ecs_parallel_scoped_task_set_new<R, M>();
    let root_child_i: i64 = 0;
    while root_child_i < root_child_scope_count {
        let child_lane = tasks.child_scope_run_lanes[root_child_i];
        let child_run = tasks.child_scope_runs[root_child_i];
        if child_lane == 0 {
            if pool.max_batch_width > 0 {
                let handles: Vec<JoinHandle<EcsParallelScopedTaskSet<R, M>>> = Vec::new();
                let batch_count: i64 = 0;
                while root_child_i + batch_count < root_child_scope_count {
                    if batch_count >= pool.max_batch_width { break; };
                    if tasks.child_scope_run_lanes[root_child_i + batch_count] != 0 { break; };
                    let wave_run = tasks.child_scope_runs[root_child_i + batch_count];
                    let child_world = shared.clone();
                    handles.push(thread::spawn(^|| wave_run(child_world)));
                    batch_count = batch_count + 1;
                }
                let join_i: i64 = 0;
                while join_i < len(handles) as i64 {
                    let generated_tasks = handles[join_i].join().unwrap();
                    pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
                    total_child_scopes = total_child_scopes + 1;
                    total_child_scope_pool = total_child_scope_pool + 1;
                    join_i = join_i + 1;
                }
                total_child_scope_waves = total_child_scope_waves + 1;
                any_threads = true;
                if options.tick_task_pool_executor { ticked_pool = true; };
                root_child_i = root_child_i + batch_count;
            } else {
                let child_world = shared.clone();
                let generated_tasks = child_run(child_world);
                pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
                ticked_pool = true;
                total_child_scopes = total_child_scopes + 1;
                total_child_scope_pool = total_child_scope_pool + 1;
                root_child_i = root_child_i + 1;
            };
        } else {
            let child_world = shared.clone();
            let generated_tasks = child_run(child_world);
            pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
            total_child_scopes = total_child_scopes + 1;
            if child_lane == 1 {
                total_child_scope_local = total_child_scope_local + 1;
                ticked_scope = true;
            };
            if child_lane == 2 {
                total_child_scope_external = total_child_scope_external + 1;
                if options.external_executor_is_scope { ticked_scope = true; };
                if options.use_external_executor && options.external_executor_is_scope != true { ticked_external = true; };
            };
            root_child_i = root_child_i + 1;
        };
    }
    let root_child_result_i: i64 = 0;
    while root_child_result_i < root_child_scope_result_count {
        let child_lane = tasks.child_scope_result_lanes[root_child_result_i];
        let result_run = tasks.child_scope_result_runs[root_child_result_i];
        if child_lane == 0 {
            if pool.max_batch_width > 0 {
                let result_handles: Vec<JoinHandle<i32>> = Vec::new();
                let batch_count: i64 = 0;
                while root_child_result_i + batch_count < root_child_scope_result_count {
                    if batch_count >= pool.max_batch_width { break; };
                    if tasks.child_scope_result_lanes[root_child_result_i + batch_count] != 0 { break; };
                    let wave_result_run = tasks.child_scope_result_runs[root_child_result_i + batch_count];
                    let result_world = shared.clone();
                    result_handles.push(thread::spawn(^|| wave_result_run(result_world)));
                    batch_count = batch_count + 1;
                }
                let result_join_i: i64 = 0;
                while result_join_i < len(result_handles) as i64 {
                    let result_value = result_handles[result_join_i].join().unwrap();
                    result_values.push(result_value);
                    result_rounds.push(depth);
                    result_lanes.push(3);
                    total_sum = total_sum + result_value;
                    total_ran = total_ran + 1;
                    total_child_scope_results = total_child_scope_results + 1;
                    result_join_i = result_join_i + 1;
                }
                let child_handles: Vec<JoinHandle<EcsParallelScopedTaskSet<R, M>>> = Vec::new();
                let child_spawn_i: i64 = 0;
                while child_spawn_i < batch_count {
                    let wave_child_run = tasks.child_scope_result_child_runs[root_child_result_i + child_spawn_i];
                    let child_world = shared.clone();
                    child_handles.push(thread::spawn(^|| wave_child_run(child_world)));
                    child_spawn_i = child_spawn_i + 1;
                }
                let child_join_i: i64 = 0;
                while child_join_i < len(child_handles) as i64 {
                    let generated_tasks = child_handles[child_join_i].join().unwrap();
                    pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
                    total_child_scopes = total_child_scopes + 1;
                    total_child_scope_pool = total_child_scope_pool + 1;
                    child_join_i = child_join_i + 1;
                }
                total_child_scope_result_waves = total_child_scope_result_waves + 1;
                any_threads = true;
                if options.tick_task_pool_executor { ticked_pool = true; };
                root_child_result_i = root_child_result_i + batch_count;
            } else {
                let result_world = shared.clone();
                let result_value = result_run(result_world);
                result_values.push(result_value);
                result_rounds.push(depth);
                result_lanes.push(3);
                total_sum = total_sum + result_value;
                total_ran = total_ran + 1;
                total_child_scope_results = total_child_scope_results + 1;
                let child_run = tasks.child_scope_result_child_runs[root_child_result_i];
                let child_world = shared.clone();
                let generated_tasks = child_run(child_world);
                pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
                ticked_pool = true;
                total_child_scopes = total_child_scopes + 1;
                total_child_scope_pool = total_child_scope_pool + 1;
                root_child_result_i = root_child_result_i + 1;
            };
        } else {
            let result_world = shared.clone();
            let result_value = result_run(result_world);
            result_values.push(result_value);
            result_rounds.push(depth);
            result_lanes.push(3);
            total_sum = total_sum + result_value;
            total_ran = total_ran + 1;
            total_child_scope_results = total_child_scope_results + 1;
            let child_run = tasks.child_scope_result_child_runs[root_child_result_i];
            let child_world = shared.clone();
            let generated_tasks = child_run(child_world);
            pending = ecs_parallel_scoped_task_set_extend<R, M>(pending, generated_tasks);
